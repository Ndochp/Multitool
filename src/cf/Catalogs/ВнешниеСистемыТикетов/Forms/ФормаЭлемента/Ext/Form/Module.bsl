#Область ОбработчикиСобытийФормы

// Токен доступа не хранится в реквизитах справочника: читается из
// безопасного хранилища (ОбщегоНазначения) по владельцу - ссылке на
// систему. Пользователю значение не показывается; в поле подставляется
// маска, чтобы дать возможность заменить или очистить токен.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	Если НЕ Объект.Ссылка.Пустая() Тогда
		УстановитьПривилегированныйРежим(Истина);
		ТокенУстановлен = ЗначениеЗаполнено(
			ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Объект.Ссылка, "PRIVATE_TOKEN"));
		УстановитьПривилегированныйРежим(Ложь);
		Токен = ?(ТокенУстановлен, Строка(Новый УникальныйИдентификатор()), "");
		ТокенИзменен = Ложь;
	КонецЕсли;

КонецПроцедуры

// Сохраняет токен в безопасное хранилище после записи элемента, если
// поле менялось. Пустое значение удаляет токен из хранилища
// (ЗаписатьДанныеВБезопасноеХранилище с Данные = Неопределено).
//
&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ТокенИзменен Тогда
		УстановитьПривилегированныйРежим(Истина);
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
			ТекущийОбъект.Ссылка,
			?(ПустаяСтрока(Токен), Неопределено, СокрЛП(Токен)),
			"PRIVATE_TOKEN");
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Любое изменение поля токена (включая очистку) требует сохранения.
//
&НаКлиенте
Процедура ПолеТокенПриИзменении(Элемент)

	ТокенИзменен = Истина;

КонецПроцедуры

#КонецОбласти

