#Область ОбработчикиКомандФормы

// Точечно загружает данные задачи из живого GitLab по веб-ссылке:
// использует ссылку из поля ВебURL (если пусто - спрашивает), внешняя
// система подбирается сервером по хосту ссылки. Реквизиты только
// заполняются - записывает объект пользователь.
&НаКлиенте
Процедура ЗагрузитьИзGitLab(Команда)

	Если НЕ ПустаяСтрока(Объект.ВебURL) Тогда
		ЗагрузитьИзGitLabПоСсылке(Объект.ВебURL);
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ЗагрузитьИзGitLabВводЗавершение", ЭтотОбъект);

	ПоказатьВводСтроки(Оповещение, "",
		НСтр("ru = 'Укажите веб-ссылку на задачу GitLab'"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

// Завершение ввода веб-ссылки: запускает загрузку.
//
// Параметры:
//   Ссылка                - Строка, Неопределено - введённая ссылка
//     (Неопределено - ввод отменён).
//   ДополнительныеПараметры - Произвольный - не используются.
//
&НаКлиенте
Процедура ЗагрузитьИзGitLabВводЗавершение(Ссылка, ДополнительныеПараметры) Экспорт

	Если Ссылка = Неопределено Или ПустаяСтрока(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ЗагрузитьИзGitLabПоСсылке(Ссылка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет загрузку: сервер заполняет объект задачи данными из GitLab,
// изменённый Объект Форма получает автоматически.
//
// Параметры:
//   Ссылка - Строка - веб-URL задачи вида ".../проект/-/issues/123".
//
&НаКлиенте
Процедура ЗагрузитьИзGitLabПоСсылке(Ссылка)

	Результат = ЗагрузитьИзGitLabНаСервере(Ссылка);

	Если Результат.Ошибка Тогда
		ПоказатьПредупреждение(, Результат.Сообщение);
	Иначе
		ПоказатьОповещениеПользователя(Результат.Сообщение);
	КонецЕсли;

КонецПроцедуры

// Заполняет объект задачи данными живой задачи GitLab через фасад
// интеграции (подбор внешней системы + чтение API в зеркале).
//
// Параметры:
//   Ссылка - Строка - веб-URL задачи.
//
// Возвращаемое значение:
//   Структура - Ошибка (Булево), Сообщение (Строка).
//
&НаСервере
Функция ЗагрузитьИзGitLabНаСервере(Знач Ссылка)

	Результат = Новый Структура("Ошибка, Сообщение", Ложь, "");

	Ошибка = Обработки.УчетРабочегоВремениИнтеграции.Создать()
		.ЗаполнитьЗадачуПоСсылке(Объект, Ссылка);

	Если НЕ ПустаяСтрока(Ошибка) Тогда
		Результат.Ошибка    = Истина;
		Результат.Сообщение = Ошибка;
		Возврат Результат;
	КонецЕсли;

	Результат.Сообщение = СтрШаблон(
		НСтр("ru = 'Данные задачи «%1» загружены из GitLab.'"),
		Объект.Наименование);

	Возврат Результат;

КонецФункции

#КонецОбласти
