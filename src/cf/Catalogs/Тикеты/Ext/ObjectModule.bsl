// Модуль объекта справочника Тикеты.
// При записи тикета с данными внешней системы (ВнешняяСистема + внешний
// идентификатор/ссылка) связка ВнешняяЗадача ищется во внешней системе:
// найдена - заполняется, не найдена - остаётся пустой.

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Попытка
		Обработки.УчетРабочегоВремениИнтеграции.Создать().ЗаполнитьВнешнююЗадачуТикета(ЭтотОбъект);
	Исключение
		// Ошибки внешней системы не прерывают запись тикета - связка остаётся пустой.
		ЗаписьЖурналаРегистрации("Тикеты.ЗаполнениеВнешнейЗадачи",
			УровеньЖурналаРегистрации.Предупреждение, ,
			Строка(ЭтотОбъект),
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
