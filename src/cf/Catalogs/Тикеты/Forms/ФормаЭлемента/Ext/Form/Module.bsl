#Область ОбработчикиСобытийФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

// Заполняет реквизиты адресации тикета по задаче зеркала GitLab:
// открывает выбор задачи (по умолчанию - текущая ВнешняяЗадача тикета).
//
&НаКлиенте
Процедура ЗаполнитьПоЗадаче(Команда)

	Оповещение = Новый ОписаниеОповещения("ЗаполнитьПоЗадачеЗавершение", ЭтотОбъект);

	ПоказатьВводЗначения(Оповещение, Объект.ВнешняяЗадача,
		НСтр("ru = 'Выберите задачу зеркала GitLab'"),
		Тип("СправочникСсылка.ГитлабЗадачи"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

// Завершение выбора задачи GitLab: заполняет реквизиты адресации.
//
// Параметры:
//   Задача                  - СправочникСсылка.ГитлабЗадачи, Неопределено -
//     выбранная задача (Неопределено - выбор отменён).
//   ДополнительныеПараметры - Произвольный - не используются.
//
&НаКлиенте
Процедура ЗаполнитьПоЗадачеЗавершение(Задача, ДополнительныеПараметры) Экспорт

	Если НЕ ЗначениеЗаполнено(Задача) Тогда
		Возврат;
	КонецЕсли;

	Результат = ЗаполнитьРеквизитыАдресацииНаСервере(Задача);

	Если Результат.Ошибка Тогда
		ПоказатьПредупреждение(, Результат.Сообщение);
	Иначе
		ПоказатьОповещениеПользователя(Результат.Сообщение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет реквизиты адресации тикета данными выбранной задачи зеркала.
// Наименование заполняется только у пустого тикета.
//
// Параметры:
//   Задача - СправочникСсылка.ГитлабЗадачи - задача зеркала.
//
// Возвращаемое значение:
//   Структура - Ошибка (Булево), Сообщение (Строка).
//
&НаСервере
Функция ЗаполнитьРеквизитыАдресацииНаСервере(Знач Задача)

	Результат = Новый Структура("Ошибка, Сообщение", Ложь, "");

	Адресация = Обработки.УчетРабочегоВремениИнтеграции.Создать()
		.РеквизитыАдресацииПоЗадаче(Задача, Объект.ВнешняяСистема);

	Если НЕ Адресация.Успешно Тогда
		Результат.Ошибка    = Истина;
		Результат.Сообщение = Адресация.Сообщение;
		Возврат Результат;
	КонецЕсли;

	Объект.ВнешняяСистема       = Адресация.Система;
	Объект.ВнешнийИдентификатор = Адресация.ВнешнийИдентификатор;
	Объект.СсылкаНаВнешнийТикет = Адресация.ВебURL;
	Объект.ВнешняяЗадача        = Задача;

	Если НЕ ЗначениеЗаполнено(Объект.Наименование) Тогда
		Объект.Наименование = Адресация.Наименование;
	КонецЕсли;

	Результат.Сообщение = СтрШаблон(
		НСтр("ru = 'Реквизиты адресации заполнены по задаче «%1».'"),
		Адресация.Наименование);

	Возврат Результат;

КонецФункции

#КонецОбласти
