// Версии расписания (п.9 роадмапа): снимок расписания проекта в
// ВерсияРасписанияПроекта и отклонения текущего расписания от снимка.
//
// Гексагональное разделение: адаптер к базе (как ИмпортMSPDI) - чтение Работ
// проекта, запись снимка; сравнение - по ссылке Работы (надёжнее строк UID,
// которые в базе дублируются между проектами).
//
// Снимок: ТЧ TaskBaselines {Task, Start, Finish, Duration, Work, Cost,
// FixedCost} - по всем Работам владельца-Проекта (папки не используются).
// Отклонения: только работы, изменившиеся после снимка (даты, длительность,
// труд); сдвиги дат возвращаются в минутах (как длительности в подсистеме).
// Ограничения v1: работы, удалённые после снимка, не отмечаются; работы,
// добавленные после снимка, в отклонения не попадают (их нет в снимке);
// Cost/FixedCost снимаются, но в сравнении не участвуют.

#Область ПрограммныйИнтерфейс

// Записывает снимок расписания проекта (новую версию).
//
// Параметры:
//   Проект - СправочникСсылка.Проект
//
// Возвращаемое значение:
//   СправочникСсылка.ВерсияРасписанияПроекта - записанная версия
//
Функция Зафиксировать(Проект) Экспорт

	Версия = Справочники.ВерсияРасписанияПроекта.СоздатьЭлемент();
	Версия.Владелец = Проект;
	Версия.UID = Строка(Новый УникальныйИдентификатор());
	Версия.VersionDate = ТекущаяДатаСеанса();
	Для Каждого Состояние Из СостоянияРабот(Проект) Цикл
		СтрокаСнимка = Версия.TaskBaselines.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСнимка, Состояние);
	КонецЦикла;
	Версия.Записать();

	Возврат Версия.Ссылка;

КонецФункции

// Отклонения текущего расписания проекта от снимка версии.
//
// Параметры:
//   Версия - СправочникСсылка.ВерсияРасписанияПроекта
//
// Возвращаемое значение:
//   Массив из Структура: {Task, StartБыло, StartСтало, СдвигStart (минуты),
//                         FinishБыло, FinishСтало, СдвигFinish (минуты),
//                         DurationБыло, DurationСтало, WorkБыло, WorkСтало}
//   - только изменившиеся работы, в порядке снимка
//
Функция Отклонения(Версия) Экспорт

	ТекущиеСостояния = СоответствиеСостояний(СостоянияРабот(Версия.Владелец));
	Результат = Новый Массив;
	Для Каждого СтрокаСнимка Из Версия.TaskBaselines Цикл
		Состояние = ТекущиеСостояния.Получить(СтрокаСнимка.Task);
		Если Состояние = Неопределено Тогда
			Продолжить; // работа удалена после снимка (v1)
		КонецЕсли;
		Если РасписаниеНеизменилось(Состояние, СтрокаСнимка) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(ОтклонениеРаботы(Состояние, СтрокаСнимка));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Состояние расписания всех работ проекта (запросом, для снимка и сравнения).
Функция СостоянияРабот(Проект)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Работы.Ссылка КАК Task,
		|	Работы.Start КАК Start,
		|	Работы.Finish КАК Finish,
		|	Работы.Duration КАК Duration,
		|	Работы.Work КАК Work,
		|	Работы.Cost КАК Cost,
		|	Работы.FixedCost КАК FixedCost
		|ИЗ
		|	Справочник.Работы КАК Работы
		|ГДЕ
		|	Работы.Владелец = &Проект";
	Запрос.УстановитьПараметр("Проект", Проект);

	Состояния = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Состояния.Добавить(НовоеСостояние(Выборка));
	КонецЦикла;

	Возврат Состояния;

КонецФункции

Функция НовоеСостояние(Выборка)

	Возврат Новый Структура("Task, Start, Finish, Duration, Work, Cost, FixedCost",
		Выборка.Task, Выборка.Start, Выборка.Finish, Выборка.Duration,
		Выборка.Work, Выборка.Cost, Выборка.FixedCost);

КонецФункции

Функция СоответствиеСостояний(Состояния)

	Соответствие = Новый Соответствие;
	Для Каждого Состояние Из Состояния Цикл
		Соответствие.Вставить(Состояние.Task, Состояние);
	КонецЦикла;
	Возврат Соответствие;

КонецФункции

// Изменились ли дата/длительность/труд (Cost/FixedCost в v1 не сравниваются).
Функция РасписаниеНеизменилось(Состояние, СтрокаСнимка)

	Возврат Состояние.Start = СтрокаСнимка.Start
		И Состояние.Finish = СтрокаСнимка.Finish
		И Состояние.Duration = СтрокаСнимка.Duration
		И Состояние.Work = СтрокаСнимка.Work;

КонецФункции

Функция ОтклонениеРаботы(Состояние, СтрокаСнимка)

	Возврат Новый Структура(
		"Task, StartБыло, StartСтало, СдвигStart, FinishБыло, FinishСтало, СдвигFinish,
		|DurationБыло, DurationСтало, WorkБыло, WorkСтало",
		Состояние.Task,
		СтрокаСнимка.Start, Состояние.Start, СдвигМинут(Состояние.Start, СтрокаСнимка.Start),
		СтрокаСнимка.Finish, Состояние.Finish, СдвигМинут(Состояние.Finish, СтрокаСнимка.Finish),
		СтрокаСнимка.Duration, Состояние.Duration,
		СтрокаСнимка.Work, Состояние.Work);

КонецФункции

// Сдвиг новой даты относительно снимка в минутах (положительный - позже).
Функция СдвигМинут(Стало, Было)

	Возврат (Стало - Было) / 60;

КонецФункции

#КонецОбласти
