// Выравнивание ресурсов подсистемы Проджект (модель MS Project Pro).
//
// Чистые функции: базовое расписание берётся из ПланированиеПроектов (CPM),
// поверх него задачи последовательно размещаются так, чтобы у ресурса не было
// двух задач одновременно (перегрузка). База данных не используется.
//
// Алгоритм v1 (жадный, последовательный; порядок задач в массиве - как
// "ID order" в MSP - приоритет выравнивания задаёт порядок массива):
//	1. Рассчитать базовое расписание CPM (ранние даты с ограничениями).
//	2. Обход задач в порядке массива; у каждого ресурса копится занятость.
//	3. Задача без конфликта размещается целиком на своих ранних датах.
//	4. Задача с конфликтом:
//	   - не закреплена (ConstraintType = 0, ASAP) - задерживается до первого
//	     окна, в которое помещается целиком без пересечений;
//	   - закреплена (любое ограничение) - разбивается на сегменты: рабочие
//	     минуты потребляются в свободные (незанятые) интервалы календаря,
//	     занятое время пропускается (splits MS Project).
//
// Ограничения v1:
//	- перегрузка = любое пересечение задач у ресурса; Units назначений входит
//	  в контракт, но не влияет (частичная загрузка не считается);
//	- календарь ресурса в v1 не влияет на сегменты (сегменты считаются по
//	  календарю задачи/проекта); пересечение календарей - будущая работа;
//	- задержка не перепроверяет связи преемников; пересчёт CPM после
//	  выравнивания - ответственность вызывающего кода;
//	- фактическая работа (задачи "в ходе выполнения") не поддерживается.
//
// Вызывает ПланированиеПроектов и КалендариПроектов (см. doc/MultitoolDoc/Проджект).

#Область ПрограммныйИнтерфейс

// Выравнивает задачи по ресурсам.
//
// Параметры:
//   Задачи  - Массив из Структура - контракт ПланированиеПроектов (см. шапку
//               того модуля) плюс Assignments - Массив из Структура
//               {Resource, Units}; Resource - ключ из Ресурсы, Units - проценты
//   Ресурсы - Соответствие       - КлючРесурса -> Структура {Calendar}
//               (структура КалендариПроектов или Неопределено)
//   Проект  - Структура          - {Calendar, Start} (см. шапку ПланированиеПроектов)
//
// Возвращаемое значение:
//   Соответствие - КлючЗадачи -> Структура:
//     * Сегменты - Массив из Структура {Начало, Конец} - рабочие куски задачи
//                  после выравнивания (один сегмент, если задача не резалась)
//     * Задержка - Число - рабочие минуты сдвига относительно раннего старта
//                  (0 - задача не сдвинута и не разрезана)
//
Функция Выровнять(Задачи, Ресурсы, Проект) Экспорт

	База = ПланированиеПроектов.РассчитатьРасписание(Задачи, Проект);
	Занятость = Новый Соответствие; // КлючРесурса -> Массив из {Начало, Конец}
	Результат = Новый Соответствие;

	Для Каждого Задача Из Задачи Цикл
		ПроверитьРесурсыЗадачи(Задача, Ресурсы);
		Ранние = База.Получить(Задача.Ключ);
		Если Ранние = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Задача.Ключ, РазместитьЗадачу(Задача, Ранние, Проект, Занятость));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Размещает одну задачу с учётом накопленной занятости её ресурсов.
Функция РазместитьЗадачу(Задача, Ранние, Проект, Занятость)

	Календарь = КалендарьЗадачи(Задача, Проект);
	Длительность = ДлительностьЗадачи(Задача);
	Старт = Ранние.Start;
	Занятое = ЗанятостьРесурсовЗадачи(Занятость, Задача);

	Если Пересечения(Занятое, Старт, Ранние.Finish).Количество() = 0 Тогда
		Сегменты = Новый Массив;
		Сегменты.Добавить(Новый Структура("Начало, Конец", Старт, Ранние.Finish));
		Задержка = 0;
	ИначеЕсли ОграничениеЗадачи(Задача) = 0 Тогда
		Старт = ПервыйСвободныйСтарт(Календарь, Старт, Длительность, Занятое);
		Сегменты = Новый Массив;
		Сегменты.Добавить(Новый Структура("Начало, Конец", Старт, ФинишРаботы(Календарь, Старт, Длительность)));
		Задержка = КалендариПроектов.РабочиеМинутыМежду(Календарь, Ранние.Start, Старт);
	Иначе
		Сегменты = СегментыСРазбиением(Календарь, Старт, Длительность, Занятое);
		Задержка = 0; // разбиение не отодвигает закреплённый старт
	КонецЕсли;

	ДобавитьЗанятость(Занятость, Задача, Сегменты);
	Возврат Новый Структура("Сегменты, Задержка", Сегменты, Задержка);

КонецФункции

// Контракт: назначение задачи должно ссылаться на известный ресурс.
Процедура ПроверитьРесурсыЗадачи(Задача, Ресурсы)

	Для Каждого Назначение Из НазначенияЗадачи(Задача) Цикл
		Если Ресурсы.Получить(Назначение.Resource) = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Задача '%1' назначена неизвестному ресурсу '%2'",
				Задача.Ключ, Назначение.Resource);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Первый старт, с которого окно длительности не пересекает занятое.
Функция ПервыйСвободныйСтарт(Календарь, Старт, Длительность, Занятое)

	Точка = КалендариПроектов.СледующийРабочийМомент(Календарь, Старт);
	Для Сч = 1 По 3700 Цикл // ~10 лет: защита от вечной перегрузки
		КонецОкна = ФинишРаботы(Календарь, Точка, Длительность);
		Если Пересечения(Занятое, Точка, КонецОкна).Количество() = 0 Тогда
			Возврат Точка;
		КонецЕсли;
		Точка = КалендариПроектов.СледующийРабочийМомент(Календарь, ПозднийКонец(Занятое, Точка, КонецОкна));
	КонецЦикла;

	Возврат Старт;

КонецФункции

// Рабочие куски задачи: минуты потребляются в свободные интервалы календаря.
Функция СегментыСРазбиением(Календарь, Старт, Длительность, Занятое)

	Сегменты = Новый Массив;
	Осталось = Длительность;
	Точка = КалендариПроектов.СледующийРабочийМомент(Календарь, Старт);

	Для Сч = 1 По 3700 Цикл // ~10 лет: защита от вечной перегрузки
		Если Осталось <= 0 Тогда
			Прервать;
		КонецЕсли;
		Для Каждого Свободный Из СвободныеИнтервалыДня(Календарь, Точка, Занятое) Цикл
			НачалоКуска = Макс(Точка, Свободный.Начало);
			Доступно = Цел((Свободный.Конец - НачалоКуска) / 60);
			Если Доступно <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Потребить = Мин(Осталось, Доступно);
			Сегменты.Добавить(Новый Структура("Начало, Конец", НачалоКуска, НачалоКуска + Потребить * 60));
			Осталось = Осталось - Потребить;
			Если Осталось <= 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Точка = НачалоДня(Точка) + 86400; // со следующей полуночи
	КонецЦикла;

	Возврат Сегменты;

КонецФункции

// Рабочие интервалы дня (моменты времени), из которых вычтена занятость.
Функция СвободныеИнтервалыДня(Календарь, День, Занятое)

	НачалоСуток = НачалоДня(День);
	Свободные = Новый Массив;
	Для Каждого Рабочий Из КалендариПроектов.ИнтервалыДня(Календарь, День) Цикл
		Свободные.Добавить(Новый Структура("Начало, Конец",
			НачалоСуток + Рабочий.Начало, НачалоСуток + Рабочий.Конец));
	КонецЦикла;

	Для Каждого Занят Из Занятое Цикл
		НачалоЗанятого = Макс(Занят.Начало, НачалоСуток);
		КонецЗанятого = Мин(Занят.Конец, НачалоСуток + 86400);
		Свободные = ВычестьИнтервал(Свободные, НачалоЗанятого, КонецЗанятого);
	КонецЦикла;

	Возврат Свободные;

КонецФункции

// Вычитает [НачалоЗанятого, КонецЗанятого) из списка свободных интервалов.
Функция ВычестьИнтервал(Свободные, НачалоЗанятого, КонецЗанятого)

	Результат = Новый Массив;
	Для Каждого Свободный Из Свободные Цикл
		Если КонецЗанятого <= Свободный.Начало ИЛИ НачалоЗанятого >= Свободный.Конец Тогда
			Результат.Добавить(Свободный);
			Продолжить;
		КонецЕсли;
		Если НачалоЗанятого > Свободный.Начало Тогда
			Результат.Добавить(Новый Структура("Начало, Конец", Свободный.Начало, НачалоЗанятого));
		КонецЕсли;
		Если КонецЗанятого < Свободный.Конец Тогда
			Результат.Добавить(Новый Структура("Начало, Конец", КонецЗанятого, Свободный.Конец));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Занятые интервалы, пересекающие окно [Начало, Конец).
Функция Пересечения(Занятое, Начало, Конец)

	Результат = Новый Массив;
	Для Каждого Занят Из Занятое Цикл
		Если Занят.Конец > Начало И Занят.Начало < Конец Тогда
			Результат.Добавить(Занят);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Самый поздний конец занятых интервалов внутри окна (точка сдвига старта).
Функция ПозднийКонец(Занятое, Начало, Конец)

	Поздний = Начало;
	Для Каждого Занят Из Занятое Цикл
		Если Занят.Конец > Начало И Занят.Начало < Конец И Занят.Конец > Поздний Тогда
			Поздний = Занят.Конец;
		КонецЕсли;
	КонецЦикла;

	Возврат Поздний;

КонецФункции

// Объединённая занятость всех ресурсов задачи.
Функция ЗанятостьРесурсовЗадачи(Занятость, Задача)

	Занятое = Новый Массив;
	Для Каждого Назначение Из НазначенияЗадачи(Задача) Цикл
		ИнтервалыРесурса = Занятость.Получить(Назначение.Resource);
		Если ИнтервалыРесурса = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Интервал Из ИнтервалыРесурса Цикл
			Занятое.Добавить(Интервал);
		КонецЦикла;
	КонецЦикла;

	Возврат Занятое;

КонецФункции

// Запоминает сегменты задачи как занятость каждого её ресурса.
Процедура ДобавитьЗанятость(Занятость, Задача, Сегменты)

	Для Каждого Назначение Из НазначенияЗадачи(Задача) Цикл
		ИнтервалыРесурса = Занятость.Получить(Назначение.Resource);
		Если ИнтервалыРесурса = Неопределено Тогда
			ИнтервалыРесурса = Новый Массив;
			Занятость.Вставить(Назначение.Resource, ИнтервалыРесурса);
		КонецЕсли;
		Для Каждого Сегмент Из Сегменты Цикл
			ИнтервалыРесурса.Добавить(Новый Структура("Начало, Конец", Сегмент.Начало, Сегмент.Конец));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Календарь задачи: свой, иначе календарь проекта.
Функция КалендарьЗадачи(Задача, Проект)

	Календарь = ЗначениеСвойства(Задача, "Calendar", Неопределено);
	Если Календарь <> Неопределено Тогда
		Возврат Календарь;
	КонецЕсли;

	Возврат Проект.Calendar;

КонецФункции

Функция ФинишРаботы(Календарь, Старт, Длительность)

	Возврат КалендариПроектов.ДобавитьРабочиеМинуты(Календарь, Старт, Длительность);

КонецФункции

Функция НазначенияЗадачи(Задача)

	Возврат ЗначениеСвойства(Задача, "Assignments", Новый Массив);

КонецФункции

Функция ОграничениеЗадачи(Задача)

	Возврат ЗначениеСвойства(Задача, "ConstraintType", 0);

КонецФункции

Функция ДлительностьЗадачи(Задача)

	Возврат ЗначениеСвойства(Задача, "Duration", 0);

КонецФункции

// Свойство структуры/соответствия или значение по умолчанию.
Функция ЗначениеСвойства(Источник, Имя, Пустое)

	ТипИсточник = ТипЗнч(Источник);
	Если ТипИсточник = Тип("Структура") Тогда
		Если Источник.Свойство(Имя) Тогда
			Возврат Источник[Имя];
		КонецЕсли;
	ИначеЕсли ТипИсточник = Тип("Соответствие") Тогда
		Значение = Источник.Получить(Имя);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	Иначе
		Возврат Пустое;
	КонецЕсли;

	Возврат Пустое;

КонецФункции

#КонецОбласти
