КонецФункции

// Выполняет запрос и возвращает первую ссылку выборки (пустую, если нет строк).
//
Функция СсылкаИзВыборки(Знач Запрос, Знач ИмяСправочника)

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники[ИмяСправочника].ПустаяСсылка();

КонецФункции

// Возвращает ссылку метки по владельцу и идентификатору GitLab.
//
Функция СсылкаМетки(Знач Владелец, Знач Идентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка
		|ИЗ Справочник.ГитлабМетки КАК Т
		|ГДЕ Т.Владелец = &Владелец
		|	И Т.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Возврат СсылкаИзВыборки(Запрос, "ГитлабМетки");

КонецФункции

// Разбирает сериализованное значение JSON в массив (пустой, если не массив).
//
Функция МассивИзJSON(Знач СтрокаJSON)

	Данные = Неопределено;

	Если НЕ ПустаяСтрока(СтрокаJSON) Тогда
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(СтрокаJSON);
			// Как Соответствие: во всём модуле поля JSON читаются через Получить().
			Данные = ПрочитатьJSON(Чтение, Истина);
			Чтение.Закрыть();
		Исключение
			ЗаписьЖурналаРегистрации("ГитлабЗеркало.МассивИзJSON",
				УровеньЖурналаРегистрации.Ошибка, , ,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Данные = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Возврат Данные;
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

// Собирает представление пользователя "Имя (Логин)".
//
Функция ПредставлениеПользователя(Знач Логин, Знач ПолноеИмя)

	Если ПустаяСтрока(ПолноеИмя) Тогда
		Возврат Логин;
	ИначеЕсли ПустаяСтрока(Логин) Тогда
		Возврат ПолноеИмя;
	Иначе
		Возврат СтрШаблон("%1 (%2)", ПолноеИмя, Логин);
	КонецЕсли;

КонецФункции

// Преобразует ISO-дату GitLab ("2026-10-07T08:18:12.217Z") в значение Дата.
//
Функция ДатаИзISO(Знач СтрокаISO)

	Результат = '00010101';

	Если ТипЗнч(СтрокаISO) = Тип("Строка") И СтрДлина(СтрокаISO) >= 19 Тогда
		Попытка
			Результат = XMLЗначение(Тип("Дата"), Лев(СтрокаISO, 19));
		Исключение
			ЗаписьЖурналаРегистрации("ГитлабЗеркало.ДатаИзISO",
				УровеньЖурналаРегистрации.Ошибка, , СтрокаISO,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Результат = '00010101';
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает число из значения JSON (0, если значение не число).
//
Функция ЧислоИзЗначения(Знач ЗначениеJSON)

	Если ТипЗнч(ЗначениеJSON) = Тип("Число") Тогда
		Возврат ЗначениеJSON;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Возвращает число из строки (0, если строка не число).
//
Функция ЧислоИзСтроки(Знач Строка)

	Если ПустаяСтрока(Строка) Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Возврат Число(Строка);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Разбирает веб-URL задачи GitLab вида "<вебURL проекта>/-/issues/<iid>".
// Принимает и новый формат "<вебURL проекта>/-/work_items/<iid>": задача
// work_items в интерфейсе GitLab - та же issue, номер после секции есть IID.
//
// Параметры:
//   ВебURL - Строка - URL задачи.
//
// Возвращаемое значение:
//   Структура - Успешно (Булево), ПутьПроекта (Строка), IID (Число),
//   Сообщение (Строка - текст ошибки, когда Успешно = Ложь).
//
Функция АдресЗадачиИзВебURL(Знач ВебURL)

	Адрес = Новый Структура("Успешно, ПутьПроекта, IID, Сообщение", Ложь, "", 0, "");

	Если ПустаяСтрока(ВебURL) Тогда
		Адрес.Сообщение = "Не заполнена веб-ссылка задачи.";
		Возврат Адрес;
	КонецЕсли;

	Секция = "/-/issues/";
	ПозицияСекции = СтрНайти(ВебURL, Секция);
	Если ПозицияСекции = 0 Тогда
		Секция = "/-/work_items/";
		ПозицияСекции = СтрНайти(ВебURL, Секция);
	КонецЕсли;
	Если ПозицияСекции = 0 Тогда
		Адрес.Сообщение = "Ссылка не является ссылкой на задачу GitLab (нет секции ""/-/issues/"" или ""/-/work_items/"").";
		Возврат Адрес;
	КонецЕсли;

	IID = ЧислоИзСтроки(Сред(ВебURL, ПозицияСекции + СтрДлина(Секция)));
	Если IID = 0 Тогда
		Адрес.Сообщение = "В ссылке не разбирается номер задачи (IID).";
		Возврат Адрес;
	КонецЕсли;

	ПутьПроекта = ПутьПроектаИзВебURL(Лев(ВебURL, ПозицияСекции - 1));
	Если ПустаяСтрока(ПутьПроекта) Тогда
		Адрес.Сообщение = "В ссылке не разбирается путь проекта.";
		Возврат Адрес;
	КонецЕсли;

	Адрес.Успешно     = Истина;
	Адрес.ПутьПроекта = ПутьПроекта;
	Адрес.IID         = IID;

	Возврат Адрес;

КонецФункции

// Извлекает полный путь проекта из его веб-URL:
// "https://сервер/namespace/проект" -> "namespace/проект".
//
Функция ПутьПроектаИзВебURL(Знач ВебURLПроекта)

	// Отбрасываем схему (https://)
	Позиция = СтрНайти(ВебURLПроекта, "://");
	Остаток = ?(Позиция > 0, Сред(ВебURLПроекта, Позиция + 3), ВебURLПроекта);

	// Отбрасываем хост до первого "/"
	Позиция = СтрНайти(Остаток, "/");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Сред(Остаток, Позиция + 1);

КонецФункции

// Создаёт структуру счётчиков синхронизации (для внешних адаптеров,
// вызывающих ОбеспечитьЗадачуИзAPI и др.).
//
Функция НовыйРезультатСинхронизации() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Задач", 0);
	Результат.Вставить("ЗадачСоздано", 0);
	Результат.Вставить("ЗадачОбновлено", 0);
	Результат.Вставить("ЗадачПропущено", 0);
	Результат.Вставить("ПроектовСоздано", 0);
	Результат.Вставить("ПользователейСоздано", 0);
	Результат.Вставить("МетокСоздано", 0);

	Возврат Результат;

КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции
