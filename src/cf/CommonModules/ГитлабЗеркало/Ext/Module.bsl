// ГитлабЗеркало - синхронизация сущностей GitLab в справочники зеркала
// (подсистема GitLabMirror). Зеркало - только чтение: данные в справочниках
// Гитлаб* создаются и обновляются исключительно этим модулем.
// Адаптер к REST API - обработка ИнтеграцияGitlab (фабрика СоздатьИнтеграцию).
// Схема зеркала: Arc/GitLab.mirror-Справочники.md.
// Версия: 1.0.0

#Область ПрограммныйИнтерфейс

// Зеркалирует задачи GitLab с отбором по метке в справочники зеркала.
// Читает задачи через ИнтеграцияGitlab.ПолучитьЗадачиПоМетке, догружает
// справочники владельцев (проекты, пользователи, метки) и записывает задачи.
//
// Параметры:
//   ВнешняяСистема - СправочникСсылка.ВнешниеСистемыТикетов - подключение к GitLab
//                    (БазовыйURL + токен в безопасном хранилище).
//   Метка          - Строка - имя метки GitLab, например "отв: НД".
//   Состояние      - Строка - отбор по состоянию: "opened", "closed", "all".
//
// Возвращаемое значение:
//   Структура - Задач, ЗадачСоздано, ЗадачОбновлено, ЗадачПропущено,
//     ПроектовСоздано, ПользователейСоздано, МетокСоздано.
//
Функция ЗеркалироватьЗадачиПоМетке(Знач ВнешняяСистема, Знач Метка, Знач Состояние = "all") Экспорт

	Интеграция   = Обработки.ИнтеграцияGitlab.СоздатьИнтеграцию(ВнешняяСистема);
	ТаблицаЗадач = Интеграция.ПолучитьЗадачиПоМетке(Метка, Состояние);

	Результат = НовыйРезультатСинхронизации();
	Результат.Задач = ТаблицаЗадач.Количество();

	Для Каждого СтрокаЗадачи Из ТаблицаЗадач Цикл

		Автор = ОбеспечитьПользователя(
			СтрокаЗадачи.author_id,
			СтрокаЗадачи.author_username,
			СтрокаЗадачи.author_name,
			Результат);

		Проект = ОбеспечитьПроект(Интеграция, СтрокаЗадачи.project_id, Результат);
		ОбеспечитьЗадачу(СтрокаЗадачи, Проект, Автор, Результат);

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// Обеспечение сущностей зеркала

// Находит пользователя зеркала по идентификатору GitLab или создаёт его.
//
// Параметры:
//   Идентификатор - Число - id пользователя в GitLab.
//   Логин         - Строка - username.
//   ПолноеИмя     - Строка - name.
//   Результат     - Структура - счётчики синхронизации.
//
// Возвращаемое значение:
//   СправочникСсылка.ГитлабПользователи.
//
Функция ОбеспечитьПользователя(Знач Идентификатор, Знач Логин, Знач ПолноеИмя, Результат)

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Справочники.ГитлабПользователи.ПустаяСсылка();
	КонецЕсли;

	Ссылка = СсылкаПользователя(Идентификатор);
	Если НЕ Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;

	Объект = Справочники.ГитлабПользователи.СоздатьЭлемент();
	Объект.Код             = Строка(Идентификатор);
	Объект.Наименование    = ПредставлениеПользователя(Логин, ПолноеИмя);
	Объект.Идентификатор   = Идентификатор;
	Объект.ИмяПользователя = Логин;
	Объект.ПолноеИмя       = ПолноеИмя;
	Объект.Записать();

	Результат.ПользователейСоздано = Результат.ПользователейСоздано + 1;

	Возврат Объект.Ссылка;

КонецФункции

// Находит проект зеркала по идентификатору GitLab; при отсутствии
// запрашивает сведения проекта у API и создаёт элемент.
//
// Возвращаемое значение:
//   СправочникСсылка.ГитлабПроекты.
//
Функция ОбеспечитьПроект(Интеграция, Знач Идентификатор, Результат)

	Ссылка = СсылкаПроекта(Идентификатор);
	Если НЕ Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;

	Данные = Интеграция.ПолучитьПроектПоИдентификатору(Идентификатор);

	Объект = Справочники.ГитлабПроекты.СоздатьЭлемент();
	Объект.Код                 = Строка(Идентификатор);
	Объект.Наименование        = Строка(Данные.name);
	Объект.Идентификатор       = Идентификатор;
	Объект.Путь                = Строка(Данные.path);
	Объект.ПутьПолный          = Строка(Данные.path_with_namespace);
	Объект.ВебURL              = Строка(Данные.web_url);
	Объект.Описание            = Строка(Данные.description);
	Объект.РепозиторийHTTP     = Строка(Данные.http_url_to_repo);
	Объект.РепозиторийSSH      = Строка(Данные.ssh_url_to_repo);
	Объект.ВеткаПоумолчанию    = Строка(Данные.default_branch);
	Объект.Видимость           = Строка(Данные.visibility);
	Объект.Архивный            = (Данные.archived = Истина);
	Объект.ДатаСоздания        = ДатаИзISO(Данные.created_at);
	Объект.ПоследняяАктивность = ДатаИзISO(Данные.last_activity_at);
	Объект.Записать();

	Результат.ПроектовСоздано = Результат.ПроектовСоздано + 1;

	Возврат Объект.Ссылка;

КонецФункции

// Находит метку проекта по идентификатору GitLab или создаёт её.
// Элемент метки - деталь из with_labels_details; для строковой метки
// (детали недоступны) возвращается пустая ссылка.
//
// Возвращаемое значение:
//   СправочникСсылка.ГитлабМетки.
//
Функция ОбеспечитьМетку(Знач Владелец, Знач ДанныеМетки, Результат)

	Идентификатор = ЧислоИзЗначения(ДанныеМетки.Получить("id"));
	ИмяМетки      = Строка(ДанныеМетки.Получить("name"));

	Если НЕ ЗначениеЗаполнено(Идентификатор) Или Владелец.Пустая() Тогда
		Возврат Справочники.ГитлабМетки.ПустаяСсылка();
	КонецЕсли;

	Ссылка = СсылкаМетки(Владелец, Идентификатор);
	Если НЕ Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;

	Объект = Справочники.ГитлабМетки.СоздатьЭлемент();
	Объект.Владелец      = Владелец;
	Объект.Код           = Строка(Идентификатор);
	Объект.Наименование  = ИмяМетки;
	Объект.Идентификатор = Идентификатор;
	Объект.Имя           = ИмяМетки;
	Объект.Цвет          = Строка(ДанныеМетки.Получить("color"));
	Объект.Описание      = Строка(ДанныеМетки.Получить("description"));
	Объект.ЭтоГрупповая  = ЗначениеЗаполнено(ДанныеМетки.Получить("group_id"));
	Объект.Записать();

	Результат.МетокСоздано = Результат.МетокСоздано + 1;

	Возврат Объект.Ссылка;

КонецФункции

// Находит задачу зеркала по глобальному идентификатору GitLab, создаёт
// или обновляет её вместе с табличными частями Метки/Исполнители.
//
Процедура ОбеспечитьЗадачу(Знач СтрокаЗадачи, Знач Проект, Знач Автор, Результат)

	Ссылка = СсылкаЗадачи(СтрокаЗадачи.issue_id);

	Если НЕ Ссылка.Пустая() Тогда
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект.ДатаОбновления >= СтрокаЗадачи.updated_at Тогда
			Результат.ЗадачПропущено = Результат.ЗадачПропущено + 1;
			Возврат;
		КонецЕсли;
		Результат.ЗадачОбновлено = Результат.ЗадачОбновлено + 1;
	Иначе
		Объект = Справочники.ГитлабЗадачи.СоздатьЭлемент();
		Объект.Владелец = Проект;
		Объект.Код      = Строка(СтрокаЗадачи.issue_iid);
		Результат.ЗадачСоздано = Результат.ЗадачСоздано + 1;
	КонецЕсли;

	Объект.Наименование     = Строка(СтрокаЗадачи.title);
	Объект.Идентификатор    = СтрокаЗадачи.issue_id;
	Объект.Состояние        = Строка(СтрокаЗадачи.state);
	Объект.Автор            = Автор;
	Объект.Описание         = Строка(СтрокаЗадачи.description);
	Объект.ВебURL           = Строка(СтрокаЗадачи.web_url);
	Объект.ДатаСоздания     = СтрокаЗадачи.created_at;
	Объект.ДатаОбновления   = СтрокаЗадачи.updated_at;
	Объект.ДатаЗакрытия     = СтрокаЗадачи.closed_at;
	Объект.Дедлайн          = СтрокаЗадачи.due_date;
	Объект.Вес              = СтрокаЗадачи.weight;
	Объект.ОценкаВремени    = СтрокаЗадачи.time_estimate;
	Объект.ЗатраченоВремени = СтрокаЗадачи.total_time_spent;

	ЗаполнитьМеткиЗадачи(Объект, Проект, СтрокаЗадачи.labels_json, Результат);
	ЗаполнитьИсполнителейЗадачи(Объект, СтрокаЗадачи.assignees_json, Результат);

	Объект.Записать();

КонецПроцедуры

// Заполняет табличную часть Метки из сериализованного массива деталей.
//
Процедура ЗаполнитьМеткиЗадачи(Объект, Знач Проект, Знач МеткиJSON, Результат)

	Объект.Метки.Очистить();

	Для Каждого ДанныеМетки Из МассивИзJSON(МеткиJSON) Цикл

		Если ТипЗнч(ДанныеМетки) = Тип("Строка") Тогда
			// Детали меток недоступны - имя без ссылки.
			СтрокаТЧ = Объект.Метки.Добавить();
			СтрокаТЧ.Имя = ДанныеМетки;
			Продолжить;
		КонецЕсли;

		СсылкаМетки = ОбеспечитьМетку(Проект, ДанныеМетки, Результат);

		СтрокаТЧ = Объект.Метки.Добавить();
		СтрокаТЧ.Метка = СсылкаМетки;
		СтрокаТЧ.Имя   = Строка(ДанныеМетки.Получить("name"));

	КонецЦикла;

КонецПроцедуры

// Заполняет табличную часть Исполнители из сериализованного массива.
//
Процедура ЗаполнитьИсполнителейЗадачи(Объект, Знач ИсполнителиJSON, Результат)

	Объект.Исполнители.Очистить();

	Для Каждого Исполнитель Из МассивИзJSON(ИсполнителиJSON) Цикл

		СсылкаПользователя = ОбеспечитьПользователя(
			ЧислоИзЗначения(Исполнитель.Получить("id")),
			Строка(Исполнитель.Получить("username")),
			Строка(Исполнитель.Получить("name")),
			Результат);

		СтрокаТЧ = Объект.Исполнители.Добавить();
		СтрокаТЧ.Пользователь = СсылкаПользователя;

	КонецЦикла;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Поиск и разбор

// Возвращает ссылку пользователя зеркала по идентификатору GitLab.
//
Функция СсылкаПользователя(Знач Идентификатор)

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Справочники.ГитлабПользователи.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка
		|ИЗ Справочник.ГитлабПользователи КАК Т
		|ГДЕ Т.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Возврат СсылкаИзВыборки(Запрос, "ГитлабПользователи");

КонецФункции

// Возвращает ссылку проекта зеркала по идентификатору GitLab.
//
Функция СсылкаПроекта(Знач Идентификатор)

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Справочники.ГитлабПроекты.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка
		|ИЗ Справочник.ГитлабПроекты КАК Т
		|ГДЕ Т.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Возврат СсылкаИзВыборки(Запрос, "ГитлабПроекты");

КонецФункции

// Возвращает ссылку задачи зеркала по идентификатору GitLab.
//
Функция СсылкаЗадачи(Знач Идентификатор)

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Справочники.ГитлабЗадачи.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка
		|ИЗ Справочник.ГитлабЗадачи КАК Т
		|ГДЕ Т.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Возврат СсылкаИзВыборки(Запрос, "ГитлабЗадачи");

КонецФункции

// Выполняет запрос и возвращает первую ссылку выборки (пустую, если нет строк).
//
Функция СсылкаИзВыборки(Знач Запрос, Знач ИмяСправочника)

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники[ИмяСправочника].ПустаяСсылка();

КонецФункции

// Возвращает ссылку метки по владельцу и идентификатору GitLab.
//
Функция СсылкаМетки(Знач Владелец, Знач Идентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка
		|ИЗ Справочник.ГитлабМетки КАК Т
		|ГДЕ Т.Владелец = &Владелец
		|	И Т.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Возврат СсылкаИзВыборки(Запрос, "ГитлабМетки");

КонецФункции

// Разбирает сериализованное значение JSON в массив (пустой, если не массив).
//
Функция МассивИзJSON(Знач СтрокаJSON)

	Данные = Неопределено;

	Если НЕ ПустаяСтрока(СтрокаJSON) Тогда
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(СтрокаJSON);
			// Как Соответствие: во всём модуле поля JSON читаются через Получить().
			Данные = ПрочитатьJSON(Чтение, Истина);
			Чтение.Закрыть();
		Исключение
			ЗаписьЖурналаРегистрации("ГитлабЗеркало.МассивИзJSON",
				УровеньЖурналаРегистрации.Ошибка, , ,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Данные = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Возврат Данные;
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

// Собирает представление пользователя "Имя (Логин)".
//
Функция ПредставлениеПользователя(Знач Логин, Знач ПолноеИмя)

	Если ПустаяСтрока(ПолноеИмя) Тогда
		Возврат Логин;
	ИначеЕсли ПустаяСтрока(Логин) Тогда
		Возврат ПолноеИмя;
	Иначе
		Возврат СтрШаблон("%1 (%2)", ПолноеИмя, Логин);
	КонецЕсли;

КонецФункции

// Преобразует ISO-дату GitLab ("2026-10-07T08:18:12.217Z") в значение Дата.
//
Функция ДатаИзISO(Знач СтрокаISO)

	Результат = '00010101';

	Если ТипЗнч(СтрокаISO) = Тип("Строка") И СтрДлина(СтрокаISO) >= 19 Тогда
		Попытка
			Результат = XMLЗначение(Тип("Дата"), Лев(СтрокаISO, 19));
		Исключение
			ЗаписьЖурналаРегистрации("ГитлабЗеркало.ДатаИзISO",
				УровеньЖурналаРегистрации.Ошибка, , СтрокаISO,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Результат = '00010101';
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает число из значения JSON (0, если значение не число).
//
Функция ЧислоИзЗначения(Знач ЗначениеJSON)

	Если ТипЗнч(ЗначениеJSON) = Тип("Число") Тогда
		Возврат ЗначениеJSON;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Создаёт структуру счётчиков синхронизации.
//
Функция НовыйРезультатСинхронизации()

	Результат = Новый Структура;
	Результат.Вставить("Задач", 0);
	Результат.Вставить("ЗадачСоздано", 0);
	Результат.Вставить("ЗадачОбновлено", 0);
	Результат.Вставить("ЗадачПропущено", 0);
	Результат.Вставить("ПроектовСоздано", 0);
	Результат.Вставить("ПользователейСоздано", 0);
	Результат.Вставить("МетокСоздано", 0);

	Возврат Результат;

КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции
