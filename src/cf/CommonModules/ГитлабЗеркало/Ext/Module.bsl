// Поиск и разбор

// Возвращает ссылку пользователя зеркала по идентификатору GitLab.
//
Функция СсылкаПользователя(Знач Идентификатор)

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Справочники.ГитлабПользователи.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка
		|ИЗ Справочник.ГитлабПользователи КАК Т
		|ГДЕ Т.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Возврат СсылкаИзВыборки(Запрос, "ГитлабПользователи");

КонецФункции

// Возвращает ссылку проекта зеркала по идентификатору GitLab.
//
Функция СсылкаПроекта(Знач Идентификатор)

