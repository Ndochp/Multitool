// Импорт MSPDI, слой 2: запись структур (результат ОбменMSProject.Разобрать)
// в справочники подсистемы Проджект по UID (п.6 роадмапа, дизайн в 4.6).
//
// Гексагональное разделение: чистый слой 1 (парсер/записчик XML) - в
// ОбменMSProject, этот модуль - единственный адаптер к базе данных.
//
// Алгоритм (два прохода):
//   1) объекты без ссылок: ГрафикиРаботы -> Проект -> Ресурсы -> Работы
//      (родитель Работ - по стеку OutlineLevel: MSPDI не хранит UID родителя;
//      ТЧ Assignments работ очищаются);
//   2) связи по UID -> ссылкам: ТЧ Predecessors работ и ТЧ Assignments
//      (назначения без обеих сторон и кросс-проектные связи пропускаются).
// Идемпотентность: поиск по UID (у Работ/Ресурсов - в рамках владельца-Проекта),
// существующая запись перезаполняется. Предупреждения Разобрать остаются у
// вызывающего кода. Ограничение v1: BaseCalendar ссылка ставится отдельным
// проходом и только на календарь из того же файла; интервалы дня - максимум 3
// пары (колонки FromTime1..ToTime3, см. Р8).
//
// Владельцы: Работы и Ресурсы подчинены Проекту, ГрафикиРаботы - свободный.

#Область ПрограммныйИнтерфейс

// Записывает результат Разобрать в справочники базы данных.
//
// Параметры:
//   Данные - Структура - результат ОбменMSProject.Разобрать (см. шапку модуля)
//
// Возвращаемое значение:
//   Структура - {Проект - СправочникСсылка.Проект,
//                Календари, Задачи, Ресурсы - Соответствие UID -> Ссылка}
//
Функция Загрузить(Данные) Экспорт

	СсылкиКалендарей = ЗагрузитьКалендари(Данные.Календари);
	Проект = ЗагрузитьПроект(Данные.Проект, СсылкиКалендарей);
	СсылкиРесурсов = ЗагрузитьРесурсы(Данные.Ресурсы, Проект, СсылкиКалендарей);
	СсылкиЗадач = ЗагрузитьРаботы(Данные.Задачи, Проект, СсылкиКалендарей);
	ЗагрузитьСвязиЗадач(Данные.Задачи, СсылкиЗадач);
	ЗагрузитьНазначения(Данные.Назначения, СсылкиЗадач, СсылкиРесурсов);

	Возврат Новый Структура("Проект, Календари, Задачи, Ресурсы",
		Проект, СсылкиКалендарей, СсылкиЗадач, СсылкиРесурсов);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// === Проход 1: объекты ===

Функция ЗагрузитьКалендари(СписокКалендарей)

	Ссылки = Новый Соответствие;
	Для Каждого Календарь Из СписокКалендарей Цикл
		Объект = ОбъектКалендаря(Календарь.UID);
		ЗаполнитьКалендарь(Объект, Календарь);
		Объект.Записать();
		Ссылки.Вставить(Календарь.UID, Объект.Ссылка);
	КонецЦикла;

	// Базовые календари - после создания всех (ссылка может идти вперёд).
	Для Каждого Календарь Из СписокКалендарей Цикл
		СсылкаБазы = Ссылки.Получить(Календарь.BaseCalendarUID);
		Если СсылкаБазы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Объект = ОбъектКалендаря(Календарь.UID);
		Объект.BaseCalendar = СсылкаБазы;
		Объект.Записать();
	КонецЦикла;

	Возврат Ссылки;

КонецФункции

Процедура ЗаполнитьКалендарь(Объект, Календарь)

	Объект.Наименование = ИмяДляКаталога(Календарь.Name, 100);
	Объект.UID = Календарь.UID;
	Объект.IsBaseCalendar = Календарь.IsBaseCalendar;
	Объект.WeekDays.Очистить();
	Для Каждого ДеньНедели Из Календарь.WeekDays Цикл
		СтрокаДня = Объект.WeekDays.Добавить();
		СтрокаДня.DayType = ДеньНедели.DayType;
		СтрокаДня.DayWorking = ДеньНедели.DayWorking;
		ЗаполнитьИнтервалыДня(СтрокаДня, ДеньНедели.Интервалы);
	КонецЦикла;
	Объект.Exceptions.Очистить();
	Для Каждого ИсключениеКалендаря Из Календарь.Exceptions Цикл
		СтрокаИсключения = Объект.Exceptions.Добавить();
		СтрокаИсключения.Name = ИсключениеКалендаря.Name;
		СтрокаИсключения.Type = ИсключениеКалендаря.Тип;
		СтрокаИсключения.FromDate = ЗначениеДаты(ИсключениеКалендаря.FromDate);
		СтрокаИсключения.ToDate = ЗначениеДаты(ИсключениеКалендаря.ToDate);
		СтрокаИсключения.DayWorking = ИсключениеКалендаря.DayWorking;
		ЗаполнитьИнтервалыДня(СтрокаИсключения, ИсключениеКалендаря.Интервалы);
	КонецЦикла;

КонецПроцедуры

// Интервалы календарного дня - в плоские колонки FromTime1..ToTime3.
Процедура ЗаполнитьИнтервалыДня(СтрокаТЧ, Интервалы)

	Номер = 1;
	Для Каждого Интервал Из Интервалы Цикл
		Если Номер > 3 Тогда
			Прервать; // больше пар колонок нет (Р8)
		КонецЕсли;
		СтрокаТЧ["FromTime" + Номер] = Интервал.FromTime;
		СтрокаТЧ["ToTime" + Номер] = Интервал.ToTime;
		Номер = Номер + 1;
	КонецЦикла;

КонецПроцедуры

Функция ЗагрузитьПроект(ДанныеПроекта, СсылкиКалендарей)

	Объект = ОбъектПроекта(ДанныеПроекта.UID);
	Объект.Наименование = ИмяДляКаталога(ДанныеПроекта.Name, 25);
	Объект.UID = ДанныеПроекта.UID;
	Объект.StartDate = ЗначениеДаты(ДанныеПроекта.StartDate);
	Объект.FinishDate = ЗначениеДаты(ДанныеПроекта.FinishDate);
	Объект.MinutesPerDay = ДанныеПроекта.MinutesPerDay;
	Объект.MinutesPerWeek = ДанныеПроекта.MinutesPerWeek;
	Объект.DaysPerMonth = ДанныеПроекта.DaysPerMonth;
	Объект.CurrencyCode = ДанныеПроекта.CurrencyCode;
	Объект.CurrencySymbol = ДанныеПроекта.CurrencySymbol;
	СсылкаКалендаря = СсылкиКалендарей.Получить(ДанныеПроекта.CalendarUID);
	Если СсылкаКалендаря <> Неопределено Тогда
		Объект.Calendar = СсылкаКалендаря;
	КонецЕсли;
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

Функция ЗагрузитьРесурсы(СписокРесурсов, Проект, СсылкиКалендарей)

	Ссылки = Новый Соответствие;
	Для Каждого Ресурс Из СписокРесурсов Цикл
		Объект = ОбъектРесурса(Проект, Ресурс.UID);
		Объект.Владелец = Проект;
		Объект.Наименование = ИмяДляКаталога(Ресурс.Name, 150);
		Объект.UID = Ресурс.UID;
		Объект.ID = Ресурс.ID;
		Объект.ResourceType = Ресурс.ResourceType;
		Объект.MaterialLabel = Ресурс.MaterialLabel;
		Объект.MaxUnits = Ресурс.MaxUnits;
		Объект.StandardRate = Ресурс.StandardRate;
		Объект.OvertimeRate = Ресурс.OvertimeRate;
		Объект.CostPerUse = Ресурс.CostPerUse;
		Объект.AccrueAt = Ресурс.AccrueAt;
		Объект.Group = Ресурс.Group;
		Объект.Initials = Ресурс.Initials;
		Объект.IsActive = Ресурс.IsActive;
		Объект.Notes = Ресурс.Notes;
		СсылкаКалендаря = СсылкиКалендарей.Получить(Ресурс.CalendarUID);
		Если СсылкаКалендаря <> Неопределено Тогда
			Объект.Calendar = СсылкаКалендаря;
		КонецЕсли;
		Объект.Записать();
		Ссылки.Вставить(Ресурс.UID, Объект.Ссылка);
	КонецЦикла;

	Возврат Ссылки;

КонецФункции

Функция ЗагрузитьРаботы(СписокЗадач, Проект, СсылкиКалендарей)

	Ссылки = Новый Соответствие;
	Родители = Новый Соответствие; // OutlineLevel -> ссылка сводной сверху
	Для Каждого Задача Из СписокЗадач Цикл
		Объект = ОбъектРаботы(Проект, Задача.UID);
		Объект.Владелец = Проект;
		Объект.Родитель = РодительРаботы(Задача, Родители);
		ЗаполнитьРаботу(Объект, Задача, СсылкиКалендарей);
		Объект.Записать();
		Ссылки.Вставить(Задача.UID, Объект.Ссылка);
		Родители.Вставить(Задача.OutlineLevel, Объект.Ссылка);
	КонецЦикла;

	Возврат Ссылки;

КонецФункции

Процедура ЗаполнитьРаботу(Объект, Задача, СсылкиКалендарей)

	Объект.Наименование = ИмяДляКаталога(Задача.Name, 150);
	Объект.UID = Задача.UID;
	Объект.ID = Задача.ID;
	Объект.WBS = Задача.WBS;
	Объект.OutlineNumber = Задача.OutlineNumber;
	Объект.OutlineLevel = Задача.OutlineLevel;
	Объект.Summary = Задача.Summary;
	Объект.Milestone = Задача.Milestone;
	Объект.ManuallyScheduled = Задача.ManuallyScheduled;
	Объект.TaskType = Задача.TaskType;
	Объект.EffortDriven = Задача.EffortDriven;
	Объект.Duration = Задача.Duration;
	Объект.DurationFormat = Задача.DurationFormat;
	Объект.Start = ЗначениеДаты(Задача.Start);
	Объект.Finish = ЗначениеДаты(Задача.Finish);
	Объект.EarlyStart = ЗначениеДаты(Задача.EarlyStart);
	Объект.EarlyFinish = ЗначениеДаты(Задача.EarlyFinish);
	Объект.LateStart = ЗначениеДаты(Задача.LateStart);
	Объект.LateFinish = ЗначениеДаты(Задача.LateFinish);
	Объект.TotalSlack = Задача.TotalSlack;
	Объект.FreeSlack = Задача.FreeSlack;
	Объект.Critical = Задача.Critical;
	Объект.ConstraintType = Задача.ConstraintType;
	Объект.ConstraintDate = ЗначениеДаты(Задача.ConstraintDate);
	Объект.Deadline = ЗначениеДаты(Задача.Deadline);
	Объект.Priority = Задача.Priority;
	Объект.LevelingDelay = Задача.LevelingDelay;
	Объект.LevelingCanSplit = Задача.LevelingCanSplit;
	Объект.LevelAssignments = Задача.LevelAssignments;
	Объект.PercentComplete = Задача.PercentComplete;
	Объект.PercentWorkComplete = Задача.PercentWorkComplete;
	Объект.ActualStart = ЗначениеДаты(Задача.ActualStart);
	Объект.ActualFinish = ЗначениеДаты(Задача.ActualFinish);
	Объект.ActualDuration = Задача.ActualDuration;
	Объект.Work = Задача.Work;
	Объект.ActualWork = Задача.ActualWork;
	Объект.RemainingWork = Задача.RemainingWork;
	Объект.FixedCost = Задача.FixedCost;
	Объект.Cost = Задача.Cost;
	Объект.Notes = Задача.Notes;
	Объект.IsActive = Задача.IsActive;
	Объект.Stop = ЗначениеДаты(Задача.Stop);
	Объект.Resume = ЗначениеДаты(Задача.Resume);
	СсылкаКалендаря = СсылкиКалендарей.Получить(Задача.CalendarUID);
	Если СсылкаКалендаря <> Неопределено Тогда
		Объект.Calendar = СсылкаКалендаря;
	КонецЕсли;
	// Назначения очищаются здесь, заполняются проходом 2 (идемпотентность).
	Объект.Assignments.Очистить();

КонецПроцедуры

// === Проход 2: связи по UID -> ссылкам ===

Процедура ЗагрузитьСвязиЗадач(СписокЗадач, СсылкиЗадач)

	Для Каждого Задача Из СписокЗадач Цикл
		Если Задача.Предшественники.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Объект = СсылкиЗадач.Получить(Задача.UID).ПолучитьОбъект();
		Объект.Predecessors.Очистить();
		Для Каждого Связь Из Задача.Предшественники Цикл
			СсылкаПредшественника = СсылкиЗадач.Получить(Связь.PredecessorUID);
			Если СсылкаПредшественника = Неопределено Тогда
				Продолжить; // кросс-проектная связь не записывается (v1)
			КонецЕсли;
			СтрокаСвязи = Объект.Predecessors.Добавить();
			СтрокаСвязи.Task = СсылкаПредшественника;
			СтрокаСвязи.LinkType = Связь.LinkType;
			СтрокаСвязи.Lag = Связь.Lag;
			СтрокаСвязи.LagFormat = Связь.LagFormat;
			СтрокаСвязи.CrossProject = Связь.CrossProject;
			СтрокаСвязи.CrossProjectName = Связь.CrossProjectName;
		КонецЦикла;
		Объект.Записать();
	КонецЦикла;

КонецПроцедуры

Процедура ЗагрузитьНазначения(СписокНазначений, СсылкиЗадач, СсылкиРесурсов)

	Для Каждого Назначение Из СписокНазначений Цикл
		СсылкаЗадачи = СсылкиЗадач.Получить(Назначение.TaskUID);
		СсылкаРесурса = СсылкиРесурсов.Получить(Назначение.ResourceUID);
		Если СсылкаЗадачи = Неопределено ИЛИ СсылкаРесурса = Неопределено Тогда
			Продолжить; // назначение без обеих сторон не записывается (v1)
		КонецЕсли;
		Объект = СсылкаЗадачи.ПолучитьОбъект();
		СтрокаНазначения = Объект.Assignments.Добавить();
		СтрокаНазначения.Resource = СсылкаРесурса;
		СтрокаНазначения.Units = Назначение.Units;
		СтрокаНазначения.Work = Назначение.Work;
		СтрокаНазначения.ActualWork = Назначение.ActualWork;
		СтрокаНазначения.RemainingWork = Назначение.RemainingWork;
		СтрокаНазначения.Delay = Назначение.Delay;
		СтрокаНазначения.Cost = Назначение.Cost;
		Объект.Записать();
	КонецЦикла;

КонецПроцедуры

// === Поиск и создание объектов ===

Функция ОбъектКалендаря(Уид)

	Ссылка = Справочники.ГрафикиРаботы.НайтиПоРеквизиту("UID", Уид);
	Если Ссылка.Пустая() Тогда
		Возврат Справочники.ГрафикиРаботы.СоздатьЭлемент();
	КонецЕсли;
	Возврат Ссылка.ПолучитьОбъект();

КонецФункции

Функция ОбъектПроекта(Уид)

	Ссылка = Справочники.Проект.НайтиПоРеквизиту("UID", Уид);
	Если Ссылка.Пустая() Тогда
		Возврат Справочники.Проект.СоздатьЭлемент();
	КонецЕсли;
	Возврат Ссылка.ПолучитьОбъект();

КонецФункции

Функция ОбъектРесурса(Проект, Уид)

	Ссылка = Справочники.Ресурсы.НайтиПоРеквизиту("UID", Уид, , Проект);
	Если Ссылка.Пустая() Тогда
		Объект = Справочники.Ресурсы.СоздатьЭлемент();
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Возврат Объект;

КонецФункции

Функция ОбъектРаботы(Проект, Уид)

	Ссылка = Справочники.Работы.НайтиПоРеквизиту("UID", Уид, , Проект);
	Если Ссылка.Пустая() Тогда
		Объект = Справочники.Работы.СоздатьЭлемент();
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Возврат Объект;

КонецФункции

// Родитель задачи: ближайшая предыдущая с уровнем на единицу меньше.
// Возвращает пустую ссылку для задач верхнего уровня (присваивание допустимо).
Функция РодительРаботы(Задача, Родители)

	СсылкаРодителя = Справочники.Работы.ПустаяСсылка();
	Если Задача.OutlineLevel > 1 Тогда
		Найденный = Родители.Получить(Задача.OutlineLevel - 1);
		Если Найденный <> Неопределено Тогда
			СсылкаРодителя = Найденный;
		КонецЕсли;
	КонецЕсли;
	Возврат СсылкаРодителя;

КонецФункции

// === Служебные конвертации ===

// Наименование каталога с обрезкой по длине реквизита.
Функция ИмяДляКаталога(Текст, МаксДлина)

	Возврат Лев(СокрЛП(Текст), МаксДлина);

КонецФункции

// Неопределено (поле не задано) -> пустая дата реквизита.
Функция ЗначениеДаты(Значение)

	Возврат ?(Значение = Неопределено, Дата(1, 1, 1), Значение);

КонецФункции

#КонецОбласти
