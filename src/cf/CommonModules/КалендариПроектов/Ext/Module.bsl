// Календарная математика подсистемы Проджект (модель MS Project).
//
// Ядро - чистые функции над структурой календаря (не знают о базе данных):
//	РабочаяНеделя - Соответствие: НомерДняНедели (1=Пн..7=Вс) -> Массив интервалов
//	                {Начало, Конец} в секундах от начала суток; дня нет или
//	                массив пуст - день нерабочий.
//	Исключения    - Массив {С, По, Рабочий, Интервалы}: диапазон дат (По
//	                включительно); Рабочий=Ложь - день нерабочий, Истина -
//	                работает по Интервалам (даже если день недели нерабочий).
//
// Момент считается рабочим, если он внутри интервала [Начало, Конец).
// Читает календари справочника ГрафикиРаботы (см. doc/MultitoolDoc/Проджект).

#Область ПрограммныйИнтерфейс

// Структура календаря по ссылке на справочник ГрафикиРаботы.
// Наследование: дни недели берутся из собственного календаря, а где строк нет -
// из основного (BaseCalendar); исключения складываются (собственное первично).
//
// Параметры:
//   КалендарьСсылка - СправочникСсылка.ГрафикиРаботы
//
// Возвращаемое значение:
//   Структура - см. шапку модуля
//
Функция КалендарьПоСсылке(КалендарьСсылка) Экспорт

	Если Не ЗначениеЗаполнено(КалендарьСсылка) Тогда
		Возврат ПустойКалендарь();
	КонецЕсли;

	Данные = РеквизитыКалендаря(КалендарьСсылка);

	Результат = ПустойКалендарь();
	ЗаполнитьНеделюИзТаблицы(Результат.РабочаяНеделя, Данные.РабочаяНеделя);
	ЗаполнитьИсключенияИзТаблицы(Результат.Исключения, Данные.Исключения);

	Если ЗначениеЗаполнено(Данные.ОсновнойКалендарь) Тогда
		Основной = КалендарьПоСсылке(Данные.ОсновнойКалендарь);
		НаследоватьНеделю(Результат.РабочаяНеделя, Основной.РабочаяНеделя);
		ДополнитьИсключения(Результат.Исключения, Основной.Исключения);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Календарь «Стандартный» MS Project: Пн-Пт 8:00-12:00, 13:00-17:00.
// Используется, когда у проекта календарь не указан, и в тестах.
//
// Возвращаемое значение:
//   Структура - структура календаря (см. шапку модуля)
//
Функция СтандартныйКалендарь() Экспорт

	Результат = ПустойКалендарь();
	Для НомерДня = 1 По 5 Цикл
		Результат.РабочаяНеделя.Вставить(НомерДня, ИнтервалыСтандартногоДня());
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Календарный день рабочий?
//
// Параметры:
//   Календарь - Структура - структура календаря
//   День      - Дата     - любая дата календарного дня
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоРабочийДень(Календарь, День) Экспорт

	Возврат РабочаяДлительностьДня(Календарь, День) > 0;

КонецФункции

// Момент времени рабочий?
//
// Параметры:
//   Календарь - Структура - структура календаря
//   Момент    - Дата     - проверяемый момент
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоРабочийМомент(Календарь, Момент) Экспорт

	Возврат РабочийИнтервалМомента(Календарь, Момент) <> Неопределено;

КонецФункции

// Первый рабочий момент, начиная с указанного (если он рабочий - сам момент).
//
// Параметры:
//   Календарь - Структура - структура календаря
//   Момент    - Дата     - стартовая точка
//
// Возвращаемое значение:
//   Дата
//
Функция СледующийРабочийМомент(Календарь, Момент) Экспорт

	Точка = НачалоМинутыМомента(Момент);
	Для ДнейВперёд = 0 По 3700 Цикл // ~10 лет: защита от пустого календаря
		Если РабочаяДлительностьДня(Календарь, Точка) > 0 Тогда
			Результат = ПерваяРабочаяТочкаДняПосле(Календарь, Точка);
			Если ЗначениеЗаполнено(Результат) Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		Точка = НачалоДня(Точка) + СекундыСуток(); // со следующей полуночи, не сохраняя время суток
	КонецЦикла;

	Возврат НачалоМинутыМомента(Момент);

КонецФункции

// Последний рабочий момент, не позднее указанного (если он рабочий - сам момент).
//
// Параметры:
//   Календарь - Структура - структура календаря
//   Момент    - Дата     - стартовая точка
//
// Возвращаемое значение:
//   Дата
//
Функция ПредыдущийРабочийМомент(Календарь, Момент) Экспорт

	Точка = ПоследняяСекундаМинуты(Момент);
	Для ДнейНазад = 0 По 3700 Цикл
		Если РабочаяДлительностьДня(Календарь, Точка) > 0 Тогда
			Результат = ПоследняяРабочаяТочкаДняДо(Календарь, Точка);
			Если ЗначениеЗаполнено(Результат) Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		Точка = НачалоДня(Точка) - 1;
	КонецЦикла;

	Возврат ПоследняяСекундаМинуты(Момент);

КонецФункции

// Добавляет к моменту указанное количество рабочих минут по календарю.
// Нерабочий стартовый момент автоматически переносится на следующий рабочий.
// Нулевые минуты дают следующий рабочий момент (веха MS Project).
//
// Параметры:
//   Календарь - Структура - структура календаря
//   Момент    - Дата      - стартовая точка
//   Минуты    - Число     - рабочие минуты (неотрицательные)
//
// Возвращаемое значение:
//   Дата - момент окончания (конец последней израсходованной минуты)
//
Функция ДобавитьРабочиеМинуты(Календарь, Момент, Минуты) Экспорт

	Если Минуты <= 0 Тогда
		Возврат СледующийРабочийМомент(Календарь, Момент);
	КонецЕсли;

	Осталось = Минуты * 60;
	Точка = СледующийРабочийМомент(Календарь, Момент);

	Для ДнейВперёд = 0 По 3700 Цикл
		Для Каждого Интервал Из ИнтервалыДня(Календарь, Точка) Цикл
			НачалоИнтервала = ТочкаДня(Точка, Интервал.Начало);
			Старт = Макс(Точка, НачалоИнтервала);
			Доступно = ТочкаДня(Точка, Интервал.Конец) - Старт;
			Если Доступно <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Если Осталось <= Доступно Тогда
				Возврат Старт + Осталось;
			КонецЕсли;
			Осталось = Осталось - Доступно;
		КонецЦикла;
		Точка = НачалоДня(Точка) + СекундыСуток();
	КонецЦикла;

	Возврат Точка;

КонецФункции

// Отнимает от момента указанное количество рабочих минут по календарю:
// расходуются минуты непосредственно перед моментом; нерабочие дни пропускаются.
// Нулевые минуты дают предыдущий рабочий момент.
//
// Параметры:
//   Календарь - Структура - структура календаря
//   Момент    - Дата      - стартовая точка
//   Минуты    - Число     - рабочие минуты (неотрицательные)
//
// Возвращаемое значение:
//   Дата - момент начала (начало первой израсходованной минуты)
//
Функция ОтнятьРабочиеМинуты(Календарь, Момент, Минуты) Экспорт

	Если Минуты <= 0 Тогда
		Возврат ПредыдущийРабочийМомент(Календарь, Момент);
	КонецЕсли;

	Осталось = Минуты * 60;
	ТекущийДень = НачалоДня(Момент);
	Ограничение = Момент; // в первый день минуты берутся только до момента

	Для ДнейНазад = 0 По 3700 Цикл
		Интервалы = ИнтервалыДня(Календарь, ТекущийДень);
		Для Сч = 1 По Интервалы.Количество() Цикл // с конца дня
			Интервал = Интервалы[Интервалы.Количество() - Сч];
			НачалоИнтервала = ТочкаДня(ТекущийДень, Интервал.Начало);
			Финиш = ТочкаДня(ТекущийДень, Интервал.Конец);
			Если Ограничение <> Неопределено И Финиш > Ограничение Тогда
				Финиш = Ограничение;
			КонецЕсли;
			Доступно = Финиш - НачалоИнтервала;
			Если Доступно <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Если Осталось <= Доступно Тогда
				Возврат Финиш - Осталось;
			КонецЕсли;
			Осталось = Осталось - Доступно;
		КонецЦикла;
		ТекущийДень = ТекущийДень - СекундыСуток();
		Ограничение = Неопределено;
	КонецЦикла;

	Возврат Момент;

КонецФункции

// Количество рабочих минут между моментами [Начало, Конец).
//
// Параметры:
//   Календарь - Структура - структура календаря
//   Начало    - Дата      - начало отрезка (включается)
//   Конец     - Дата      - конец отрезка (не включается)
//
// Возвращаемое значение:
//   Число - рабочие минуты (0, если Конец <= Начало)
//
Функция РабочиеМинутыМежду(Календарь, Начало, Конец) Экспорт

	Если Конец <= Начало Тогда
		Возврат 0;
	КонецЕсли;

	Итого = 0;
	Граница = Конец;
	Точка = Начало;

	Для ДнейВперёд = 0 По 3700 Цикл
		Если Точка >= Граница Тогда
			Прервать;
		КонецЕсли;
		Для Каждого Интервал Из ИнтервалыДня(Календарь, Точка) Цикл
			Старт = Макс(Точка, ТочкаДня(Точка, Интервал.Начало));
			Финиш = Мин(Граница, ТочкаДня(Точка, Интервал.Конец));
			Если Финиш > Старт Тогда
				Итого = Итого + (Финиш - Старт);
			КонецЕсли;
		КонецЦикла;
		Точка = НачалоДня(Точка) + СекундыСуток();
	КонецЦикла;

	Возврат Цел(Итого / 60);

КонецФункции

// Рабочие интервалы календарного дня [{Начало, Конец} в секундах от суток].
//
// Параметры:
//   Календарь - Структура - структура календаря
//   День      - Дата      - любая дата календарного дня
//
// Возвращаемое значение:
//   Массив из Структура
//
Функция ИнтервалыДня(Календарь, День) Экспорт

	ИсключениеДня = ИсключениеДняКалендаря(Календарь, День);
	Если ИсключениеДня <> Неопределено Тогда
		Если ИсключениеДня.Рабочий Тогда
			Возврат ИсключениеДня.Интервалы;
		КонецЕсли;
		Возврат Новый Массив;
	КонецЕсли;

	Интервалы = Календарь.РабочаяНеделя.Получить(ДеньНедели(День));
	Если Интервалы = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат Интервалы;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПустойКалендарь()

	Возврат Новый Структура("РабочаяНеделя, Исключения", Новый Соответствие, Новый Массив);

КонецФункции

Функция ИнтервалыСтандартногоДня()

	Интервалы = Новый Массив;
	Интервалы.Добавить(Новый Структура("Начало, Конец", 8 * 3600, 12 * 3600));
	Интервалы.Добавить(Новый Структура("Начало, Конец", 13 * 3600, 17 * 3600));
	Возврат Интервалы;

КонецФункции

Функция СекундыСуток()

	Возврат 86400;

КонецФункции

Функция НачалоМинутыМомента(Момент)

	// НачалоМинуты - встроенная функция платформы; объявить свою с этим именем нельзя.
	Возврат НачалоМинуты(Момент);

КонецФункции

Функция ПоследняяСекундаМинуты(Момент)

	Возврат НачалоМинутыМомента(Момент) + 59;

КонецФункции

Функция СекундыМомента(Момент)

	Возврат Момент - НачалоДня(Момент);

КонецФункции

// Момент внутри календарного дня по смещению в секундах.
Функция ТочкаДня(Момент, Смещение)

	Возврат НачалоДня(Момент) + Смещение;

КонецФункции

Функция РеквизитыКалендаря(КалендарьСсылка)

	// Динамический доступ: реквизит и табличные части читаются одним обращением.
	Возврат Новый Структура("ОсновнойКалендарь, РабочаяНеделя, Исключения",
		КалендарьСсылка.BaseCalendar,
		КалендарьСсылка.WeekDays,
		КалендарьСсылка.Exceptions);

КонецФункции

// Заполняет неделю по строкам табличной части WeekDays.
Процедура ЗаполнитьНеделюИзТаблицы(Приёмник, Строки)

	Для Каждого Строка Из Строки Цикл
		Если Не Строка.DayWorking Тогда
			Приёмник.Вставить(Строка.DayType, Новый Массив);
			Продолжить;
		КонецЕсли;
		Интервалы = Новый Массив;
		ДобавитьИнтервалВремени(Интервалы, Строка.FromTime1, Строка.ToTime1);
		ДобавитьИнтервалВремени(Интервалы, Строка.FromTime2, Строка.ToTime2);
		ДобавитьИнтервалВремени(Интервалы, Строка.FromTime3, Строка.ToTime3);
		Приёмник.Вставить(Строка.DayType, Интервалы);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьИсключенияИзТаблицы(Приёмник, Строки)

	Для Каждого Строка Из Строки Цикл
		Интервалы = Новый Массив;
		Если Строка.DayWorking Тогда
			ДобавитьИнтервалВремени(Интервалы, Строка.FromTime1, Строка.ToTime1);
			ДобавитьИнтервалВремени(Интервалы, Строка.FromTime2, Строка.ToTime2);
			ДобавитьИнтервалВремени(Интервалы, Строка.FromTime3, Строка.ToTime3);
		КонецЕсли;
		Приёмник.Добавить(Новый Структура("С, По, Рабочий, Интервалы",
			НачалоДня(Строка.FromDate), НачалоДня(Строка.ToDate),
			Строка.DayWorking, Интервалы));
	КонецЦикла;

КонецПроцедуры

// Дни, не переопределённые собственным календарём, наследуются от основного.
Процедура НаследоватьНеделю(Приёмник, ОсновнаяНеделя)

	Для Каждого Пара Из ОсновнаяНеделя Цикл
		Если Приёмник.Получить(Пара.Ключ) = Неопределено Тогда
			Приёмник.Вставить(Пара.Ключ, Пара.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Исключения основного календаря добавляются после собственных.
Процедура ДополнитьИсключения(Приёмник, Дополнительные)

	Для Каждого Дополнение Из Дополнительные Цикл
		Приёмник.Добавить(Дополнение);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьИнтервалВремени(Приёмник, ВремяС, ВремяПо)

	Если Не ЗначениеЗаполнено(ВремяС) Или Не ЗначениеЗаполнено(ВремяПо) Тогда
		Возврат;
	КонецЕсли;

	Начало = СекундыВремени(ВремяС);
	Конец = СекундыВремени(ВремяПо);
	Если Конец <= Начало Тогда
		Возврат;
	КонецЕсли;

	Приёмник.Добавить(Новый Структура("Начало, Конец", Начало, Конец));

КонецПроцедуры

Функция СекундыВремени(Время)

	Возврат Час(Время) * 3600 + Минута(Время) * 60 + Секунда(Время);

КонецФункции

// Первое применимое исключение календаря для дня.
Функция ИсключениеДняКалендаря(Календарь, День)

	НачалоСуток = НачалоДня(День);
	Для Каждого ИсключениеКалендаря Из Календарь.Исключения Цикл
		Если НачалоСуток >= ИсключениеКалендаря.С И НачалоСуток <= ИсключениеКалендаря.По Тогда
			Возврат ИсключениеКалендаря;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция РабочаяДлительностьДня(Календарь, День)

	Итого = 0;
	Для Каждого Интервал Из ИнтервалыДня(Календарь, День) Цикл
		Итого = Итого + (Интервал.Конец - Интервал.Начало);
	КонецЦикла;

	Возврат Итого;

КонецФункции

Функция РабочийИнтервалМомента(Календарь, Момент)

	Смещение = СекундыМомента(Момент);
	Для Каждого Интервал Из ИнтервалыДня(Календарь, Момент) Цикл
		Если Смещение >= Интервал.Начало И Смещение < Интервал.Конец Тогда
			Возврат Интервал;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Первая рабочая точка дня не раньше момента (пусто - дня не хватает).
Функция ПерваяРабочаяТочкаДняПосле(Календарь, Момент)

	Для Каждого Интервал Из ИнтервалыДня(Календарь, Момент) Цикл
		КонецИнтервала = ТочкаДня(Момент, Интервал.Конец);
		Если Момент < КонецИнтервала Тогда
			Возврат Макс(Момент, ТочкаДня(Момент, Интервал.Начало));
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Последняя рабочая точка дня не позже момента (пусто - дня не хватает).
Функция ПоследняяРабочаяТочкаДняДо(Календарь, Момент)

	Интервалы = ИнтервалыДня(Календарь, Момент);
	Для Сч = 1 По Интервалы.Количество() Цикл
		Интервал = Интервалы[Интервалы.Количество() - Сч];
		НачалоИнтервала = ТочкаДня(Момент, Интервал.Начало);
		Если Момент >= НачалоИнтервала Тогда
			Возврат Мин(Момент, ТочкаДня(Момент, Интервал.Конец) - 1);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
