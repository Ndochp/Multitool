#Область ПрограммныйИнтерфейс
Процедура ОбработатьИзменениеДлительности(Таблица, Индекс) Экспорт
	ТекущаяСтрока = Таблица[Индекс];
	ПредыдущаяСтрока = ?(Индекс = 0 , Неопределено, Таблица[Индекс - 1]);
	СледующаяСтрока = ?(Индекс = Таблица.Количество() - 1, Неопределено, Таблица[Индекс + 1]);

	ТекущаяСтрока.Окончание = ТекущаяСтрока.Начало + ТекущаяСтрока.Длительность;
	ПересчитатьСледующуюСтроку(ТекущаяСтрока, СледующаяСтрока, Таблица);
КонецПроцедуры

Процедура ОбработатьИзменениеНачала(Таблица, Индекс) Экспорт
	ТекущаяСтрока = Таблица[Индекс];
	ПредыдущаяСтрока = ?(Индекс = 0 , Неопределено, Таблица[Индекс - 1]);
	СледующаяСтрока = ?(Индекс = Таблица.Количество() - 1, Неопределено, Таблица[Индекс + 1]);

	// Изменение начала дня при корректировке первой строки оставляем на совести формы/вызывающего. Я не хочу сюда ссылку на документ
	ПересчитатьПредыдущуюСтроку(ТекущаяСтрока, ПредыдущаяСтрока, Таблица);
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.Окончание) Тогда
		// это должна быть последняя строка, для нее длительность не считаем
		// Возможно потом переделаем на постоянное заполнение текущей датой с подтяжкой
		Возврат;
	КонецЕсли;
	
	Если ТекущаяСтрока.ФиксированнаяДлительность Тогда
		ТекущаяСтрока.Окончание = ТекущаяСтрока.Начало + ТекущаяСтрока.Длительность;
		ПересчитатьСледующуюСтроку(ТекущаяСтрока, СледующаяСтрока, Таблица);
	Иначе
		ТекущаяСтрока.Длительность = ТекущаяСтрока.Окончание - ТекущаяСтрока.Начало;
		Если ТекущаяСтрока.Длительность < 0 Тогда
			ТекущаяСтрока.Длительность  = 0;
			ТекущаяСтрока.Окончание = ТекущаяСтрока.начало;
			ПересчитатьСледующуюСтроку(ТекущаяСтрока, СледующаяСтрока, Таблица);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьИзменениеОкончания(Таблица, Индекс) Экспорт
	ТекущаяСтрока = Таблица[Индекс];
	ПредыдущаяСтрока = ?(Индекс = 0 , Неопределено, Таблица[Индекс - 1]);
	СледующаяСтрока = ?(Индекс = Таблица.Количество() - 1, Неопределено, Таблица[Индекс + 1]);

	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Окончание) Тогда
		// Открытая строка (последняя) — окончание остаётся пустым, пересчёта нет.
		Возврат;
	КонецЕсли;

	// Изменение начала дня при корректировке первой строки оставляем на совести формы/вызывающего. Я не хочу сюда ссылку на документ
	ПересчитатьСледующуюСтроку(ТекущаяСтрока, СледующаяСтрока, Таблица);
	
	Если ТекущаяСтрока.ФиксированнаяДлительность Тогда
		ТекущаяСтрока.Начало = ТекущаяСтрока.Окончание - ТекущаяСтрока.Длительность;
		ПересчитатьПредыдущуюСтроку(ТекущаяСтрока, ПредыдущаяСтрока, Таблица);
	Иначе
		ТекущаяСтрока.Длительность = ТекущаяСтрока.Окончание - ТекущаяСтрока.Начало;
		Если ТекущаяСтрока.Длительность < 0 Тогда
			ТекущаяСтрока.Длительность  = 0;
			ТекущаяСтрока.Окончание = ТекущаяСтрока.начало;
			ПересчитатьСледующуюСтроку(ТекущаяСтрока, СледующаяСтрока, Таблица);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Время начала рабочего дня по умолчанию (09:00), в секундах.
// Единый источник константы для модуля объекта и форм.
Функция ВремяНачалаРабочегоДня() Экспорт

	Возврат 9 * 60 * 60;

КонецФункции

// Удаление строки (UC-00 шаг 15): время начала следующей строки становится
// временем начала удаляемой; если следующая обычная — меняется длительность,
// если фиксированная — каскадный пересчёт вниз. Запись времени внешней
// системы удаляемой строки переносится в первую строку таблицы с датой
// начала = дата окончания, нулевой длительностью и комментарием «к удалению».
//
// Параметры:
//   Таблица               - ТаблицаЗначений/ДанныеФормыКоллекция - ОтчетЗаДень.
//   Индекс                - Число - индекс строки, стоящей на месте удалённой
//                           (строка уже удалена).
//   ДанныеУдаленнойСтроки - Структура - Начало/Окончание/Тикет/Описание/
//                           СсылкаНаТаймлог/Длительность удалённой строки.
//
Процедура ОбработатьУдалениеСтроки(Таблица, Знач Индекс, Знач ДанныеУдаленнойСтроки = Неопределено) Экспорт

	Если Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если Индекс < 0 Тогда
		Индекс = 0;
	КонецЕсли;
	Если Индекс >= Таблица.Количество() Тогда
		Индекс = Таблица.Количество() - 1;
	КонецЕсли;

	// Шаг 15 UC-00: время начала следующей строки становится началом удаляемой.
	Если ДанныеУдаленнойСтроки <> Неопределено
		И НЕ ПустаяДата(ДанныеУдаленнойСтроки.Начало) Тогда
		Таблица[Индекс].Начало = ДанныеУдаленнойСтроки.Начало;
	КонецЕсли;

	// Шаг 15 UC-00: запись внешней системы переносится в первую строку.
	Если ДанныеУдаленнойСтроки <> Неопределено
		И НЕ ПустаяСтрока(ДанныеУдаленнойСтроки.СсылкаНаТаймлог) Тогда
		НоваяСтрока = Таблица.Вставить(0);
		НоваяСтрока.Тикет = ДанныеУдаленнойСтроки.Тикет;
		НоваяСтрока.СсылкаНаТаймлог = ДанныеУдаленнойСтроки.СсылкаНаТаймлог;
		НоваяСтрока.Начало = ДанныеУдаленнойСтроки.Окончание;
		НоваяСтрока.Окончание = ДанныеУдаленнойСтроки.Окончание;
		НоваяСтрока.Длительность = 0;
		НоваяСтрока.Описание = "к удалению";
		Индекс = Индекс + 1;
	КонецЕсли;

	Если Таблица[Индекс].ФиксированнаяДлительность Тогда
		// Каскадный пересчёт вниз: длительности сохраняются.
		ПересчитатьВременаОт(Таблица, Индекс);
	Иначе
		// Обычная строка: длительность пересчитывается по новым границам.
		СтрокаТЧ = Таблица[Индекс];
		Если ПустаяДата(СтрокаТЧ.Начало) Или ПустаяДата(СтрокаТЧ.Окончание)
			Или СтрокаТЧ.Окончание <= СтрокаТЧ.Начало Тогда
			СтрокаТЧ.Длительность = 0;
		Иначе
			СтрокаТЧ.Длительность = СтрокаТЧ.Окончание - СтрокаТЧ.Начало;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Перемещение строки вверх (UC-00 шаг 12): строки меняются местами,
// длительности сохраняются, времена пересчитываются как цепочка.
//
// Параметры:
//   Таблица - ТаблицаЗначений/ДанныеФормыКоллекция - ОтчетЗаДень.
//   Индекс  - Число - индекс перемещаемой строки.
//
// Возвращаемое значение:
//   Булево - Истина, если строки перемещены; Ложь — первую строку вверх не двигают.
//
Функция ПереместитьСтрокуВверх(Таблица, Знач Индекс) Экспорт

	Если Индекс <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ПоменятьСтрокиМестами(Таблица, Индекс - 1, Индекс);
	ПересчитатьВременаОт(Таблица, Индекс - 1);

	Возврат Истина;

КонецФункции

// Перемещение строки вниз (UC-00 шаг 11): строки меняются местами,
// длительности сохраняются, времена пересчитываются как цепочка.
//
// Возвращаемое значение:
//   Булево - Истина, если строки перемещены; Ложь — последнюю вниз не двигают.
//
Функция ПереместитьСтрокуВниз(Таблица, Знач Индекс) Экспорт

	Если Индекс >= Таблица.Количество() - 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	ПоменятьСтрокиМестами(Таблица, Индекс, Индекс + 1);
	ПересчитатьВременаОт(Таблица, Индекс);

	Возврат Истина;

КонецФункции

#КонецОбласти //ПрограммныйИнтерфейс

#Область СлужебныйПрограммныйИнтерфейс
// Код процедур и функций
#КонецОбласти //СлужебныйПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции
Процедура ПересчитатьСледующуюСтроку(Знач ТекущаяСтрока, Знач СледующаяСтрока, знач Таблица)
	// Меняем термины на точку зрения обрабатываемой строки
	ПредыдущаяСтрока = ТекущаяСтрока;
	ТекущаяСтрока = СледующаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	Дельта = ТекущаяСтрока.Начало - ПредыдущаяСтрока.Окончание;
	Если Дельта = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущаяСтрока.Начало <> ПредыдущаяСтрока.Окончание Тогда
		
		ТекущаяСтрока.Начало = ТекущаяСтрока.Начало - Дельта;
		Если ТекущаяСтрока.ФиксированнаяДлительность Тогда
			ТекущаяСтрока.Окончание = ТекущаяСтрока.Окончание - Дельта;
			Индекс = Таблица.Индекс(ТекущаяСтрока);
			СледующаяСтрока = ?(Индекс = Таблица.Количество() - 1, Неопределено, Таблица[Индекс + 1]);
			ПересчитатьСледующуюСтроку(ТекущаяСтрока, СледующаяСтрока, Таблица);
		Иначе
			ТекущаяСтрока.Длительность = ТекущаяСтрока.Длительность + Дельта;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПересчитатьПредыдущуюСтроку(Знач ТекущаяСтрока, Знач ПредыдущаяСтрока, знач Таблица)
	// Меняем термины на точку зрения обрабатываемой строки:
	// обрабатываем предыдущую строку, а текущая для неё — следующая.
	СледующаяСтрока = ТекущаяСтрока;
	ТекущаяСтрока = ПредыдущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если не ЗначениеЗаполнено(ТекущаяСтрока.Окончание) Тогда
		// Шаг 5 UC-00: окончание предыдущей = новое начало текущей строки.
		ТекущаяСтрока.Окончание = СледующаяСтрока.Начало;
		ОбработатьИзменениеОкончания(Таблица, Таблица.Индекс(ТекущаяСтрока));
		Возврат;
	КонецЕсли;

	// Шаг 5 UC-00: у предыдущей строки меняется окончание, а не начало.
	// Начало сохраняется, длительность пересчитывается по новым границам.
	ТекущаяСтрока.Окончание = СледующаяСтрока.Начало;

	Если ТекущаяСтрока.ФиксированнаяДлительность Тогда
		// Шаг 7.1 UC-00: фиксированная строка сохраняет длительность —
		// её начало сдвигается, что требует пересчёта строки выше (каскад).
		ТекущаяСтрока.Начало = ТекущаяСтрока.Окончание - ТекущаяСтрока.Длительность;
		Индекс = Таблица.Индекс(ТекущаяСтрока);
		ПредыдущаяВыше = ?(Индекс = 0, Неопределено, Таблица[Индекс - 1]);
		ПересчитатьПредыдущуюСтроку(ТекущаяСтрока, ПредыдущаяВыше, Таблица);
	Иначе
		ТекущаяСтрока.Длительность = ТекущаяСтрока.Окончание - ТекущаяСтрока.Начало;
		Если ТекущаяСтрока.Длительность < 0 Тогда
			// Новое окончание раньше начала — приравниваем (шаг 5 UC-00).
			ТекущаяСтрока.Длительность = 0;
			ТекущаяСтрока.Окончание = ТекущаяСтрока.Начало;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Пересчитывает времена строк от индекса до конца как непрерывную цепочку:
// каждая следующая строка начинается с окончания предыдущей, длительности
// сохраняются. Открытая последняя строка (окончание пустое) не заполняется.
Процедура ПересчитатьВременаОт(Таблица, Знач Индекс)

	Если Индекс < 0 Или Индекс >= Таблица.Количество() Тогда
		Возврат;
	КонецЕсли;

	Для НомерСтроки = Индекс По Таблица.Количество() - 1 Цикл
		СтрокаТЧ = Таблица[НомерСтроки];
		Если НомерСтроки > 0 Тогда
			СтрокаТЧ.Начало = Таблица[НомерСтроки - 1].Окончание;
		КонецЕсли;
		Если НомерСтроки = Таблица.Количество() - 1
			И НЕ ЗначениеЗаполнено(СтрокаТЧ.Окончание) Тогда
			// Открытая последняя строка: окончание остаётся пустым.
			Продолжить;
		КонецЕсли;
		СтрокаТЧ.Окончание = СтрокаТЧ.Начало + СтрокаТЧ.Длительность;
	КонецЦикла;

КонецПроцедуры

// UC-03: фиксирует окончание открытой строки моментом (переключение задачи,
// добавление новой строки). Уже зафиксированная строка не меняется.
//
// Параметры:
//   Таблица - ТаблицаЗначений/ДанныеФормыКоллекция - ОтчетЗаДень.
//   Индекс  - Число - индекс фиксируемой строки.
//   Момент  - Дата - момент фиксации.
//
Процедура ЗафиксироватьОкончаниеСтроки(Таблица, Знач Индекс, Знач Момент) Экспорт

	Если Индекс < 0 Или Индекс >= Таблица.Количество() Тогда
		Возврат;
	КонецЕсли;

	СтрокаТЧ = Таблица[Индекс];
	Если ЗначениеЗаполнено(СтрокаТЧ.Окончание) И СтрокаТЧ.Окончание > СтрокаТЧ.Начало Тогда
		Возврат;
	КонецЕсли;

	СтрокаТЧ.Окончание = Момент;
	СтрокаТЧ.Длительность = ?(СтрокаТЧ.Окончание > СтрокаТЧ.Начало,
		СтрокаТЧ.Окончание - СтрокаТЧ.Начало, 0);

КонецПроцедуры

// Форматирует длительность в секундах строкой вида «ЧЧ:мм:сс»
// (часы не ограничены сутками). Пустая/нулевая длительность — пустая строка.
//
// Параметры:
//   Длительность - Число - длительность в секундах.
//
// Возвращаемое значение:
//   Строка - длительность в формате «ЧЧ:мм:сс».
//
Функция ДлительностьСтрокой(Знач Длительность) Экспорт

	Если НЕ ЗначениеЗаполнено(Длительность) Или Длительность < 0 Тогда
		Возврат "";
	КонецЕсли;

	Часы = Цел(Длительность / 3600);
	Минуты = Цел((Длительность - Часы * 3600) / 60);
	Секунды = Длительность - Часы * 3600 - Минуты * 60;

	Возврат ДополнитьДо2Цифр(Часы) + ":" + ДополнитьДо2Цифр(Минуты)
		+ ":" + ДополнитьДо2Цифр(Секунды);

КонецФункции

Функция ДополнитьДо2Цифр(Знач Значение)

	Представление = Строка(Значение);
	Пока СтрДлина(Представление) < 2 Цикл
		Представление = "0" + Представление;
	КонецЦикла;
	Возврат Представление;

КонецФункции

// Обменивает логическое содержимое двух строк (тикет, описание, ссылку,
// длительность), сохраняя времена у позиций (UC-00 шаги 11–12).
Процедура ПоменятьСтрокиМестами(Таблица, Знач ИндексПервая, Знач ИндексВторая)

	Первая = Таблица[ИндексПервая];
	Вторая = Таблица[ИндексВторая];

	Тикет = Первая.Тикет;
	Описание = Первая.Описание;
	СсылкаНаТаймлог = Первая.СсылкаНаТаймлог;
	Длительность = Первая.Длительность;

	Первая.Тикет = Вторая.Тикет;
	Первая.Описание = Вторая.Описание;
	Первая.СсылкаНаТаймлог = Вторая.СсылкаНаТаймлог;
	Первая.Длительность = Вторая.Длительность;

	Вторая.Тикет = Тикет;
	Вторая.Описание = Описание;
	Вторая.СсылкаНаТаймлог = СсылкаНаТаймлог;
	Вторая.Длительность = Длительность;

КонецПроцедуры

// Признак пустой (незаполненной) даты.
Функция ПустаяДата(Значение)

	Возврат ТипЗнч(Значение) = Тип("Дата") И НЕ ЗначениеЗаполнено(Значение);

КонецФункции

#КонецОбласти //СлужебныеПроцедурыИФункции
