		ЗаписатьПоле(Запись, "Name", Ресурс.Name);
		ЗаписатьПоле(Запись, "Code", Ресурс.Code);
		ЗаписатьПоле(Запись, "ID", Ресурс.ID);
		ЗаписатьПоле(Запись, "Type", Ресурс.ResourceType);
		ЗаписатьПоле(Запись, "MaterialLabel", Ресурс.MaterialLabel);
		ЗаписатьЭлемент(Запись, "MaxUnits", ДоляXML(Ресурс.MaxUnits));
		ЗаписатьПоле(Запись, "StandardRate", Ресурс.StandardRate);
		ЗаписатьПоле(Запись, "StandardRateFormat", Ресурс.StandardRateFormat);
		ЗаписатьПоле(Запись, "OvertimeRate", Ресурс.OvertimeRate);
		ЗаписатьПоле(Запись, "OvertimeRateFormat", Ресурс.OvertimeRateFormat);
		ЗаписатьПоле(Запись, "CostPerUse", Ресурс.CostPerUse);
		ЗаписатьПоле(Запись, "AccrueAt", Ресурс.AccrueAt);
		ЗаписатьПоле(Запись, "CalendarUID", Ресурс.CalendarUID);
		ЗаписатьПоле(Запись, "Group", Ресурс.Group);
		ЗаписатьПоле(Запись, "Initials", Ресурс.Initials);
		ЗаписатьПоле(Запись, "IsInactive", Не Ресурс.IsActive);
		ЗаписатьПоле(Запись, "Notes", Ресурс.Notes);
		Запись.ЗаписатьКонецЭлемента(); // Resource
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента(); // Resources

КонецПроцедуры

Процедура ЗаписатьНазначения(Запись, СписокНазначений)

	Если СписокНазначений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента("Assignments");
	Для Каждого Назначение Из СписокНазначений Цикл
		Запись.ЗаписатьНачалоЭлемента("Assignment");
		ЗаписатьПоле(Запись, "TaskUID", Назначение.TaskUID);
		ЗаписатьПоле(Запись, "ResourceUID", Назначение.ResourceUID);
		ЗаписатьЭлемент(Запись, "Units", ДоляXML(Назначение.Units));
		ЗаписатьЭлемент(Запись, "Work", ДлительностьXML(Назначение.Work));
		ЗаписатьЭлемент(Запись, "ActualWork", ДлительностьXML(Назначение.ActualWork));
		ЗаписатьЭлемент(Запись, "RemainingWork", ДлительностьXML(Назначение.RemainingWork));
		ЗаписатьЭлемент(Запись, "Delay", ДесятыеXML(Назначение.Delay));
		ЗаписатьПоле(Запись, "Cost", Назначение.Cost);
		Запись.ЗаписатьКонецЭлемента(); // Assignment
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента(); // Assignments

КонецПроцедуры

// === Конвертации при записи (обратные к разбору) ===

// Рабочие минуты -> ISO 8601 ("PT8H0M0S"); доли минуты отбрасываются.
Функция ДлительностьXML(Минуты)

	МинутыЦелые = Цел(Минуты);
	Часы = Цел(МинутыЦелые / 60);
	Остаток = МинутыЦелые - Часы * 60;
	Возврат "PT" + Часы + "H" + Остаток + "M0S";

КонецФункции

// Минуты -> десятые доли минуты (формат slack/lag/LevelingDelay/Delay).
Функция ДесятыеXML(Минуты)

	Возврат XMLСтрока(Окр(Минуты * 10, 0));

КонецФункции

// Проценты -> доля 1.0 (100 -> "1", 50 -> "0.5").
Функция ДоляXML(Проценты)

	Возврат XMLСтрока(Окр(Проценты / 100, 2));

КонецФункции

// День 1С (1=пн..7=вс) -> день MSPDI (1=вс..7=сб), обратный к ДеньИзMSPDI.
Функция ДеньИз1С(День1С)

	Возврат День1С - Цел(День1С / 7) * 7 + 1;

КонецФункции

// Дата без даты -> xsd:time ("T08:00:00"), обратный к ВремяИзXML.
Функция ВремяXML(Момент)

	ЧасыМинуты = ДвеЦифры(Час(Момент)) + ":" + ДвеЦифры(Минута(Момент));
	Возврат "T" + ЧасыМинуты + ":" + ДвеЦифры(Секунда(Момент));

КонецФункции

// Число с ведущим нулём ("08"); вход всегда 0..59.
Функция ДвеЦифры(Число)

	Если Число < 10 Тогда
		Возврат "0" + Число;
	КонецЕсли;
	Возврат "" + Число;

КонецФункции

#КонецОбласти
