		ЗаписатьЭлемент(Запись, "LinkLag", ДесятыеXML(Связь.Lag));
		ЗаписатьПоле(Запись, "LagFormat", Связь.LagFormat);
		ЗаписатьПоле(Запись, "CrossProject", Связь.CrossProject);
		ЗаписатьПоле(Запись, "CrossProjectName", Связь.CrossProjectName);
		Запись.ЗаписатьКонецЭлемента(); // PredecessorLink
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента(); // PredecessorLinks

