// === Запись MSPDI ===

// Пишет элемент с текстовым значением (пустая строка - пустой узел).
Процедура ЗаписатьЭлемент(Запись, Имя, Текст)

	Запись.ЗаписатьНачалоЭлемента(Имя);
	Запись.ЗаписатьТекст(Текст);
	Запись.ЗаписатьКонецЭлемента();

КонецПроцедуры

// Пишет поле структуры: Булево -> "1"/"0", остальное -> XMLСтрока;
// Неопределено (поле не задано) пропускается.
Процедура ЗаписатьПоле(Запись, Имя, Значение)

	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		ЗаписатьЭлемент(Запись, Имя, ?(Значение, "1", "0"));
	Иначе
		ЗаписатьЭлемент(Запись, Имя, XMLСтрока(Значение));
	КонецЕсли;

КонецПроцедуры

// === Разделы документа ===

Процедура ЗаписатьПроект(Запись, Проект)

	ЗаписатьПоле(Запись, "UID", Проект.UID);
	ЗаписатьПоле(Запись, "Title", Проект.Name);
	ЗаписатьПоле(Запись, "StartDate", Проект.StartDate);
	ЗаписатьПоле(Запись, "FinishDate", Проект.FinishDate);
	ЗаписатьПоле(Запись, "MinutesPerDay", Проект.MinutesPerDay);
	ЗаписатьПоле(Запись, "MinutesPerWeek", Проект.MinutesPerWeek);
	ЗаписатьПоле(Запись, "DaysPerMonth", Проект.DaysPerMonth);
	ЗаписатьПоле(Запись, "CurrencyCode", Проект.CurrencyCode);
	ЗаписатьПоле(Запись, "CurrencySymbol", Проект.CurrencySymbol);
	ЗаписатьПоле(Запись, "CalendarUID", Проект.CalendarUID);

КонецПроцедуры

Процедура ЗаписатьКалендари(Запись, СписокКалендарей)

	Если СписокКалендарей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента("Calendars");
	Для Каждого Календарь Из СписокКалендарей Цикл
		Запись.ЗаписатьНачалоЭлемента("Calendar");
		ЗаписатьПоле(Запись, "UID", Календарь.UID);
		ЗаписатьПоле(Запись, "Name", Календарь.Name);
		ЗаписатьПоле(Запись, "IsBaseCalendar", Календарь.IsBaseCalendar);
		ЗаписатьПоле(Запись, "BaseCalendarUID", Календарь.BaseCalendarUID);
		ЗаписатьДниНедели(Запись, Календарь.WeekDays);
		ЗаписатьИсключения(Запись, Календарь.Exceptions);
		Запись.ЗаписатьКонецЭлемента(); // Calendar
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента(); // Calendars

КонецПроцедуры

Процедура ЗаписатьДниНедели(Запись, ДниНедели)

	Если ДниНедели.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента("WeekDays");
	Для Каждого ДеньНедели Из ДниНедели Цикл
		Запись.ЗаписатьНачалоЭлемента("WeekDay");
		ЗаписатьЭлемент(Запись, "DayType", XMLСтрока(ДеньИз1С(ДеньНедели.DayType)));
		ЗаписатьПоле(Запись, "DayWorking", ДеньНедели.DayWorking);
		ЗаписатьИнтервалы(Запись, ДеньНедели.Интервалы);
		Запись.ЗаписатьКонецЭлемента(); // WeekDay
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента(); // WeekDays

КонецПроцедуры

Процедура ЗаписатьИсключения(Запись, СписокИсключений)

	Если СписокИсключений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента("Exceptions");
	Для Каждого ИсключениеКалендаря Из СписокИсключений Цикл
		Запись.ЗаписатьНачалоЭлемента("Exception");
		ЗаписатьПоле(Запись, "Name", ИсключениеКалендаря.Name);
		ЗаписатьПоле(Запись, "Type", ИсключениеКалендаря.Тип);
		Запись.ЗаписатьНачалоЭлемента("TimePeriod");
		ЗаписатьПоле(Запись, "FromDate", ИсключениеКалендаря.FromDate);
		ЗаписатьПоле(Запись, "ToDate", ИсключениеКалендаря.ToDate);
		Запись.ЗаписатьКонецЭлемента(); // TimePeriod
		ЗаписатьПоле(Запись, "DayWorking", ИсключениеКалендаря.DayWorking);
		ЗаписатьИнтервалы(Запись, ИсключениеКалендаря.Интервалы);
		Запись.ЗаписатьКонецЭлемента(); // Exception
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента(); // Exceptions

