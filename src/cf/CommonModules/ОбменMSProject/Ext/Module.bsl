// Импорт MSPDI XML (формат обмена MS Project) подсистемы Проджект.
//
// Слой 1 (этот модуль, чистые функции): Разобрать(ТекстXML) -> структуры данных
// без записи в базу. Слой 2 (запись справочников по UID) - отдельная процедура
// вызывающего кода, здесь не смешивается (гексагональное разделение).
//
// Обратное преобразование: Записать(Данные) -> текст MSPDI XML (экспорт).
// Выводится то, что задано пользователем; поля, которые MS Project пересчитывает
// при импорте сам (WBS/OutlineNumber, Early/Late, slack, Critical), не выводятся.
//
// Контракты разбора (см. doc/MultitoolDoc/Проджект, разделы 3 и 6):
//	Проект     - {UID, Name, StartDate, FinishDate, CalendarUID, MinutesPerDay,
//	              MinutesPerWeek, DaysPerMonth, CurrencyCode, CurrencySymbol}
//	Календари  - Массив {UID, Name, IsBaseCalendar, BaseCalendarUID,
//	              WeekDays: Массив {DayType (1=пн..7=вс, конвертация из MSPDI),
//	                                DayWorking, Интервалы: Массив {FromTime, ToTime}},
//	              Exceptions: Массив {Name, FromDate, ToDate, DayWorking,
//	                                  Тип (только 1), Интервалы}}
//	Задачи     - Массив {UID, Name, ID, WBS, OutlineNumber, OutlineLevel,
//	              Summary, Milestone, ManuallyScheduled, TaskType, EffortDriven,
//	              Duration (минуты), DurationFormat, Start, Finish, EarlyStart,
//	              EarlyFinish, LateStart, LateFinish, TotalSlack (минуты),
//	              FreeSlack (минуты), Critical, ConstraintType, ConstraintDate,
//	              Deadline, Priority, LevelingDelay (минуты), LevelingCanSplit,
//	              LevelAssignments, PercentComplete, PercentWorkComplete,
//	              ActualStart, ActualFinish, ActualDuration, Work, ActualWork,
//	              RemainingWork, FixedCost, Cost, CalendarUID, Notes, IsActive,
//	              Stop, Resume, Предшественники: Массив {PredecessorUID, LinkType,
//	              Lag (минуты), LagFormat, CrossProject, CrossProjectName}}
//	Ресурсы    - Массив {UID, Name, Code, ID, ResourceType, MaterialLabel,
//	              MaxUnits (проценты), StandardRate, StandardRateFormat,
//	              OvertimeRate, OvertimeRateFormat, CostPerUse, AccrueAt,
//	              CalendarUID, Group, Initials, IsActive (инверсия IsInactive),
//	              Notes}
//	Назначения - Массив {TaskUID, ResourceUID, Units (проценты), Work,
//	              ActualWork, RemainingWork, Delay (минуты), Cost}
//	Предупреждения - Массив строк (что пропущено/сконвертировано нестандартно)
//
// Конвертации при разборе:
//	- Duration/Work: ISO 8601 ("PT8H0M0S") -> рабочие минуты (часы в MSPDI -
//	  рабочие часы при MinutesPerDay проекта);
//	- slack/lag/LevelingDelay/Delay (Assignment): десятые доли минуты -> минуты (/10);
//	- Units/MaxUnits: доля 1.0 -> проценты (x100);
//	- WeekDay.DayType: MSPDI 1=вс..7=сб -> день 1С 1=пн..7=вс;
//	- IsInactive ресурса -> IsActive (инверсия);
//	- Link.Type хранится как есть (движок считает только FS, отчёт Р9).
//
// Ограничения v1: рекуррентные исключения календарей (Type <> 1) пропускаются
// с предупреждением; более 3 интервалов рабочего времени в дне - лишние
// отбрасываются с предупреждением (MS Project UI больше не даёт, отчёт Р8).

#Область ПрограммныйИнтерфейс

// Разбирает текст MSPDI XML в структуры данных (без записи в базу).
//
// Параметры:
//   ТекстXML - Строка - содержимое файла MSPDI (namespace schemas.microsoft.com/project)
//
// Возвращаемое значение:
//   Структура - см. шапку модуля (Проект, Календари, Задачи, Ресурсы,
//               Назначения, Предупреждения)
//
Функция Разобрать(ТекстXML) Экспорт

	Результат = Новый Структура("Проект, Календари, Задачи, Ресурсы, Назначения, Предупреждения",
		ПустойПроект(), Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив);

	Контекст = НовыйКонтекст(Результат);
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);

	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ОткрытьУзел(Контекст, Чтение.ЛокальноеИмя);
		КонецЕсли;
		Если Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
			ДобавитьТекст(Контекст, Чтение.Значение);
		КонецЕсли;
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			ЗакрытьУзел(Контекст);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Записывает структуры данных (результат Разобрать) в текст MSPDI XML.
//
// Параметры:
//   Данные - Структура - результат Разобрать (см. шапку модуля)
//
// Возвращаемое значение:
//   Строка - содержимое файла MSPDI (namespace schemas.microsoft.com/project)
//
// v1 не выводит поля, которые MS Project пересчитывает при импорте сам:
// WBS/OutlineNumber (строит по OutlineLevel), EarlyStart/EarlyFinish,
// LateStart/LateFinish, TotalSlack/FreeSlack, Critical.
//
Функция Записать(Данные) Экспорт

	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("Project");
	Запись.ЗаписатьАтрибут("xmlns", "http://schemas.microsoft.com/project");

	ЗаписатьПроект(Запись, Данные.Проект);
	ЗаписатьКалендари(Запись, Данные.Календари);
	ЗаписатьЗадачи(Запись, Данные.Задачи);
	ЗаписатьРесурсы(Запись, Данные.Ресурсы);
	ЗаписатьНазначения(Запись, Данные.Назначения);

	Запись.ЗаписатьКонецЭлемента(); // Project
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// === Управление обходом XML ===

Функция НовыйКонтекст(Результат)

	ИменаПолей = "Результат, Стек, Приёмники, Буфер";
	ИменаПолей = ИменаПолей + ", ТекущийКалендарь, ТекущийДеньНедели, ТекущееИсключение, ТекущийИнтервал";
	ИменаПолей = ИменаПолей + ", ТекущаяЗадача, ТекущаяСвязь, ТекущийРесурс, ТекущееНазначение";
	Возврат Новый Структура(ИменаПолей,
		Результат, Новый Массив, Новый Соответствие, Неопределено,
		Неопределено, Неопределено, Неопределено, Неопределено,
		Неопределено, Неопределено, Неопределено, Неопределено);

КонецФункции

Процедура ОткрытьУзел(Контекст, Имя)

	Контекст.Стек.Добавить(Имя);
	Путь = СтрСоединить(Контекст.Стек, "/");

	Если Контекст.Приёмники.Получить(Путь) <> Неопределено Тогда
		Контекст.Буфер = "";
	КонецЕсли;

	Если Путь = "Project" Тогда
		ОткрытьПроект(Контекст);
	ИначеЕсли Путь = "Project/Calendars/Calendar" Тогда
		ОткрытьКалендарь(Контекст);
	ИначеЕсли Путь = "Project/Calendars/Calendar/WeekDays/WeekDay" Тогда
		ОткрытьДеньНедели(Контекст);
	ИначеЕсли Путь = "Project/Calendars/Calendar/Exceptions/Exception" Тогда
		ОткрытьИсключение(Контекст);
	ИначеЕсли Путь = "Project/Tasks/Task" Тогда
		ОткрытьЗадачу(Контекст);
	ИначеЕсли Путь = "Project/Tasks/Task/PredecessorLinks/PredecessorLink" Тогда
		ОткрытьСвязь(Контекст, Путь);
	ИначеЕсли Путь = "Project/Resources/Resource" Тогда
		ОткрытьРесурс(Контекст);
	ИначеЕсли Путь = "Project/Assignments/Assignment" Тогда
		ОткрытьНазначение(Контекст);
	ИначеЕсли СтрЗаканчиваетсяНа(Путь, "/WorkingTime") Тогда
		ОткрытьИнтервал(Контекст, Путь);
	Иначе
		// Узел вне схемы разбора не требует инициализации.
		Возврат;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьТекст(Контекст, Текст)

	Если Контекст.Буфер <> Неопределено Тогда
		Контекст.Буфер = Контекст.Буфер + Текст;
	КонецЕсли;

КонецПроцедуры

Процедура ЗакрытьУзел(Контекст)

	Путь = СтрСоединить(Контекст.Стек, "/");

	Если Контекст.Буфер <> Неопределено Тогда
		ПрисвоитьЛист(Контекст, Путь, Контекст.Буфер);
		Контекст.Буфер = Неопределено;
	КонецЕсли;

	Контекст.Стек.Удалить(Контекст.Стек.ВГраница());

	Если Путь = "Project/Calendars/Calendar" Тогда
		ЗакрытьКалендарь(Контекст);
	ИначеЕсли Путь = "Project/Calendars/Calendar/WeekDays/WeekDay" Тогда
		ЗакрытьДеньНедели(Контекст);
	ИначеЕсли Путь = "Project/Calendars/Calendar/Exceptions/Exception" Тогда
		ЗакрытьИсключение(Контекст);
	ИначеЕсли СтрЗаканчиваетсяНа(Путь, "/WorkingTime") Тогда
		ЗакрытьИнтервал(Контекст);
	ИначеЕсли Путь = "Project/Tasks/Task" Тогда
		ЗакрытьЗадачу(Контекст);
	ИначеЕсли Путь = "Project/Tasks/Task/PredecessorLinks/PredecessorLink" Тогда
		ЗакрытьСвязь(Контекст);
	ИначеЕсли Путь = "Project/Resources/Resource" Тогда
		ЗакрытьРесурс(Контекст);
	ИначеЕсли Путь = "Project/Assignments/Assignment" Тогда
		ЗакрытьНазначение(Контекст);
	Иначе
		// Узел вне схемы разбора не требует завершения.
		Возврат;
	КонецЕсли;

КонецПроцедуры

// Присваивает значение листа XML полю структуры-приёмника.
Процедура ПрисвоитьЛист(Контекст, Путь, Текст)

	Настройка = Контекст.Приёмники.Получить(Путь);
	Если Настройка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекстЗначения = СокрЛП(Текст);
	Если ТекстЗначения = "" Тогда
		Возврат; // пустой узел - поле остаётся по умолчанию
	КонецЕсли;
	Настройка.Объект.Вставить(Настройка.Поле, ЗначениеПоля(ТекстЗначения, Настройка.Конвертер));

КонецПроцедуры

// Регистрирует поля одного объекта: "Путь|Поле|Конвертер,..." от Префикса.
Процедура ЗарегистрироватьПоля(Контекст, Префикс, Объект, Список)

	Для Каждого Элемент Из СтрРазделить(Список, ",", Ложь) Цикл
		Части = СтрРазделить(Элемент, "|", Ложь);
		Контекст.Приёмники.Вставить(Префикс + "/" + СокрЛП(Части[0]),
			Новый Структура("Объект, Поле, Конвертер", Объект, СокрЛП(Части[1]), СокрЛП(Части[2])));
	КонецЦикла;

КонецПроцедуры

// === Открытие контейнеров ===

Процедура ОткрытьПроект(Контекст)

	Контекст.Результат.Проект = ПустойПроект();
	Список = "UID|UID|Строка,Title|Name|Строка,StartDate|StartDate|Дата,FinishDate|FinishDate|Дата";
	Список = Список + ",MinutesPerDay|MinutesPerDay|Число,MinutesPerWeek|MinutesPerWeek|Число,DaysPerMonth|DaysPerMonth|Число";
	Список = Список + ",CurrencyCode|CurrencyCode|Строка,CurrencySymbol|CurrencySymbol|Строка,CalendarUID|CalendarUID|Строка";
	ЗарегистрироватьПоля(Контекст, "Project", Контекст.Результат.Проект, Список);

КонецПроцедуры

Процедура ОткрытьКалендарь(Контекст)

	Контекст.ТекущийКалендарь = ПустойКалендарь();
	Список = "UID|UID|Строка,Name|Name|Строка,IsBaseCalendar|IsBaseCalendar|Булево,BaseCalendarUID|BaseCalendarUID|Строка";
	ЗарегистрироватьПоля(Контекст, "Project/Calendars/Calendar", Контекст.ТекущийКалендарь, Список);

КонецПроцедуры

Процедура ОткрытьДеньНедели(Контекст)

	Контекст.ТекущийДеньНедели = Новый Структура("DayType, DayWorking, Интервалы", 0, Ложь, Новый Массив);
	Список = "DayType|DayType|День,DayWorking|DayWorking|Булево";
	ЗарегистрироватьПоля(Контекст, "Project/Calendars/Calendar/WeekDays/WeekDay", Контекст.ТекущийДеньНедели, Список);

КонецПроцедуры

Процедура ОткрытьИсключение(Контекст)

	Контекст.ТекущееИсключение = Новый Структура("Name, FromDate, ToDate, DayWorking, Тип, Интервалы",
		"", Неопределено, Неопределено, Ложь, 1, Новый Массив);
	Список = "Name|Name|Строка,DayWorking|DayWorking|Булево,Type|Тип|Число";
	Список = Список + ",TimePeriod/FromDate|FromDate|Дата,TimePeriod/ToDate|ToDate|Дата";
	ЗарегистрироватьПоля(Контекст, "Project/Calendars/Calendar/Exceptions/Exception", Контекст.ТекущееИсключение, Список);

КонецПроцедуры

Процедура ОткрытьИнтервал(Контекст, Путь)

	Контекст.ТекущийИнтервал = Новый Структура("FromTime, ToTime");
	ЗарегистрироватьПоля(Контекст, Путь, Контекст.ТекущийИнтервал, "FromTime|FromTime|Время,ToTime|ToTime|Время");

КонецПроцедуры

Процедура ОткрытьЗадачу(Контекст)

	Контекст.ТекущаяЗадача = ПустаяЗадача();
	Список = "UID|UID|Строка,Name|Name|Строка,ID|ID|Число,WBS|WBS|Строка,OutlineNumber|OutlineNumber|Строка";
	Список = Список + ",OutlineLevel|OutlineLevel|Число,Summary|Summary|Булево,Milestone|Milestone|Булево,Manual|ManuallyScheduled|Булево";
	Список = Список + ",Type|TaskType|Число,EffortDriven|EffortDriven|Булево,Duration|Duration|Длительность,DurationFormat|DurationFormat|Число";
	Список = Список + ",Start|Start|Дата,Finish|Finish|Дата,EarlyStart|EarlyStart|Дата,EarlyFinish|EarlyFinish|Дата";
	Список = Список + ",LateStart|LateStart|Дата,LateFinish|LateFinish|Дата,TotalSlack|TotalSlack|Десятые,FreeSlack|FreeSlack|Десятые";
	Список = Список + ",Critical|Critical|Булево,ConstraintType|ConstraintType|Число,ConstraintDate|ConstraintDate|Дата,Deadline|Deadline|Дата";
	Список = Список + ",Priority|Priority|Число,LevelingDelay|LevelingDelay|Десятые,LevelingCanSplit|LevelingCanSplit|Булево";
	Список = Список + ",LevelAssignments|LevelAssignments|Булево,PercentComplete|PercentComplete|Число,PercentWorkComplete|PercentWorkComplete|Число";
	Список = Список + ",ActualStart|ActualStart|Дата,ActualFinish|ActualFinish|Дата,ActualDuration|ActualDuration|Длительность";
	Список = Список + ",Work|Work|Длительность,ActualWork|ActualWork|Длительность,RemainingWork|RemainingWork|Длительность";
	Список = Список + ",FixedCost|FixedCost|Число,Cost|Cost|Число,CalendarUID|CalendarUID|Строка,Notes|Notes|Строка";
	Список = Список + ",Active|IsActive|Булево,Stop|Stop|Дата,Resume|Resume|Дата";
	ЗарегистрироватьПоля(Контекст, "Project/Tasks/Task", Контекст.ТекущаяЗадача, Список);

КонецПроцедуры

Процедура ОткрытьСвязь(Контекст, Путь)

	Контекст.ТекущаяСвязь = ПустаяСвязь();
	Список = "PredecessorUID|PredecessorUID|Строка,Type|LinkType|Число,LinkLag|Lag|Десятые";
	Список = Список + ",LagFormat|LagFormat|Число,CrossProject|CrossProject|Булево,CrossProjectName|CrossProjectName|Строка";
	ЗарегистрироватьПоля(Контекст, Путь, Контекст.ТекущаяСвязь, Список);

КонецПроцедуры

Процедура ОткрытьРесурс(Контекст)

	Контекст.ТекущийРесурс = ПустойРесурс();
	Список = "UID|UID|Строка,Name|Name|Строка,Code|Code|Строка,ID|ID|Число,Type|ResourceType|Число";
	Список = Список + ",MaterialLabel|MaterialLabel|Строка,MaxUnits|MaxUnits|Проценты,StandardRate|StandardRate|Число";
	Список = Список + ",StandardRateFormat|StandardRateFormat|Число,OvertimeRate|OvertimeRate|Число,OvertimeRateFormat|OvertimeRateFormat|Число";
	Список = Список + ",CostPerUse|CostPerUse|Число,AccrueAt|AccrueAt|Число,CalendarUID|CalendarUID|Строка,Group|Group|Строка";
	Список = Список + ",Initials|Initials|Строка,IsInactive|IsActive|Инверсия,Notes|Notes|Строка";
	ЗарегистрироватьПоля(Контекст, "Project/Resources/Resource", Контекст.ТекущийРесурс, Список);

КонецПроцедуры

Процедура ОткрытьНазначение(Контекст)

	Контекст.ТекущееНазначение = ПустоеНазначение();
	Список = "TaskUID|TaskUID|Строка,ResourceUID|ResourceUID|Строка,Units|Units|Проценты,Work|Work|Длительность";
	Список = Список + ",ActualWork|ActualWork|Длительность,RemainingWork|RemainingWork|Длительность,Delay|Delay|Десятые,Cost|Cost|Число";
	ЗарегистрироватьПоля(Контекст, "Project/Assignments/Assignment", Контекст.ТекущееНазначение, Список);

КонецПроцедуры

// === Закрытие контейнеров ===

Процедура ЗакрытьКалендарь(Контекст)

	Контекст.Результат.Календари.Добавить(Контекст.ТекущийКалендарь);
	Контекст.ТекущийКалендарь = Неопределено;

КонецПроцедуры

Процедура ЗакрытьДеньНедели(Контекст)

	Интервалы = Контекст.ТекущийДеньНедели.Интервалы;
	Если Интервалы.Количество() > 3 Тогда
		ДобавитьПредупреждение(Контекст, "Более 3 интервалов рабочего времени в дне - лишние отброшены");
		Пока Интервалы.Количество() > 3 Цикл
			Интервалы.Удалить(Интервалы.ВГраница());
		КонецЦикла;
	КонецЕсли;
	Контекст.ТекущийКалендарь.WeekDays.Добавить(Контекст.ТекущийДеньНедели);
	Контекст.ТекущийДеньНедели = Неопределено;

КонецПроцедуры

Процедура ЗакрытьИсключение(Контекст)

	ИсключениеКалендаря = Контекст.ТекущееИсключение;
	Если ИсключениеКалендаря.Тип <> 1 Тогда
		ДобавитьПредупреждение(Контекст, СтрШаблон(
			"Рекуррентное исключение '%1' пропущено (поддерживаются только исключения с диапазоном дат)",
			ИсключениеКалендаря.Name));
	Иначе
		Контекст.ТекущийКалендарь.Exceptions.Добавить(ИсключениеКалендаря);
	КонецЕсли;
	Контекст.ТекущееИсключение = Неопределено;

КонецПроцедуры

Процедура ЗакрытьИнтервал(Контекст)

	Если ЗначениеЗаполнено(Контекст.ТекущийИнтервал.FromTime) Тогда
		ИнтервалыКонтейнера(Контекст).Добавить(Контекст.ТекущийИнтервал);
	КонецЕсли;
	Контекст.ТекущийИнтервал = Неопределено;

КонецПроцедуры

Процедура ЗакрытьЗадачу(Контекст)

	Контекст.Результат.Задачи.Добавить(Контекст.ТекущаяЗадача);
	Контекст.ТекущаяЗадача = Неопределено;

КонецПроцедуры

Процедура ЗакрытьСвязь(Контекст)

	СвязьЗадачи = Контекст.ТекущаяСвязь;
	Если Контекст.ТекущаяЗадача <> Неопределено Тогда
		Контекст.ТекущаяЗадача.Предшественники.Добавить(СвязьЗадачи);
	КонецЕсли;
	Если СвязьЗадачи.LinkType <> 1 Тогда
		ДобавитьПредупреждение(Контекст, СтрШаблон(
			"Тип связи %1 задачи '%2' не поддерживается (только FS) - при расчёте считается как FS",
			СвязьЗадачи.LinkType, Контекст.ТекущаяЗадача.Name));
	КонецЕсли;
	Контекст.ТекущаяСвязь = Неопределено;

КонецПроцедуры

Процедура ЗакрытьРесурс(Контекст)

	Контекст.Результат.Ресурсы.Добавить(Контекст.ТекущийРесурс);
	Контекст.ТекущийРесурс = Неопределено;

КонецПроцедуры

Процедура ЗакрытьНазначение(Контекст)

	Контекст.Результат.Назначения.Добавить(Контекст.ТекущееНазначение);
	Контекст.ТекущееНазначение = Неопределено;

КонецПроцедуры

Процедура ДобавитьПредупреждение(Контекст, Текст)

	Контекст.Результат.Предупреждения.Добавить(Текст);

КонецПроцедуры

Функция ИнтервалыКонтейнера(Контекст)

	Если Контекст.ТекущееИсключение <> Неопределено Тогда
		Возврат Контекст.ТекущееИсключение.Интервалы;
	КонецЕсли;
	Возврат Контекст.ТекущийДеньНедели.Интервалы;

КонецФункции

// === Значения и конвертации ===

Функция ЗначениеПоля(Текст, Конвертер)

	Если Конвертер = "Число" Тогда
		Возврат XMLЗначение(Тип("Число"), Текст);
	ИначеЕсли Конвертер = "Булево" Тогда
		Возврат XMLЗначение(Тип("Булево"), Текст);
	ИначеЕсли Конвертер = "Дата" Тогда
		Возврат XMLЗначение(Тип("Дата"), Текст);
	ИначеЕсли Конвертер = "Длительность" Тогда
		Возврат МинутыИзДлительности(Текст);
	ИначеЕсли Конвертер = "Десятые" Тогда
		Возврат Окр(XMLЗначение(Тип("Число"), Текст) / 10, 2);
	ИначеЕсли Конвертер = "Проценты" Тогда
		Возврат Окр(XMLЗначение(Тип("Число"), Текст) * 100, 2);
	ИначеЕсли Конвертер = "Время" Тогда
		Возврат ВремяИзXML(Текст);
	ИначеЕсли Конвертер = "День" Тогда
		Возврат ДеньИзMSPDI(XMLЗначение(Тип("Число"), Текст));
	ИначеЕсли Конвертер = "Инверсия" Тогда
		Возврат Не XMLЗначение(Тип("Булево"), Текст);
	Иначе
		Возврат Текст;
	КонецЕсли;

КонецФункции

// ISO 8601 длительность ("PT8H0M0S", "PT40H30M") -> рабочие минуты.
// Часы в MSPDI - рабочие часы проекта, минуты и секунды - астрономические доли часа.
Функция МинутыИзДлительности(Строка)

	Текст = ВРег(СокрЛП(Строка));
	Если Текст = "" Тогда
		Возврат 0;
	КонецЕсли;
	Текст = СтрЗаменить(Текст, "PT", "");

	Возврат Окр(ЧислоДоБуквы(Текст, "H") * 60 + ЧислоДоБуквы(Текст, "M") + ЧислоДоБуквы(Текст, "S") / 60, 2);

КонецФункции

// Число перед буквой-маркером ("8H" -> 8); маркеры H, M, S.
Функция ЧислоДоБуквы(Текст, Буква)

	Позиция = СтрНайти(Текст, Буква);
	Если Позиция = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Начало = 1;
	Для Каждого Маркер Из МаркерыДлительности() Цикл
		ПозицияМаркера = СтрНайти(Текст, Маркер);
		Если ПозицияМаркера > 0 И ПозицияМаркера < Позиция Тогда
			Начало = ПозицияМаркера + СтрДлина(Маркер);
		КонецЕсли;
	КонецЦикла;

	Фрагмент = Сред(Текст, Начало, Позиция - Начало);
	Если Фрагмент = "" Тогда
		Возврат 0;
	КонецЕсли;
	Возврат XMLЗначение(Тип("Число"), Фрагмент);

КонецФункции

Функция МаркерыДлительности()

	Маркеры = Новый Массив;
	Маркеры.Добавить("H");
	Маркеры.Добавить("M");
	Маркеры.Добавить("S");
	Возврат Маркеры;

КонецФункции

// xsd:time ("T08:00:00") -> Дата без даты (1 января 1 года, время сохранено).
Функция ВремяИзXML(Строка)

	Текст = СтрЗаменить(СокрЛП(Строка), "T", "");
	Части = СтрРазделить(Текст, ":", Ложь);
	Часы = ?(Части.Количество() > 0, XMLЗначение(Тип("Число"), Части[0]), 0);
	Минуты = ?(Части.Количество() > 1, XMLЗначение(Тип("Число"), Части[1]), 0);
	Секунды = ?(Части.Количество() > 2, XMLЗначение(Тип("Число"), Части[2]), 0);
	Возврат Дата(1, 1, 1, Часы, Минуты, Секунды);

КонецФункции

// День недели MSPDI (1=вс..7=сб) -> день 1С (1=пн..7=вс), см. раздел 6.5.
Функция ДеньИзMSPDI(ДеньMSPDI)

	Смещение = ДеньMSPDI + 5; // = ДеньMSPDI - 2 + 7, всегда неотрицательно при 1..7
	Возврат Смещение - Цел(Смещение / 7) * 7 + 1;

КонецФункции

