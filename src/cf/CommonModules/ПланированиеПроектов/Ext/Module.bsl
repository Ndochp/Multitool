// Расчёт расписания подсистемы Проджект: метод критического пути (CPM),
// как в MS Project (см. doc/MultitoolDoc/Проджект/Проджект.md, разделы 4.2-4.3).
//
// Чистый движок: работает над структурами, не знает о базе данных, формах
// и обмене (гексагональное разделение, раздел 5 документации).
//
// Вход:
//   Задачи - Массив из Структура:
//     Ключ           - произвольный уникальный ключ задачи (ссылка, число, строка)
//     Родитель       - ключ сводной задачи (не заполнен - корневая)
//     Duration       - Число - длительность в рабочих минутах (0 - веха)
//     Calendar       - Структура - календарь задачи (КалендариПроектов);
//                      не заполнен - календарь проекта
//     ConstraintType - Число - 0=ASAP, 1=ALAP, 2=SNET, 3=SNLT, 4=FNET,
//                      5=FNLT, 6=MSO, 7=MFO
//     ConstraintDate - Дата    - дата ограничения
//     LevelingDelay  - Число   - задержка выравнивания в рабочих минутах
//     Predecessors   - Массив из Структура {Task, Type, Lag}: Task - ключ
//                      предшественника, Type - 0=FF, 1=FS, 2=SF, 3=SS
//                      (v1 считает все связи FS), Lag - рабочие минуты
//   Проект - Структура:
//     Calendar - Структура - календарь проекта
//     Start    - Дата      - старт проекта (не заполнен - текущие сутки)
//
// Выход (РассчитатьРасписание): Соответствие Ключ -> Структура
//   ES, EF          - раннее начало/окончание (Дата)
//   LS, LF          - позднее начало/окончание (Дата)
//   Start, Finish   - плановые даты: ES/EF, для ALAP - LS/LF
//   TotalSlack      - общий резерв, рабочие минуты (отрицательный -> 0)
//   FreeSlack       - свободный резерв, рабочие минуты
//   Critical        - Булево - TotalSlack <= 0
//   SummaryDuration - рабочие минуты между Start и Finish у сводной (иначе 0)
//
// Ограничения v1 (отчёт ночной сессии, Проджект.md раздел 8):
//   сводная задача игнорирует собственные предшественников (агрегация детей);
//   elapsed-длительности не поддерживаются; связи != FS трактуются как FS
//   (предупреждение выдаёт импорт, Р9).

#Область ПрограммныйИнтерфейс

// Рассчитывает расписание: прямой и обратный проход CPM.
//
// Параметры:
//   Задачи - Массив из Структура - описания задач (см. шапку модуля)
//   Проект - Структура - календарь и старт проекта (см. шапку модуля)
//
// Возвращаемое значение:
//   Соответствие - Ключ задачи -> результат расчёта (см. шапку модуля)
//
Функция РассчитатьРасписание(Задачи, Проект) Экспорт

	Индексы = ИндексыЗадач(Задачи, Проект);

	Состояние = СостояниеРасчёта();

	Для Каждого Задача Из Задачи Цикл
		РанниеДляЗадачи(Индексы, Состояние, Задача.Ключ);
	КонецЦикла;

	LFПроекта = ПозднийФинишПроекта(Индексы, Состояние);
	Состояние.LFПроекта = LFПроекта;

	Для Каждого Задача Из Задачи Цикл
		ПоздниеДляЗадачи(Индексы, Состояние, Задача.Ключ);
	КонецЦикла;

	Возврат РезультатыЗадач(Индексы, Состояние);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Индексы: задачи по ключу, дети сводных, преемники по связям.
Функция ИндексыЗадач(Задачи, Проект)

	ПоКлючу = Новый Соответствие;
	Для Каждого Задача Из Задачи Цикл
		ПоКлючу.Вставить(Задача.Ключ, Задача);
	КонецЦикла;

	Дети = Новый Соответствие;
	Для Каждого Задача Из Задачи Цикл
		Если ЗначениеЗаполнено(Задача.Родитель) И ПоКлючу.Получить(Задача.Родитель) <> Неопределено Тогда
			ДобавитьВКлюч(Дети, Задача.Родитель, Задача.Ключ);
		КонецЕсли;
	КонецЦикла;

	Преемники = Новый Соответствие;
	Для Каждого Задача Из Задачи Цикл
		Для Каждого Связь Из ПредшественникиЗадачи(Задача) Цикл
			Если ПоКлючу.Получить(Связь.Task) = Неопределено Тогда
				ВызватьИсключение СтрШаблон("Предшественник %1 задачи %2 не найден",
					Связь.Task, Задача.Ключ);
			КонецЕсли;
			Преемник = Новый Структура("Задача, Lag", Задача.Ключ, LagСвязи(Связь));
			ДобавитьВКлюч(Преемники, Связь.Task, Преемник);
		КонецЦикла;
	КонецЦикла;

	Возврат Новый Структура("Задачи, ПоКлючу, Дети, Преемники, КалендарьПроекта, НачалоПроекта",
		Задачи, ПоКлючу, Дети, Преемники, Проект.Calendar, НачалоПроекта(Проект));

КонецФункции

// Старт проекта: явный Start, иначе - текущие сутки.
Функция НачалоПроекта(Проект)

	Старт = Неопределено;
	Проект.Свойство("Start", Старт);
	Если ЗначениеЗаполнено(Старт) Тогда
		Возврат Старт;
	КонецЕсли;

	Возврат НачалоДня(ТекущаяДатаСеанса());

КонецФункции

// Добавляет значение в массив по ключу соответствия, создавая массив при необходимости.
Процедура ДобавитьВКлюч(Приёмник, Ключ, Значение)

	Список = Приёмник.Получить(Ключ);
	Если Список = Неопределено Тогда
		Список = Новый Массив;
		Приёмник.Вставить(Ключ, Список);
	КонецЕсли;
	Список.Добавить(Значение);

КонецПроцедуры

Функция СостояниеРасчёта()

	Возврат Новый Структура("Ранние, Поздние, ВРасчёте, ВРасчётеПоздних, LFПроекта",
		Новый Соответствие, Новый Соответствие, Новый Соответствие, Новый Соответствие, Неопределено);

КонецФункции

// Наибольшая дата массива (Макс по датам, Неопределено игнорируется).
Функция МаксимальнаяДата(Даты)

	Максимум = Неопределено;
	Для Каждого Дата Из Даты Цикл
		Если Дата = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Максимум = Неопределено Или Дата > Максимум Тогда
			Максимум = Дата;
		КонецЕсли;
	КонецЦикла;

	Возврат Максимум;

КонецФункции

// Наименьшая дата массива (Мин по датам, Неопределено игнорируется).
Функция МинимальнаяДата(Даты)

	Минимум = Неопределено;
	Для Каждого Дата Из Даты Цикл
		Если Дата = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Минимум = Неопределено Или Дата < Минимум Тогда
			Минимум = Дата;
		КонецЕсли;
	КонецЦикла;

	Возврат Минимум;

КонецФункции

// Ранние даты задачи (с мемоизацией и защитой от циклов).
Функция РанниеДляЗадачи(Индексы, Состояние, Ключ)

	Готово = Состояние.Ранние.Получить(Ключ);
	Если Готово <> Неопределено Тогда
		Возврат Готово;
	КонецЕсли;

	Если Состояние.ВРасчёте.Получить(Ключ) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("Циклическая связь задач: %1", Ключ);
	КонецЕсли;
	Состояние.ВРасчёте.Вставить(Ключ, Истина);

	Задача = Индексы.ПоКлючу.Получить(Ключ);
	Если ЭтоСводная(Индексы, Ключ) Тогда
		Результат = РаннееСводной(Индексы, Состояние, Задача);
	Иначе
		Результат = РаннееОбычной(Индексы, Состояние, Задача);
	КонецЕсли;

	Состояние.ВРасчёте.Удалить(Ключ);
	Состояние.Ранние.Вставить(Ключ, Результат);

	Возврат Результат;

КонецФункции

// Прямой проход обычной задачи: ES = max(связи FS, ограничения SNET/FNET/MSO,
// старт проекта), приведённый к рабочему моменту календаря задачи, + LevelingDelay.
Функция РаннееОбычной(Индексы, Состояние, Задача)

	Календарь = КалендарьЗадачи(Индексы, Задача);

	Кандидаты = Новый Массив;
	ДобавитьКандидатыСвязей(Индексы, Состояние, Задача, Кандидаты);
	ДобавитьКандидатыОграничений(Задача, Кандидаты);
	Если Кандидаты.Количество() = 0 Тогда
		Кандидаты.Добавить(Индексы.НачалоПроекта);
	КонецЕсли;

	ES = КалендариПроектов.СледующийРабочийМомент(Календарь, МаксимальнаяДата(Кандидаты));

	Задержка = ЗадержкаВыравниванияЗадачи(Задача);
	Если Задержка > 0 Тогда
		ES = КалендариПроектов.ДобавитьРабочиеМинуты(Календарь, ES, Задержка);
	КонецЕсли;

	EF = ФинишПоДлительности(Календарь, ES, ДлительностьЗадачи(Задача));

	Возврат Новый Структура("ES, EF", ES, EF);

КонецФункции

// Сводная задача: ES = min(дети), EF = max(дети); собственные предшественники игнорируются.
Функция РаннееСводной(Индексы, Состояние, Задача)

	ДатыES = Новый Массив;
	ДатыEF = Новый Массив;
	Для Каждого КлючРебёнка Из Индексы.Дети.Получить(Задача.Ключ) Цикл
		Ребёнок = РанниеДляЗадачи(Индексы, Состояние, КлючРебёнка);
		ДатыES.Добавить(Ребёнок.ES);
		ДатыEF.Добавить(Ребёнок.EF);
	КонецЦикла;

	Возврат Новый Структура("ES, EF", МинимальнаяДата(ДатыES), МаксимальнаяДата(ДатыEF));

КонецФункции

// Кандидаты ES от предшественников: EF предшественника + Lag рабочими минутами
// календаря задачи (связи v1 трактуются как FS).
Процедура ДобавитьКандидатыСвязей(Индексы, Состояние, Задача, Кандидаты)

	Календарь = КалендарьЗадачи(Индексы, Задача);
	Для Каждого Связь Из ПредшественникиЗадачи(Задача) Цикл
		Ранняя = РанниеДляЗадачи(Индексы, Состояние, Связь.Task);
		Кандидаты.Добавить(КалендариПроектов.ДобавитьРабочиеМинуты(Календарь, Ранняя.EF, LagСвязи(Связь)));
	КонецЦикла;

КонецПроцедуры

// Кандидаты ES от ограничений SNET/FNET/MSO (SNLT/FNLT/MFO учитываются на обратном проходе).
Процедура ДобавитьКандидатыОграничений(Задача, Кандидаты)

	Тип = ОграничениеЗадачи(Задача);
	Если Тип <> 2 И Тип <> 4 И Тип <> 6 Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОграничениеДатаЗадачи(Задача)) Тогда
		Кандидаты.Добавить(ОграничениеДатаЗадачи(Задача));
	КонецЕсли;

КонецПроцедуры

// Поздний финиш проекта: наибольший EF обычных задач.
Функция ПозднийФинишПроекта(Индексы, Состояние)

	Даты = Новый Массив;
	Для Каждого Задача Из Индексы.Задачи Цикл
		Если ЭтоСводная(Индексы, Задача.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Даты.Добавить(РанниеДляЗадачи(Индексы, Состояние, Задача.Ключ).EF);
	КонецЦикла;

	Возврат МаксимальнаяДата(Даты);

КонецФункции

// Поздние даты и резервы задачи (с мемоизацией и защитой от циклов).
// LF проекта берётся из состояния - он одинаков для всех задач.
Функция ПоздниеДляЗадачи(Индексы, Состояние, Ключ)

	Готово = Состояние.Поздние.Получить(Ключ);
	Если Готово <> Неопределено Тогда
		Возврат Готово;
	КонецЕсли;

	Если Состояние.ВРасчётеПоздних.Получить(Ключ) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("Циклическая связь задач: %1", Ключ);
	КонецЕсли;
	Состояние.ВРасчётеПоздних.Вставить(Ключ, Истина);

	Задача = Индексы.ПоКлючу.Получить(Ключ);
	Ранняя = РанниеДляЗадачи(Индексы, Состояние, Ключ);

	Если ЭтоСводная(Индексы, Ключ) Тогда
		Результат = ПозднееСводной(Индексы, Состояние, Задача);
	Иначе
		Результат = ПозднееОбычной(Индексы, Состояние, Задача, Ранняя);
	КонецЕсли;

	Состояние.ВРасчётеПоздних.Удалить(Ключ);
	Состояние.Поздние.Вставить(Ключ, Результат);

	Возврат Результат;

КонецФункции

// Обратный проход обычной задачи: LF = min(старты преемников - Lag, ограничения
// SNLT/FNLT/MFO, финиш проекта); LS = LF - Duration рабочими минутами.
Функция ПозднееОбычной(Индексы, Состояние, Задача, Ранняя)

	Календарь = КалендарьЗадачи(Индексы, Задача);
	Длительность = ДлительностьЗадачи(Задача);

	Кандидаты = Новый Массив;
	Кандидаты.Добавить(Состояние.LFПроекта);
	ДобавитьКандидатыПозднегоФиниша(Индексы, Состояние, Задача, Кандидаты);
	LF = МинимальнаяДата(Кандидаты);

	LS = ?(Длительность > 0, КалендариПроектов.ОтнятьРабочиеМинуты(Календарь, LF, Длительность), LF);

	ОбщийРезерв = КалендариПроектов.РабочиеМинутыМежду(Календарь, Ранняя.ES, LS);
	Свободный = СвободныйРезервЗадачи(Индексы, Состояние, Задача, Ранняя);

	Возврат Новый Структура("LS, LF, TotalSlack, FreeSlack, Critical",
		LS, LF, Макс(ОбщийРезерв, 0), Свободный, ОбщийРезерв <= 0);

КонецФункции

// Сводная: LF = max(дети), LS = min(дети); резервы - по собственным ES/LS.
Функция ПозднееСводной(Индексы, Состояние, Задача)

	ДатыLF = Новый Массив;
	ДатыLS = Новый Массив;
	Для Каждого КлючРебёнка Из Индексы.Дети.Получить(Задача.Ключ) Цикл
		Ребёнок = ПоздниеДляЗадачи(Индексы, Состояние, КлючРебёнка);
		ДатыLF.Добавить(Ребёнок.LF);
		ДатыLS.Добавить(Ребёнок.LS);
	КонецЦикла;

	Ранняя = РанниеДляЗадачи(Индексы, Состояние, Задача.Ключ);
	Календарь = КалендарьЗадачи(Индексы, Задача);
	ОбщийРезерв = КалендариПроектов.РабочиеМинутыМежду(Календарь, Ранняя.ES, МинимальнаяДата(ДатыLS));

	Возврат Новый Структура("LS, LF, TotalSlack, FreeSlack, Critical",
		МинимальнаяДата(ДатыLS), МаксимальнаяДата(ДатыLF), Макс(ОбщийРезерв, 0), 0, ОбщийРезерв <= 0);

КонецФункции

// Кандидаты LF: старт каждого преемника минус Lag рабочими минутами календаря
// преемника, плюс ограничения SNLT (старт <= дата) / FNLT, MFO (финиш <= дата).
Процедура ДобавитьКандидатыПозднегоФиниша(Индексы, Состояние, Задача, Кандидаты)

	Для Каждого Преемник Из ПреемникиЗадачи(Индексы, Задача.Ключ) Цикл
		ЗадачаПреемника = Индексы.ПоКлючу.Получить(Преемник.Задача);
		ПозднийПреемник = ПоздниеДляЗадачи(Индексы, Состояние, Преемник.Задача);
		КалендарьПреемника = КалендарьЗадачи(Индексы, ЗадачаПреемника);
		Кандидаты.Добавить(КалендариПроектов.ОтнятьРабочиеМинуты(
			КалендарьПреемника, ПозднийПреемник.LS, Преемник.Lag));
	КонецЦикла;

	Тип = ОграничениеЗадачи(Задача);
	Дата = ОграничениеДатаЗадачи(Задача);
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат;
	КонецЕсли;
	Если Тип = 3 Тогда
		Кандидаты.Добавить(КалендариПроектов.ДобавитьРабочиеМинуты(
			КалендарьЗадачи(Индексы, Задача), Дата, ДлительностьЗадачи(Задача)));
	КонецЕсли;
	Если Тип = 5 ИЛИ Тип = 7 Тогда
		Кандидаты.Добавить(Дата);
	КонецЕсли;

КонецПроцедуры

// Свободный резерв: минимум рабочих минут от EF до ES каждого преемника.
Функция СвободныйРезервЗадачи(Индексы, Состояние, Задача, Ранняя)

	Минимум = Неопределено;
	Для Каждого Преемник Из ПреемникиЗадачи(Индексы, Задача.Ключ) Цикл
		РаннийПреемник = РанниеДляЗадачи(Индексы, Состояние, Преемник.Задача);
		Резерв = КалендариПроектов.РабочиеМинутыМежду(
			КалендарьЗадачи(Индексы, Задача), Ранняя.EF, РаннийПреемник.ES);
		Если Минимум = Неопределено Или Резерв < Минимум Тогда
			Минимум = Резерв;
		КонецЕсли;
	КонецЦикла;

	Если Минимум = Неопределено Тогда
		Возврат 0; // преемников нет - свободный резерв не считается
	КонецЕсли;
	Если Минимум < 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Минимум;

КонецФункции

// Преемники задачи из индекса (пустой массив, если их нет).
Функция ПреемникиЗадачи(Индексы, Ключ)

	Список = Индексы.Преемники.Получить(Ключ);
	Если Список = Неопределено Тогда
		Список = Новый Массив;
	КонецЕсли;

	Возврат Список;

КонецФункции

// Итоговое соответствие: даты, резервы, признак критичности, сводная длительность.
Функция РезультатыЗадач(Индексы, Состояние)

	Результат = Новый Соответствие;
	Для Каждого Задача Из Индексы.Задачи Цикл
		Ранняя = Состояние.Ранние.Получить(Задача.Ключ);
		Поздняя = Состояние.Поздние.Получить(Задача.Ключ);
		ALAP = ОграничениеЗадачи(Задача) = 1;

		Начало = ?(ALAP, Поздняя.LS, Ранняя.ES);
		Окончание = ?(ALAP, Поздняя.LF, Ранняя.EF);
		СводнаяДлительность = 0;
		Если ЭтоСводная(Индексы, Задача.Ключ) Тогда
			СводнаяДлительность = КалендариПроектов.РабочиеМинутыМежду(
				КалендарьЗадачи(Индексы, Задача), Начало, Окончание);
		КонецЕсли;

		Результат.Вставить(Задача.Ключ, Новый Структура(
			"ES, EF, LS, LF, Start, Finish, TotalSlack, FreeSlack, Critical, SummaryDuration",
			Ранняя.ES, Ранняя.EF, Поздняя.LS, Поздняя.LF, Начало, Окончание,
			Поздняя.TotalSlack, Поздняя.FreeSlack, Поздняя.Critical, СводнаяДлительность));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЭтоСводная(Индексы, Ключ)

	ДетиЗадачи = Индексы.Дети.Получить(Ключ);
	Возврат ДетиЗадачи <> Неопределено И ДетиЗадачи.Количество() > 0;

КонецФункции

// Календарь задачи, а при отсутствии - календарь проекта.
Функция КалендарьЗадачи(Индексы, Задача)

	Календарь = Неопределено;
	Задача.Свойство("Calendar", Календарь);
	Если ЗначениеЗаполнено(Календарь) Тогда
		Возврат Календарь;
	КонецЕсли;

	Возврат Индексы.КалендарьПроекта;

КонецФункции

Функция ФинишПоДлительности(Календарь, Начало, Длительность)

	Если Длительность > 0 Тогда
		Возврат КалендариПроектов.ДобавитьРабочиеМинуты(Календарь, Начало, Длительность);
	КонецЕсли;

	Возврат Начало; // веха: начало и конец совпадают

КонецФункции

Функция ДлительностьЗадачи(Задача)

	Длительность = 0;
	Задача.Свойство("Duration", Длительность);
	Возврат Длительность;

КонецФункции

Функция ОграничениеЗадачи(Задача)

	Тип = 0;
	Задача.Свойство("ConstraintType", Тип);
	Возврат Тип;

КонецФункции

Функция ОграничениеДатаЗадачи(Задача)

	Дата = Неопределено;
	Задача.Свойство("ConstraintDate", Дата);
	Возврат Дата;

КонецФункции

Функция ЗадержкаВыравниванияЗадачи(Задача)

	Задержка = 0;
	Задача.Свойство("LevelingDelay", Задержка);
	Возврат Задержка;

КонецФункции

Функция ПредшественникиЗадачи(Задача)

	Список = Новый Массив;
	Задача.Свойство("Predecessors", Список);
	Возврат Список;

КонецФункции

Функция LagСвязи(Связь)

	Lag = 0;
	Связь.Свойство("Lag", Lag);
	Возврат Lag;

КонецФункции

#КонецОбласти
