// Сводные задачи подсистемы Проджект (п.4 роадмапа).
//
// Чистые функции поверх иерархии задач (Ключ/Родитель) и календарной математики
// КалендариПроектов: агрегация дат/длительности сводных задач по потомкам и
// построение структуры WBS. База данных не используется.
//
// Контракт задачи (как в ПланированиеПроектов и ВыравниваниеРесурсов):
//   Ключ     - ключ задачи в массиве;
//   Родитель - ключ родительской сводной задачи ("" - корень иерархии);
//   Calendar - календарь задачи (опционально; иначе календарь проекта).
// Родитель, отсутствующий в массиве, считается корнем (задача - верхний уровень).
//
// Агрегировать принимает Расписание - Соответствие Ключ -> {Start, Finish}
// для листьев (результат ПланированиеПроектов.РассчитатьРасписание либо
// даты импортированного проекта).
//
// Ограничения v1:
//   - агрегируются только даты и длительность (трудозатраты и проценты - нет);
//   - сводная без потомков считается обычной задачей и не агрегируется;
//   - Duration сводной - рабочие минуты между агрегированными Start и Finish
//     по её календарю (как в MS Project);
//   - WBS сводной равен OutlineNumber (пользовательский WBS не поддерживается).

#Область ПрограммныйИнтерфейс

// Агрегирует даты сводных задач по датам потомков (снизу вверх).
//
// Параметры:
//   Задачи     - Массив из Структура - контракт см. шапку модуля
//   Расписание - Соответствие       - Ключ -> {Start, Finish} для листьев
//   Проект     - Структура          - {Calendar} (см. шапку ПланированиеПроектов)
//
// Возвращаемое значение:
//   Соответствие - КлючСводной -> Структура {Start, Finish, Duration};
//                  Duration - рабочие минуты между Start и Finish
//
Функция Агрегировать(Задачи, Расписание, Проект) Экспорт

	ПроверитьИерархию(Задачи);
	Дети = ДетиЗадач(Задачи);
	Результат = Новый Соответствие;

	Для Каждого Задача Из Задачи Цикл
		Если Дети.Получить(Задача.Ключ) <> Неопределено Тогда
			ДатыСводной(Задача, Дети, Расписание, Проект, Результат);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строит структуру WBS по иерархии и порядку массива.
//
// Параметры:
//   Задачи - Массив из Структура - контракт см. шапку модуля
//
// Возвращаемое значение:
//   Соответствие - Ключ -> Структура:
//     * ID            - Число  - позиция в массиве, начиная с 1
//     * OutlineLevel  - Число  - глубина иерархии, корень = 1
//     * OutlineNumber - Строка - "N" у корня, "<номер родителя>.N" у потомка
//     * WBS           - Строка - равен OutlineNumber (ограничение v1)
//
Функция СтруктураWBS(Задачи) Экспорт

	ПроверитьИерархию(Задачи);
	ПоКлючу = ИндексЗадач(Задачи);
	Позиции = ПозицииСредиБратьев(Задачи);
	Номера = Новый Соответствие;
	Результат = Новый Соответствие;
	Счётчик = 0;

	Для Каждого Задача Из Задачи Цикл
		Счётчик = Счётчик + 1;
		Номер = НомерЗадачи(Задача, ПоКлючу, Позиции, Номера);
		Результат.Вставить(Задача.Ключ, Новый Структура("ID, OutlineLevel, OutlineNumber, WBS",
			Счётчик, ГлубинаЗадачи(Задача, ПоКлючу) + 1, Номер, Номер));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Контракт: иерархия без циклов (родитель может идти после потомка).
Процедура ПроверитьИерархию(Задачи)

	ПоКлючу = ИндексЗадач(Задачи);
	Для Каждого Задача Из Задачи Цикл
		Шаги = 0;
		Текущий = Задача;
		Пока Истина Цикл
			КлючРодителя = КлючРодителя(Текущий);
			Если КлючРодителя = "" Тогда
				Прервать;
			КонецЕсли;
			Шаги = Шаги + 1;
			Если Шаги > 100 Тогда
				ВызватьИсключение СтрШаблон("Цикл в иерархии задач у '%1'", Задача.Ключ);
			КонецЕсли;
			Текущий = ПоКлючу.Получить(КлючРодителя);
			Если Текущий = Неопределено Тогда
				Прервать; // родитель вне массива - ветка считается корневой
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Даты сводной: минимум Start и максимум Finish по потомкам (рекурсивно).
Функция ДатыСводной(Задача, Дети, Расписание, Проект, Результат)

	Уже = Результат.Получить(Задача.Ключ);
	Если Уже <> Неопределено Тогда
		Возврат Уже;
	КонецЕсли;

	Начало = Неопределено;
	Конец = Неопределено;
	Для Каждого Дитя Из Дети.Получить(Задача.Ключ) Цикл
		ДатыДитя = ДатыПотомка(Дитя, Дети, Расписание, Проект, Результат);
		Если Начало = Неопределено ИЛИ ДатыДитя.Start < Начало Тогда
			Начало = ДатыДитя.Start;
		КонецЕсли;
		Если Конец = Неопределено ИЛИ ДатыДитя.Finish > Конец Тогда
			Конец = ДатыДитя.Finish;
		КонецЕсли;
	КонецЦикла;

	Календарь = КалендарьЗадачи(Задача, Проект);
	Итог = Новый Структура("Start, Finish, Duration",
		Начало, Конец, КалендариПроектов.РабочиеМинутыМежду(Календарь, Начало, Конец));
	Результат.Вставить(Задача.Ключ, Итог);
	Возврат Итог;

КонецФункции

// Даты потомка: вычисленные (сводная) либо из расписания (лист).
Функция ДатыПотомка(Дитя, Дети, Расписание, Проект, Результат)

	Если Дети.Получить(Дитя.Ключ) <> Неопределено Тогда
		Возврат ДатыСводной(Дитя, Дети, Расписание, Проект, Результат);
	КонецЕсли;

	Даты = Расписание.Получить(Дитя.Ключ);
	Если Даты = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Задача '%1' отсутствует в расписании (листу нужны Start/Finish)",
			Дитя.Ключ);
	КонецЕсли;

	Возврат Даты;

КонецФункции

// Номер задачи: у корня "N", у потомка "<номер родителя>.N" (рекурсивно).
Функция НомерЗадачи(Задача, ПоКлючу, Позиции, Номера)

	Уже = Номера.Получить(Задача.Ключ);
	Если Уже <> Неопределено Тогда
		Возврат Уже;
	КонецЕсли;

	Позиция = Формат(Позиции.Получить(Задача.Ключ), "ЧГ=0");
	КлючРодителя = КлючРодителя(Задача);
	Родитель = ПоКлючу.Получить(КлючРодителя);
	Если КлючРодителя = "" ИЛИ Родитель = Неопределено Тогда
		Номер = Позиция;
	Иначе
		Номер = НомерЗадачи(Родитель, ПоКлючу, Позиции, Номера) + "." + Позиция;
	КонецЕсли;

	Номера.Вставить(Задача.Ключ, Номер);
	Возврат Номер;

КонецФункции

// Позиция задачи среди "братьев" (одинаковый Родитель) в порядке массива.
Функция ПозицииСредиБратьев(Задачи)

	Счётчики = Новый Соответствие;
	Позиции = Новый Соответствие;
	Для Каждого Задача Из Задачи Цикл
		КлючРодителя = КлючРодителя(Задача);
		Позиция = Счётчики.Получить(КлючРодителя);
		Если Позиция = Неопределено Тогда
			Позиция = 0;
		КонецЕсли;
		Позиция = Позиция + 1;
		Счётчики.Вставить(КлючРодителя, Позиция);
		Позиции.Вставить(Задача.Ключ, Позиция);
	КонецЦикла;

	Возврат Позиции;

КонецФункции

// Глубина иерархии: корень = 0.
Функция ГлубинаЗадачи(Задача, ПоКлючу)

	Глубина = 0;
	Текущий = Задача;
	Пока Истина Цикл
		КлючРодителя = КлючРодителя(Текущий);
		Если КлючРодителя = "" Тогда
			Прервать;
		КонецЕсли;
		Родитель = ПоКлючу.Получить(КлючРодителя);
		Если Родитель = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Глубина = Глубина + 1;
		Текущий = Родитель;
	КонецЦикла;

	Возврат Глубина;

КонецФункции

// Соответствие Ключ -> Массив дочерних задач (в порядке массива).
Функция ДетиЗадач(Задачи)

	Дети = Новый Соответствие;
	Для Каждого Задача Из Задачи Цикл
		КлючРодителя = КлючРодителя(Задача);
		Если КлючРодителя = "" Тогда
			Продолжить;
		КонецЕсли;
		Ветка = Дети.Получить(КлючРодителя);
		Если Ветка = Неопределено Тогда
			Ветка = Новый Массив;
			Дети.Вставить(КлючРодителя, Ветка);
		КонецЕсли;
		Ветка.Добавить(Задача);
	КонецЦикла;

	Возврат Дети;

КонецФункции

// Соответствие Ключ -> Задача (при дублях ключа побеждает последняя).
Функция ИндексЗадач(Задачи)

	ПоКлючу = Новый Соответствие;
	Для Каждого Задача Из Задачи Цикл
		ПоКлючу.Вставить(Задача.Ключ, Задача);
	КонецЦикла;

	Возврат ПоКлючу;

КонецФункции

Функция КлючРодителя(Задача)

	Значение = ЗначениеСвойства(Задача, "Родитель", "");
	Возврат ?(Значение = Неопределено, "", Значение);

КонецФункции

// Календарь задачи: свой, иначе календарь проекта.
Функция КалендарьЗадачи(Задача, Проект)

	Календарь = ЗначениеСвойства(Задача, "Calendar", Неопределено);
	Если Календарь <> Неопределено Тогда
		Возврат Календарь;
	КонецЕсли;

	Возврат Проект.Calendar;

КонецФункции

// Свойство структуры/соответствия или значение по умолчанию.
Функция ЗначениеСвойства(Источник, Имя, Пустое)

	ТипИсточник = ТипЗнч(Источник);
	Если ТипИсточник = Тип("Структура") Тогда
		Если Источник.Свойство(Имя) Тогда
			Возврат Источник[Имя];
		КонецЕсли;
	ИначеЕсли ТипИсточник = Тип("Соответствие") Тогда
		Значение = Источник.Получить(Имя);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	Иначе
		Возврат Пустое;
	КонецЕсли;

	Возврат Пустое;

КонецФункции

#КонецОбласти
