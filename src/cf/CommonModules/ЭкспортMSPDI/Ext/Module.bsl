// Экспорт MSPDI (продолжение п.7): справочники базы -> структуры контракта
// ОбменMSProject (обратная к ИмпортMSPDI.Загрузить сборка). Полный круг:
// ОбменMSProject.Записать(ЭкспортMSPDI.Выгрузить(Проект)) -> текст MSPDI.
//
// Календари не привязаны к проекту напрямую (ГрафикиРаботы - свободный
// каталог), поэтому собираются по ссылкам: календарь проекта, календари
// ресурсов и работ, дедупликация по UID. Плоские колонки интервалов дня
// (FromTime1..ToTime3) сворачиваются обратно в массив пар; пустые даты
// реквизитов конвертируются в Неопределено (узел не пишется, см. Записать).
//
// Ограничения v1: рекуррентные исключения календаря в базе не хранятся
// (пропускались при импорте) и не восстанавливаются; нули числовых
// реквизитов выгружаются как есть (0), Неопределено возвращается только
// для пустых дат и незаполненных строк.

#Область ПрограммныйИнтерфейс

// Собирает структуры для ОбменMSProject.Записать из справочников проекта.
//
// Параметры:
//   Проект - СправочникСсылка.Проект
//
// Возвращаемое значение:
//   Структура - тот же контракт, что у ОбменMSProject.Разобрать:
//   {Проект, Календари, Задачи, Ресурсы, Назначения}
//
Функция Выгрузить(Проект) Экспорт

	Состояния = СоответствиеСостоянийРабот(Проект);
	ДанныеПроекта = ДанныеПроектаИзБазы(Проект);
	Календари = КалендариПроекта(Проект, Состояния);
	СписокЗадач = РаботыВЗадачи(Состояния);
	Ресурсы = РесурсыВРесурсы(Проект);
	Назначения = НазначенияИзТЧ(Состояния);

	Возврат Новый Структура("Проект, Календари, Задачи, Ресурсы, Назначения",
		ДанныеПроекта, Календари, СписокЗадач, Ресурсы, Назначения);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеПроектаИзБазы(Проект)

	Объект = Проект.ПолучитьОбъект();
	Возврат Новый Структура("UID, Name, StartDate, FinishDate, MinutesPerDay,
		|MinutesPerWeek, DaysPerMonth, CurrencyCode, CurrencySymbol, CalendarUID",
		Объект.UID,
		Объект.Наименование,
		ПустаяДатаВНеопределено(Объект.StartDate),
		ПустаяДатаВНеопределено(Объект.FinishDate),
		Объект.MinutesPerDay,
		Объект.MinutesPerWeek,
		Объект.DaysPerMonth,
		Объект.CurrencyCode,
		Объект.CurrencySymbol,
		УидСтроки(Объект.Calendar));

КонецФункции

// Календари по ссылкам проекта/ресурсов/работ, дедупликация по UID.
Функция КалендариПроекта(Проект, Состояния)

	УжеВзяты = Новый Соответствие;
	СписокКалендарей = Новый Массив;
	Ссылки = Новый Массив;
	Ссылки.Добавить(Проект.ПолучитьОбъект().Calendar);
	Для Каждого Состояние Из Состояния Цикл
		Ссылки.Добавить(Состояние.Calendar);
	КонецЦикла;
	РесурсыБазы = РесурсыПроекта(Проект);
	Для Каждого РесурсБазы Из РесурсыБазы Цикл
		Ссылки.Добавить(РесурсБазы.Calendar);
	КонецЦикла;

	Для Каждого Ссылка Из Ссылки Цикл
		Если Ссылка.Пустая() ИЛИ УжеВзяты.Получить(Ссылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеВзяты.Вставить(Ссылка, Истина);
		СписокКалендарей.Добавить(КалендарьИзБазы(Ссылка));
	КонецЦикла;

	Возврат СписокКалендарей;

КонецФункции

Функция КалендарьИзБазы(Ссылка)

	Объект = Ссылка.ПолучитьОбъект();
	Календарь = Новый Структура("UID, Name, IsBaseCalendar, BaseCalendarUID,
		|WeekDays, Exceptions",
		Объект.UID,
		Объект.Наименование,
		Объект.IsBaseCalendar,
		УидСтроки(Объект.BaseCalendar),
		Новый Массив,
		Новый Массив);

	Для Каждого СтрокаДня Из Объект.WeekDays Цикл
		Календарь.WeekDays.Добавить(ДеньИзБазы(СтрокаДня));
	КонецЦикла;
	Для Каждого СтрокаИсключения Из Объект.Exceptions Цикл
		ИсключениеКалендаря = Новый Структура("Name, FromDate, ToDate, DayWorking, Тип, Интервалы",
			СтрокаИсключения.Name,
			ПустаяДатаВНеопределено(СтрокаИсключения.FromDate),
			ПустаяДатаВНеопределено(СтрокаИсключения.ToDate),
			СтрокаИсключения.DayWorking,
			СтрокаИсключения.Type,
			ИнтервалыИзКолонок(СтрокаИсключения));
		Календарь.Exceptions.Добавить(ИсключениеКалендаря);
	КонецЦикла;

	Возврат Календарь;

КонецФункции

Функция ДеньИзБазы(СтрокаДня)

	Возврат Новый Структура("DayType, DayWorking, Интервалы",
		СтрокаДня.DayType,
		СтрокаДня.DayWorking,
		ИнтервалыИзКолонок(СтрокаДня));

КонецФункции

// Плоские колонки FromTime1..ToTime3 -> массив пар {FromTime, ToTime}.
Функция ИнтервалыИзКолонок(СтрокаТЧ)

	Интервалы = Новый Массив;
	Для Номер = 1 По 3 Цикл
		ОтВремени = СтрокаТЧ["FromTime" + Номер];
		ДоВремени = СтрокаТЧ["ToTime" + Номер];
		Если ОтВремени = Дата(1, 1, 1) Тогда
			Продолжить;
		КонецЕсли;
		Интервалы.Добавить(Новый Структура("FromTime, ToTime", ОтВремени, ДоВремени));
	КонецЦикла;
	Возврат Интервалы;

КонецФункции

Функция РаботыВЗадачи(Состояния)

	СписокЗадач = Новый Массив;
	Для Каждого Состояние Из Состояния Цикл
		СписокЗадач.Добавить(ЗадачаИзБазы(Состояние));
	КонецЦикла;
	Возврат СписокЗадач;

КонецФункции

Функция ЗадачаИзБазы(Состояние)

	Объект = Состояние.Task.ПолучитьОбъект();
	Задача = Новый Структура("UID, Name, ID, WBS, OutlineNumber, OutlineLevel,
		|Summary, Milestone, ManuallyScheduled, TaskType, EffortDriven, Duration,
		|DurationFormat, Start, Finish, EarlyStart, EarlyFinish, LateStart,
		|LateFinish, TotalSlack, FreeSlack, Critical, ConstraintType,
		|ConstraintDate, Deadline, Priority, LevelingDelay, LevelingCanSplit,
		|LevelAssignments, PercentComplete, PercentWorkComplete, ActualStart,
		|ActualFinish, ActualDuration, Work, ActualWork, RemainingWork, FixedCost,
		|Cost, CalendarUID, Notes, IsActive, Stop, Resume, Предшественники",
		Объект.UID,
		Объект.Наименование,
		Объект.ID,
		Объект.WBS,
		Объект.OutlineNumber,
		Объект.OutlineLevel,
		Объект.Summary,
		Объект.Milestone,
		Объект.ManuallyScheduled,
		Объект.TaskType,
		Объект.EffortDriven,
		Объект.Duration,
		Объект.DurationFormat,
		ПустаяДатаВНеопределено(Объект.Start),
		ПустаяДатаВНеопределено(Объект.Finish),
		ПустаяДатаВНеопределено(Объект.EarlyStart),
		ПустаяДатаВНеопределено(Объект.EarlyFinish),
		ПустаяДатаВНеопределено(Объект.LateStart),
		ПустаяДатаВНеопределено(Объект.LateFinish),
		Объект.TotalSlack,
		Объект.FreeSlack,
		Объект.Critical,
		Объект.ConstraintType,
		ПустаяДатаВНеопределено(Объект.ConstraintDate),
		ПустаяДатаВНеопределено(Объект.Deadline),
		Объект.Priority,
		Объект.LevelingDelay,
		Объект.LevelingCanSplit,
		Объект.LevelAssignments,
		Объект.PercentComplete,
		Объект.PercentWorkComplete,
		ПустаяДатаВНеопределено(Объект.ActualStart),
		ПустаяДатаВНеопределено(Объект.ActualFinish),
		Объект.ActualDuration,
		Объект.Work,
		Объект.ActualWork,
		Объект.RemainingWork,
		Объект.FixedCost,
		Объект.Cost,
		УидСтроки(Объект.Calendar),
		Объект.Notes,
		Объект.IsActive,
		ПустаяДатаВНеопределено(Объект.Stop),
		ПустаяДатаВНеопределено(Объект.Resume),
		ПредшественникиИзТЧ(Объект.Predecessors));
	Возврат Задача;

КонецФункции

Функция ПредшественникиИзТЧ(ТаблицаСвязей)

	Предшественники = Новый Массив;
	Для Каждого СтрокаСвязи Из ТаблицаСвязей Цикл
		Предшественники.Добавить(Новый Структура(
			"PredecessorUID, LinkType, Lag, LagFormat, CrossProject, CrossProjectName",
			УидСтроки(СтрокаСвязи.Task),
			СтрокаСвязи.LinkType,
			СтрокаСвязи.Lag,
			СтрокаСвязи.LagFormat,
			СтрокаСвязи.CrossProject,
			СтрокаСвязи.CrossProjectName));
	КонецЦикла;
	Возврат Предшественники;

КонецФункции

Функция РесурсыВРесурсы(Проект)

	Ресурсы = Новый Массив;
	Для Каждого РесурсБазы Из РесурсыПроекта(Проект) Цикл
		Ресурсы.Добавить(Новый Структура(
			"UID, Name, Code, ID, ResourceType, MaterialLabel, MaxUnits,
			|StandardRate, OvertimeRate, CostPerUse, AccrueAt, CalendarUID,
			|Group, Initials, IsActive, Notes, StandardRateFormat, OvertimeRateFormat",
			РесурсБазы.UID,
			РесурсБазы.Наименование,
			РесурсБазы.Code,
			РесурсБазы.ID,
			РесурсБазы.ResourceType,
			РесурсБазы.MaterialLabel,
			РесурсБазы.MaxUnits,
			РесурсБазы.StandardRate,
			РесурсБазы.OvertimeRate,
			РесурсБазы.CostPerUse,
			РесурсБазы.AccrueAt,
			УидСтроки(РесурсБазы.Calendar),
			РесурсБазы.Group,
			РесурсБазы.Initials,
			РесурсБазы.IsActive,
			РесурсБазы.Notes,
			Неопределено, // форматы ставок в базе не хранятся, узел не пишется
			Неопределено));
	КонецЦикла;
	Возврат Ресурсы;

КонецФункции

Функция РесурсыПроекта(Проект)

	Ресурсы = Новый Массив;
	Выборка = Справочники.Ресурсы.Выбрать(, Проект);
	Пока Выборка.Следующий() Цикл
		Ресурсы.Добавить(Выборка.Ссылка.ПолучитьОбъект());
	КонецЦикла;
	Возврат Ресурсы;

КонецФункции

// Работы проекта запросом (для порядка и одного чтения полей).
Функция СоответствиеСостоянийРабот(Проект)

	Состояния = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Работы.Ссылка КАК Task,
		|	Работы.Calendar КАК Calendar
		|ИЗ
		|	Справочник.Работы КАК Работы
		|ГДЕ
		|	Работы.Владелец = &Проект
		|УПОРЯДОЧИТЬ ПО
		|	Работы.ID";
	Запрос.УстановитьПараметр("Проект", Проект);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Состояния.Добавить(Новый Структура("Task, Calendar", Выборка.Task, Выборка.Calendar));
	КонецЦикла;
	Возврат Состояния;

КонецФункции

// Назначения из ТЧ Assignments работ (TaskUID берётся из UID задачи).
Функция НазначенияИзТЧ(Состояния)

	Назначения = Новый Массив;
	Для Каждого Состояние Из Состояния Цикл
		Объект = Состояние.Task.ПолучитьОбъект();
		Для Каждого СтрокаНазначения Из Объект.Assignments Цикл
			Назначения.Добавить(Новый Структура(
				"TaskUID, ResourceUID, Units, Work, ActualWork, RemainingWork, Delay, Cost",
				Объект.UID,
				УидСтроки(СтрокаНазначения.Resource),
				СтрокаНазначения.Units,
				СтрокаНазначения.Work,
				СтрокаНазначения.ActualWork,
				СтрокаНазначения.RemainingWork,
				СтрокаНазначения.Delay,
				СтрокаНазначения.Cost));
		КонецЦикла;
	КонецЦикла;
	Возврат Назначения;

КонецФункции

// Пустая дата реквизита -> Неопределено (узел не пишется, см. Записать).
Функция ПустаяДатаВНеопределено(Значение)

	Возврат ?(Значение = Дата(1, 1, 1), Неопределено, Значение);

КонецФункции

// UID-реквизит объекта по ссылке календаря/ресурса/работы.
Функция УидСтроки(Ссылка)

	Возврат ?(Ссылка.Пустая(), "", Ссылка.UID);

КонецФункции

#КонецОбласти
