// ============================================================================
// GITL-TL-011: Команда загрузки таймлогов в таблицу результата
// ============================================================================

// Заполняет табличную часть "Таймлог" данными из источника.
//
// Параметры:
//   ИсточникДанных - ТаблицаЗначений - данные для загрузки.
//
Процедура КомандаЗагрузитьТаймлогиВТаблицу(Знач ИсточникДанных)
	
	Если ИсточникДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Очищаем текущую таблицу
	ЭтотОбъект.Таймлог.Очистить();
	
	Для Каждого СтрокаИсточника Из ИсточникДанных Цикл
		
		СтрокаТаблицы = ЭтотОбъект.Таймлог.Добавить();
		СтрокаТаблицы.ТаймлогИД = СтрокаИсточника.timelog_id;
		СтрокаТаблицы.IssueIID  = СтрокаИсточника.issue_iid;
		СтрокаТаблицы.Project   = СтрокаИсточника.project_name;
		СтрокаТаблицы.Summary   = СтрокаИсточника.description;
		СтрокаТаблицы.Duration  = СтрокаИсточника.duration_seconds;
		СтрокаТаблицы.Date      = СтрокаИсточника.spent_at;
		
	КонецЦикла;
	
КонецПроцедуры

// ============================================================================
// GITL-TL-012: Команда валидации данных перед отправкой в GitLab
// ============================================================================

// Проверяет корректность данных для создания/обновления записи таймлога.
//
// Параметры:
//   ДанныеДляПроверки - Структура - данные с реквизитами:
//     * ПроектID            - Число
//     * IssueIID            - Число
//     * ДлительностьВСекундах - Число
//     * ДатаРаботы          - Строка
//     * Описание            - Строка
//
// Возвращаемое значение:
//   Структура - результат валидации с реквизитами:
//     * Корректно - Булево
//     * Ошибки    - Массив строк с описаниями ошибок.
//
Функция КомандаВалидироватьДанныеТаймлога(Знач ДанныеДляПроверки) Экспорт
	
	Результат = Новый Структура("Корректно, Ошибки", Истина, Новый Массив);
	
	Если ДанныеДляПроверки = Неопределено Тогда
		Результат.Корректно = Ложь;
		Результат.Ошибки.Добавить("Данные для проверки не указаны.");
		Возврат Результат;
	КонецЕсли;
	
	// Проверка ПроектID
	ПроектID = ДанныеДляПроверки.Получить("ПроектID");
	Если ПроектID = Неопределено ИЛИ НЕ Число(ПроектID) ИЛИ Число(ПроектID) <= 0 Тогда
		Результат.Корректно = Ложь;
		Результат.Ошибки.Добавить("ПроектID должен быть положительным числом.");
	КонецЕсли;
	
	// Проверка IssueIID
	IssueIID = ДанныеДляПроверки.Получить("IssueIID");
	Если IssueIID = Неопределено ИЛИ НЕ Число(IssueIID) ИЛИ Число(IssueIID) <= 0 Тогда
		Результат.Корректно = Ложь;
		Результат.Ошибки.Добавить("IssueIID должен быть положительным числом.");
	КонецЕсли;
	
	// Проверка ДлительностьВСекундах
	Длительность = ДанныеДляПроверки.Получить("ДлительностьВСекундах");
	Если Длительность = Неопределено ИЛИ НЕ Число(Длительность) ИЛИ Число(Длительность) <= 0 Тогда
		Результат.Корректно = Ложь;
		Результат.Ошибки.Добавить("ДлительностьВСекундах должна быть положительным числом.");
	КонецЕсли;
	
	// Проверка ДатаРаботы
	ДатаРаботы = ДанныеДляПроверки.Получить("ДатаРаботы");
	Если ДатаРаботы = Неопределено ИЛИ ПустаяСтрока(ДатаРаботы) Тогда
		Результат.Корректно = Ложь;
		Результат.Ошибки.Добавить("ДатаРаботы должна быть указана в формате ГГГГ-ММ-ДД.");
	ИначеЕсли НЕ СтрПодобнаПоРегулярномуВыражению(ДатаРаботы, "^\d{4}-\d{2}-\d{2}$") Тогда
		Результат.Корректно = Ложь;
		Результат.Ошибки.Добавить("ДатаРаботы должна быть в формате ГГГГ-ММ-ДД.");
	КонецЕсли;
	
	// Проверка Описание (опционально)
	Описание = ДанныеДляПроверки.Получить("Описание");
	Если Описание <> Неопределено ИЛИ НЕ ПустаяСтрока(Описание) Тогда
		Если стрДлина(Описание) > 1000 Тогда
			Результат.Корректно = Ложь;
			Результат.Ошибки.Добавить("Описание не должно превышать 1000 символов.");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// ============================================================================
// GITL-TL-013: Команда формирования отчёта по таймлогам
// ============================================================================

// Формирует сводный отчёт по таймлогам за период.
//
// Параметры:
//   ПериодНач - Строка - начальная дата периода в формате "ГГГГ-ММ-ДД".
//   ПериодКон - Строка - конечная дата периода в формате "ГГГГ-ММ-ДД".
//
// Возвращаемое значение:
//   ТаблицаЗначений - сводный отчёт с колонками:
//     * project_name    - Строка - имя проекта.
//     * issue_iid       - Число - ID задачи.
//     * issue_title     - Строка - название задачи.
//     * total_seconds   - Число - суммарное время в секундах.
//     * total_hours     - Число - суммарное время в часах.
//     * record_count    - Число - количество записей.
//
Функция КомандаСформироватьОтчёт(Знач ПериодНач, Знач ПериодКон) Экспорт
	
	ПроверитьПодключение();
	
	// Получаем все таймлоги сотрудника за период
	ИсточникДанных = КомандаПолучитьТаймлогиСотрудника(ПериодНач, ПериодКон);
	
	Если ИсточникДанных.Количество() = 0 Тогда
		// Возвращаем пустую таблицу с нужной структурой
		Возврат СоздатьПустойОтчёт();
	КонецЕсли;
	
	// Группируем данные по проекту и задаче
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("project_name",    Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("issue_iid",       Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("issue_title",     Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("total_seconds",   Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("total_hours",     Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("record_count",    Новый ОписаниеТипов("Число"));
	
	// Создаём ключи для группировки
	Группировка = Новый Соответствие;
	
	Для Каждого Запись Из ИсточникДанных Цикл
		
		Ключ = СтрШаблон("%1|%2", Запись.project_name, Запись.issue_iid);
		
		Если Группировка.Содержит(Ключ) Тогда
			СтрокаОтчёта = Группировка.Получить(Ключ);
			СтрокаОтчёта.total_seconds = СтрокаОтчёта.total_seconds + Запись.duration_seconds;
			СтрокаОтчёта.record_count  = СтрокаОтчёта.record_count + 1;
		Иначе
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.project_name   = Запись.project_name;
			НоваяСтрока.issue_iid      = Запись.issue_iid;
			НоваяСтрока.issue_title    = Запись.issue_title;
			НоваяСтрока.total_seconds  = Запись.duration_seconds;
			НоваяСтрока.total_hours    = Запись.duration_seconds / 3600;
			НоваяСтрока.record_count   = 1;
			
			Группировка.Вставить(Ключ, НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

// Проверка подключения к GitLab API.
//
Процедура ПроверитьПодключение()
	
	Если ПустаяСтрока(ЭтотОбъект.BaseURL) Тогда
		ВызватьИсключение "Не установлен базовый URL GitLab сервера.";
	КонецЕсли;
	
	Если ПустаяСтрока(ЭтотОбъект.Токен) Тогда
		ВызватьИсключение "Не установлен токен доступа GitLab API.";
	КонецЕсли;
	
	Если ПустаяСтрока(ЭтотОбъект.userID) Тогда
		ВызватьИсключение "Не указан идентификатор пользователя GitLab.";
	КонецЕсли;
	
КонецПроцедуры

// Создаёт пустую таблицу для отчёта.
//
// Возвращаемое значение:
//   ТаблицаЗначений - пустая таблица с описанными колонками.
//
Функция СоздатьПустойОтчёт() Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("project_name",    Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("issue_iid",       Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("issue_title",     Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("total_seconds",   Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("total_hours",     Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("record_count",    Новый ОписаниеТипов("Число"));
	
	Возврат Результат;
	
КонецФункции

// Соединяет элементы массива в строку с разделителем.
//
// Параметры:
//   МассивСтрок  - Массив - массив строк для соединения.
//   Разделитель  - Строка - разделитель между строками.
//
// Возвращаемое значение:
//   Строка - соединённая строка.
//
Функция СоединитьСтроки(Знач МассивСтрок, Знач Разделитель) Экспорт
	
	Результат = "";
	
	Для Каждого Элемент Из МассивСтрок Цикл
		Если Результат <> "" Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		
		Результат = Результат + Элемент;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции