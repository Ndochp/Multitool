// Модуль менеджера обработки ИнтеграцияGitlab
// Фабричные методы для создания экземпляров интеграции.
// Версия: 1.0.0

#Область ПрограммныйИнтерфейс

// Создаёт и инициализирует новый экземпляр интеграции с GitLab.
//
// Параметры:
//
// Возвращаемое значение:
//   DataProcessorObject.ИнтеграцияGitlab - инициализированный объект обработки.
//
Функция СоздатьИнтеграцию(Знач ВнешняяСистемаТикетов) Экспорт
   БазовыйURL = ВнешняяСистемаТикетов.БазовыйURL;
	Токен = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВнешняяСистемаТикетов, "PRIVATE_TOKEN");
	
	Интеграция = Обработки.ИнтеграцияGitlab.Создать();

	Если ЗначениеЗаполнено(БазовыйURL) Тогда
		Интеграция.УстановитьБазовыйURL(БазовыйURL);
	КонецЕсли;

	Если ЗначениеЗаполнено(Токен) Тогда
		Интеграция.УстановитьТокен(Токен);
	КонецЕсли;

	Возврат Интеграция;

КонецФункции

#КонецОбласти