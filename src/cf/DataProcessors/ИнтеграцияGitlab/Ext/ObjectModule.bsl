КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Обработка ошибок (CodingRules п.8)

// Возвращает тело HTTP-ответа в виде строки.
// Реальный КоннекторHTTP возвращает Структуру (см. КоннекторHTTP.НовыйОтвет)
// с полем Тело - ДвоичныеДанные; метода ПолучитьТелоКакСтроку у неё нет.
// Под моком Мокито в тестах возвращается платформенный HTTPОтвет,
// у которого тело читается методом ПолучитьТелоКакСтроку.
//
// Параметры:
//   Ответ - Структура - ответ КоннекторHTTP; HTTPОтвет - ответ платформы/мока.
//
// Возвращаемое значение:
//   Строка - тело ответа.
//
Функция ТелоОтветаСтрокой(Знач Ответ)

	Если ТипЗнч(Ответ) = Тип("Структура") Тогда
		// GitLab API отдаёт JSON только в UTF-8; без charset в Content-Type
		// коннектор декодирует тело в кодировке по умолчанию (CP1251).
		Возврат КоннекторHTTP.КакТекст(Ответ, "utf-8");
	КонецЕсли;

	Возврат Ответ.ПолучитьТелоКакСтроку();

КонецФункции

// Универсальный обработчик HTTP-ответов с ошибками.
//
// Параметры:
//   Ответ - объект ответа КоннекторHTTP с свойствами КодСостояния и Тело.
//
Процедура ОбработатьОшибкуОтвет(Знач Ответ)
	
	Код = Ответ.КодСостояния;
	Тело = ТелоОтветаСтрокой(Ответ);

	Если Код = 401 Тогда
		ВызватьИсключение "Не авторизован. Проверьте токен.";
	ИначеЕсли Код = 403 Тогда
		ВызватьИсключение "Доступ запрещён.";
	ИначеЕсли Код = 404 Тогда
		ВызватьИсключение "Ресурс не найден.";
	Иначе
		ВызватьИсключение String(Код) + ": " + Тело;
	КонецЕсли;

КонецПроцедуры

