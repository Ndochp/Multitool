// Модуль объекта обработки ИнтеграцияGitlab
// Адаптер к GitLab REST API по принципам гексагональной архитектуры.
// Использует КоннекторHTTP для выполнения HTTP-запросов.
// Версия: 2.0.0

#Область ПрограммныйИнтерфейс

////////////////////////////////////////////////////////////////////////////////
// Инициализация (GITL-004)

// Устанавливает базовый URL GitLab сервера.
//
// Параметры:
//   БазовыйURL - Строка - URL GitLab сервера, например "https://gitlab.example.com".
//
Процедура УстановитьБазовыйURL(Знач БазовыйURL) Экспорт
	
	ЭтотОбъект.БазовыйURL = БазовыйURL;

КонецПроцедуры

// Устанавливает токен аутентификации для GitLab API.
//
// Параметры:
//   Токен - Строка - персональный токен доступа GitLAB (PRIVATE-TOKEN).
//
Процедура УстановитьТокен(Знач Токен) Экспорт
	
	ЭтотОбъект.Токен = Токен;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Работа с таймлогами (Timelogs)

// Получает список таймлогов для задачи за период.
//
// Параметры:
//   ПроектID    - Число - идентификатор проекта в GitLab.
//   IssueIID    - Число - внутренний идентификатор задачи (IID) в GitLab.
//   ДатаНач     - Строка - начальная дата периода в формате "ГГГГ-ММ-ДД".
//   ДатаКон     - Строка - конечная дата периода в формате "ГГГГ-ММ-ДД".
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с колонками:
//     * timelog_id       - Число - идентификатор записи времени.
//     * project_name     - Строка - имя проекта.
//     * issue_title      - Строка - название задачи.
//     * duration_seconds - Число - длительность в секундах.
//     * spent_at         - Дата/Строка - дата и время работы.
//     * description      - Строка - описание работы.
//
Функция ПолучитьTimelogи(Знач ПроектID, Знач IssueIID, Знач ДатаНач, Знач ДатаКон) Экспорт
	
	ПроверитьИнициализацию();
	
	Путь = СтрШаблон("/api/v4/projects/%1/issues/%2/timelogs", ПроектID, IssueIID);
	URL = СформироватьURL(Путь);
	
	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("spent_at_on_or_after", ДатаНач);
	ПараметрыЗапроса.Вставить("spent_at_before", ДатаКон);
	
	Ответ = ВыполнитьЗапросСАвторизацией("GET", URL, ПараметрыЗапроса);
	
	Если Ответ.КодСостояния = 200 Тогда
		Возврат ПреобразоватьTimelogиВТаблицу(Ответ.Тело);
	Иначе
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

КонецФункции

// Получает все таймлоги сотрудника за период.
//
// Параметры:
//   ИдентификаторПользователя - Число - идентификатор пользователя в GitLab.
//   ДатаНач                   - Строка - начальная дата периода в формате "ГГГГ-ММ-ДД".
//   ДатаКон                   - Строка - конечная дата периода в формате "ГГГГ-ММ-ДД".
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с колонками:
//     * timelog_id       - Число - идентификатор записи времени.
//     * project_name     - Строка - имя проекта.
//     * issue_iid        - Число - внутренний идентификатор задачи.
//     * issue_title      - Строка - название задачи.
//     * duration_seconds - Число - длительность в секундах.
//     * spent_at         - Дата/Строка - дата и время работы.
//     * description      - Строка - описание работы.
//     * web_url          - Строка - URL задачи в GitLab.
//
Функция ПолучитьTimelogиПоСотруднику(Знач ИдентификаторПользователя, Знач ДатаНач, Знач ДатаКон) Экспорт
	
	ПроверитьИнициализацию();
	
	Путь = СтрШаблон("/api/v4/users/%1/time_entries", ИдентификаторПользователя);
	URL = СформироватьURL(Путь);
	
	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("date_on_or_after", ДатаНач);
	ПараметрыЗапроса.Вставить("date_before", ДатаКон);
	
	Ответ = ВыполнитьЗапросСАвторизацией("GET", URL, ПараметрыЗапроса);
	
	Если Ответ.КодСостояния = 200 Тогда
		Возврат ПреобразоватьTimelogиПоСотрудникуВТаблицу(Ответ.Тело);
	Иначе
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Обновление таймлогов

// Создаёт новую запись времени (time entry) для задачи.
//
// Параметры:
//   ПроектID         - Число - идентификатор проекта в GitLab.
//   IssueIID         - Число - внутренний идентификатор задачи (IID).
//   ДлительностьВСекундах - Число - затраченное время в секундах.
//   ДатаВыполнения   - Строка - дата выполнения в формате "ГГГГ-ММ-ДД".
//   Комментарий      - Строка - комментарий к затраченному времени (необязательно).
//
// Возвращаемое значение:
//   Число - идентификатор созданной записи времени.
//
Функция СоздатьЗаписьВремени(Знач ПроектID, Знач IssueIID, Знач ДлительностьВСекундах, Знач ДатаВыполнения, Знач Комментарий = "") Экспорт
	
	ПроверитьИнициализацию();
	
	Путь = СтрШаблон("/api/v4/projects/%1/issues/%2/time_stats", ПроектID, IssueIID);
	URL = СформироватьURL(Путь);
	
	Данные = Новый Структура;
	Данные.Вставить("duration", ДлительностьВСекундах);
	Если ЗначениеЗаполнено(Комментарий) Тогда
		Данные.Вставить("note", Комментарий);
	КонецЕсли;
	Данные.Вставить("spent_at", ДатаВыполнения);
	
	ТелоJSON = КоннекторHTTP.JsonИзОбъект(Данные);
	
	Ответ = ВыполнитьЗапросСАвторизацией("POST", URL, Неопределено, ТелоJSON);
	
	Если Ответ.КодСостояния = 200 Тогда
		Результат = КоннекторHTTP.JsonВОбъект(Ответ.Тело);
		Возврат Результат.Получить("id");
	Иначе
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

КонецФункции

// Обновляет существующую запись времени.
//
// Параметры:
//   ИдентификаторЗаписи  - Число - идентификатор записи времени.
//   ДлительностьВСекундах - Число (необязательно) - новая длительность в секундах.
//   Комментарий           - Строка (необязательно) - новый комментарий.
//   ДатаВыполнения        - Строка (необязательно) - новая дата в формате "ГГГГ-ММ-ДД".
//
Функция ОбновитьЗаписьВремени(Знач ИдентификаторЗаписи, Знач ДлительностьВСекундах = Неопределено, Знач Комментарий = "", Знач ДатаВыполнения = "") Экспорт
	
	ПроверитьИнициализацию();
	
	// Запрос к эндпоинту time_entry (для пользователя) или project issue time_stats
	// Для простоты используем универсальный подход через user time_entries
	Путь = СтрШаблон("/api/v4/users/me/time_entries/%1", ИдентификаторЗаписи);
	URL = СформироватьURL(Путь);
	
	Данные = Новый Структура;
	Если ДлительностьВСекундах <> Неопределено Тогда
		Данные.Вставить("time_spent", ДлительностьВСекундах);
	КонецЕсли;
	Если ЗначениеЗаполнено(Комментарий) Тогда
		Данные.Вставить("note", Комментарий);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаВыполнения) Тогда
		Данные.Вставить("spent_at", ДатаВыполнения);
	КонецЕсли;
	
	ТелоJSON = КоннекторHTTP.JsonИзОбъект(Данные);
	
	Ответ = ВыполнитьЗапросСАвторизацией("PUT", URL, Неопределено, ТелоJSON);
	
	Если Ответ.КодСостояния = 200 Тогда
		Возврат Истина;
	Иначе
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

КонецФункции

// Удаляет запись времени.
//
// Параметры:
//   ИдентификаторЗаписи - Число - идентификатор записи времени.
//
Функция УдалитьЗаписьВремени(Знач ИдентификаторЗаписи) Экспорт
	
	ПроверитьИнициализацию();
	
	Путь = СтрШаблон("/api/v4/users/me/time_entries/%1", ИдентификаторЗаписи);
	URL = СформироватьURL(Путь);
	
	Ответ = ВыполнитьЗапросСАвторизацией("DELETE", URL, Неопределено);
	
	Если Ответ.КодСостояния = 204 Тогда
		Возврат Истина;
	Иначе
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Справочные методы API GitLab

// Получает список проектов GitLab с фильтрацией по поиску.
//
// Параметры:
//   Поиск - Строка (необязательно) - текст для поиска по названию проекта.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с колонками:
//     * project_id    - Число - ID проекта в GitLab.
//     * name          - Строка - название проекта.
//     * path_with_namespace - Строка - полный путь к проекту.
//     * web_url       - Строка - URL проекта.
//
Функция ПолучитьПроекты(Знач Поиск = "") Экспорт
	
	ПроверитьИнициализацию();
	
	Путь = "/api/v4/projects";
	URL = СформироватьURL(Путь);
	
	ПараметрыЗапроса = Новый Соответствие;
	Если ЗначениеЗаполнено(Поиск) Тогда
		ПараметрыЗапроса.Вставить("search", Поиск);
	КонецЕсли;
	// Ограничиваем результат для производительности
	ПараметрыЗапроса.Вставить("per_page", 100);
	
	Ответ = ВыполнитьЗапросСАвторизацией("GET", URL, ПараметрыЗапроса);
	
	Если Ответ.КодСостояния = 200 Тогда
		Возврат ПреобразоватьПроектыВТаблицу(Ответ.Тело);
	Иначе
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

КонецФункции

// Получает информацию о текущем пользователе (проверка авторизации).
//
// Возвращаемое значение:
//   Структура - данные пользователя или Неопределено при ошибке.
//
Функция ПолучитьТекущегоПользователя() Экспорт
	
	ПроверитьИнициализацию();
	
	Путь = "/api/v4/user";
	URL = СформироватьURL(Путь);
	
	Ответ = ВыполнитьЗапросСАвторизацией("GET", URL, Неопределено);
	
	Если Ответ.КодСостояния = 200 Тогда
		Возврат КоннекторHTTP.JsonВОбъект(Ответ.Тело);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Методы предварительной загрузки кэша

// Заполняет кэш маппинга сотрудников во внешнюю систему.
//
// Параметры:
//   МассивСоответствий - Массив - массив структур с полями:
//     * ВнешнийID - Число - идентификатор во внешней системе.
//
Процедура ЗаполнитьКэшВнешнихПользователей(МассивСоответствий) Экспорт
	
	Если МассивСоответствий = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из МассивСоответствий Цикл
		ЭтотОбъект.КэшПользователь_ВнешнийID.Вставить(Элемент.СсылкаНаСотрудника, Элемент.ВнешнийID);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// Инициализация и проверка

// Формирует полный URL для запроса к GitLab API.
//
// Параметры:
//   Эндпоинт - Строка - путь эндпоинта, например "/api/v4/projects/1".
//
// Возвращаемое значение:
//   Строка - полный URL.
//
Функция СформироватьURL(Знач Эндпоинт) Экспорт
	
	Возврат ЭтотОбъект.БазовыйURL + Эндпоинт;

КонецФункции

// Проверяет, что базовый URL и токен установлены.
//
Процедура ПроверитьИнициализацию() Экспорт
	
	Если ПустаяСтрока(ЭтотОбъект.БазовыйURL) Тогда
		ВызватьИсключение "Не установлен базовый URL GitLab сервера. Вызовите УстановитьБазовыйURL().";
	КонецЕсли;
	
	Если ПустаяСтрока(ЭтотОбъект.Токен) Тогда
		ВызватьИсключение "Не установлен токен доступа GitLab. Вызовите УстановитьТокен().";
	КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// HTTP-запросы с авторизацией и повтором при 401

// Выполняет HTTP-запрос с автоматической обработкой ошибок авторизации (401).
// При получении 401 пытается обновить токен и повторяет запрос однократно.
//
// Параметры:
//   Метод            - Строка - HTTP-метод ("GET", "POST", "PUT", "DELETE").
//   URL              - Строка - полный URL запроса.
//   ПараметрыЗапроса - Соответствие (необязательно) - параметры строки запроса.
//   ТелоЗапроса      - ДвоичныеДанные/Строка (необязательно) - тело POST/PUT запроса.
//
// Возвращаемое значение:
//   Структура - ответ с полями: КодСостояния, Тело, ЗаголовкиОтвета.
//
Функция ВыполнитьЗапросСАвторизацией(Знач Метод, Знач URL, Знач ПараметрыЗапроса = Неопределено, Знач ТелоЗапроса = Неопределено)
	
	ПопыткаПовтора = 0;
	
	Пока Истина Цикл
		
		Заголовки = ПолучитьЗаголовкиАутентификации();
		
		Ответ = ВыполнитьHTTPЗапрос(Метод, URL, ПараметрыЗапроса, ТелоЗапроса, Заголовки);
		
		// Централизованная обработка ошибок авторизации
		Если Ответ.КодСостояния = 401 И ПопыткаПовтора = 0 Тогда
			
			НовыйТокен = ОбновитьТокенGitLab();
			
			Если ЗначениеЗаполжено(НовыйТокен) Тогда
				ЭтотОбъект.Токен = НовыйТокен;
				ПопыткаПовтора = 1;
				Продолжить; // Повторяем запрос с новым токеном
			КонецЕсли;
			
			// Токен не обновился — выбрасываем ошибку
			ВызватьИсключение "Ошибка авторизации GitLab (401). Токен истёк и не может быть обновлён.";
		
		КонецЕсли;
		
		// Возвращаем ответ как есть (успех или другая ошибка)
		Возврат Ответ;
	
	КонецЦикла;

КонецФункции

// Выполняет HTTP-запрос через КоннекторHTTP.
//
Функция ВыполнитьHTTPЗапрос(Знач Метод, Знач URL, Знач ПараметрыЗапроса, Знач ТелоЗапроса, Заголовки)
	
	ПолныйURL = СформироватьПолныйURL(URL, ПараметрыЗапроса);
	
	Если Метод = "GET" Тогда
		
		Ответ = КоннекторHTTP.Get(ПолныйURL, Неопределено, Заголовки);
		
	ИначеЕсли Метод = "POST" Тогда
		
		Ответ = КоннекторHTTP.Post(ПолныйURL, ТелоЗапроса, Заголовки);
		
	ИначеЕсли Метод = "PUT" Тогда
		
		Ответ = КоннекторHTTP.Put(ПолныйURL, ТелоЗапроса, Заголовки);
		
	ИначеЕсли Метод = "DELETE" Тогда
		
		Ответ = КоннекторHTTP.Delete(ПолныйURL, Неопределено, Заголовки);
		
	Иначе
		
		ВызватьИсключение "Неподдерживаемый HTTP-метод: " + Метод;
	
	КонецЕсли;
	
	// Нормализация ответа
	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", Ответ.КодСостояния);
	Результат.Вставить("Тело", Ответ.Тело);
	Результат.Вставить("ЗаголовкиОтвета", Ответ.Заголовки);
	
	Возврат Результат;

КонецФункции

// Формирует полный URL с параметрами строки запроса.
//
Функция СформироватьПолныйURL(Знач БазовыйURL, Знач Параметры)
	
	Если Параметры = Неопределено Или Параметры.Количество() = 0 Тогда
		Возврат БазовыйURL;
	КонецЕсли;
	
	СтрокаПараметров = "";
	Для Каждого КлючЗначение Из Параметры Цикл
		Разделитель = (СтрДлина(СтрокаПараметров) = 0) ? "?" : "&";
		СтрокаПараметров = СтрШаблон("%1%2%3=%4", СтрокаПараметров, Разделитель, КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	Возврат БазовыйURL + "?" + СтрокаПараметров;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Аутентификация

// Возвращает заголовки аутентификации для GitLab API.
//
// Возвращаемое значение:
//   Структура - параметры HTTP-запроса с заголовком PRIVATE-TOKEN.
//
Функция ПолучитьЗаголовкиАутентификации() Экспорт
	
	Заголовки = КоннекторHTTP.НовыеПараметры();
	Если Заголовки.Заголовки = Неопределено Тогда
		Заголовки.Заголовки = Новый Соответствие;
	КонецЕсли;
	Заголовки.Заголовки.Вставить("PRIVATE-TOKEN", ЭтотОбъект.Токен);
	Возврат Заголовки;

КонецФункции

