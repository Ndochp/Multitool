////////////////////////////////////////////////////////////////////////////////
// Работа со статистикой (GITL-009)

// Получает статистику времени для задачи через GitLab API.
//
// Параметры:
//   ПроектID  - Число - идентификатор проекта в GitLab.
//   IssueIID  - Число - внутренний идентификатор задачи (IID) в GitLab.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с колонками:
//     * time_spent          - Строка - суммарное затраченное время.
//     * total_time_spent    - Число - общее время в секундах.
//
Функция ПолучитьСтатистикуВремени(Знач ПроектID, Знач IssueIID) Экспорт

	ПроверитьИнициализацию();

	URL = СформироватьURL(СтрШаблон(
		"/api/v4/projects/%1/issues/%2/time_stats", ПроектID, IssueIID));

	Заголовки = ПолучитьЗаголовкиАутентификации();

	Ответ = КоннекторHTTP.Get(URL, Новый Соответствие, Заголовки);

	Если Ответ.КодСостояния <> 200 Тогда
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

	Возврат ПреобразоватьСтатистикуВТаблицуЗначений(Ответ.ПолучитьТелоКакСтроку());

КонецФункции

