////////////////////////////////////////////////////////////////////////////////
// Работа с таймлогами (GITL-008, GITL-011)

// Получает список timelogs для задачи за период.
//
// Параметры:
//   ПроектID    - Число - идентификатор проекта в GitLab.
//   IssueIID    - Число - внутренний идентификатор задачи (IID) в GitLab.
//   ДатаНач     - Строка - начальная дата периода в формате "ГГГГ-ММ-ДД".
//   ДатаКон     - Строка - конечная дата периода в формате "ГГГГ-ММ-ДД".
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с колонками:
//     * timelog_id         - Число - идентификатор записи времени.
//     * project_name       - Строка - имя проекта.
//     * issue_title        - Строка - название задачи.
//     * duration_seconds   - Число - длительность в секундах.
//     * spent_at           - Строка - дата затраченного времени.
//     * description        - Строка - описание работы.
//
Функция ПолучитьТаймЛоги(Знач ПроектID, Знач IssueIID, Знач ДатаНач, Знач ДатаКон) Экспорт

	ПроверитьИнициализацию();

	URL = СформироватьURL(СтрШаблон(
		"/api/v4/projects/%1/issues/%2/timelogs", ПроектID, IssueIID));

	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("spent_at_on_or_after", ДатаНач);
	ПараметрыЗапроса.Вставить("spent_at_before", ДатаКон);

	Заголовки = ПолучитьЗаголовкиАутентификации();

	Ответ = КоннекторHTTP.Get(URL, ПараметрыЗапроса, Заголовки);

	Если Ответ.КодСостояния <> 200 Тогда
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

	Возврат ПреобразоватьTimelogиВТаблицуЗначений(Ответ.ПолучитьТелоКакСтроку());

КонецФункции

// Получает все timelogs сотрудника за период через user time_entries endpoint.
//
// Параметры:
//   ПользовательID - Число - идентификатор пользователя в GitLab.
//   ДатаНач        - Строка - начальная дата периода в формате "ГГГГ-ММ-ДД".
//   ДатаКон        - Строка - конечная дата периода в формате "ГГГГ-ММ-ДД".
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с колонками:
//     * timelog_id         - Число - идентификатор записи времени.
//     * project_name       - Строка - имя проекта.
//     * issue_iid          - Число - внутренний ID задачи в GitLab.
//     * issue_title        - Строка - название задачи.
//     * duration_seconds   - Число - длительность в секундах.
//     * spent_at           - Строка - дата затраченного времени.
//     * description        - Строка - описание работы (note).
//     * web_url            - Строка - ссылка на задачу.
//
Функция ПолучитьTimelogиПоСотруднику(Знач ПользовательID, Знач ДатаНач, Знач ДатаКон) Экспорт

	ПроверитьИнициализацию();

	URL = СформироватьURL(СтрШаблон(
		"/api/v4/users/%1/time_entries", ПользовательID));

	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("date_on_or_after", ДатаНач);
	ПараметрыЗапроса.Вставить("date_before", ДатаКон);

	Заголовки = ПолучитьЗаголовкиАутентификации();

	Ответ = КоннекторHTTP.Get(URL, ПараметрыЗапроса, Заголовки);

	Если Ответ.КодСостояния <> 200 Тогда
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

	Возврат ПреобразоватьTimeEntriesВТаблицуЗначений(Ответ.ПолучитьТелоКакСтроку());

КонецФункции

// Получает список назначенных задач (Issues) пользователя через GitLab API.
//
// Параметры:
//   ПользовательID - Число - идентификатор пользователя в GitLab.
//   Состояние      - Строка - состояние задач ("opened", "closed", "all").
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с колонками:
//     * issue_id         - Число - идентификатор задачи в GitLab.
//     * issue_iid        - Число - внутренний ID задачи в проекте.
//     * title            - Строка - заголовок задачи.
//     * web_url          - Строка - ссылка на задачу.
//     * проект_id        - Число - идентификатор проекта в GitLab.
//     * состояние        - Строка - текущее состояние задачи.
//
Функция ПолучитьНазначенныеЗадачи(Знач ПользовательID, Знач Состояние = "opened") Экспорт

	ПроверитьИнициализацию();

	URL = СформироватьURL("/api/v4/users/" + String(ПользовательID) + "/issues");

	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("state", Состояние);
	ПараметрыЗапроса.Вставить("assignee_id", String(ПользовательID));

	Заголовки = ПолучитьЗаголовкиАутентификации();

	Ответ = КоннекторHTTP.Get(URL, ПараметрыЗапроса, Заголовки);

	Если Ответ.КодСостояния = 404 Тогда
		ВызватьИсключение "Пользователь с ID " + String(ПользовательID) + " не найден.";
	ИначеЕсли Ответ.КодСостояния <> 200 Тогда
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

	Возврат ПреобразоватьЗадачиВТаблицуЗначений(Ответ.ПолучитьТелоКакСтроку());

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// GraphQL API (GQL-Q001)

// Получает таймлоги пользователя за период через GraphQL API.
//
// Параметры:
//   ПользовательID - Число - идентификатор пользователя в GitLab.
//   ДатаНач        - Строка - начальная дата периода в формате "ГГГГ-ММ-ДД".
//   ДатаКон        - Строка - конечная дата периода в формате "ГГГГ-ММ-ДД".
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с колонками:
//     * timeentry_id    - Число - уникальный ID записи времени.
//     * duration        - Число - длительность в секундах.
//     * message         - Строка - сообщение/описание работы.
//     * label           - Строка - метка (тег) записи.
//     * spent_at        - Дата - дата выполненной работы.
//     * project_id      - Число - ID проекта.
//     * project_name    - Строка - название проекта.
//     * project_path    - Строка - путь к проекту (namespace/project).
//     * project_web_url - Строка - URL проекта.
//     * issue_id        - Число - ID задачи (если есть).
//     * issue_iid       - Число - внутренний IID задачи.
//     * issue_title     - Строка - название задачи.
//     * issue_state     - Строка - статус задачи (opened/closed/merged).
//     * issue_web_url   - Строка - URL задачи.
//
Функция ПолучитьТаймлогиПользователяGraphQL(Знач ПользовательID, Знач ДатаНач, Знач ДатаКон) Экспорт

	ПроверитьИнициализацию();

	// Формируем GraphQL запрос для получения таймлогов пользователя
	ТекстЗапроса = 
		"query GetUserTimeEntries($userId: ID!, $first: Int!) {
		|  user(username: ""username_placeholder"") {
		|    timeEntries(first: $first) {
		|      nodes {
		|        id
		|        duration
		|        message
		|        label
		|        spentAt
		|        project {
		|          id
		|          name
		|          pathWithNamespace
		|          webUrl
		|        }
		|        issue {
		|          id
		|          iid
		|          title
		|          state
		|          webUrl
		|        }
		|      }
		|    }
		|  }
		|}";

	// Получаем ID пользователя по username
	Username = ПолучитьUsernameПользователя(ПользовательID);
	Если ПустаяСтрока(Username) Тогда
		ВызватьИсключение "Не удалось получить username для пользователя с ID " + String(ПользовательID);
	КонецЕсли;

	// Заменяем placeholder на реальный username
	ТекстЗапроса = СтрЗамениТЬ(ТекстЗапроса, "username_placeholder", Username);

	// Параметры запроса
	ПараметрыGraphQL = Новый Структура;
	ПараметрыGraphQL.Вставить("userId", String(ПользовательID));
	ПараметрыGraphQL.Вставить("first", "100"); // Максимум за один запрос

	// Выполняем GraphQL запрос
	Ответ = ВыполнитьGraphQLЗапрос(ТекстЗапроса, ПараметрыGraphQL);

	Если Ответ = Неопределено Тогда
		Возврат СоздатьПустуюТаблицуДляGraphQLTimelogov();
	КонецЕсли;

	// Преобразуем ответ в ТаблицуЗначений
	Возврат ПреобразоватьGraphQLTimeEntriesВТаблицуЗначений(Ответ, ДатаНач, ДатаКон);

КонецФункции

// Получает username пользователя по его ID через GraphQL API.
//
// Параметры:
//   ПользовательID - Число - идентификатор пользователя в GitLab.
//
// Возвращаемое значение:
//   Строка - username пользователя или пустая строка при ошибке.
//
Функция ПолучитьUsernameПользователя(Знач ПользовательID) Экспорт

	ТекстЗапроса = 
		"query GetUser($userId: ID!) {
		|  user(username: ""placeholder"") {
		|    id
		|    username
		|  }
		|}";

	Параметры = Новый Структура;
	Параметры.Вставить("userId", String(ПользовательID));

	Ответ = ВыполнитьGraphQLЗапрос(ТекстЗапроса, Параметры);

	Если Ответ <> Неопределено Тогда
		Возврат Ответ.Получить("username");
	КонецЕсли;

	Возврат "";

КонецФункции

// Выполняет GraphQL запрос к GitLab API.
//
// Параметры:
//   ТекстЗапроса  - Строка - текст GraphQL запроса/мутации.
//   ПараметрыЗапроса - Структура - параметры для подстановки в запрос.
//
// Возвращаемое значение:
//   Объект - распарсенный ответ GraphQL (Объект/Массив) или Неопределено при ошибке.
//
Функция ВыполнитьGraphQLЗапрос(Знач ТекстЗапроса, Знач ПараметрыЗапроса) Экспорт

	// Формируем тело GraphQL запроса
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("query", ТекстЗапроса);

	// Формируем variables для подстановки
	Variables = Новый Соответствие();
	Для Каждого КлючЗнач Из ПараметрыЗапроса Цикл
		Variables.Вставить(КлючЗнач.Ключ, КлючЗнач.Значение);
	КонецЦикла;

	ТелоЗапроса.Вставить("variables", Variables);

	// Подготавливаем заголовки
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("PRIVATE-TOKEN", Токен);

	// Формируем JSON строку тела запроса
	JSONТело = КоннекторHTTP.ОбъектВJSON(ТелоЗапроса);

	// Отправляем POST запрос к GraphQL endpoint
	URL = СформироватьURL("/api/graphql");

	Попытка
		Ответ = КоннекторHTTP.Post(URL, Новый Соответствие, JSONТело, Заголовки);
	Исключение
		// Возвращаем Неопределено при ошибке сети
		Возврат Неопределено;
	КонецПопытки;

	Если Ответ.КодСостояния() <> 200 Тогда
		// Обработка ошибок GraphQL
		ТекстОшибки = СтрШаблон("GraphQL запрос завершился ошибкой %1: %2", 
			Ответ.КодСостояния(), Ответ.ПолучитьТелоКакСтроку());
		// Не выбрасываем исключение, а возвращаем Неопределено
		Возврат Неопределено;
	КонецЕсли;

	// Парсим ответ
	Попытка
		ДанныеОтвета = КоннекторHTTP.JsonВОбъект(Ответ.ПолучитьТелоКакСтроку());
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	// Проверяем на ошибки GraphQL в ответе
	Если ДанныеОтвета.Ошибки <> Неопределено Тогда
		МассивОшибок = ДанныеОтвета.Ошибки;
		ТекстОшибок = "";
		Для Каждого Ошибка Из МассивОшибок Цикл
			ТекстОшибок = ТекстОшибок + СтрШаблон("[%s] %s\n", Ошибка.Code, Ошибка.Message);
		КонецЦикла;
		// Возвращаем Неопределено при ошибках GraphQL
		Возврат Неопределено;
	КонецЕсли;

	// Возвращаем данные из ответа
	Возврат ДанныеОтвета.Data;

КонецФункции

// Преобразует JSON-ответ GraphQL (timeEntries) в таблицу значений.
//
// Параметры:
//   ОтветGraphQL - Объект - ответ от GraphQL API (структура с полями timeEntries).
//   ДатаНач      - Строка - начальная дата фильтрации.
//   ДатаКон      - Строка - конечная дата фильтрации.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с преобразованными данными.
//
Функция ПреобразоватьGraphQLTimeEntriesВТаблицуЗначений(Знач ОтветGraphQL, Знач ДатаНач, Знач ДатаКон) Экспорт

	Результат = СоздатьПустуюТаблицуДляGraphQLTimelogov();

	Если ОтветGraphQL = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	// Получаем nodes из ответа
	TimeEntries = ОтветGraphQL.Получить("timeEntries");
	Если TimeEntries = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Nodes = TimeEntries.Получить("nodes");
	Если ТипЗнч(Nodes) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Элемент Из Nodes Цикл
		
		// Фильтрация по дате
		SpentAt = Элемент.Получить("spentAt");
		Если Не ПустаяСтрока(ДатаНач) И Не ПустаяСтрока(ДатаКон) Тогда
			Если SpentAt < ДатаНач Или SpentAt > ДатаКон Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		СтрокаТаблицы = Результат.Добавить();

		// Основные поля таймлога
		СтрокаТаблицы.timeentry_id  = Элемент.Получить("id");
		
		DurationStr = Элемент.Получить("duration");
		СтрокаТаблицы.duration = ПреобразоватьGraphQLDurationВСекунды(DurationStr);
		
		СтрокаТаблицы.message   = Элемент.Получить("message");
		СтрокаТаблицы.label     = Элемент.Получить("label");
		СтрокаТаблицы.spent_at  = Элемент.Получить("spentAt");

		// Данные проекта
		Проект = Элемент.Получить("project");
		Если Проект <> Неопределено Тогда
			СтрокаТаблицы.project_id      = Проект.Получить("id");
			СтрокаТаблицы.project_name    = Проект.Получить("name");
			СтрокаТаблицы.project_path    = Проект.Получить("pathWithNamespace");
			СтрокаТаблицы.project_web_url = Проект.Получить("webUrl");
		КонецЕсли;

		// Данные задачи
		Задача = Элемент.Получить("issue");
		Если Задача <> Неопределено Тогда
			СтрокаТаблицы.issue_id    = Задача.Получить("id");
			СтрокаТаблицы.issue_iid   = Задача.Получить("iid");
			СтрокаТаблицы.issue_title = Задача.Получить("title");
			СтрокаТаблицы.issue_state = Задача.Получить("state");
			СтрокаТаблицы.issue_web_url = Задача.Получить("webUrl");
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Преобразует длительность из формата GraphQL (ISO 8601) в секунды.
//
// Параметры:
//   DurationGraphQL - Строка - длительность в формате ISO 8601 (например, PT30S, P1DT2H).
//
// Возвращаемое значение:
//   Число - количество секунд.
//
Функция ПреобразоватьGraphQLDurationВСекунды(Знач DurationGraphQL) Экспорт

	Если ПустаяСтрока(DurationGraphQL) Или DurationGraphQL = "PT0S" Тогда
		Возврат 0;
	КонецЕсли;

	Результат = 0;

	// Парсим формат ISO 8601: P[n]W или P[n]DT[n]H[n]M[n]S
	Попытка
		// Парсим формат ISO 8601: P[n]W или P[n]DT[n]H[n]M[n]S
		// Единый шаблон для разбора всех компонентов длительности
		Шаблон = "^P(?:(\d+)W)?(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?)?$";
		МассивВхождений = СтрНайтиВсеПоРегулярномуВыражению(DurationGraphQL, Шаблон, Ложь, Ложь);
		
		Если МассивВхождений.Количество() > 0 Тогда
			// Берём первое (и единственное) совпадение
			РезультатПоиска = МассивВхождений[0];
			Группы = РезультатПоиска.Группы;
			
			// Группы[0] – полное совпадение, далее по порядку открывающих скобок
			Недели = 0;
			Если ЗначениеЗаполнено(Группы[1]) Тогда
				Недели = Число(Группы[1]);
			КонецЕсли;
			
			Дни = 0;
			Если ЗначениеЗаполнено(Группы[2]) Тогда
				Дни = Число(Группы[2]);
			КонецЕсли;
			
			Часы = 0;
			Если ЗначениеЗаполнено(Группы[3]) Тогда
				Часы = Число(Группы[3]);
			КонецЕсли;
			
			Минуты = 0;
			Если ЗначениеЗаполнено(Группы[4]) Тогда
				Минуты = Число(Группы[4]);
			КонецЕсли;
			
			Сек = 0;
			Если ЗначениеЗаполнено(Группы[5]) Тогда
				Сек = Число(Группы[5]);
			КонецЕсли;
			
			Результат = Результат + Недели * 7 * 86400 + Дни * 86400 + Часы * 3600 + Минуты * 60 + Сек;
		КонецЕсли;
	Исключение
		// Если не удалось распарсить — возвращаем 0
		Возврат 0;
	КонецПопытки;

	Возврат Результат;

