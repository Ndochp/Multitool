////////////////////////////////////////////////////////////////////////////////
// Работа с таймлогами по дате (GITL-012)

// Получает timelogs сотрудника за конкретную дату.
//
// Параметры:
//   ПользовательID - Число - идентификатор пользователя в GitLab.
//   Дата           - Дата - дата в формате
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с колонками timelogs (см. ПолучитьTimelogиПоСотруднику).
//
Функция ПолучитьTimelogиПоДатеИСотруднику(Знач ПользовательID, Знач Дата) Экспорт

	// Формируем период из одной даты: on_or_after = Дата, before = Дата + 1 день
	ДатаНач = Формат(Дата, "ДФ=гггг-ММ-дд");
	ДатаКон = Формат(Дата + 24*60*60, "ДФ=гггг-ММ-дд"); // "ГГГГ-ММ-ДД"

	Возврат ПолучитьTimelogиПоСотруднику(ПользовательID, ДатаНач, ДатаКон);

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Удаление timelogs (GITL-013)

// Удаляет timelog по его ID для указанного проекта.
//
// Параметры:
//   TimelogID  - Число - идентификатор записи времени в GitLab.
//   ПроектID   - Число - идентификатор проекта в GitLab.
//
// Возвращаемое значение:
//   Булево - Истина при успешном удалении, Ложь иначе.
//
Функция УдалитьTimelogПоID(Знач TimelogID, Знач ПроектID) Экспорт

	ПроверитьИнициализацию();

	URL = СформироватьURL(СтрШаблон(
		"/api/v4/projects/%1/time_entries/%2", ПроектID, TimelogID));

	Заголовки = ПолучитьЗаголовкиАутентификации();

	Ответ = КоннекторHTTP.Delete(URL, Новый Соответствие, Заголовки);

	Если Ответ.КодСостояния = 204 Или Ответ.КодСостояния = 200 Тогда
		Возврат Истина;
	ИначеЕсли Ответ.КодСостояния = 404 Тогда
		ВызватьИсключение "Timelog с ID " + String(TimelogID) + " не найден.";
	Иначе
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

	Возврат Ложь;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Добавление timelog (GITL-006)

// Создаёт новую запись времени (timelog) в GitLab.
//
// Параметры:
//   ПроектID            - Число - идентификатор проекта в GitLab.
//   IssueIID            - Число - внутренний идентификатор задачи (IID).
//   ДлительностьВСекундах - Число - затраченное время в секундах.
//   ДатаРаботы          - Строка - дата работы в формате "ГГГГ-ММ-ДД".
//   Описание            - Строка - описание выполненной работы.
//
// Возвращаемое значение:
//   Число - идентификатор созданной записи timelog.
//
Функция ДобавитьЗатраченноеВремя(Знач ПроектID, Знач IssueIID, Знач ДлительностьВСекундах, Знач ДатаРаботы, Знач Описание) Экспорт

	ПроверитьИнициализацию();

	URL = СформироватьURL(СтрШаблон(
		"/api/v4/projects/%1/issues/%2/time_spent", ПроектID, IssueIID));

	ТелоЗапроса = Новый Соответствие;
	ТелоЗапроса.Вставить("time_spent", String(ДлительностьВСекундах));
	ТелоЗапроса.Вставить("spent_at", ДатаРаботы);
	ТелоЗапроса.Вставить("summary", Описание);

	JSONСтрока = КоннекторHTTP.ОбъектВJson(ТелоЗапроса);

	ПараметрыЗапроса = КоннекторHTTP.НовыеПараметры();
	ПараметрыЗапроса.Заголовки.Вставить("Content-Type", "application/json");

	Заголовки = ПолучитьЗаголовкиАутентификации();
	ПараметрыЗапроса.Заголовки.Соединить(Заголовки.Заголовки);

	Ответ = КоннекторHTTP.Post(URL, ПараметрыЗапроса, JSONСтрока);

	Если Ответ.КодСостояния = 201 Тогда
		ДанныеОтвета = КоннекторHTTP.JsonВОбъект(Ответ.ПолучитьТелоКакСтроку());
		Возврат ДанныеОтвета.Получить("id");
	ИначеЕсли Ответ.КодСостояния = 422 Тогда
		ВызватьИсключение "Ошибка валидации данных: " + КоннекторHTTP.КакТекст(Ответ);
	Иначе
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

	Возврат 0;

КонецФункции

