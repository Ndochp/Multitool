////////////////////////////////////////////////////////////////////////////////
// Работа с таймлогами (GITL-008, GITL-011)

// Получает список timelogs для задачи за период.
//
// Параметры:
//   ПроектID    - Число - идентификатор проекта в GitLab.
//   IssueIID    - Число - внутренний идентификатор задачи (IID) в GitLab.
//   ДатаНач     - Строка - начальная дата периода в формате "ГГГГ-ММ-ДД".
//   ДатаКон     - Строка - конечная дата периода в формате "ГГГГ-ММ-ДД".
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с колонками:
//     * timelog_id         - Число - идентификатор записи времени.
//     * project_name       - Строка - имя проекта.
//     * issue_title        - Строка - название задачи.
//     * duration_seconds   - Число - длительность в секундах.
//     * spent_at           - Строка - дата затраченного времени.
//     * description        - Строка - описание работы.
//
Функция ПолучитьТаймЛоги(Знач ПроектID, Знач IssueIID, Знач ДатаНач, Знач ДатаКон) Экспорт

	ПроверитьИнициализацию();

	URL = СформироватьURL(СтрШаблон(
		"/api/v4/projects/%1/issues/%2/timelogs", ПроектID, IssueIID));

	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("spent_at_on_or_after", ДатаНач);
	ПараметрыЗапроса.Вставить("spent_at_before", ДатаКон);

	Заголовки = ПолучитьЗаголовкиАутентификации();

	Ответ = КоннекторHTTP.Get(URL, ПараметрыЗапроса, Заголовки);

	Если Ответ.КодСостояния <> 200 Тогда
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

	Возврат ПреобразоватьTimelogиВТаблицуЗначений(ТелоОтветаСтрокой(Ответ));

КонецФункции

// Получает все timelogs сотрудника за период через user time_entries endpoint.
//
// Параметры:
//   ПользовательID - Число - идентификатор пользователя в GitLab.
//   ДатаНач        - Строка - начальная дата периода в формате "ГГГГ-ММ-ДД".
//   ДатаКон        - Строка - конечная дата периода в формате "ГГГГ-ММ-ДД".
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с колонками:
//     * timelog_id         - Число - идентификатор записи времени.
//     * project_name       - Строка - имя проекта.
//     * issue_iid          - Число - внутренний ID задачи в GitLab.
//     * issue_title        - Строка - название задачи.
//     * duration_seconds   - Число - длительность в секундах.
//     * spent_at           - Строка - дата затраченного времени.
//     * description        - Строка - описание работы (note).
//     * web_url            - Строка - ссылка на задачу.
//
Функция ПолучитьTimelogиПоСотруднику(Знач ПользовательID, Знач ДатаНач, Знач ДатаКон) Экспорт

	ПроверитьИнициализацию();

	URL = СформироватьURL(СтрШаблон(
		"/api/v4/users/%1/time_entries", ПользовательID));

	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("date_on_or_after", ДатаНач);
	ПараметрыЗапроса.Вставить("date_before", ДатаКон);

	Заголовки = ПолучитьЗаголовкиАутентификации();

	Ответ = КоннекторHTTP.Get(URL, ПараметрыЗапроса, Заголовки);

	Если Ответ.КодСостояния <> 200 Тогда
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

	Возврат ПреобразоватьTimeEntriesВТаблицуЗначений(ТелоОтветаСтрокой(Ответ));

КонецФункции

// Получает список назначенных задач (Issues) пользователя через GitLab API.
//
// Параметры:
//   ПользовательID - Число - идентификатор пользователя в GitLab.
//   Состояние      - Строка - состояние задач ("opened", "closed", "all").
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с колонками:
//     * issue_id         - Число - идентификатор задачи в GitLab.
//     * issue_iid        - Число - внутренний ID задачи в проекте.
//     * title            - Строка - заголовок задачи.
//     * web_url          - Строка - ссылка на задачу.
//     * проект_id        - Число - идентификатор проекта в GitLab.
//     * состояние        - Строка - текущее состояние задачи.
//
Функция ПолучитьНазначенныеЗадачи(Знач ПользовательID, Знач Состояние = "opened") Экспорт

	ПроверитьИнициализацию();

	URL = СформироватьURL("/api/v4/users/" + String(ПользовательID) + "/issues");

	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("state", Состояние);
	ПараметрыЗапроса.Вставить("assignee_id", String(ПользовательID));

	Заголовки = ПолучитьЗаголовкиАутентификации();

	Ответ = КоннекторHTTP.Get(URL, ПараметрыЗапроса, Заголовки);

	Если Ответ.КодСостояния = 404 Тогда
		ВызватьИсключение "Пользователь с ID " + String(ПользовательID) + " не найден.";
	ИначеЕсли Ответ.КодСостояния <> 200 Тогда
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

	Возврат ПреобразоватьЗадачиВТаблицуЗначений(ТелоОтветаСтрокой(Ответ));

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Зеркало GitLab (GITL-M-001)

// Получает задачи (issues) по метке через глобальный эндпоинт /api/v4/issues.
// Обходит постранично (заголовок X-Next-Page) и собирает расширенный набор
// колонок для зеркалирования в справочники подсистемы GitLabMirror.
//
// Параметры:
//   Метка       - Строка - имя метки GitLab, например "отв: НД".
//   Состояние   - Строка - отбор по состоянию: "opened", "closed", "all".
//   МаксСтраниц - Число - предохранитель от зацикливания (по 100 задач на страницу).
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки см. СоздатьПустуюТаблицуДляЗадачЗеркала().
//
Функция ПолучитьЗадачиПоМетке(Знач Метка, Знач Состояние = "all", Знач МаксСтраниц = 20) Экспорт

	ПроверитьИнициализацию();

	Результат = СоздатьПустуюТаблицуДляЗадачЗеркала();
	Страница  = 1;

	Пока Страница <= МаксСтраниц Цикл

		URL = СформироватьURL("/api/v4/issues");

		ПараметрыЗапроса = Новый Соответствие;
		ПараметрыЗапроса.Вставить("labels", Метка);
		ПараметрыЗапроса.Вставить("scope", "all");
		ПараметрыЗапроса.Вставить("state", Состояние);
		ПараметрыЗапроса.Вставить("order_by", "updated_at");
		ПараметрыЗапроса.Вставить("with_labels_details", "true");
		ПараметрыЗапроса.Вставить("per_page", "100");
		ПараметрыЗапроса.Вставить("page", String(Страница));

		Ответ = КоннекторHTTP.Get(URL, ПараметрыЗапроса, ПолучитьЗаголовкиАутентификации());

		Если Ответ.КодСостояния <> 200 Тогда
			ОбработатьОшибкуОтвет(Ответ);
		КонецЕсли;

		ДополнитьТаблицуЗадачЗеркалаИзJSON(Результат, ТелоОтветаСтрокой(Ответ));

		Следующая = ЗначениеЗаголовка(Ответ, "X-Next-Page");
		Если ПустаяСтрока(Следующая) Тогда
			Прервать;
		КонецЕсли;

		Страница = Страница + 1;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Получает проект по идентификатору (GET /api/v4/projects/:id).
//
// Параметры:
//   Идентификатор - Число - идентификатор проекта в GitLab.
//
// Возвращаемое значение:
//   Структура - ключи: id, name, path, path_with_namespace, web_url,
//     description, http_url_to_repo, ssh_url_to_repo, default_branch,
//     visibility, archived, created_at, last_activity_at.
//     Отсутствующие поля возвращаются пустыми значениями.
//
Функция ПолучитьПроектПоИдентификатору(Знач Идентификатор) Экспорт

	ПроверитьИнициализацию();

	URL = СформироватьURL(СтрШаблон("/api/v4/projects/%1", String(Идентификатор)));

	Ответ = КоннекторHTTP.Get(URL, , ПолучитьЗаголовкиАутентификации());

	Если Ответ.КодСостояния <> 200 Тогда
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

	Данные = КоннекторHTTP.JsonВОбъект(ТелоОтветаСтрокой(Ответ));

	Возврат СтруктураОтОбъектаJSON(Данные,
		"id, name, path, path_with_namespace, web_url, description,"
		+ " http_url_to_repo, ssh_url_to_repo, default_branch, visibility,"
		+ " archived, created_at, last_activity_at");

КонецФункции

// Получает задачу по идентификаторам проекта и IID (GET /api/v4/projects/:id/issues/:iid).
//
// Параметры:
//   ПроектID - Число или Строка - идентификатор проекта в GitLab
//     (число или полный путь "namespace/project", кодируется автоматически).
//   IID      - Число - внутренний идентификатор задачи (IID) в проекте.
//
// Возвращаемое значение:
//   Строка таблицы СоздатьПустуюТаблицуДляЗадачЗеркала;
//   Неопределено - если задача не найдена (404).
//
Функция ПолучитьЗадачуПоПроектуИIID(Знач ПроектID, Знач IID) Экспорт

	ПроверитьИнициализацию();

	Если ТипЗнч(ПроектID) = Тип("Строка") Тогда
		ПроектЧасть = КодироватьСтроку(ПроектID, СпособКодированияСтроки.КодировкаURL);
	Иначе
		ПроектЧасть = String(ПроектID);
	КонецЕсли;

	URL = СформироватьURL(СтрШаблон("/api/v4/projects/%1/issues/%2", ПроектЧасть, String(IID)));

	Ответ = КоннекторHTTP.Get(URL, , ПолучитьЗаголовкиАутентификации());

	Если Ответ.КодСостояния = 404 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Ответ.КодСостояния <> 200 Тогда
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

	// Один объект ответа заворачивается в массив для общего конвертера /issues.
	Таблица = СоздатьПустуюТаблицуДляЗадачЗеркала();
	ДополнитьТаблицуЗадачЗеркалаИзJSON(Таблица, "[" + ТелоОтветаСтрокой(Ответ) + "]");

	Если Таблица.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Таблица[0];

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// GraphQL API (GQL-Q001)

// Получает таймлоги пользователя за период через GraphQL API.
//
// Параметры:
//   ПользовательID - Число - идентификатор пользователя в GitLab.
//   ДатаНач        - Строка - начальная дата периода в формате "ГГГГ-ММ-ДД".
//   ДатаКон        - Строка - конечная дата периода в формате "ГГГГ-ММ-ДД".
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с колонками:
//     * timeentry_id    - Число - уникальный ID записи времени.
//     * duration        - Число - длительность в секундах.
//     * message         - Строка - сообщение/описание работы.
//     * label           - Строка - метка (тег) записи.
//     * spent_at        - Дата - дата выполненной работы.
//     * project_id      - Число - ID проекта.
//     * project_name    - Строка - название проекта.
//     * project_path    - Строка - путь к проекту (namespace/project).
//     * project_web_url - Строка - URL проекта.
//     * issue_id        - Число - ID задачи (если есть).
//     * issue_iid       - Число - внутренний IID задачи.
//     * issue_title     - Строка - название задачи.
//     * issue_state     - Строка - статус задачи (opened/closed/merged).
//     * issue_web_url   - Строка - URL задачи.
//
Функция ПолучитьТаймлогиПользователяGraphQL(Знач ПользовательID, Знач ДатаНач, Знач ДатаКон) Экспорт

	ПроверитьИнициализацию();

	// Формируем GraphQL запрос для получения таймлогов пользователя
	ТекстЗапроса = 
		"query GetUserTimeEntries($userId: ID!, $first: Int!) {
		|  user(username: ""username_placeholder"") {
		|    timeEntries(first: $first) {
		|      nodes {
		|        id
		|        duration
		|        message
		|        label
		|        spentAt
		|        project {
		|          id
		|          name
		|          pathWithNamespace
		|          webUrl
		|        }
		|        issue {
		|          id
		|          iid
		|          title
		|          state
		|          webUrl
		|        }
		|      }
		|    }
		|  }
		|}";

	// Получаем ID пользователя по username
	Username = ПолучитьUsernameПользователя(ПользовательID);
	Если ПустаяСтрока(Username) Тогда
		ВызватьИсключение "Не удалось получить username для пользователя с ID " + String(ПользовательID);
	КонецЕсли;

	// Заменяем placeholder на реальный username
	ТекстЗапроса = СтрЗамениТЬ(ТекстЗапроса, "username_placeholder", Username);

	// Параметры запроса
	ПараметрыGraphQL = Новый Структура;
	ПараметрыGraphQL.Вставить("userId", String(ПользовательID));
	ПараметрыGraphQL.Вставить("first", "100"); // Максимум за один запрос

	// Выполняем GraphQL запрос
	Ответ = ВыполнитьGraphQLЗапрос(ТекстЗапроса, ПараметрыGraphQL);

	Если Ответ = Неопределено Тогда
		Возврат СоздатьПустуюТаблицуДляGraphQLTimelogov();
	КонецЕсли;

	// Преобразуем ответ в ТаблицуЗначений
	Возврат ПреобразоватьGraphQLTimeEntriesВТаблицуЗначений(Ответ, ДатаНач, ДатаКон);

КонецФункции

// Получает username пользователя по его ID через GraphQL API.
//
// Параметры:
//   ПользовательID - Число - идентификатор пользователя в GitLab.
//
// Возвращаемое значение:
//   Строка - username пользователя или пустая строка при ошибке.
//
Функция ПолучитьUsernameПользователя(Знач ПользовательID) Экспорт

	ТекстЗапроса = 
		"query GetUser($userId: ID!) {
		|  user(username: ""placeholder"") {
		|    id
		|    username
		|  }
		|}";

	Параметры = Новый Структура;
	Параметры.Вставить("userId", String(ПользовательID));

	Ответ = ВыполнитьGraphQLЗапрос(ТекстЗапроса, Параметры);

	Если Ответ = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	// Полезная нагрузка запроса GetUser: data.user.username.
	UserData = Ответ.Получить("user");
	Если UserData = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Username = UserData.Получить("username");

	Возврат ?(Username = Неопределено, "", Строка(Username));

КонецФункции

// Получает username пользователя, владеющего токеном, через GraphQL API.
// Токен сам идентифицирует пользователя, поэтому дополнительный параметр не нужен.
//
// Возвращаемое значение:
//   Строка - username текущего пользователя; пустая строка, если не получен.
//
Функция ПолучитьUsernameТекущегоПользователя() Экспорт

	ТекстЗапроса =
		"query GetCurrentUser {
		|  currentUser {
		|    username
		|  }
		|}";

	Ответ = ВыполнитьGraphQLЗапрос(ТекстЗапроса, Новый Структура);

	Если Ответ = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ТекущийПользователь = Ответ.Получить("currentUser");
	Если ТекущийПользователь = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(ТекущийПользователь.Получить("username"));

КонецФункции

// Получает таймлоги текущего пользователя (по токену) на дату через GraphQL API.
//
// Параметры:
//   Дата - Дата - день, за который собираются таймлоги
//     (endDate = следующий день, не включается).
//
// Возвращаемое значение:
//   ТаблицаЗначений - СоздатьПустуюТаблицуДляТаймлоговНаДату.
//
Функция ПолучитьТаймлогиНаДатуGraphQL(Знач Дата) Экспорт

	ПроверитьИнициализацию();

	Результат = СоздатьПустуюТаблицуДляТаймлоговНаДату();

	Username = ПолучитьUsernameТекущегоПользователя();
	Если ПустаяСтрока(Username) Тогда
		ВызватьИсключение "Не удалось определить username текущего пользователя GitLab по токену";
	КонецЕсли;

	ТекстЗапроса =
		"query MyTimelogsForDate($startDate: Date!, $endDate: Date!, $username: String!, $after: String) {
		|  timelogs(startDate: $startDate, endDate: $endDate, username: $username, after: $after) {
		|    nodes {
		|      id
		|      timeSpent
		|      spentAt
		|      summary
		|      issue {
		|        id
		|        iid
		|        title
		|        webUrl
		|        project {
		|          id
		|          name
		|          pathWithNamespace
		|          webUrl
		|        }
		|      }
		|    }
		|    pageInfo {
		|      hasNextPage
		|      endCursor
		|    }
		|  }
		|}";

	ПараметрыGraphQL = Новый Структура;
	ПараметрыGraphQL.Вставить("startDate", СтрокаДатыGraphQL(Дата));
	ПараметрыGraphQL.Вставить("endDate",   СтрокаДатыGraphQL(Дата + 86400));
	ПараметрыGraphQL.Вставить("username",  Username);

	Курсор = "";
	Пока Истина Цикл

		ПараметрыGraphQL.Вставить("after", Курсор);

		Ответ = ВыполнитьGraphQLЗапрос(ТекстЗапроса, ПараметрыGraphQL);

		Если Ответ = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Таймлоги = Ответ.Получить("timelogs");
		Если Таймлоги = Неопределено Тогда
			Прервать;
		КонецЕсли;

		ДополнитьТаблицуТаймлоговНаДатуИзJSON(Результат, Таймлоги);

		ИнфоСтраницы = Таймлоги.Получить("pageInfo");
		Если ИнфоСтраницы = Неопределено
			Или ИнфоСтраницы.Получить("hasNextPage") <> Истина Тогда
			Прервать;
		КонецЕсли;

		Курсор = Строка(ИнфоСтраницы.Получить("endCursor"));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Выполняет GraphQL запрос к GitLab API.
//
// Параметры:
//   ТекстЗапроса  - Строка - текст GraphQL запроса/мутации.
//   ПараметрыЗапроса - Структура - параметры для подстановки в запрос.
//
// Возвращаемое значение:
//   Объект - распарсенный ответ GraphQL (Объект/Массив) или Неопределено при ошибке.
//
Функция ВыполнитьGraphQLЗапрос(Знач ТекстЗапроса, Знач ПараметрыЗапроса) Экспорт
   //+++
	// Формируем тело GraphQL запроса
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("query", ТекстЗапроса);

	// Формируем variables для подстановки
	Variables = Новый Соответствие();
	Для Каждого КлючЗнач Из ПараметрыЗапроса Цикл
		Variables.Вставить(КлючЗнач.Ключ, КлючЗнач.Значение);
	КонецЦикла;

	ТелоЗапроса.Вставить("variables", Variables);

	// Формируем JSON строку тела запроса
	JSONТело = КоннекторHTTP.ОбъектВJSON(ТелоЗапроса);

	// Отправляем POST запрос к GraphQL endpoint.
	// Токен передаётся заголовком PRIVATE-TOKEN (см. ПолучитьЗаголовкиАутентификации).
	URL = СформироватьURL("/api/graphql");
	Ответ = КоннекторHTTP.PostJson(URL, JSONТело, ПолучитьЗаголовкиАутентификации());

	// PostJson возвращает уже распарсенный JSON ответа (Соответствие при
	// настройках по умолчанию, см. КоннекторHTTP.ПараметрыПреобразованияJSONПоУмолчанию);
	// сетевые ошибки пробрасываются как исключение.
	// Полезная нагрузка GraphQL лежит в ключе "data" (нижний регистр);
	// Неопределено (ошибка GraphQL) потребители трактуют как «пустой ответ».
	Возврат Ответ["data"];

КонецФункции

// Преобразует JSON-ответ GraphQL (timeEntries) в таблицу значений.
//
// Параметры:
//   ОтветGraphQL - Объект - ответ от GraphQL API (структура с полями timeEntries).
//   ДатаНач      - Строка - начальная дата фильтрации.
//   ДатаКон      - Строка - конечная дата фильтрации.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с преобразованными данными.
//
Функция ПреобразоватьGraphQLTimeEntriesВТаблицуЗначений(Знач ОтветGraphQL, Знач ДатаНач, Знач ДатаКон) Экспорт

	Результат = СоздатьПустуюТаблицуДляGraphQLTimelogov();

	Если ОтветGraphQL = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	// Получаем nodes из ответа
	TimeEntries = ОтветGraphQL.Получить("timeEntries");
	Если TimeEntries = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Nodes = TimeEntries.Получить("nodes");
	Если ТипЗнч(Nodes) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Элемент Из Nodes Цикл
		
		// Фильтрация по дате
		SpentAt = Элемент.Получить("spentAt");
		Если Не ПустаяСтрока(ДатаНач) И Не ПустаяСтрока(ДатаКон) Тогда
			Если SpentAt < ДатаНач Или SpentAt > ДатаКон Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		СтрокаТаблицы = Результат.Добавить();

		// Основные поля таймлога
		СтрокаТаблицы.timeentry_id  = Элемент.Получить("id");
		
		DurationStr = Элемент.Получить("duration");
		СтрокаТаблицы.duration = ПреобразоватьGraphQLDurationВСекунды(DurationStr);
		
		СтрокаТаблицы.message   = Элемент.Получить("message");
		СтрокаТаблицы.label     = Элемент.Получить("label");
		СтрокаТаблицы.spent_at  = Элемент.Получить("spentAt");

		// Данные проекта
		Проект = Элемент.Получить("project");
		Если Проект <> Неопределено Тогда
			СтрокаТаблицы.project_id      = Проект.Получить("id");
			СтрокаТаблицы.project_name    = Проект.Получить("name");
			СтрокаТаблицы.project_path    = Проект.Получить("pathWithNamespace");
			СтрокаТаблицы.project_web_url = Проект.Получить("webUrl");
		КонецЕсли;

		// Данные задачи
		Задача = Элемент.Получить("issue");
		Если Задача <> Неопределено Тогда
			СтрокаТаблицы.issue_id    = Задача.Получить("id");
			СтрокаТаблицы.issue_iid   = Задача.Получить("iid");
			СтрокаТаблицы.issue_title = Задача.Получить("title");
			СтрокаТаблицы.issue_state = Задача.Получить("state");
			СтрокаТаблицы.issue_web_url = Задача.Получить("webUrl");
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Преобразует длительность из формата GraphQL (ISO 8601) в секунды.
//
// Параметры:
//   DurationGraphQL - Строка - длительность в формате ISO 8601 (например, PT30S, P1DT2H).
//
// Возвращаемое значение:
//   Число - количество секунд.
//
Функция ПреобразоватьGraphQLDurationВСекунды(Знач DurationGraphQL) Экспорт

	Если ПустаяСтрока(DurationGraphQL) Или DurationGraphQL = "PT0S" Тогда
		Возврат 0;
	КонецЕсли;

	Результат = 0;

	// Парсим формат ISO 8601: P[n]W или P[n]DT[n]H[n]M[n]S
	Попытка
		// Парсим формат ISO 8601: P[n]W или P[n]DT[n]H[n]M[n]S
		// Единый шаблон для разбора всех компонентов длительности
		Шаблон = "^P(?:(\d+)W)?(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?)?$";
		МассивВхождений = СтрНайтиВсеПоРегулярномуВыражению(DurationGraphQL, Шаблон, Ложь, Ложь);
		
		Если МассивВхождений.Количество() > 0 Тогда
			// Берём первое (и единственное) совпадение
			РезультатПоиска = МассивВхождений[0];
			Группы = РезультатПоиска.Группы;
			
			// Группы[0] – полное совпадение, далее по порядку открывающих скобок
			Недели = 0;
			Если ЗначениеЗаполнено(Группы[1]) Тогда
				Недели = Число(Группы[1]);
			КонецЕсли;
			
			Дни = 0;
			Если ЗначениеЗаполнено(Группы[2]) Тогда
				Дни = Число(Группы[2]);
			КонецЕсли;
			
			Часы = 0;
			Если ЗначениеЗаполнено(Группы[3]) Тогда
				Часы = Число(Группы[3]);
			КонецЕсли;
			
			Минуты = 0;
			Если ЗначениеЗаполнено(Группы[4]) Тогда
				Минуты = Число(Группы[4]);
			КонецЕсли;
			
			Сек = 0;
			Если ЗначениеЗаполнено(Группы[5]) Тогда
				Сек = Число(Группы[5]);
			КонецЕсли;
			
			Результат = Результат + Недели * 7 * 86400 + Дни * 86400 + Часы * 3600 + Минуты * 60 + Сек;
		КонецЕсли;
	Исключение
		// Если не удалось распарсить — возвращаем 0
		Возврат 0;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Создаёт пустую таблицу таймлогов за дату (GraphQL-запрос timelogs).
//
// Колонки:
//   * timeentry_id     - Строка - глобальный ID записи времени (gid).
//   * duration_seconds - Число  - длительность в секундах.
//   * spent_at         - Дата   - момент списания времени.
//   * summary          - Строка - комментарий к записи.
//   * issue_id         - Число  - глобальный ID задачи (из gid).
//   * issue_iid        - Число  - IID задачи в проекте.
//   * issue_title      - Строка - название задачи.
//   * issue_web_url    - Строка - URL задачи.
//   * project_id       - Число  - глобальный ID проекта (из gid).
//   * project_name     - Строка - название проекта.
//   * project_path     - Строка - полный путь проекта.
//   * project_web_url  - Строка - URL проекта.
//
// Возвращаемое значение:
//   ТаблицаЗначений.
//
Функция СоздатьПустуюТаблицуДляТаймлоговНаДату() Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("timeentry_id",     Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("duration_seconds", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("spent_at",         Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("summary",          Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("issue_id",         Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("issue_iid",        Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("issue_title",      Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("issue_web_url",    Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("project_id",       Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("project_name",     Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("project_path",     Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("project_web_url",  Новый ОписаниеТипов("Строка"));

	Возврат Результат;

КонецФункции

#КонецОбласти // ПрограммныйИнтерфейс

