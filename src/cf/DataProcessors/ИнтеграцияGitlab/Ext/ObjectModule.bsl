// Модуль объекта обработки ИнтеграцияGitlab
// Адаптер к GitLab REST API.
// Использует КоннекторHTTP для выполнения HTTP-запросов.
// Версия: 1.0.0

// ============================================================================
// Реквизиты состояния (по CodingRules п.2.2)
// ============================================================================

БазовыйURL				= Строка; // URL GitLab сервера
Токен					= Строка; // Токен аутентификации PRIVATE-TOKEN
Кэш					= Соответствие; // Кэш маппингов сущностей

#Область ПрограммныйИнтерфейс

////////////////////////////////////////////////////////////////////////////////
// Инициализация (GITL-004)

// Устанавливает базовый URL GitLab сервера.
//
// Параметры:
//   БазовыйURL - Строка - URL GitLab сервера, например "https://gitlab.example.com".
//
Процедура УстановитьБазовыйURL(Знач БазовыйURL) Экспорт

	БазовыйURL = БазовыйURL;

КонецПроцедуры

// Устанавливает токен аутентификации для GitLab API.
//
// Параметры:
//   Токен - Строка - персональный токен доступа GitLab (PRIVATE-TOKEN).
//
Процедура УстановитьТокен(Знач Токен) Экспорт

	Токен = Токен;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Работа с таймлогами (GITL-008, GITL-011)

// Получает список timelogs для задачи за период.
//
// Параметры:
//   ПроектID    - Число - идентификатор проекта в GitLab.
//   IssueIID    - Число - внутренний идентификатор задачи (IID) в GitLab.
//   ДатаНач     - Строка - начальная дата периода в формате "ГГГГ-ММ-ДД".
//   ДатаКон     - Строка - конечная дата периода в формате "ГГГГ-ММ-ДД".
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с колонками:
//     * timelog_id         - Число - идентификатор записи времени.
//     * project_name       - Строка - имя проекта.
//     * issue_title        - Строка - название задачи.
//     * duration_seconds   - Число - длительность в секундах.
//     * spent_at           - Строка - дата затраченного времени.
//     * description        - Строка - описание работы.
//
Функция ПолучитьTimelogи(Знач ПроектID, Знач IssueIID, Знач ДатаНач, Знач ДатаКон) Экспорт

	ПроверитьИнициализацию();

	URL = СформироватьURL(СтрШаблон(
		"/api/v4/projects/%1/issues/%2/timelogs", ПроектID, IssueIID));

	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("spent_at_on_or_after", ДатаНач);
	ПараметрыЗапроса.Вставить("spent_at_before", ДатаКон);

	Заголовки = ПолучитьЗаголовкиАутентификации();

	Ответ = КоннекторHTTP.Get(URL, ПараметрыЗапроса, Заголовки);

	Если Ответ.КодСостояния <> 200 Тогда
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

	Возврат ПреобразоватьTimelogиВТаблицуЗначений(Ответ.ПолучитьТелоКакСтроку());

КонецФункции

// Получает все timelogs сотрудника за период через user time_entries endpoint.
//
// Параметры:
//   ПользовательID - Число - идентификатор пользователя в GitLab.
//   ДатаНач        - Строка - начальная дата периода в формате "ГГГГ-ММ-ДД".
//   ДатаКон        - Строка - конечная дата периода в формате "ГГГГ-ММ-ДД".
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с колонками:
//     * timelog_id         - Число - идентификатор записи времени.
//     * project_name       - Строка - имя проекта.
//     * issue_iid          - Число - внутренний ID задачи в GitLab.
//     * issue_title        - Строка - название задачи.
//     * duration_seconds   - Число - длительность в секундах.
//     * spent_at           - Строка - дата затраченного времени.
//     * description        - Строка - описание работы (note).
//     * web_url            - Строка - ссылка на задачу.
//
Функция ПолучитьTimelogиПоСотруднику(Знач ПользовательID, Знач ДатаНач, Знач ДатаКон) Экспорт

	ПроверитьИнициализацию();

	URL = СформироватьURL(СтрШаблон(
		"/api/v4/users/%1/time_entries", ПользовательID));

	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("date_on_or_after", ДатаНач);
	ПараметрыЗапроса.Вставить("date_before", ДатаКон);

	Заголовки = ПолучитьЗаголовкиАутентификации();

	Ответ = КоннекторHTTP.Get(URL, ПараметрыЗапроса, Заголовки);

	Если Ответ.КодСостояния <> 200 Тогда
		ОбработатьОшибкуОтвет(Ответ);
	КонецЕсли;

	Возврат ПреобразоватьTimeEntriesВТаблицуЗначений(Ответ.ПолучитьТелоКакСтроку());

КонецФункции

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// Инициализация и проверка (GITL-004)

// Формирует полный URL для запроса к GitLab API.
//
// Параметры:
//   Эндпоинт - Строка - путь эндпоинта, например "/api/v4/projects/1".
//
// Возвращаемое значение:
//   Строка - полный URL.
//
Функция СформироватьURL(Знач Эндпоинт) Экспорт

	Возврат БазовыйURL + Эндпоинт;

КонецФункции

// Проверяет, что базовый URL и токен установлены.
//
Процедура ПроверитьИнициализацию() Экспорт

	Если ПустаяСтрока(БазовыйURL) Тогда
		ВызватьИсключение "Не установлен базовый URL GitLab сервера. Вызовите УстановитьБазовыйURL().";
	КонецЕсли;

	Если ПустаяСтрока(Токен) Тогда
		ВызватьИсключение "Не установлен токен доступа GitLab. Вызовите УстановитьТокен().";
	КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Аутентификация (CodingRules п.5)

// Возвращает заголовки аутентификации для GitLab API.
//
// Возвращаемое значение:
//   Структура - параметры HTTP-запроса с заголовком PRIVATE-TOKEN.
//
Функция ПолучитьЗаголовкиАутентификации() Экспорт

	Параметры = КоннекторHTTP.НовыеПараметры();
	Параметры.Заголовки.Вставить("PRIVATE-TOKEN", Токен);
	Возврат Параметры;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Обработка ошибок (CodingRules п.8)

// Универсальный обработчик HTTP-ответов с ошибками.
//
// Параметры:
//   Ответ - объект ответа КоннекторHTTP с свойствами КодСостояния и Тело.
//
Процедура ОбработатьОшибкуОтвет(Знач Ответ)
	
	Код = Ответ.КодСостояния;
	Тело = КоннекторHTTP.КакТекст(Ответ);

	Если Код = 401 Тогда
		ВызватьИсключение "Не авторизован. Проверьте токен.";
	ИначеЕсли Код = 403 Тогда
		ВызватьИсключение "Доступ запрещён.";
	ИначеЕсли Код = 404 Тогда
		ВызватьИсключение "Ресурс не найден.";
	Иначе
		ВызватьИсключение String(Код) + ": " + Тело;
	КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Преобразование данных (CodingRules п.4)

// Преобразует JSON-ответ GitLab API (timelogs для задачи) в таблицу значений.
// Формирует ТаблицуЗначений с колонками:
//   timelog_id, project_name, issue_title, duration_seconds, spent_at, description
//
// Параметры:
//   ДанныеJSON - Строка - тело ответа в формате JSON.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с преобразованными данными.
//
Функция ПреобразоватьTimelogиВТаблицуЗначений(Знач ДанныеJSON) Экспорт

	Результат = СоздатьПустуюТаблицуДляTimelogov();

	Попытка
		Данные = КоннекторHTTP.JsonВОбъект(ДанныеJSON);
	Исключение
		// Ошибка парсинга JSON — возвращаем пустую таблицу
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Элемент Из Данные Цикл
		СтрокаТаблицы = Результат.Добавить();
		
		СтрокаТаблицы.timelog_id			= Элемент.Получить("id");
		СтрокаТаблицы.duration_seconds		= Элемент.Получить("time_spent");
		СтрокаТаблицы.spent_at				= Элемент.Получить("spent_at");
		СтрокаТаблицы.description			= Элемент.Получить("summary");

		Проект = Элемент.Получить("project");
		Если Проект <> Неопределено Тогда
			СтрокаТаблицы.project_name = Проект.Получить("name");
		КонецЕсли;

		Задача = Элемент.Получить("issue");
		Если Задача <> Неопределено Тогда
			СтрокаТаблицы.issue_title = Задача.Получить("title");
		КонецЕсли;
		
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Преобразует JSON-ответ GitLab API (user time_entries) в таблицу значений.
// Формирует ТаблицуЗначений с колонками:
//   timelog_id, project_name, issue_iid, issue_title, duration_seconds, spent_at, description, web_url
//
// Параметры:
//   ДанныеJSON - Строка - тело ответа в формате JSON.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с преобразованными данными.
//
Функция ПреобразоватьTimeEntriesВТаблицуЗначений(Знач ДанныеJSON) Экспорт

	Результат = СоздатьПустуюТаблицуДляTimeEntries();

	Попытка
		Данные = КоннекторHTTP.JsonВОбъект(ДанныеJSON);
	Исключение
		// Ошибка парсинга JSON — возвращаем пустую таблицу
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Элемент Из Данные Цикл
		СтрокаТаблицы = Результат.Добавить();
		
		СтрокаТаблицы.timelog_id			= Элемент.Получить("id");
		СтрокаТаблицы.duration_seconds		= Элемент.Получить("time_spent");
		СтрокаТаблицы.spent_at				= Элемент.Получить("spent_at");
		СтрокаТаблицы.description			= Элемент.Получить("note");

		Проект = Элемент.Получить("project");
		Если Проект <> Неопределено Тогда
			СтрокаТаблицы.project_name = Проект.Получить("name");
			СтрокаТаблицы.web_url				= Проект.Получить("web_url");
		КонецЕсли;

		Цель = Элемент.Получить("target");
		Если Цель <> Неопределено Тогда
			СтрокаТаблицы.issue_iid			= Цель.Получить("iid");
			СтрокаТаблицы.issue_title		= Цель.Получить("title");
			
			// web_url из target имеет приоритет (содержит полный путь к задаче)
			Если ЗначениеЗаполнено(Цель.Получить("web_url")) Тогда
				СтрокаТаблицы.web_url = Цель.Получить("web_url");
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Создает пустую ТаблицуЗначений для timelogs (задача-таймлоги).
//
// Возвращаемое значение:
//   ТаблицаЗначений - пустая таблица с описанными колонками.
//
Функция СоздатьПустуюТаблицуДляTimelogov() Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("timelog_id",			Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("project_name",			Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("issue_title",			Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("duration_seconds",		Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("spent_at",				Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("description",			Новый ОписаниеТипов("Строка"));
	
	Возврат Результат;

КонецФункции

// Создает пустую ТаблицуЗначений для user time entries.
//
// Возвращаемое значение:
//   ТаблицаЗначений - пустая таблица с описанными колонками.
//
Функция СоздатьПустуюТаблицуДляTimeEntries() Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("timelog_id",			Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("project_name",			Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("issue_iid",				Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("issue_title",			Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("duration_seconds",		Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("spent_at",				Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("description",			Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("web_url",				Новый ОписаниеТипов("Строка"));
	
	Возврат Результат;

КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции