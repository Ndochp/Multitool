		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		// Ответ не массив — это объект со статистикой
		СтрокаТаблицы = Результат.Добавить();
		
		TimeSpent = Данные.Получить("time_spent");
		Если TimeSpent <> Неопределено Тогда
			СтрокаТаблицы.time_spent = String(TimeSpent);
		КонецЕсли;

		TotalTimeSpent = Данные.Получить("total_time_spent");
		Если TotalTimeSpent <> Неопределено Тогда
			СтрокаТаблицы.total_time_spent = Число(TotalTimeSpent);
		КонецЕсли;
		
		Возврат Результат;
	КонецЕсли;

	Для Каждого Элемент Из Данные Цикл
		СтрокаТаблицы = Результат.Добавить();
		
		TimeSpent = Элемент.Получить("time_spent");
		Если TimeSpent <> Неопределено Тогда
			СтрокаТаблицы.time_spent = String(TimeSpent);
		КонецЕсли;

		TotalTimeSpent = Элемент.Получить("total_time_spent");
		Если TotalTimeSpent <> Неопределено Тогда
			СтрокаТаблицы.total_time_spent = Число(TotalTimeSpent);
		КонецЕсли;
		
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Преобразует JSON-ответ GitLab API (список проектов) в таблицу значений.
//
// Параметры:
//   ДанныеJSON - Строка - тело ответа в формате JSON.
//
Функция ПреобразоватьПроектыВТаблицуЗначений(Знач ДанныеJSON) Экспорт

	Результат = СоздатьПустуюТаблицуДляПроектов();

	Попытка
		Данные = КоннекторHTTP.JsonВОбъект(ДанныеJSON);
	Исключение
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Элемент Из Данные Цикл
		СтрокаТаблицы = Результат.Добавить();
		
		СтрокаТаблицы.проект_id     = Элемент.Получить("id");
		СтрокаТаблицы.name          = Элемент.Получить("name");
		СтрокаТаблицы.web_url       = Элемент.Получить("web_url");
		
		Namespace = Элемент.Получить("namespace");
		Если Namespace <> Неопределено Тогда
			СтрокаТаблицы.namespace_path = Namespace.Получить("full_path");
		КонецЕсли;
		
	КонецЦикла;

	Возврат Результат;

КонецФункции

