//     * namespace_path - Строка - путь к пространству имён (группе).
//
Функция ПолучитьПроекты(Знач Состояние = "active") Экспорт

	ПроверитьИнициализацию();

	URL = СформироватьURL("/api/v4/projects?membership=true&state=" + Состояние);

	Заголовки = ПолучитьЗаголовкиАутентификации();

	Ответ = КоннекторHTTP.Get(URL, Новый Соответствие, Заголовки);

	Если Ответ.КодСостояния <> 200 Тогда
		ОбработатьОшибкуОтвет(Ответ);
