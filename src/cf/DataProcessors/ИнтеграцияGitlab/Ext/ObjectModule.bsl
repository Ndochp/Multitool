// Получает проекты пользователя через GraphQL API.
//
/// Параметры:
///   ПользовательID - Число - идентификатор пользователя в GitLab.
///   Параллельно    - Булево - выполнять ли параллельно (не используется, для совместимости).
///
/// Возвращаемое значение:
///   ТаблицаЗначений - таблица с колонками:
///     * project_id      - Число - уникальный ID проекта.
///     * project_name    - Строка - название проекта.
///     * project_path    - Строка - полный путь (namespace/project).
///     * description     - Строка - описание проекта.
///     * web_url         - Строка - URL проекта в веб-интерфейсе.
///     * api_url         - Строка - URL API проекта.
///     * archived        - Булево - архивирован ли проект.
///     * visibility      - Строка - видимость (PRIVATE/INTERNAL/PUBLIC).
///     * default_branch  - Строка - ветка по умолчанию.
///
Функция ПолучитьПроектыПользователяGraphQL(Знач ПользовательID, Знач Параллельно = Ложь) Экспорт

	ПроверитьИнициализацию();

	// Получаем username пользователя
	Username = ПолучитьUsernameПользователя(ПользовательID);
	Если ПустаяСтрока(Username) Тогда
		ВызватьИсключение "Не удалось получить username для пользователя с ID " + String(ПользовательID);
	КонецЕсли;

	// Формируем GraphQL запрос для получения проектов пользователя с пагинацией
	ТекстЗапроса = 
		"query GetUserProjects($userId: ID!, $first: Int!, $after: String) {
		|  user(username: \""" + Username + "\"") {
		|    projects(first: $first, after: $after, includeAllNamespaces: true) {
		|      nodes {
		|        id
		|        name
		|        pathWithNamespace
		|        description
		|        webUrl
		|        url
		|        archived
		|        visibility
		|        defaultBranchName
		|      }
		|      pageInfo {
		|        hasNextPage
		|        endCursor
		|      }
		|    }
		|  }
		|}";

	Результат = СоздатьПустуюТаблицуДляGraphQLПроектов();
	Курсор = Неопределено;
	МаксЗаписейНаЗапрос = 100;

	Пока Истина Цикл

		ПараметрыGraphQL = Новый Структура;
		ПараметрыGraphQL.Вставить("userId", String(ПользовательID));
		ПараметрыGraphQL.Вставить("first", String(МаксЗаписейНаЗапрос));
		Если Курсор <> Неопределено Тогда
			ПараметрыGraphQL.Вставить("after", Курсор);
		КонецЕсли;

		Ответ = ВыполнитьGraphQLЗапрос(ТекстЗапроса, ПараметрыGraphQL);

		Если Ответ = Неопределено Тогда
			Прервать;
		КонецЕсли;

		// Преобразуем полученные данные
		ПреобразоватьGraphQLПроектыВТаблицуЗначений(Ответ, Результат);

		// Проверяем пагинацию
		UserData = Ответ.Получить("user");
		Если UserData = Неопределено Тогда
			Прервать;
		КонецЕсли;

		ProjectsData = UserData.Получить("projects");
		Если ProjectsData = Неопределено Тогда
			Прервать;
		КонецЕсли;

		PageInfo = ProjectsData.Получить("pageInfo");
		Если PageInfo = Неопределено ИЛИ PageInfo.Получить("hasNextPage") <> Истина Тогда
			Прервать;
		КонецЕсли;

		Курсор = PageInfo.Получить("endCursor");
		Если ПустаяСтрока(Курсор) Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Преобразует JSON-ответ GraphQL (projects) в таблицу значений.
//
/// Параметры:
///   ОтветGraphQL - Объект - ответ от GraphQL API (структура с полями projects).
///   Результат    - ТаблицаЗначений - таблица для заполнения (передается по ссылке).
///
Функция ПреобразоватьGraphQLПроектыВТаблицуЗначений(Знач ОтветGraphQL, Результат) Экспорт

	Если ОтветGraphQL = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	UserData = ОтветGraphQL.Получить("user");
	Если UserData = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ProjectsData = UserData.Получить("projects");
	Если ProjectsData = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Nodes = ProjectsData.Получить("nodes");
	Если ТипЗнч(Nodes) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Элемент Из Nodes Цикл

		СтрокаТаблицы = Результат.Добавить();

		СтрокаТаблицы.project_id     = Элемент.Получить("id");
		СтрокаТаблицы.project_name   = Элемент.Получить("name");
		СтрокаТаблицы.project_path   = Элемент.Получить("pathWithNamespace");
		СтрокаТаблицы.description    = Элемент.Получить("description");
		СтрокаТаблицы.web_url        = Элемент.Получить("webUrl");
		СтрокаТаблицы.api_url        = Элемент.Получить("url");
		СтрокаТаблицы.archived       = Элемент.Получить("archived");
		СтрокаТаблицы.visibility     = Элемент.Получить("visibility");
		СтрокаТаблицы.default_branch = Элемент.Получить("defaultBranchName");

	КонецЦикла;

КонецФункции

