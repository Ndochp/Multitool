// Дополняет таблицу задач данными JSON-ответа эндпоинта /issues.
//
// Параметры:
//   Таблица    - ТаблицаЗначений - целевая таблица (СоздатьПустуюТаблицуДляЗадачЗеркала).
//   ДанныеJSON - Строка - тело ответа в формате JSON (массив задач).
//
Процедура ДополнитьТаблицуЗадачЗеркалаИзJSON(Знач Таблица, Знач ДанныеJSON)

	Попытка
		Данные = КоннекторHTTP.JsonВОбъект(ДанныеJSON);
	Исключение
		Возврат;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Элемент Из Данные Цикл

		Строка = Таблица.Добавить();

		Строка.issue_id         = Элемент.Получить("id");
		Строка.issue_iid        = Элемент.Получить("iid");
		Строка.project_id       = Элемент.Получить("project_id");
		Строка.title            = Элемент.Получить("title");
		Строка.description      = Элемент.Получить("description");
		Строка.state            = Элемент.Получить("state");
		Строка.web_url          = Элемент.Получить("web_url");

		Автор = Элемент.Получить("author");
		Если Автор <> Неопределено Тогда
			Строка.author_id       = Автор.Получить("id");
			Строка.author_username = Автор.Получить("username");
			Строка.author_name     = Автор.Получить("name");
		КонецЕсли;

		Строка.created_at = ДатаИзISO(Элемент.Получить("created_at"));
		Строка.updated_at = ДатаИзISO(Элемент.Получить("updated_at"));
		Строка.closed_at  = ДатаИзISO(Элемент.Получить("closed_at"));
		Строка.due_date   = ДатаИзISO(Элемент.Получить("due_date"));

		Строка.weight     = ЧислоИзЗначения(Элемент.Получить("weight"));
		Строка.time_estimate    = ЧислоИзЗначения(Элемент.Получить("time_estimate"));
		Строка.total_time_spent = ЧислоИзЗначения(Элемент.Получить("total_time_spent"));

		Статистика = Элемент.Получить("time_stats");
		Если Статистика <> Неопределено Тогда
			Строка.time_estimate    = ЧислоИзЗначения(Статистика.Получить("time_estimate"));
			Строка.total_time_spent = ЧислоИзЗначения(Статистика.Получить("total_time_spent"));
		КонецЕсли;

		Строка.labels_json    = СтрокаЗначенияJSON(Элемент.Получить("labels"));
		Строка.assignees_json = СтрокаЗначенияJSON(Элемент.Получить("assignees"));

	КонецЦикла;

КонецПроцедуры

// Возвращает значение заголовка HTTP-ответа без учёта регистра имени.
//
// Параметры:
//   Ответ        - объект ответа КоннекторHTTP.
//   ИмяЗаголовка - Строка - имя заголовка, например "X-Next-Page".
//
// Возвращаемое значение:
//   Строка - значение заголовка; пустая строка, если заголовка нет.
//
Функция ЗначениеЗаголовка(Знач Ответ, Знач ИмяЗаголовка)

	Заголовки = Ответ.Заголовки;
	Если ТипЗнч(Заголовки) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого Пара Из Заголовки Цикл
		Если НРег(String(Пара.Ключ)) = НРег(ИмяЗаголовка) Тогда
			Возврат Строка(Пара.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Преобразует ISO-дату GitLab ("2026-10-07T08:18:12.217Z") в значение Дата.
//
// Параметры:
//   СтрокаISO - Строка - дата в формате ISO 8601.
//
// Возвращаемое значение:
//   Дата - пустая дата, если строка не распознана.
//
Функция ДатаИзISO(Знач СтрокаISO)

	Результат = '00010101';

	Если ТипЗнч(СтрокаISO) = Тип("Строка") И СтрДлина(СтрокаISO) >= 19 Тогда
		Попытка
			Результат = XMLЗначение(Тип("Дата"), Лев(СтрокаISO, 19));
		Исключение
			ЗаписьЖурналаРегистрации("ИнтеграцияGitlab.ДатаИзISO",
				УровеньЖурналаРегистрации.Ошибка, , СтрокаISO,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Результат = '00010101';
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Преобразует значение JSON в число (0, если значение не число).
//
Функция ЧислоИзЗначения(Знач ЗначениеJSON)

	Если ТипЗнч(ЗначениеJSON) = Тип("Число") Тогда
		Возврат ЗначениеJSON;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Извлекает число из глобального идентификатора GraphQL
// ("gid://gitlab/Issue/123" -> 123).
//
// Возвращаемое значение:
//   Число - числовая часть идентификатора; 0, если не распознана.
//
Функция ЧислоИзGid(Знач GidСтрока)

	Если ТипЗнч(GidСтрока) <> Тип("Строка") Тогда
		Возврат 0;
	КонецЕсли;

	Позиция = СтрНайти(GidСтрока, "/", НаправлениеПоиска.СКонца);
	Если Позиция = 0 Тогда
		Возврат 0;
	КонецЕсли;

	ЧислоСтрокой = Сред(GidСтрока, Позиция + 1);

	Если ПустаяСтрока(ЧислоСтрокой) Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Возврат Число(ЧислоСтрокой);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Форматирует дату для параметров GraphQL-запросов: "ГГГГ-ММ-ДД".
//
Функция СтрокаДатыGraphQL(Знач Дата)

	Возврат Формат(Дата, "ДФ=yyyy-MM-dd");

КонецФункции

// Дополняет таблицу таймлогов узлами ответа GraphQL-запроса timelogs.
//
// Параметры:
//   Таблица  - ТаблицаЗначений - целевая таблица (СоздатьПустуюТаблицуДляТаймлоговНаДату).
//   Таймлоги - Объект - разобранный узел "timelogs" ответа (nodes, pageInfo).
//
Процедура ДополнитьТаблицуТаймлоговНаДатуИзJSON(Знач Таблица, Знач Таймлоги)

	Узлы = Таймлоги.Получить("nodes");
	Если ТипЗнч(Узлы) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Элемент Из Узлы Цикл

		Строка = Таблица.Добавить();

		Строка.timeentry_id = Строка(Элемент.Получить("id"));

		Длительность = Элемент.Получить("timeSpent");
		Если ТипЗнч(Длительность) = Тип("Число") Тогда
			Строка.duration_seconds = Длительность;
		Иначе
			// На случай ISO-8601 ("PT1H30M") в ответе.
			Строка.duration_seconds = ПреобразоватьGraphQLDurationВСекунды(Строка(Длительность));
		КонецЕсли;

		Строка.spent_at = ДатаИзISO(Элемент.Получить("spentAt"));
		Строка.summary  = Строка(Элемент.Получить("summary"));

		Задача = Элемент.Получить("issue");
		Если Задача <> Неопределено Тогда
			Строка.issue_id      = ЧислоИзGid(Задача.Получить("id"));
			Строка.issue_iid     = ЧислоИзЗначения(Задача.Получить("iid"));
			Строка.issue_title   = Строка(Задача.Получить("title"));
			Строка.issue_web_url = Строка(Задача.Получить("webUrl"));

			Проект = Задача.Получить("project");
			Если Проект <> Неопределено Тогда
				Строка.project_id      = ЧислоИзGid(Проект.Получить("id"));
				Строка.project_name    = Строка(Проект.Получить("name"));
				Строка.project_path    = Строка(Проект.Получить("pathWithNamespace"));
				Строка.project_web_url = Строка(Проект.Получить("webUrl"));
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Сериализует значение JSON в строку (массивы/объекты) для передачи
// в модуль зеркала. Скалярные значения сериализуются как есть.
//
Функция СтрокаЗначенияJSON(Знач ЗначениеJSON)

	Если ЗначениеJSON = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(ЗначениеJSON) = Тип("Массив") Тогда
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, ЗначениеJSON);
		Возврат Запись.Закрыть();
	КонецЕсли;

	Возврат Строка(ЗначениеJSON);

КонецФункции

// Заполняет структуру ключами из объекта JSON.
//
// Параметры:
//   ОбъектJSON - Объект из КоннекторHTTP.JsonВОбъект (Соответствие или Структура).
//   ИменаКлючей - Строка - имена ключей через запятую.
//
// Возвращаемое значение:
//   Структура - ключи равны именам; отсутствующие - пустыми значениями.
//
Функция СтруктураОтОбъектаJSON(Знач ОбъектJSON, Знач ИменаКлючей)

	Результат = Новый Структура;

	Для Каждого Имя Из СтрРазделить(ИменаКлючей, ",", Ложь) Цикл
		Ключ = СокрЛП(Имя);
		Значение = Неопределено;
		Если ТипЗнч(ОбъектJSON) = Тип("Соответствие") Тогда
			Значение = ОбъектJSON.Получить(Ключ);
		ИначеЕсли ТипЗнч(ОбъектJSON) = Тип("Структура") Тогда
			Значение = ОбъектJSON[Ключ];
		КонецЕсли;
		Результат.Вставить(Ключ, Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Преобразует JSON-ответ GitLab API (статистика времени) в таблицу значений.
//
// Параметры:
//   ДанныеJSON - Строка - тело ответа в формате JSON.
//
Функция ПреобразоватьСтатистикуВТаблицуЗначений(Знач ДанныеJSON) Экспорт

	Результат = СоздатьПустуюТаблицуДляСтатистики();

	Попытка
		Данные = КоннекторHTTP.JsonВОбъект(ДанныеJSON);
	Исключение
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		// Ответ не массив — это объект со статистикой
		СтрокаТаблицы = Результат.Добавить();
		
		TimeSpent = Данные.Получить("time_spent");
		Если TimeSpent <> Неопределено Тогда
			СтрокаТаблицы.time_spent = String(TimeSpent);
		КонецЕсли;

		TotalTimeSpent = Данные.Получить("total_time_spent");
		Если TotalTimeSpent <> Неопределено Тогда
			СтрокаТаблицы.total_time_spent = Число(TotalTimeSpent);
		КонецЕсли;
		
		Возврат Результат;
	КонецЕсли;

	Для Каждого Элемент Из Данные Цикл
		СтрокаТаблицы = Результат.Добавить();
		
		TimeSpent = Элемент.Получить("time_spent");
		Если TimeSpent <> Неопределено Тогда
			СтрокаТаблицы.time_spent = String(TimeSpent);
		КонецЕсли;

		TotalTimeSpent = Элемент.Получить("total_time_spent");
		Если TotalTimeSpent <> Неопределено Тогда
			СтрокаТаблицы.total_time_spent = Число(TotalTimeSpent);
		КонецЕсли;
		
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Преобразует JSON-ответ GitLab API (список проектов) в таблицу значений.
//
// Параметры:
//   ДанныеJSON - Строка - тело ответа в формате JSON.
