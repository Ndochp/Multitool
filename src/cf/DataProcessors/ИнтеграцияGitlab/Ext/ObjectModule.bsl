КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Обработка ошибок

// Универсальный обработчик HTTP-ответов с ошибками.
//
Процедура ОбработатьОшибкуОтвет(Знач Ответ)
	
	Код = Ответ.КодСостояния;
	ТелоОтвета = КоннекторHTTP.КакТекст(Ответ);
	
	СообщениеОбОшибка = СтрШаблон("Ошибка GitLab API [HTTP %1]: %2", Код, ТелоОтвета);
	
	Если Код = 401 Тогда
		ВызватьИсключение "Не авторизован. Проверьте токен доступа.";
	ИначеЕсли Код = 403 Тогда
		ВызватьИсключение "Доступ запрещён. Проверите права на проект/ресурс.";
	ИначеЕсли Код = 404 Тогда
		ВызватьИсключение "Ресурс не найден. Проверьте ID проекта или задачи.";
	ИначеЕсли Код >= 500 Тогда
		ВызватьИсключение "Ошибка сервера внешней системы. Повторите запрос позже.";
	Иначе
		ВызватьИсключение СообщениеОбОшибка;
	КонецЕсли;

КонецПроцедуры

