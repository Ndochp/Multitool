#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьСписокВыбораСостояния();

	Система   = СистемаПоУмолчанию();
	Состояние = "Все";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьЗадачи(Команда)

	Результат = ОбновитьЗадачиНаСервере(Проекты, Метки, Состояние);

	ПоказатьПредупреждение(, Результат.Сообщение);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Зеркалирует задачи GitLab по указанным проектам и меткам.
//
// Параметры:
//   СтрокаПроектов  - Строка - пути проектов, через запятую или переводы строк.
//   СтрокаМеток     - Строка - метки, через запятую или переводы строк.
//   СостояниеЗадач  - Строка - значение поля состояния (Все/Открытые/Закрытые).
//
// Возвращаемое значение:
//   Структура - Ошибка (Булево), Сообщение (Строка).
//
&НаСервере
Функция ОбновитьЗадачиНаСервере(Знач СтрокаПроектов, Знач СтрокаМеток, Знач СостояниеЗадач)

	Результат = Новый Структура("Ошибка, Сообщение", Ложь, "");

	Если Система.Пустая() Тогда
		Система = СистемаПоУмолчанию();
	КонецЕсли;

	Если Система.Пустая() Тогда
		Результат.Ошибка    = Истина;
		Результат.Сообщение = НСтр("ru = 'Не выбрана и не найдена система GitLab.
			|Создайте внешнюю систему тикетов с типом GitLab.'");
		Возврат Результат;
	КонецЕсли;

	Пути        = ПутиИзСтроки(СтрокаПроектов);
	НормализоватьПути(Пути);
	СписокМеток = ПутиИзСтроки(СтрокаМеток);

	Если Пути.Количество() = 0 И СписокМеток.Количество() = 0 Тогда
		Результат.Ошибка    = Истина;
		Результат.Сообщение = НСтр("ru = 'Укажите хотя бы один проект или метку.'");
		Возврат Результат;
	КонецЕсли;

	Итого = НовыйРезультатОбновления();

	Попытка
		ЗеркалироватьПроекты(Пути, Итого);
		ЗеркалироватьПоМеткам(СписокМеток, СостояниеИзСтроки(СостояниеЗадач), Итого);
	Исключение
		Результат.Ошибка    = Истина;
		Результат.Сообщение = СтрШаблон(НСтр("ru = 'Ошибка обращения к GitLab: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(
			"ИнтеграцияGitlab.ОбновлениеЗадач",
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;

	Результат.Сообщение = СтрШаблон(
		НСтр("ru = 'Задач прочитано: %1. Создано: %2. Обновлено: %3. Пропущено: %4.'"),
		Итого.Задач, Итого.ЗадачСоздано, Итого.ЗадачОбновлено, Итого.ЗадачПропущено);

	Возврат Результат;

КонецФункции

// Заполняет список выбора поля «Состояние задач».
//
&НаСервере
Процедура ЗаполнитьСписокВыбораСостояния()

	Элементы.ПолеСостояние.СписокВыбора.Добавить("Все");
	Элементы.ПолеСостояние.СписокВыбора.Добавить("Открытые");
	Элементы.ПолеСостояние.СписокВыбора.Добавить("Закрытые");

КонецПроцедуры

// Возвращает первую неархивную внешнюю систему с типом GitLab.
//
&НаСервере
Функция СистемаПоУмолчанию()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Системы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВнешниеСистемыТикетов КАК Системы
		|ГДЕ
		|	НЕ Системы.Архивная
		|	И НЕ Системы.ПометкаУдаления
		|	И Системы.ТипСистемы = ЗНАЧЕНИЕ(Справочник.ТипыСистемТикетов.GitLab)
		|	УПОРЯДОЧИТЬ ПО Системы.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Ссылка,
		Справочники.ВнешниеСистемыТикетов.ПустаяСсылка());

КонецФункции

// Зеркалирует задачи перечисленных проектов, накапливая итог.
//
// Параметры:
//   Пути  - Массив из Строка - пути проектов (например, группа/проект).
//   Итого - Структура - накопленный итог (заполняется).
//
&НаСервере
Процедура ЗеркалироватьПроекты(Знач Пути, Итого)

	Для Каждого Путь Из Пути Цикл
		СложитьИтог(Итого, ГитлабЗеркало.ЗеркалироватьЗадачиПроекта(Система, Путь));
	КонецЦикла;

КонецПроцедуры

// Зеркалирует задачи по перечисленным меткам, накапливая итог.
//
// Параметры:
//   СписокМеток    - Массив из Строка - названия меток.
//   СостояниеЗадач - Строка - параметр состояния API (all/opened/closed).
//   Итого          - Структура - накопленный итог (заполняется).
//
&НаСервере
Процедура ЗеркалироватьПоМеткам(Знач СписокМеток, Знач СостояниеЗадач, Итого)

	Для Каждого Метка Из СписокМеток Цикл
		СложитьИтог(Итого, ГитлабЗеркало.ЗеркалироватьЗадачиПоМетке(Система, Метка, СостояниеЗадач));
	КонецЦикла;

КонецПроцедуры

// Накапливает счётчики результата зеркалирования.
//
// Параметры:
//   Итого     - Структура - накопленный итог (заполняется).
//   Источник  - Структура - результат одной операции зеркалирования.
//
&НаСервере
Процедура СложитьИтог(Итого, Знач Источник)

	Итого.Задач          = Итого.Задач          + Источник.Задач;
	Итого.ЗадачСоздано   = Итого.ЗадачСоздано   + Источник.ЗадачСоздано;
	Итого.ЗадачОбновлено = Итого.ЗадачОбновлено + Источник.ЗадачОбновлено;
	Итого.ЗадачПропущено = Итого.ЗадачПропущено + Источник.ЗадачПропущено;

КонецПроцедуры

// Создаёт накопитель итогов обновления задач.
//
&НаСервере
Функция НовыйРезультатОбновления()

	Возврат Новый Структура("Задач, ЗадачСоздано, ЗадачОбновлено, ЗадачПропущено", 0, 0, 0, 0);

КонецФункции

// Разрезает строку на элементы по запятым и переводам строк.
//
// Параметры:
//   Строка - Строка - пользовательский ввод.
//
// Возвращаемое значение:
//   Массив из Строка - непустые элементы без пробелов по краям.
//
&НаСервере
Функция ПутиИзСтроки(Знач Строка)

	Строка = СтрЗаменить(Строка, Символы.ПС, ",");
	Строка = СтрЗаменить(Строка, Символы.ВК, "");

	Пути = Новый Массив;

	Для Каждого Элемент Из СтрРазделить(Строка, ",", Ложь) Цикл
		Путь = СокрЛП(Элемент);
		Если Путь <> "" Тогда
			Пути.Добавить(Путь);
		КонецЕсли;
	КонецЦикла;

	Возврат Пути;

КонецФункции

// Приводит элементы списка проектов к путям: допускается путь проекта
// ("Neumoichev_D/3E") и полный URL из браузера
// ("https://gt.rosinkas.ru/Neumoichev_D/3E/-/issues").
//
// Параметры:
//   Пути - Массив из Строка - список нормализуется на месте.
//
&НаСервере
Процедура НормализоватьПути(Пути)

	Для Индекс = 0 По Пути.Количество() - 1 Цикл
		Путь = ПутьПроектаИзВвода(Пути[Индекс]);
		Если Путь = "" Тогда
			Пути.Удалить(Индекс);
			Индекс = Индекс - 1;
		Иначе
			Пути[Индекс] = Путь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Разбирает ввод одного проекта: из полного URL выделяет путь проекта
// (без схемы, хоста и секций вида /-/issues), обычный путь возвращает
// без изменений.
//
// Параметры:
//   СтрокаВвода - Строка - путь или URL проекта.
//
// Возвращаемое значение:
//   Строка - путь проекта; пустая, если из ввода путь не выделяется.
//
&НаСервере
Функция ПутьПроектаИзВвода(Знач СтрокаВвода)

	Значение = СокрЛП(СтрокаВвода);

	Если НЕ (ВРег(Лев(Значение, 7)) = "HTTP://" ИЛИ ВРег(Лев(Значение, 8)) = "HTTPS://") Тогда
		Возврат Значение;
	КонецЕсли;

	ДлинаСхемы = ?(ВРег(Лев(Значение, 7)) = "HTTP://", 7, 8);
	ПослеСхемы = Сред(Значение, ДлинаСхемы + 1);

	ПозицияПути = СтрНайти(ПослеСхемы, "/");

	Если ПозицияПути = 0 Тогда
		// только схема и хост - пути проекта нет
		Возврат "";
	КонецЕсли;

	Путь = Сред(ПослеСхемы, ПозицияПути + 1);

	// отрезаем секции интерфейса GitLab: ".../Neumoichev_D/3E/-/issues/5"
	ПозицияСекции = СтрНайти(Путь, "/-/");
	Если ПозицияСекции > 0 Тогда
		Путь = Лев(Путь, ПозицияСекции - 1);
	КонецЕсли;

	Пока СтрЗаканчиваетсяНа(Путь, "/") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;

	Возврат Путь;

КонецФункции

// Приводит значение поля «Состояние задач» к параметру API GitLab.
//
&НаСервере
Функция СостояниеИзСтроки(Знач Состояние)

	Если ВРег(СокрЛП(Состояние)) = "ОТКРЫТЫЕ" Тогда
		Возврат "opened";
	КонецЕсли;

	Если ВРег(СокрЛП(Состояние)) = "ЗАКРЫТЫЕ" Тогда
		Возврат "closed";
	КонецЕсли;

	Возврат "all";

КонецФункции

#КонецОбласти
