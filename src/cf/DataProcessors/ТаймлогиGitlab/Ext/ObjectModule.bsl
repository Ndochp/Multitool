////////////////////////////////////////////////////////////////////////////////
// Адаптер чтения таймлогов GitLab для фасада УчетРабочегоВремениИнтеграции.
// Инициализация принимает систему тикетов (БазовыйURL + токен в безопасном
// хранилище); таймлоги получаются через GraphQL от имени пользователя токена.
// Каждая запись привязывается к тикету: задача зеркала находится/докачивается
// по глобальному id задачи, тикет - по связке ВнешняяЗадача (при отсутствии
// создаётся с данными внешней системы).

#Область Переменные
Перем ИнтеграцияGitlab; // Адаптер к REST/GraphQL API (Обработка.ИнтеграцияGitlab)
Перем СистемаТикетов;   // Подключение к внешней системе (ВнешниеСистемыТикетов)
#КонецОбласти // Переменные

#Область СлужебныйПрограммныйИнтерфейс

// Инициализирует адаптер системой тикетов (подключение к GitLab).
//
// Параметры:
//   Система - СправочникСсылка.ВнешниеСистемыТикетов - подключение к GitLab.
//
Процедура Инициализировать(Знач Система) Экспорт

	СистемаТикетов   = Система;
	ИнтеграцияGitlab = Обработки.ИнтеграцияGitlab.СоздатьИнтеграцию(Система);

КонецПроцедуры

// Собирает таймлоги GitLab на дату и возвращает их в стандартной таблице
// таймлогов с заполненным тикетом. Каждая задача времени докачивается
// в зеркало при отсутствии, тикет находится/создаётся по связке.
//
// Параметры:
//   Дата - Дата - день, за который собираются таймлоги.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица УчетРабочегоВремени.ИнициализироватьТаблицуТаймлогов
//   (Тикет, СсылкаНаТаймлог, Описание, Длительность, ДатаЗаписи);
//   Строка - описание ошибки обращения к API (фасад отнесёт систему
//   к НеОтветившиеСистемы).
//
Функция СобратьТаймлогиНаДату(Дата) Экспорт

	Результат = УчетРабочегоВремени.ИнициализироватьТаблицуТаймлогов();

	Попытка
		ЗаписиВремени = ИнтеграцияGitlab.ПолучитьТаймлогиНаДатуGraphQL(Дата);
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(
			"УчетРабочегоВремени.ПолучениеТаймлогов",
			УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		Возврат ТекстОшибки;
	КонецПопытки;

	РезультатЗеркала = ГитлабЗеркало.НовыйРезультатСинхронизации();

	Для Каждого Запись Из ЗаписиВремени Цикл

		Если Запись.issue_id = 0 Тогда
			// Таймлог без задачи - привязать тикет не к чему, пропускаем.
			Продолжить;
		КонецЕсли;

		ЗадачаЗеркала = ОбеспечитьЗадачуЗеркала(Запись, РезультатЗеркала);
		Если ЗадачаЗеркала.Пустая() Тогда
			Продолжить;
		КонецЕсли;

		СтрокаТаймлога = Результат.Добавить();
		СтрокаТаймлога.Тикет           = ОбеспечитьТикетЗадачи(ЗадачаЗеркала);
		СтрокаТаймлога.СсылкаНаТаймлог = Запись.timeentry_id;
		СтрокаТаймлога.Описание        = Запись.summary;
		СтрокаТаймлога.Длительность    = Запись.duration_seconds;
		СтрокаТаймлога.ДатаЗаписи      = Запись.spent_at;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Загружает задачи проекта GitLab в зеркало (ГитлабЗадачи) и обеспечивает
// тикеты по задачам зеркала. Используется перед отправкой записей времени:
// тикет строки документа должен ссылаться на задачу зеркала.
//
// Параметры:
//   ПроектIDилиПуть - Число или Строка - идентификатор или путь проекта
//     ("Neumoichev_D/3E").
//
// Возвращаемое значение:
//   Структура - Зеркало (Структура - счётчики зеркалирования + Проект),
//     ТикетовСоздано (Число), ТикетовВсего (Число - задач проекта с тикетами).
//
Функция ЗагрузитьЗадачиПроекта(Знач ПроектIDилиПуть) Экспорт

	РезультатЗеркала = ГитлабЗеркало.ЗеркалироватьЗадачиПроекта(СистемаТикетов, ПроектIDилиПуть);

	Результат = Новый Структура("Зеркало, ТикетовСоздано, ТикетовВсего",
		РезультатЗеркала, 0, 0);

	Если НЕ РезультатЗеркала.Проект.Пустая() Тогда
		ТикетовСоздано = 0;
		Результат.ТикетовВсего = ОбеспечитьТикетыЗадачПроекта(
			РезультатЗеркала.Проект, ТикетовСоздано);
		Результат.ТикетовСоздано = ТикетовСоздано;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Синхронизирует строки документа с GitLab, сводя их по задаче: все строки
// одной задачи за день дают одну запись времени (длительности складываются,
// описания объединяются). Внешнее состояние сводится к документу: записи
// задач, отсутствующих среди строк, удаляются; группы, совпадающие со своей
// записью после свёртки, не трогаются - все строки группы лишь получают ссылку
// на запись. Расхождение (или несколько записей вместо одной) устраняется
// заменой: GitLab не редактирует таймлоги, старые записи задачи удаляются и
// создаётся одна свёрнутая.
//
// Параметры:
//   СтрокиДокумента - ТаблицаЗначений - строки документа одной системы;
//     колонки: ИндексСтроки (Число, фактический индекс строки в ТЧ
//     ОтчетЗаДень, с нуля), Тикет, ГидТаймлога (Строка), Описание (Строка),
//     Длительность (Число, секунды), Момент (Дата, начало строки).
//   ДатаРаботы      - Дата - день документа.
//
// Возвращаемое значение:
//   Структура - Успешно (Булево), Ошибка (Строка - сбой опроса API целиком),
//     Отправлено, Обновлено (Числа - задачи, для которых создана запись),
//     Удалено (Число - записей), Пропущено (Число - строк), ГидыПоСтрокам
//     (Соответствие ИндексСтроки -> gid записи группы), Ошибки (Массив строк).
//
Функция СинхронизироватьСтрокиДокумента(Знач СтрокиДокумента, Знач ДатаРаботы) Экспорт

	Результат = НовыйРезультатСинхронизации();

	Попытка
		ВнешниеЗаписи = ИнтеграцияGitlab.ПолучитьТаймлогиНаДатуGraphQL(ДатаРаботы);
	Исключение
		Результат.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(
			"УчетРабочегоВремени.СинхронизацияТаймлогов",
			УровеньЖурналаРегистрации.Ошибка, , , Результат.Ошибка);
		Возврат Результат;
	КонецПопытки;

	СтрокиПоЗадачам    = СтрокиДокументаПоЗадачам(Результат, СтрокиДокумента);
	ВнешниеПоЗадачам   = ВнешниеЗаписиПоЗадачам(ВнешниеЗаписи);

	СвестиГруппыЗадач(Результат, СтрокиПоЗадачам, ВнешниеПоЗадачам);
	УдалитьЗаписиЗадачНеИзДокумента(Результат, СтрокиПоЗадачам, ВнешниеПоЗадачам, СтрокиДокумента);

	Результат.Успешно = ПустаяСтрока(Результат.Ошибка)
		И Результат.Ошибки.Количество() = 0;

	Возврат Результат;

КонецФункции

#КонецОбласти //СлужебныйПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

// Возвращает задачу зеркала для записи времени; при отсутствии в зеркале -
// докачивает задачу из API GitLab и зеркалирует её.
//
// Параметры:
//   Запись          - Строка таблицы ПолучитьТаймлогиНаДатуGraphQL.
//   РезультатЗеркала - Структура - счётчики зеркалирования.
//
// Возвращаемое значение:
//   СправочникСсылка.ГитлабЗадачи - пустая, если задачу получить не удалось.
//
Функция ОбеспечитьЗадачуЗеркала(Знач Запись, РезультатЗеркала)

	ЗадачаЗеркала = ГитлабЗеркало.СсылкаЗадачиПоИдентификатору(Запись.issue_id);

	Если ЗадачаЗеркала.Пустая() Тогда
		ЗадачаЗеркала = ГитлабЗеркало.ОбеспечитьЗадачуИзAPI(
			ИнтеграцияGitlab, Запись.project_id, Запись.issue_iid, РезультатЗеркала);
	КонецЕсли;

	Возврат ЗадачаЗеркала;

КонецФункции

// Возвращает тикет для задачи зеркала; при отсутствии - создаёт тикет
// с данными внешней системы (ВнешнийИдентификатор = глобальный id задачи).
//
// Параметры:
//   ЗадачаЗеркала - СправочникСсылка.ГитлабЗадачи.
//
// Возвращаемое значение:
//   СправочникСсылка.Тикеты.
//
Функция ОбеспечитьТикетЗадачи(Знач ЗадачаЗеркала)

	Тикет = Обработки.УчетРабочегоВремениИнтеграции.Создать().ТикетПоВнешнейЗадаче(ЗадачаЗеркала);
	Если НЕ Тикет.Пустая() Тогда
		Возврат Тикет;
	КонецЕсли;

	РеквизитыЗадачи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ЗадачаЗеркала, "Наименование, Идентификатор, ВебURL");

	Объект = Справочники.Тикеты.СоздатьЭлемент();
	Объект.Наименование         = Лев(РеквизитыЗадачи.Наименование, 150);
	Объект.ВнешняяСистема       = СистемаТикетов;
	Объект.ВнешнийИдентификатор = Формат(РеквизитыЗадачи.Идентификатор, "ЧГ=");
	Объект.СсылкаНаВнешнийТикет = РеквизитыЗадачи.ВебURL;
	Объект.ВнешняяЗадача        = ЗадачаЗеркала;
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

// Обеспечивает тикеты для всех задач зеркала проекта.
//
// Параметры:
//   Проект          - СправочникСсылка.ГитлабПроекты.
//   ТикетовСоздано  - Число - счётчик созданных тикетов (заполняется).
//
// Возвращаемое значение:
//   Число - задач проекта, обеспеченных тикетами.
//
Функция ОбеспечитьТикетыЗадачПроекта(Знач Проект, ТикетовСоздано)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Задачи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ГитлабЗадачи КАК Задачи
		|ГДЕ
		|	Задачи.Владелец = &Проект";
	Запрос.УстановитьПараметр("Проект", Проект);

	ТикетовВсего = 0;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Тикет = Обработки.УчетРабочегоВремениИнтеграции.Создать().ТикетПоВнешнейЗадаче(Выборка.Ссылка);

		Если Тикет.Пустая() Тогда
			ОбеспечитьТикетЗадачи(Выборка.Ссылка);
			ТикетовСоздано = ТикетовСоздано + 1;
		КонецЕсли;

		ТикетовВсего = ТикетовВсего + 1;

	КонецЦикла;

	Возврат ТикетовВсего;

КонецФункции

// Удаляет внешнюю запись времени; сбой фиксируется в Ошибки результата.
//
Процедура УдалитьВнешнююЗапись(Результат, Знач ГидТаймлога)

	Ошибка = ИнтеграцияGitlab.УдалитьТаймлог(ГидТаймлога);

	Если ПустаяСтрока(Ошибка) Тогда
		Результат.Удалено = Результат.Удалено + 1;
	Иначе
		Результат.Ошибки.Добавить(СтрШаблон(
			"Не удалена запись %1: %2", ГидТаймлога, Ошибка));
	КонецЕсли;

КонецПроцедуры

// Возвращает глобальный id задачи внешней системы для тикета (кэшируется).
//
Функция ИдентификаторЗадачиТикета(Знач Тикет, Знач КэшЗадач)

	Идентификатор = КэшЗадач.Получить(Тикет);

	Если Идентификатор = Неопределено Тогда
		Идентификатор = ИдентификаторЗадачиИзТикета(Тикет);
		КэшЗадач.Вставить(Тикет, Идентификатор);
	КонецЕсли;

	Возврат Идентификатор;

КонецФункции

// Глобальный id задачи по тикету: сначала из элемента зеркала (ссылка
// ВнешняяЗадача), при потерянной связке (элемент зеркала удалён - ссылка
// заполнена, но значений нет) - по сохранённому ВнешнийИдентификатор.
//
Функция ИдентификаторЗадачиИзТикета(Знач Тикет)

	РеквизитыТикета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Тикет, "ВнешняяЗадача, ВнешнийИдентификатор");

	Если ЗначениеЗаполнено(РеквизитыТикета.ВнешняяЗадача) Тогда
		РеквизитыЗадачи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			РеквизитыТикета.ВнешняяЗадача, "Идентификатор");
		// ЗначениеЗаполнено отсекает и ссылку на удалённый элемент
		// (тип Null вместо числа).
		Если ЗначениеЗаполнено(РеквизитыЗадачи.Идентификатор) Тогда
			Возврат РеквизитыЗадачи.Идентификатор;
		КонецЕсли;
	КонецЕсли;

	// Связка с зеркалом потеряна - используем сохранённый глобальный id задачи.
	Если ЗначениеЗаполнено(РеквизитыТикета.ВнешнийИдентификатор) Тогда
		Попытка
			Возврат Число(СокрЛП(РеквизитыТикета.ВнешнийИдентификатор));
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Новый результат синхронизации строк документа (счётчики по нулям).
//
Функция НовыйРезультатСинхронизации()

	Возврат Новый Структура(
		"Успешно, Ошибка, Отправлено, Удалено, Обновлено, Пропущено, ГидыПоСтрокам, Ошибки",
		Ложь, "", 0, 0, 0, 0, Новый Соответствие, Новый Массив);

КонецФункции

// Группирует строки документа по глобальному id задачи внешней системы
// (группа = единица свёртки: на задачу создаётся одна запись). Строки с
// тикетом без задачи и незавершённые строки (нулевая длительность) в группы
// не входят - они учитываются в Пропущено и Ошибки результата.
//
// Возвращаемое значение:
//   Соответствие - id задачи -> Массив строк СтрокиДокумента.
//
Функция СтрокиДокументаПоЗадачам(Результат, Знач СтрокиДокумента)

	ПоЗадачам = Новый Соответствие;
	КэшЗадач  = Новый Соответствие;

	Для Каждого СтрокаДокумента Из СтрокиДокумента Цикл

		ИдентификаторЗадачи = ИдентификаторЗадачиТикета(СтрокаДокумента.Тикет, КэшЗадач);

		Если ИдентификаторЗадачи = 0 Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			Результат.Ошибки.Добавить(СтрШаблон(
				"Строка %1: тикет без задачи внешней системы (%2)",
				Формат(СтрокаДокумента.ИндексСтроки + 1, "ЧГ="),
				Строка(СтрокаДокумента.Тикет)));
			Продолжить;
		КонецЕсли;

		// незавершённая строка (нет длительности) в GitLab не отправляется
		Если НЕ ЗначениеЗаполнено(СтрокаДокумента.Длительность)
			ИЛИ СтрокаДокумента.Длительность <= 0 Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			Результат.Ошибки.Добавить(СтрШаблон(
				"Строка %1: нулевая длительность - строка не завершена",
				Формат(СтрокаДокумента.ИндексСтроки + 1, "ЧГ=")));
			Продолжить;
		КонецЕсли;

		Группа = ПоЗадачам.Получить(ИдентификаторЗадачи);

		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			ПоЗадачам.Вставить(ИдентификаторЗадачи, Группа);
		КонецЕсли;

		Группа.Добавить(СтрокаДокумента);

	КонецЦикла;

	Возврат ПоЗадачам;

КонецФункции

// Индексирует внешние записи по глобальному id их задачи
// (Соответствие id задачи -> Массив записей).
//
Функция ВнешниеЗаписиПоЗадачам(Знач ВнешниеЗаписи)

	ПоЗадачам = Новый Соответствие;

	Для Каждого ВнешняяЗапись Из ВнешниеЗаписи Цикл

		Записи = ПоЗадачам.Получить(ВнешняяЗапись.issue_id);

		Если Записи = Неопределено Тогда
			Записи = Новый Массив;
			ПоЗадачам.Вставить(ВнешняяЗапись.issue_id, Записи);
		КонецЕсли;

		Записи.Добавить(ВнешняяЗапись);

	КонецЦикла;

	Возврат ПоЗадачам;

КонецФункции

// Сводит каждую группу строк документа с записями её задачи в GitLab:
// совпадающая после свёртки одиночная запись не трогается (строки лишь
// связываются с ней), иначе записи задачи заменяются одной свёрнутой.
//
Процедура СвестиГруппыЗадач(Результат, СтрокиПоЗадачам, ВнешниеПоЗадачам)

	Для Каждого Группа Из СтрокиПоЗадачам Цикл

		ЗаписиЗадачи = ВнешниеПоЗадачам.Получить(Группа.Ключ);

		Если ЗаписиЗадачи <> Неопределено
			И ЗаписиЗадачи.Количество() = 1
			И СовпадениеПослеСвёртки(Группа.Значение, ЗаписиЗадачи) Тогда
			// Внешнее состояние совпадает со свёрткой группы - GitLab не
			// трогаем, только прописываем ссылку записи всем строкам.
			СвязатьСтрокиСЗаписью(Результат, Группа.Значение, ЗаписиЗадачи[0].timeentry_id);
			Продолжить;
		КонецЕсли;

		// Расхождение или несколько записей вместо ожидаемой одной -
		// удалить записи задачи и создать вместо них одну.
		ЗаменитьЗаписиЗадачи(Результат, Группа.Ключ, Группа.Значение, ЗаписиЗадачи);

	КонецЦикла;

КонецПроцедуры

// Определяет совпадение записей задачи с группой строк документа после
// свёртки: равны суммарная длительность и наборы описаний. Момент работы
// не сверяется: внешняя запись хранится в UTC, строка документа - в
// локальном времени.
//
Функция СовпадениеПослеСвёртки(Знач СтрокиГруппы, Знач ЗаписиЗадача)

	Если СуммарнаяДлительностьСтрок(СтрокиГруппы) <> СуммарнаяДлительностьЗаписей(ЗаписиЗадача) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НормализованныйНаборОписаний(ТекстыОписанийСтрок(СтрокиГруппы))
		= НормализованныйНаборОписаний(ТекстыОписанийЗаписей(ЗаписиЗадача));

КонецФункции

// Удаляет записи задач, для которых в документе нет ни одной строки группы.
// Записи, на которые ссылается ГидТаймлога строки (задачу строки разрешить
// не удалось), не удаляются: чужое состояние трогать нельзя.
//
Процедура УдалитьЗаписиЗадачНеИзДокумента(Результат, СтрокиПоЗадачам, ВнешниеПоЗадачам, Знач СтрокиДокумента)

	ЗащищённыеГиды = Новый Соответствие;

	Для Каждого СтрокаДокумента Из СтрокиДокумента Цикл
		Если НЕ ПустаяСтрока(СтрокаДокумента.ГидТаймлога) Тогда
			ЗащищённыеГиды.Вставить(СтрокаДокумента.ГидТаймлога, Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ЗаписиЗадачи Из ВнешниеПоЗадачам Цикл

		Если СтрокиПоЗадачам.Получить(ЗаписиЗадачи.Ключ) <> Неопределено Тогда
			// задачи группы сводит СвестиГруппыЗадач
			Продолжить;
		КонецЕсли;

		Для Каждого ВнешняяЗапись Из ЗаписиЗадачи.Значение Цикл
			Если ЗащищённыеГиды.Получить(ВнешняяЗапись.timeentry_id) = Неопределено Тогда
				УдалитьВнешнююЗапись(Результат, ВнешняяЗапись.timeentry_id);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Записывает gid существующей записи во все строки группы (ГидыПоСтрокам),
// не меняя состояние GitLab.
//
Процедура СвязатьСтрокиСЗаписью(Результат, Знач СтрокиГруппы, Знач ГидТаймлога)

	Для Каждого СтрокаГруппы Из СтрокиГруппы Цикл
		Результат.ГидыПоСтрокам.Вставить(СтрокаГруппы.ИндексСтроки, ГидТаймлога);
	КонецЦикла;

КонецПроцедуры

// Удаляет внешние записи задачи и создаёт вместо них одну по свёртке группы
// строк; счётчики результата заполняются по задаче одной единицей
// (Обновлено/Отправлено), ошибки - со списком номеров строк группы.
//
Процедура ЗаменитьЗаписиЗадачи(Результат, Знач ИдентификаторЗадачи, Знач СтрокиГруппы, Знач ЗаписиЗадачи)

	ЭтоОбновление = ЗаписиЗадачи <> Неопределено;

	Если ЭтоОбновление Тогда
		Для Каждого ВнешняяЗапись Из ЗаписиЗадачи Цикл
			УдалитьВнешнююЗапись(Результат, ВнешняяЗапись.timeentry_id);
		КонецЦикла;
	КонецЕсли;

	Создание = ИнтеграцияGitlab.СоздатьТаймлог(
		ИдентификаторЗадачи,
		СуммарнаяДлительностьСтрок(СтрокиГруппы),
		ПервыйМоментСтрок(СтрокиГруппы),
		НормализованныйНаборОписаний(ТекстыОписанийСтрок(СтрокиГруппы)));

	Если НЕ ПустаяСтрока(Создание.Ошибка) Тогда
		Результат.Ошибки.Добавить(СтрШаблон(
			"Задача %1 (строки %2): %3",
			Формат(ИдентификаторЗадачи, "ЧГ="),
			НомераСтрок(СтрокиГруппы),
			Создание.Ошибка));
		Возврат;
	КонецЕсли;

	СвязатьСтрокиСЗаписью(Результат, СтрокиГруппы, Создание.Гид);

	Если ЭтоОбновление Тогда
		Результат.Обновлено = Результат.Обновлено + 1;
	Иначе
		Результат.Отправлено = Результат.Отправлено + 1;
	КонецЕсли;

КонецПроцедуры

// Суммарная длительность строк группы (секунды).
//
Функция СуммарнаяДлительностьСтрок(Знач СтрокиГруппы)

	Сумма = 0;
	Для Каждого СтрокаГруппы Из СтрокиГруппы Цикл
		Сумма = Сумма + СтрокаГруппы.Длительность;
	КонецЦикла;
	Возврат Сумма;

КонецФункции

// Суммарная длительность внешних записей задачи (секунды).
//
Функция СуммарнаяДлительностьЗаписей(Знач ЗаписиЗадачи)

	Сумма = 0;
	Для Каждого ВнешняяЗапись Из ЗаписиЗадачи Цикл
		Сумма = Сумма + ВнешняяЗапись.duration_seconds;
	КонецЦикла;
	Возврат Сумма;

КонецФункции

// Момент начала самой ранней строки группы - spentAt создаваемой записи.
//
Функция ПервыйМоментСтрок(Знач СтрокиГруппы)

	ПервыйМомент = Неопределено;
	Для Каждого СтрокаГруппы Из СтрокиГруппы Цикл
		Если ПервыйМомент = Неопределено Или СтрокаГруппы.Момент < ПервыйМомент Тогда
			ПервыйМомент = СтрокаГруппы.Момент;
		КонецЕсли;
	КонецЦикла;
	Возврат ПервыйМомент;

КонецФункции

// Описания строк группы списком текстов (для сравнения и свёртки).
//
Функция ТекстыОписанийСтрок(Знач СтрокиГруппы)

	Тексты = Новый Массив;
	Для Каждого СтрокаГруппы Из СтрокиГруппы Цикл
		Тексты.Добавить(СтрокаГруппы.Описание);
	КонецЦикла;
	Возврат Тексты;

КонецФункции

// Описания внешних записей задачи списком текстов (для сравнения).
//
Функция ТекстыОписанийЗаписей(Знач ЗаписиЗадачи)

	Тексты = Новый Массив;
	Для Каждого ВнешняяЗапись Из ЗаписиЗадачи Цикл
		Тексты.Добавить(ВнешняяЗапись.summary);
	КонецЦикла;
	Возврат Тексты;

КонецФункции

// Приводит набор описаний к сравнимому виду: текст разбивается по строкам,
// фрагменты образываются, пустые отбрасываются, набор сортируется и
// дедуплицируется. Результат - склейка фрагментов переводами строк: он же
// служит сводным описанием создаваемой записи, поэтому повторная
// синхронизация с теми же строками получает то же описание (идемпотентность).
//
// Параметры:
//   Тексты - Массив - описания строк или summary внешних записей.
//
// Возвращаемое значение:
//   Строка - нормализованный набор описаний.
//
Функция НормализованныйНаборОписаний(Знач Тексты)

	Фрагменты = Новый Соответствие;

	Для Каждого Текст Из Тексты Цикл

		Текст = СтрЗаменить(Строка(Текст), Символы.ВК, "");

		Для Каждого Фрагмент Из СтрРазделить(Текст, Символы.ПС) Цикл
			Фрагмент = СокрЛП(Фрагмент);
			Если НЕ ПустаяСтрока(Фрагмент) Тогда
				Фрагменты.Вставить(Фрагмент, Истина);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Набор = Новый Массив;
	Для Каждого Фрагмент Из Фрагменты Цикл
		Набор.Добавить(Фрагмент.Ключ);
	КонецЦикла;
	ОтсортироватьСтроки(Набор);

	Возврат СтрСоединить(Набор, Символы.ПС);

КонецФункции

// Упорядочивание строк по возрастанию (сортировка вставками) - нужно для
// стабильного сравнения наборов описаний и одинакового summary в GitLab.
// Строки передаются по ссылке и сортируются на месте.
//
Процедура ОтсортироватьСтроки(Строки)

	Для Инд = 1 По Строки.Количество() - 1 Цикл
		Текущая = Строки[Инд];
		Где = Инд - 1;
		Пока Где >= 0 И Строки[Где] > Текущая Цикл
			Строки[Где + 1] = Строки[Где];
			Где = Где - 1;
		КонецЦикла;
		Строки[Где + 1] = Текущая;
	КонецЦикла;

КонецПроцедуры

// Перечисление номеров строк группы (нумерация с 1, порядок документа) для
// сообщений об ошибках.
//
Функция НомераСтрок(Знач СтрокиГруппы)

	Номера = Новый Массив;
	Для Каждого СтрокаГруппы Из СтрокиГруппы Цикл
		Номера.Добавить(Формат(СтрокаГруппы.ИндексСтроки + 1, "ЧГ="));
	КонецЦикла;
	Возврат СтрСоединить(Номера, ", ");

КонецФункции

#КонецОбласти //СлужебныеПроцедурыИФункции
