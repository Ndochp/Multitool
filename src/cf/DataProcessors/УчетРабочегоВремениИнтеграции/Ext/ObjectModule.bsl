// Должна вернуть все записи таймлогов в единой таблице + информацию о том, какие тикет системы не удалось опросить.
Функция СобратьТаймлогиНаДату(Дата, Знач ОпрашиваемыеТикетСистемы = Неопределено) Экспорт
	Если ОпрашиваемыеТикетСистемы = Неопределено Тогда
		ОпрашиваемыеТикетСистемы = ТикетСистемыКромеАрхивных();
	КонецЕсли;
	
	НеОтветившиеСистемы = Новый Массив;
	Таймлоги = УчетРабочегоВремени.ИнициализироватьТаблицуТаймлогов();
	Для Каждого ТикетСистема из ОпрашиваемыеТикетСистемы Цикл 
		ТаймлогиТикетСистемы = ОбработкаТаймлоговТикетСистемы(ТикетСистема);
		РезультатЗапроса = ТаймлогиТикетСистемы.СобратьТаймлогиНаДату(Дата);
		Если ТипЗнч(РезультатЗапроса) = Тип("ТаблицаЗначений") Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(РезультатЗапроса, Таймлоги);
		Иначе
			НеОтветившиеСистемы.Добавить(ТикетСистема);
			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(
				"УчетРабочегоВремени.ПолучениеТаймлогов",
				УровеньЖурналаРегистрации.Предупреждение,
				,
				,
				РезультатЗапроса
			);
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура("Таймлоги, НеОтветившиеСистемы", Таймлоги, НеОтветившиеСистемы);
	Возврат Результат;
КонецФункции

// Заполняет реквизит ВнешняяЗадача тикета по данным внешней системы.
// Вызывается при записи тикета, когда заполнены данные внешней системы
// (ВнешнийИдентификатор и/или СсылкаНаВнешнийТикет), а связка ещё пустая.
// Задача не найдена во внешней системе - реквизит остаётся пустым.
// Уже заполненная ВнешняяЗадача не перезаписывается.
//
// Параметры:
//   ТикетОбъект - СправочникОбъект.Тикеты - записываемый тикет.
//
Процедура ЗаполнитьВнешнююЗадачуТикета(ТикетОбъект) Экспорт

	Если НЕ ЗначениеЗаполнено(ТикетОбъект.ВнешняяСистема)
		Или ЗначениеЗаполнено(ТикетОбъект.ВнешняяЗадача) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ТикетОбъект.ВнешнийИдентификатор)
		И НЕ ЗначениеЗаполнено(ТикетОбъект.СсылкаНаВнешнийТикет) Тогда
		Возврат;
	КонецЕсли;

	ТипСистемы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТикетОбъект.ВнешняяСистема, "ТипСистемы");

	Если ТипСистемы = Справочники.ТипыСистемТикетов.GitLab Тогда
		ЗаполнитьВнешнююЗадачуТикетаGitlab(ТикетОбъект);
	КонецЕсли;

КонецПроцедуры

// Возвращает тикет, связанный с задачей зеркала внешней системы.
// Сначала ищет по реквизиту ВнешняяЗадача, затем - по ВнешнийИдентификатору
// и СсылкаНаВнешнийТикет (тикеты, записанные до появления связки).
//
// Параметры:
//   ЗадачаЗеркала - СправочникСсылка.ГитлабЗадачи.
//
// Возвращаемое значение:
//   СправочникСсылка.Тикеты - пустая, если тикет не найден.
//
Функция ТикетПоВнешнейЗадаче(Знач ЗадачаЗеркала) Экспорт

	Если НЕ ЗначениеЗаполнено(ЗадачаЗеркала) Тогда
		Возврат Справочники.Тикеты.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Тикеты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Тикеты КАК Тикеты
	|ГДЕ
	|	Тикеты.ВнешняяЗадача = &Задача";
	Запрос.УстановитьПараметр("Задача", ЗадачаЗеркала);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	// Фолбэк: тикеты с данными внешней системы, но без заполненной связки.
	РеквизитыЗадачи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗадачаЗеркала, "Идентификатор, ВебURL");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Тикеты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Тикеты КАК Тикеты
	|ГДЕ
	|	(Тикеты.ВнешнийИдентификатор = &ВнешнийИдентификатор
	|			Или Тикеты.СсылкаНаВнешнийТикет = &ВебURL)
	|	И Тикеты.ВнешняяЗадача = ЗНАЧЕНИЕ(Справочник.ГитлабЗадачи.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ВнешнийИдентификатор", Формат(РеквизитыЗадачи.Идентификатор, "ЧГ="));
	Запрос.УстановитьПараметр("ВебURL", РеквизитыЗадачи.ВебURL);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Тикеты.ПустаяСсылка();

КонецФункции

