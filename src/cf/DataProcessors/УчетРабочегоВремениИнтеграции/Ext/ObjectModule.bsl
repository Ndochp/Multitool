#Область СлужебныеПроцедурыИФункции

// Группирует строки ТЧ ОтчетЗаДень документа по внешним системам тикетов.
// Строки задач без интеграции не попадают ни в одну систему (учтены
// в Результат.Пропущено).
//
// Параметры:
//   ДокументОбъект - ДокументОбъект.ЛУРВ.
//   Результат      - Структура - итог синхронизации (заполняется Пропущено).
//
// Возвращаемое значение:
//   Соответствие - СправочникСсылка.ВнешниеСистемыТикетов -> ТаблицаЗначений
//   (колонки: ИндексСтроки, Тикет, ГидТаймлога, Описание, Длительность, Момент).
//
Функция СтрокиДокументаПоСистемам(ДокументОбъект, Результат)

	СтрокиПоСистемам = Новый Соответствие;

	ИндексСтроки = 0;

	Для Каждого СтрокаТЧ Из ДокументОбъект.ОтчетЗаДень Цикл

		Если НЕ УчетРабочегоВремени.ИмеетИнтеграцию(СтрокаТЧ.Тикет) Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		ВнешняяСистема = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.Тикет, "ВнешняяСистема");

		ТаблицаСистемы = СтрокиПоСистемам.Получить(ВнешняяСистема);

		Если ТаблицаСистемы = Неопределено Тогда
			ТаблицаСистемы = Новый ТаблицаЗначений;
			ТаблицаСистемы.Колонки.Добавить("ИндексСтроки", Новый ОписаниеТипов("Число"));
			ТаблицаСистемы.Колонки.Добавить("Тикет");
			ТаблицаСистемы.Колонки.Добавить("ГидТаймлога", Новый ОписаниеТипов("Строка"));
			ТаблицаСистемы.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
			ТаблицаСистемы.Колонки.Добавить("Длительность", Новый ОписаниеТипов("Число"));
			ТаблицаСистемы.Колонки.Добавить("Момент", Новый ОписаниеТипов("Дата"));
			СтрокиПоСистемам.Вставить(ВнешняяСистема, ТаблицаСистемы);
		КонецЕсли;

		СтрокаСистемы = ТаблицаСистемы.Добавить();
		СтрокаСистемы.ИндексСтроки  = ИндексСтроки;
		СтрокаСистемы.Тикет         = СтрокаТЧ.Тикет;
		СтрокаСистемы.ГидТаймлога   = СтрокаТЧ.СсылкаНаТаймлог;
		СтрокаСистемы.Описание      = СтрокаТЧ.Описание;
		СтрокаСистемы.Длительность  = СтрокаТЧ.Длительность;
		СтрокаСистемы.Момент        = СтрокаТЧ.Начало;

		ИндексСтроки = ИндексСтроки + 1;

	КонецЦикла;

	Возврат СтрокиПоСистемам;

КонецФункции

Функция ТикетСистемыКромеАрхивных()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВнешниеСистемыТикетов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВнешниеСистемыТикетов КАК ВнешниеСистемыТикетов
	|ГДЕ
	|	НЕ ВнешниеСистемыТикетов.Архивная"
	;
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Возврат Результат;
КонецФункции

Функция ОбработкаТаймлоговТикетСистемы(ТикетСистема)
	ОбработкаТаймлоговТикетСистемы = НовыйОбработкаТаймлоговТикетСистемы(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТикетСистема, "ТипСистемы"));
	ОбработкаТаймлоговТикетСистемы.Инициализировать(ТикетСистема);
	Возврат ОбработкаТаймлоговТикетСистемы;
КонецФункции                              

Функция НовыйОбработкаТаймлоговТикетСистемы(ТипСистемы)
	Если ТипСистемы = Справочники.ТипыСистемТикетов.ЛокальныйУчет Тогда
		Возврат Обработки.ТаймлогиЛокальныйУчет.Создать();
	ИначеЕсли ТипСистемы = Справочники.ТипыСистемТикетов.GitLab Тогда
		Возврат Обработки.ТаймлогиGitlab.Создать();
	Иначе
		ВызватьИсключение СтрШаблон("Для типа <%1> обработчик чтения таймлогов не определен", ТипСистемы);
	КонецЕсли;
КонецФункции

// Заполняет ВнешняяЗадача тикета, подключённого к GitLab: сначала поиск
// в зеркале, затем API GitLab по данным из СсылкаНаВнешнийТикет.
//
Процедура ЗаполнитьВнешнююЗадачуТикетаGitlab(ТикетОбъект)

	СсылкаЗадачи = ГитлабЗеркало.СсылкаЗадачиПоВебURL(ТикетОбъект.СсылкаНаВнешнийТикет);

	Если СсылкаЗадачи.Пустая() Тогда
		СсылкаЗадачи = ГитлабЗеркало.НайтиИлиЗеркалироватьЗадачуПоВебURL(
			ТикетОбъект.ВнешняяСистема, ТикетОбъект.СсылкаНаВнешнийТикет);
	КонецЕсли;

	Если СсылкаЗадачи.Пустая() Тогда
		// Цифровой ВнешнийИдентификатор трактуем как глобальный id задачи GitLab.
		Идентификатор = ЧислоИзСтроки(ТикетОбъект.ВнешнийИдентификатор);
		Если Идентификатор > 0 Тогда
			СсылкаЗадачи = ГитлабЗеркало.СсылкаЗадачиПоИдентификатору(Идентификатор);
		КонецЕсли;
	КонецЕсли;

	Если НЕ СсылкаЗадачи.Пустая() Тогда
		ТикетОбъект.ВнешняяЗадача = СсылкаЗадачи;
	КонецЕсли;

КонецПроцедуры

// Ищет тикет без заполненной связки по внешнему идентификатору задачи.
//
// Параметры:
//   ВнешнийИдентификатор - Строка - глобальный id задачи внешней системы.
//
// Возвращаемое значение:
//   СправочникСсылка.Тикеты - пустая, если тикет не найден.
//
Функция ТикетПоВнешнемуИдентификатору(Знач ВнешнийИдентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Тикеты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Тикеты КАК Тикеты
	|ГДЕ
	|	Тикеты.ВнешнийИдентификатор = &ВнешнийИдентификатор
	|	И Тикеты.ВнешняяЗадача = ЗНАЧЕНИЕ(Справочник.ГитлабЗадачи.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ВнешнийИдентификатор", ВнешнийИдентификатор);

	Возврат СсылкаИзВыборки(Запрос);

КонецФункции

// Ищет тикет без заполненной связки по ссылке на внешний тикет.
//
// Параметры:
//   ВебURL - Строка - веб-URL задачи внешней системы.
//
// Возвращаемое значение:
//   СправочникСсылка.Тикеты - пустая, если тикет не найден.
//
Функция ТикетПоВнешнейСсылке(Знач ВебURL)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Тикеты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Тикеты КАК Тикеты
	|ГДЕ
	|	ВЫРАЗИТЬ(Тикеты.СсылкаНаВнешнийТикет КАК СТРОКА(1024)) = &ВебURL
	|	И Тикеты.ВнешняяЗадача = ЗНАЧЕНИЕ(Справочник.ГитлабЗадачи.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ВебURL", ВебURL);

	Возврат СсылкаИзВыборки(Запрос);

КонецФункции

// Возвращает первую ссылку выборки запроса (пустая, если выборка пуста).
//
// Параметры:
//   Запрос - Запрос - однотабличный запрос с полем Ссылка.
//
// Возвращаемое значение:
//   СправочникСсылка.Тикеты.
//
Функция СсылкаИзВыборки(Знач Запрос)

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Тикеты.ПустаяСсылка();

КонецФункции

// Подбирает внешнюю систему для задачи зеркала: базовый URL системы -
// префикс веб-URL задачи. Система, уже указанная в тикете, имеет
// предпочтение при нескольких подходящих.
//
// Параметры:
//   ВебURL         - Строка - веб-URL задачи зеркала.
//   ТекущаяСистема - СправочникСсылка.ВнешниеСистемыТикетов - система,
//     уже указанная в тикете.
//
// Возвращаемое значение:
//   СправочникСсылка.ВнешниеСистемыТикетов - пустая, если ни одна система
//   не подходит.
//
Функция СистемаПоЗадачеЗеркала(Знач ВебURL, Знач ТекущаяСистема = Неопределено)

	Если ЗначениеЗаполнено(ТекущаяСистема) Тогда
		БазовыйURL = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСистема, "БазовыйURL");
		Если ЗначениеЗаполнено(БазовыйURL)
			И СтрНачинаетсяС(ВебURL, БазовыйURL) Тогда
			Возврат ТекущаяСистема;
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Системы.Ссылка КАК Ссылка,
		|	Системы.БазовыйURL КАК БазовыйURL
		|ИЗ
		|	Справочник.ВнешниеСистемыТикетов КАК Системы
		|ГДЕ
		|	НЕ Системы.Архивная";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.БазовыйURL)
			И СтрНачинаетсяС(ВебURL, Выборка.БазовыйURL) Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Справочники.ВнешниеСистемыТикетов.ПустаяСсылка();

КонецФункции

// Возвращает число из строки цифр (0, если строка не является числом).
//
Функция ЧислоИзСтроки(Знач Строка)

	Строка = СокрЛП(Строка);

	Если НЕ СтрокаИзЦифр(Строка) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Число(Строка);

КонецФункции

// Определяет, состоит ли строка только из цифр (пустая строка - не число).
//
Функция СтрокаИзЦифр(Знач Строка)

	Если ПустаяСтрока(Строка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для НомерСимвола = 1 По СтрДлина(Строка) Цикл

		Код = КодСимвола(Строка, НомерСимвола);

		Если Код < 48 Или Код > 57 Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции
