#Область ПрограммныйИнтерфейс
// Опрашивает тикет-системы и собирает таймлоги на дату в единой таблице.
// Система не ответила - её таймлоги не входят в таблицу, а сама система
// попадает в НеОтветившиеСистемы.
//
// Параметры:
//   Дата - Дата - день, за который собираются таймлоги.
//   ОпрашиваемыеТикетСистемы - Массив - системы для опроса; если не задана,
//     опрашиваются все неархивные (см. ТикетСистемыКромеАрхивных).
//
// Возвращаемое значение:
//   Структура - Таймлоги (ТаблицаЗначений -
//   УчетРабочегоВремени.ИнициализироватьТаблицуТаймлогов),
//   НеОтветившиеСистемы (Массив ссылок).
//
Функция СобратьТаймлогиНаДату(Дата, Знач ОпрашиваемыеТикетСистемы = Неопределено) Экспорт
	Если ОпрашиваемыеТикетСистемы = Неопределено Тогда
		ОпрашиваемыеТикетСистемы = ТикетСистемыКромеАрхивных();
	КонецЕсли;
	
	НеОтветившиеСистемы = Новый Массив;
	Таймлоги = УчетРабочегоВремени.ИнициализироватьТаблицуТаймлогов();
	Для Каждого ТикетСистема из ОпрашиваемыеТикетСистемы Цикл 
		ТаймлогиТикетСистемы = ОбработкаТаймлоговТикетСистемы(ТикетСистема);
		РезультатЗапроса = ТаймлогиТикетСистемы.СобратьТаймлогиНаДату(Дата);
		Если ТипЗнч(РезультатЗапроса) = Тип("ТаблицаЗначений") Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(РезультатЗапроса, Таймлоги);
		Иначе
			НеОтветившиеСистемы.Добавить(ТикетСистема);
			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(
				"УчетРабочегоВремени.ПолучениеТаймлогов",
				УровеньЖурналаРегистрации.Предупреждение,
				,
				,
				РезультатЗапроса
			);
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура("Таймлоги, НеОтветившиеСистемы", Таймлоги, НеОтветившиеСистемы);
	Возврат Результат;
КонецФункции

// Загружает задачи проекта тикет-системы в зеркало и обеспечивает тикеты
// по задачам зеркала (для отправки записей времени).
//
// Параметры:
//   ВнешняяСистема  - СправочникСсылка.ВнешниеСистемыТикетов.
//   ПроектIDилиПуть - Число или Строка - идентификатор или путь проекта
//     ("Neumoichev_D/3E").
//
// Возвращаемое значение:
//   Структура адаптера (см. ТаймлогиGitlab.ЗагрузитьЗадачиПроекта):
//   Зеркало, ТикетовСоздано, ТикетовВсего.
//
Функция ЗагрузитьЗадачиПроекта(Знач ВнешняяСистема, Знач ПроектIDилиПуть) Экспорт

	ТипСистемы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВнешняяСистема, "ТипСистемы");

	Если ТипСистемы <> Справочники.ТипыСистемТикетов.GitLab Тогда
		ВызватьИсключение СтрШаблон(
			"Загрузка задач проекта поддерживается только для GitLab (получен тип <%1>)",
			ТипСистемы);
	КонецЕсли;

	Обработчик = ОбработкаТаймлоговТикетСистемы(ВнешняяСистема);

	Возврат Обработчик.ЗагрузитьЗадачиПроекта(ПроектIDилиПуть);

КонецФункции

// Синхронизирует документ ЛУРВ с внешними системами его строк: состояние
// каждой системы сводится к документу - записи времени на дату документа,
// которых нет среди строк, удаляются; строки без записи или с изменёнными
// данными отправляются заново; ссылки на созданные записи заносятся
// в СсылкаНаТаймлог строк. Документ не записывается - за записью отвечает
// вызывающий код.
//
// Параметры:
//   ДокументОбъект - ДокументОбъект.ЛУРВ - синхронизируемый документ.
//
// Возвращаемое значение:
//   Структура - Отправлено, Удалено, Обновлено, Пропущено (Числа;
//     Пропущено - строки задач без интеграции), Ошибки (Массив строк).
//
Функция СинхронизироватьДокумент(ДокументОбъект) Экспорт

	Результат = Новый Структура("Отправлено, Удалено, Обновлено, Пропущено, Ошибки",
		0, 0, 0, 0, Новый Массив);

	ДатаРаботы = НачалоДня(ДокументОбъект.Дата);

	СтрокиПоСистемам = СтрокиДокументаПоСистемам(ДокументОбъект, Результат);

	Для Каждого СтрокиСистемы Из СтрокиПоСистемам Цикл

		Обработчик      = ОбработкаТаймлоговТикетСистемы(СтрокиСистемы.Ключ);
		РезультатСистемы = Обработчик.СинхронизироватьСтрокиДокумента(
			СтрокиСистемы.Значение, ДатаРаботы);

		Если ТипЗнч(РезультатСистемы) <> Тип("Структура") Тогда
			// Адаптер вернул строку ошибки - система не ответила целиком.
			Результат.Ошибки.Добавить(РезультатСистемы);
			Продолжить;
		КонецЕсли;

		Результат.Отправлено = Результат.Отправлено + РезультатСистемы.Отправлено;
		Результат.Удалено    = Результат.Удалено + РезультатСистемы.Удалено;
		Результат.Обновлено  = Результат.Обновлено + РезультатСистемы.Обновлено;

		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			Результат.Ошибки, РезультатСистемы.Ошибки);

		Для Каждого Пара Из РезультатСистемы.ГидыПоСтрокам Цикл
			ДокументОбъект.ОтчетЗаДень[Пара.Ключ].СсылкаНаТаймлог = Пара.Значение;
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заполняет реквизит ВнешняяЗадача тикета по данным внешней системы.
// Вызывается при записи тикета, когда заполнены данные внешней системы
// (ВнешнийИдентификатор и/или СсылкаНаВнешнийТикет), а связка ещё пустая.
// Задача не найдена во внешней системе - реквизит остаётся пустым.
// Уже заполненная ВнешняяЗадача не перезаписывается.
//
// Параметры:
//   ТикетОбъект - СправочникОбъект.Тикеты - записываемый тикет.
//
Процедура ЗаполнитьВнешнююЗадачуТикета(ТикетОбъект) Экспорт

	Если НЕ ЗначениеЗаполнено(ТикетОбъект.ВнешняяСистема)
		Или ЗначениеЗаполнено(ТикетОбъект.ВнешняяЗадача) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ТикетОбъект.ВнешнийИдентификатор)
		И НЕ ЗначениеЗаполнено(ТикетОбъект.СсылкаНаВнешнийТикет) Тогда
		Возврат;
	КонецЕсли;

	ТипСистемы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТикетОбъект.ВнешняяСистема, "ТипСистемы");

	Если ТипСистемы = Справочники.ТипыСистемТикетов.GitLab Тогда
		ЗаполнитьВнешнююЗадачуТикетаGitlab(ТикетОбъект);
	КонецЕсли;

КонецПроцедуры

// Возвращает тикет, связанный с задачей зеркала внешней системы.
// Сначала ищет по реквизиту ВнешняяЗадача, затем - по ВнешнийИдентификатору
// и СсылкаНаВнешнийТикет (тикеты, записанные до появления связки).
//
// Параметры:
//   ЗадачаЗеркала - СправочникСсылка.ГитлабЗадачи.
//
// Возвращаемое значение:
//   СправочникСсылка.Тикеты - пустая, если тикет не найден.
//
Функция ТикетПоВнешнейЗадаче(Знач ЗадачаЗеркала) Экспорт

	Если НЕ ЗначениеЗаполнено(ЗадачаЗеркала) Тогда
		Возврат Справочники.Тикеты.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Тикеты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Тикеты КАК Тикеты
	|ГДЕ
	|	Тикеты.ВнешняяЗадача = &Задача";
	Запрос.УстановитьПараметр("Задача", ЗадачаЗеркала);

	Тикет = СсылкаИзВыборки(Запрос);

	Если НЕ Тикет.Пустая() Тогда
		Возврат Тикет;
	КонецЕсли;

	// Фолбэк: тикеты с данными внешней системы, но без заполненной связки.
	РеквизитыЗадачи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗадачаЗеркала, "Идентификатор, ВебURL");

	Тикет = ТикетПоВнешнемуИдентификатору(Формат(РеквизитыЗадачи.Идентификатор, "ЧГ="));

	Если НЕ Тикет.Пустая() Тогда
		Возврат Тикет;
	КонецЕсли;

	Возврат ТикетПоВнешнейСсылке(РеквизитыЗадачи.ВебURL);

КонецФункции

// Возвращает реквизиты адресации тикета по выбранной задаче зеркала GitLab:
// внешнюю систему (подбирается по базовому URL задачи), внешний идентификатор
// и ссылку на внешний тикет. Используется командой «Заполнить по задаче
// GitLab» формы тикета.
//
// Параметры:
//   ЗадачаЗеркала  - СправочникСсылка.ГитлабЗадачи - выбранная задача.
//   ТекущаяСистема - СправочникСсылка.ВнешниеСистемыТикетов - система, уже
//     указанная в тикете (при нескольких подходящих отдаётся предпочтение ей).
//
// Возвращаемое значение:
//   Структура - Успешно (Булево), Сообщение (Строка - причина отказа),
//     Система (СправочникСсылка.ВнешниеСистемыТикетов), ВнешнийИдентификатор
//     (Строка), ВебURL (Строка), Наименование (Строка - заголовок задачи).
//
Функция РеквизитыАдресацииПоЗадаче(Знач ЗадачаЗеркала, Знач ТекущаяСистема = Неопределено) Экспорт

	Результат = Новый Структура(
		"Успешно, Сообщение, Система, ВнешнийИдентификатор, ВебURL, Наименование",
		Ложь, "", Справочники.ВнешниеСистемыТикетов.ПустаяСсылка(), "", "", "");

	Если НЕ ЗначениеЗаполнено(ЗадачаЗеркала) Тогда
		Результат.Сообщение = НСтр("ru = 'Не выбрана задача GitLab.'");
		Возврат Результат;
	КонецЕсли;

	РеквизитыЗадачи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗадачаЗеркала,
		"Наименование, Идентификатор, ВебURL");

	Результат.Наименование         = РеквизитыЗадачи.Наименование;
	Результат.ВнешнийИдентификатор = Формат(РеквизитыЗадачи.Идентификатор, "ЧГ=");
	Результат.ВебURL               = РеквизитыЗадачи.ВебURL;

	Система = СистемаПоЗадачеЗеркала(РеквизитыЗадачи.ВебURL, ТекущаяСистема);

	Если Система.Пустая() Тогда
		Результат.Сообщение = СтрШаблон(
			НСтр("ru = 'Для задачи %1 не найдена внешняя система с подходящим базовым URL.'"),
			РеквизитыЗадачи.ВебURL);
		Возврат Результат;
	КонецЕсли;

	Результат.Система = Система;
	Результат.Успешно = Истина;

	Возврат Результат;

КонецФункции

