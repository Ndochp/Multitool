// Модуль менеджера документа «Лист учета рабочего времени» (ЛУРВ).
// Печатная форма — табличный документ с колонками:
// «Неделя», «Дата», «Время», «Описание», «Время окончания», «Длительность»,
// «Ссылка на задачу», «Примечание».
// Форматные представления значений — общий модуль ЛУРВКлиентСервер.

#Region ПечатнаяФорма

// Строит печатную форму по группе документов ЛУРВ (один день или период).
//
// Параметры:
//   Ссылки - Массив - ссылки на документы ЛУРВ.
//
// Возвращаемое значение:
//   ТабличныйДокумент - печатная форма; закрывается показывающей стороной.
//
Функция ПечатнаяФорма(Ссылки) Экспорт

    Строки = СтрокиПечатнойФормы(Ссылки);

    ТабДок = Новый ТабличныйДокумент;
    ОформитьПечатнуюФорму(ТабДок, Ссылки);
    ВывестиСтрокиПечатнойФормы(ТабДок, Строки);

    Возврат ТабДок;

КонецФункции

#КонецОбласти // ПечатнаяФорма

#Region ПодсистемаПечати

// Объект подключен к стандартной подсистеме «Печать» (БСП). Вызывается
// подсистемой после регистрации объекта в
// УправлениеПечатьюПереопределяемый.ПриОпределенииНастроекПечати.
//
// Параметры:
//   Настройки - Структура:
//    * ПриДобавленииКомандПечати - Булево - вызывать ДобавитьКомандыПечати
//      этого менеджера для формирования списка команд печати.
//
Процедура ПриОпределенииНастроекПечати(Настройки) Экспорт

    Настройки.ПриДобавленииКомандПечати = Истина;

КонецПроцедуры

// Добавляет команду печати листа учета рабочего времени.
//
// Параметры:
//   КомандыПечати - см. УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.Идентификатор = ИдентификаторПечатнойФормы();
    КомандаПечати.Представление = ПредставлениеПечатнойФормы();
    КомандаПечати.ЗаголовокФормы = ПредставлениеПечатнойФормы();

КонецПроцедуры

// Формирует печатную форму для подсистемы «Печать».
// Протокол параметров — см. УправлениеПечатьюПереопределяемый.ПриПечати.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

    Если НЕ ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
        Возврат;
    КонецЕсли;

    МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
    Если НЕ МодульУправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, ИдентификаторПечатнойФормы()) Тогда
        Возврат;
    КонецЕсли;

    ТабДок = ПечатнаяФорма(МассивОбъектов);

    МодульУправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
        КоллекцияПечатныхФорм,
        ИдентификаторПечатнойФормы(),
        ПредставлениеПечатнойФормы(),
        ТабДок);

КонецПроцедуры

#КонецОбласти // ПодсистемаПечати

#Область СлужебныеПроцедурыИФункции

// Строки данных печатной формы: строки отчёта за день выбранных документов
// в хронологическом порядке.
Функция СтрокиПечатнойФормы(Ссылки)

    ТекстЗапроса = "ВЫБРАТЬ" +
        " ОтчетЗаДень.Начало КАК Начало," +
        " ОтчетЗаДень.Окончание КАК Окончание," +
        " ОтчетЗаДень.Описание КАК Описание," +
        " ОтчетЗаДень.Длительность КАК Длительность," +
        " ОтчетЗаДень.СсылкаНаТаймлог КАК СсылкаНаТаймлог," +
        " ОтчетЗаДень.Тикет.СсылкаНаВнешнийТикет КАК СсылкаНаЗадачу" +
        " ИЗ Документ.ЛУРВ.ОтчетЗаДень КАК ОтчетЗаДень" +
        " ГДЕ ОтчетЗаДень.Ссылка В(&Ссылки)" +
        " УПОРЯДОЧИТЬ ПО Начало, НомерСтроки";

    ОтборСсылок = Новый Массив;
    Для Каждого Ссылка Из Ссылки Цикл
        ОтборСсылок.Добавить(Ссылка);
    КонецЦикла;

    Запрос = Новый Запрос(ТекстЗапроса);
    Запрос.УстановитьПараметр("Ссылки", ОтборСсылок);

    Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Оформление листа: альбомная А4, заголовок, повторяемая шапка колонок,
// ширина колонок (мм).
Процедура ОформитьПечатнуюФорму(ТабДок, Ссылки)

    ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
    ТабДок.РазмерСтраницы = "A4";

    КоличествоКолонок = 8;

    // Строка 1 — заголовок.
    ОбластьЗаголовка = ТабДок.Область(1, 1, 1, КоличествоКолонок);
    ОбластьЗаголовка.Объединить();
    ОбластьЗаголовка.Текст = ЗаголовокПечатнойФормы(Ссылки);
    ОбластьЗаголовка.Шрифт = Новый Шрифт(, 12, Истина);
    ОбластьЗаголовка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
    ОбластьЗаголовка.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
    ОбластьЗаголовка.ВысотаСтроки = 8;

    // Строка 2 — шапка колонок.
    Шапка = Новый Массив;
    Шапка.Добавить("Неделя");
    Шапка.Добавить("Дата");
    Шапка.Добавить("Время");
    Шапка.Добавить("Описание");
    Шапка.Добавить("Время окончания");
    Шапка.Добавить("Длительность");
    Шапка.Добавить("Ссылка на задачу");
    Шапка.Добавить("Примечание");

    ТонкаяЛиния = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);

    Для Колонка = 1 По КоличествоКолонок Цикл
        Ячейка = ТабДок.Область(2, Колонка);
        Ячейка.Текст = Шапка[Колонка - 1];
        Ячейка.Шрифт = Новый Шрифт(, , Истина);
        Ячейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
        Ячейка.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
        Ячейка.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
        Ячейка.ЦветФона = WebЦвета.Silver;
        Ячейка.Обвести(ТонкаяЛиния, ТонкаяЛиния, ТонкаяЛиния, ТонкаяЛиния);
    КонецЦикла;

    Ширины = Новый Массив;
    Ширины.Добавить(10);  // Неделя
    Ширины.Добавить(12);  // Дата
    Ширины.Добавить(10);  // Время
    Ширины.Добавить(60);  // Описание
    Ширины.Добавить(14);  // Время окончания
    Ширины.Добавить(12);  // Длительность
    Ширины.Добавить(55);  // Ссылка на задачу
    Ширины.Добавить(14);  // Примечание
    Для Колонка = 1 По КоличествоКолонок Цикл
        ТабДок.Область(1, Колонка).ШиринаКолонки = Ширины[Колонка - 1];
    КонецЦикла;

    // Строки 1–2 — заголовок, печатается на каждой странице.
    ТабДок.ПовторятьПриПечатиСтроки = ТабДок.Область(1, 1, 2, КоличествоКолонок);

КонецПроцедуры

Функция ЗаголовокПечатнойФормы(Ссылки)

    Заголовок = "Лист учета рабочего времени";

    Если Ссылки.Количество() = 1 Тогда
        Ссылка = Ссылки[0];
        Если НЕ ПустаяСтрока(Ссылка.Номер) Тогда
            Заголовок = Заголовок + " №" + Ссылка.Номер;
        КонецЕсли;
        // Токены ДФ чувствительны к регистру: день "дд", год "гггг" — строчные.
        Заголовок = Заголовок + " от " + Формат(Ссылка.Дата, "ДФ=дд.ММ.гггг");
    КонецЕсли;

    Возврат Заголовок;

КонецФункции

// Идентификатор печатной формы: используется командой печати подсистемы
// «Печать» и как имя макета в коллекции печатных форм.
Функция ИдентификаторПечатнойФормы()

    Возврат "ЛистУчетаРабочегоВремени";

КонецФункции

// Представление печатной формы (команда печати, форма «Печать документов»).
Функция ПредставлениеПечатнойФормы()

    Возврат НСтр("ru = 'Лист учета рабочего времени'");

КонецФункции

// Данные строк: ячейки с тонкой рамкой; текстовые колонки (описание, ссылка)
// — перенос по словам, остальные — по центру.
Процедура ВывестиСтрокиПечатнойФормы(ТабДок, Строки)

    ТонкаяЛиния = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);

    Для Индекс = 0 По Строки.Количество() - 1 Цикл
        Данные = Строки[Индекс];
        СтрокаВывода = Индекс + 3;

        НеделяТекст = "";
        Если ЗначениеЗаполнено(Данные.Начало) Тогда
            НеделяТекст = Строка(ЛУРВКлиентСервер.НомерНеделиISO(Данные.Начало));
        КонецЕсли;

        СсылкаНаЗадачуТекст = "";
        Если ЗначениеЗаполнено(Данные.СсылкаНаЗадачу) Тогда
            СсылкаНаЗадачуТекст = Строка(Данные.СсылкаНаЗадачу);
        КонецЕсли;

        // «Примечание»: «+» у строк, отправленных во внешнюю систему (есть
        // ссылка на таймлог) — строка подтверждена в задаче.
        ПримечаниеТекст = "";
        Если ЗначениеЗаполнено(Данные.СсылкаНаТаймлог) Тогда
            ПримечаниеТекст = "+";
        КонецЕсли;

        Значения = Новый Массив;
        Значения.Добавить(НеделяТекст);
        Значения.Добавить(ЛУРВКлиентСервер.ДатаКраткоСтрокой(Данные.Начало));
        Значения.Добавить(ЛУРВКлиентСервер.ВремяСтрокой(Данные.Начало));
        Значения.Добавить(Данные.Описание);
        Значения.Добавить(ЛУРВКлиентСервер.ВремяСтрокой(Данные.Окончание));
        Значения.Добавить(ЛУРВКлиентСервер.ДлительностьКраткоСтрокой(Данные.Длительность));
        Значения.Добавить(СсылкаНаЗадачуТекст);
        Значения.Добавить(ПримечаниеТекст);

        Для Колонка = 1 По Значения.Количество() Цикл
            Ячейка = ТабДок.Область(СтрокаВывода, Колонка);
            Ячейка.Текст = Значения[Колонка - 1];
            Ячейка.Обвести(ТонкаяЛиния, ТонкаяЛиния, ТонкаяЛиния, ТонкаяЛиния);
            Ячейка.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
            Если Колонка = 4 Или Колонка = 7 Тогда
                Ячейка.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
                Ячейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
            Иначе
                Ячейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

КонецПроцедуры

#КонецОбласти // СлужебныеПроцедурыИФункции
