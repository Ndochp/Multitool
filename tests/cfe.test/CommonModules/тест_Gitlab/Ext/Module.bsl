// ТЕСТ_GQL_Q002_УспешноеПолучениеПроектов: Успешное получение списка проектов пользователя через GraphQL
//
// Дано: Mock HTTP-сокета, возвращающий ответ GraphQL с массивом проектов
// Когда: Вызван ПолучитьПроектыПользователяGraphQL(12345)
// То: Возвращается ТаблицаЗначений с полями project_id, project_name, project_path,
//     description, web_url, api_url, archived, visibility, default_branch
//
Процедура ТЕСТ_GQL_Q002_УспешноеПолучениеПроектов() Экспорт

	// Подготовка: мок ответа GraphQL
	МокОтвет = ЮТест.Данные().HTTPОтвет()
		.УстановитьКодСостояния(200)
		.УстановитьТело(СоздатьМокGraphQLПроектов());
	
	// Настраиваем мок для POST запроса к GraphQL endpoint
	Мокито.Обучение(КоннекторHTTP)
		.Когда("Post")
		.Вернуть(МокОтвет)
		.Прогон();

	Интеграция = Обработки.ИнтеграцияGitlab.Создать();
	Интеграция.УстановитьБазовыйURL("https://gitlab.example.com");
	Интеграция.УстановитьТокен("glpat-test-token");

	// Действие
	Результат = Интеграция.ПолучитьПроектыПользователяGraphQL(12345);

	// Проверка количества записей
	ЮТест.ОжидаетЧто(Результат.Количество())
		.Равно(2, "Должно быть 2 проекта");

	// Проверка первой записи
	ЮТест.ОжидаетЧто(Результат[0].project_id)
		.Равно(101, "ID первого проекта должен быть 101");

	ЮТест.ОжидаетЧто(Результат[0].project_name)
		.Равно("Проект А", "Название проекта должно соответствовать");

	ЮТест.ОжидаетЧто(Результат[0].project_path)
		.Равно("group/project-a", "Путь проекта должен соответствовать");

	ЮТест.ОжидаетЧто(Результат[0].description)
		.Равно("Описание проекта А", "Описание должно соответствовать");

	ЮТест.ОжидаетЧто(Результат[0].web_url)
		.Равно("https://gitlab.example.com/group/project-a", "Web URL должен соответствовать");

	ЮТест.ОжидаетЧто(Результат[0].api_url)
		.Равно("https://gitlab.example.com/api/v4/projects/101", "API URL должен соответствовать");

	ЮТест.ОжидаетЧто(Результат[0].archived)
		.Равно(Ложь, "Проект не должен быть архивным");

	ЮТест.ОжидаетЧто(Результат[0].visibility)
		.Равно("PRIVATE", "Видимость должна быть PRIVATE");

	ЮТест.ОжидаетЧто(Результат[0].default_branch)
		.Равно("main", "Ветка по умолчанию должна быть main");

	// Проверка второй записи (архивный проект)
	ЮТест.ОжидаетЧто(Результат[1].project_id)
		.Равно(102, "ID второго проекта должен быть 102");

	ЮТест.ОжидаетЧто(Результат[1].project_name)
		.Равно("Проект Б (архив)", "Название архивного проекта должно соответствовать");

	ЮТест.ОжидаетЧто(Результат[1].archived)
		.Равно(Истина, "Второй проект должен быть архивным");

	ЮТест.ОжидаетЧто(Результат[1].visibility)
		.Равно("INTERNAL", "Видимость архивного проекта должна быть INTERNAL");

КонецПроцедуры

