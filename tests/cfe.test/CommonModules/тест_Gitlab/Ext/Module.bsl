	// Подготовка: подмена КоннекторHTTP.Get через Мокито
	МокОтвет = ЮТест.Данные().HTTPОтвет()
		.УстановитьКодСостояния(200)
		.УстановитьТело(СоздатьПустойМассивJSON());
	Мокито.Обучение(КоннекторHTTP)
