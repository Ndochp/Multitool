		.Вернуть(МокОтвет)
		.Прогон();

	Интеграция = Обработки.ИнтеграцияGitlab.Создать();
	Интеграция.УстановитьБазовыйURL("https://gitlab.example.com");
	Интеграция.УстановитьТокен("glpat-test-token");

	// Действие: вызываем ПолучитьTimelogи - внутри он формирует URL с параметрами
	Результат = Интеграция.ПолучитьTimelogи(1, 42, "2024-01-01", "2024-01-31");

	// Проверяем, что метод Get был вызван ровно 1 раз
	Мокито.Проверить(КоннекторHTTP)
