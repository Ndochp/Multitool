// ТЕСТ_GQL_Q002_ПагинацияПроектов: Пагинация при большом количестве проектов
//
// Дано: Mock HTTP-сокета, возвращающий проекты постранично (2 страницы)
// Когда: Вызван ПолучитьПроектыПользователяGraphQL(12345)
// То: Выполняется несколько POST запросов, все проекты собраны в один результат
//
Процедура ТЕСТ_GQL_Q002_ПагинацияПроектов() Экспорт

	// Подготовка: моки для двух страниц
	МокОтветСтраница1 = ЮТест.Данные().HTTPОтвет()
		.УстановитьКодСостояния(200)
		.УстановитьТело(СоздатьМокGraphQLПроектыСтраница1());
	
	МокОтветСтраница2 = ЮТест.Данные().HTTPОтвет()
		.УстановитьКодСостояния(200)
		.УстановитьТело(СоздатьМокGraphQLПроектыСтраница2());
	
	// Обучаем мок: первый вызов возвращает страницу 1, второй - страницу 2
	Мокито.Обучение(КоннекторHTTP)
		.Когда("Post")
		.Вернуть(МокОтветСтраница1)
		.Потом()
		.Вернуть(МокОтветСтраница2)
		.Прогон();

	Интеграция = Обработки.ИнтеграцияGitlab.Создать();
	Интеграция.УстановитьБазовыйURL("https://gitlab.example.com");
	Интеграция.УстановитьТокен("glpat-test-token");

	// Действие
	Результат = Интеграция.ПолучитьПроектыПользователяGraphQL(12345);

	// Проверка: получены проекты с обеих страниц
	ЮТест.ОжидаетЧто(Результат.Количество())
		.Равно(4, "Должно быть 4 проекта (2 со страницы 1 + 2 со страницы 2)");

	// Проверка: было выполнено 2 POST запроса (пагинация)
	Мокито.Проверить(КоннекторHTTP)
		.КоличествоВызовов("Post").Равно(2);

КонецПроцедуры

