	// Первый параметр Get - URL
	URLВызова = Вызовы[0].Параметры[0];
	// Второй параметр Get - ПараметрыЗапроса
	ПараметрыЗапроса = Вызовы[0].Параметры[1];

	ЮТест.ОжидаетЧто(URLВызова)
		.Содержит("spent_at_on_or_after=2024-01-01",
			"URL должен содержать параметр spent_at_on_or_after");

	ЮТест.ОжидаетЧто(URLВызова)
		.Содержит("spent_at_before=2024-01-31",
			"URL должен содержать параметр spent_at_before");

	ЮТест.ОжидаетЧто(URLВызова)
		.Содержит("/api/v4/projects/1/issues/42/timelogs",
			"URL должен содержать путь к timelogs задачи");

