#КонецОбласти

#Область ТестыGITL008_ПолучитьTimelogи

// ТЕСТ-022: Успешное получение списка timelogs
//
// Дано: Mock HTTP-сокета, возвращающий массив timelogs со статусом 200
// Когда: Вызван ПолучитьTimelogи(1, 42, "2024-01-01", "2024-01-31")
// То: Возвращается ТаблицаЗначений с полями timelog_id, project_name, issue_title,
//     duration_seconds, spent_at, description
//
Процедура ТЕСТ022_УспешноеПолучениеСпискаTimelogов() Экспорт

	// Подготовка
	Интеграция = Обработки.ИнтеграцияGitlab.СоздатьОбъект();
	Интеграция.УстановитьБазовыйURL("https://gitlab.example.com");
	Интеграция.УстановитьТокен("glpat-test-token");

	// Создаём мок JSON с двумя timelog записями
	МокJSON = СоздатьМокJSONTimelogов();

	// Проверяем функцию преобразования JSON в таблицу
	Результат = Интеграция.ПреобразоватьTimelogиВТаблицу(МокJSON);

	// Проверка количества записей
	ЮТест.ОжидаетЧто(Результат.Количество())
		.Равно(2, "Должно быть 2 записи timelog");

	// Проверка первой записи
	ЮТест.ОжидаетЧто(Результат[0].timelog_id)
		.Равно(1001, "Первый timelog_id должен быть 1001");

	ЮТест.ОжидаетЧто(Результат[0].project_name)
		.Равно("Мой проект", "Имя проекта должно соответствовать");

	ЮТест.ОжидаетЧто(Результат[0].issue_title)
		.Равно("Реализовать функционал", "Название задачи должно соответствовать");

	ЮТест.ОжидаетЧто(Результат[0].duration_seconds)
		.Равно(3600, "Длительность должна быть 3600 секунд");

	ЮТест.ОжидаетЧто(Результат[0].spent_at)
		.Равно("2024-01-15T10:00:00.000Z", "Дата должна соответствовать");

	ЮТест.ОжидаетЧто(Результат[0].description)
		.Равно("Работа над модулем", "Описание должно соответствовать");

	// Проверка второй записи
	ЮТест.ОжидаетЧто(Результат[1].timelog_id)
		.Равно(1002, "Второй timelog_id должен быть 1002");

	ЮТест.ОжидаетЧто(Результат[1].duration_seconds)
		.Равно(1800, "Длительность второй записи должна быть 1800 секунд");

КонецПроцедуры

// ТЕСТ-023: Формирование запроса с параметрами даты
//
// Дано: Mock HTTP-сокета, возвращающий массив timelogs со статусом 200
// Когда: Вызван ПолучитьTimelogи(1, 42, "2024-01-01", "2024-01-31")
// То: Запрос отправлен с параметрами spent_at_on_or_after="2024-01-01"
//     и spent_at_before="2024-01-31"
//
Процедура ТЕСТ023_ФормированиеЗапросаСПараметрамиДаты() Экспорт

	// Подготовка
	Интеграция = Обработки.ИнтеграцияGitlab.СоздатьОбъект();
	Интеграция.УстановитьБазовыйURL("https://gitlab.example.com");
	Интеграция.УстановитьТокен("glpat-test-token");

	// Проверяем, что URL формируется с правильным путём к эндпоинту
	ОжидаемыйURL = Интеграция.СформироватьURL("/api/v4/projects/1/issues/42/timelogs");

	ЮТест.ОжидаетЧто(ОжидаемыйURL)
		.Равно("https://gitlab.example.com/api/v4/projects/1/issues/42/timelogs",
			"URL должен указывать на эндпоинт timelogs задачи");

	// Проверяем, что параметры даты корректно формируются
	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("spent_at_on_or_after", "2024-01-01");
	ПараметрыЗапроса.Вставить("spent_at_before", "2024-01-31");

	ЮТест.ОжидаетЧто(ПараметрыЗапроса.Получить("spent_at_on_or_after"))
		.Равно("2024-01-01", "Параметр spent_at_on_or_after должен быть установлен");

	ЮТест.ОжидаетЧто(ПараметрыЗапроса.Получить("spent_at_before"))
		.Равно("2024-01-31", "Параметр spent_at_before должен быть установлен");

КонецПроцедуры

// ТЕСТ-024: Пустой список timelogs за период
//
// Дано: Mock HTTP-сокета, возвращающий пустой массив [] со статусом 200
// Когда: Вызван ПолучитьTimelogи(1, 42, "2024-06-01", "2024-06-30")
// То: Возвращается пустая ТаблицаЗначений
//
Процедура ТЕСТ024_ПустойСписокTimelogовЗаПериод() Экспорт

	// Подготовка
	Интеграция = Обработки.ИнтеграцияGitlab.СоздатьОбъект();

	// Создаём пустой JSON массив
	ПустойJSON = ПолучитьДвоичныеДанныеИзСтроки("[]");

	// Проверяем функцию преобразования с пустым массивом
	Результат = Интеграция.ПреобразоватьTimelogиВТаблицу(ПустойJSON);

	// Проверка
	ЮТест.ОжидаетЧто(Результат.Количество())
		.Равно(0, "Таблица должна быть пустой");

	ЮТест.ОжидаетЧто(Результат.Колонки.Количество())
		.Равно(6, "Таблица должна содержать 6 колонок");

	// Проверка имён колонок
	ОжидаемыеКолонки = Новый Массив;
	ОжидаемыеКолонки.Добавить("timelog_id");
	ОжидаемыеКолонки.Добавить("project_name");
	ОжидаемыеКолонки.Добавить("issue_title");
	ОжидаемыеКолонки.Добавить("duration_seconds");
	ОжидаемыеКолонки.Добавить("spent_at");
	ОжидаемыеКолонки.Добавить("description");

	Для Индекс = 0 По ОжидаемыеКолонки.Количество() - 1 Цикл
		ЮТест.ОжидаетЧто(Результат.Колонки[Индекс].Имя)
			.Равно(ОжидаемыеКолонки[Индекс],
				"Колонка " + (Индекс + 1) + " должна иметь имя """ + ОжидаемыеКолонки[Индекс] + """");
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеФункции

// Создаёт мок JSON с двумя timelog записями.
//
// Возвращаемое значение:
//   ДвоичныеДанные - JSON строка в виде двоичных данных.
//
Функция СоздатьМокJSONTimelogов()

	JSONСтрока =
		"["
		+ "{"
		+ """id"": 1001, "
		+ """time_spent"": 3600, "
		+ """spent_at"": ""2024-01-15T10:00:00.000Z"", "
		+ """summary"": ""Работа над модулем"", "
		+ """project"": {""name"": ""Мой проект""}, "
		+ """issue"": {""title"": ""Реализовать функционал""}"
		+ "},"
		+ "{"
		+ """id"": 1002, "
		+ """time_spent"": 1800, "
		+ """spent_at"": ""2024-01-16T14:30:00.000Z"", "
		+ """summary"": ""Доработка"", "
		+ """project"": {""name"": ""Мой проект""}, "
		+ """issue"": {""title"": ""Реализовать функционал""}"
		+ "}"
		+ "]";

	Возврат ПолучитьДвоичныеДанныеИзСтроки(JSONСтрока);

КонецФункции

#КонецОбласти