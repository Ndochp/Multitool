	// Подготовка
	Интеграция = Обработки.ИнтеграцияGitlab.Создать();

	// Действие
	Интеграция.УстановитьТокен("glpat-abc123");

	// Проверка: реквизит объекта содержит установленный токен
	ЮТест.ОжидаетЧто(Интеграция.Токен)
		.Равно("glpat-abc123",
			"Токен должен быть сохранён в реквизите объекта");

	// Проверка: заголовки аутентификации содержат PRIVATE-TOKEN
	Заголовки = Интеграция.ПолучитьЗаголовкиАутентификации();

	ЮТест.ОжидаетЧто(Заголовки.Заголовки.Получить("PRIVATE-TOKEN"))
		.Равно("glpat-abc123",
			"Токен должен быть установлен в заголовке PRIVATE-TOKEN");

КонецПроцедуры

