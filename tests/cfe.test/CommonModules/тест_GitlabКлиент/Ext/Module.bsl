// Покрытие: GITL-TL-004 (Инициализация соединения)
// Фреймворк: yaxunit

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТестовыйНабор("GITL-TL-004 (Инициализация)")
			.ДобавитьТест("ТЕСТ001_УстановкаБазовогоURL")
			.ДобавитьТест("ТЕСТ002_УстановкаТокенаАутентификации")
			.ДобавитьТест("ТЕСТ003_УстановкаИдентификатораПользователя")
			.ДобавитьТест("ТЕСТ004_ПроверкаКорректностиНастроекВсеВерно")
