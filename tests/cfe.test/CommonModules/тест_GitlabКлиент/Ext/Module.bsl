КонецПроцедуры

#Область ТестыGITLTL004_Инициализация

// ТЕСТ-001: Установка базового URL GitLab сервера
//
// Дано: Новая обработка GitlabTimeLog без настроек
// Когда: Вызван КомандаИнициализацииБазовыйURL("https://gitlab.example.com")
// То: Реквизит Объект.BaseURL установлен в "https://gitlab.example.com"
//
Процедура ТЕСТ001_УстановкаБазовогоURL() Экспорт
	
	Обработка = Обработки.GitlabTimeLog.Создать();
	
	// Действие: установка базового URL
	Обработка.КомандаИнициализацииБазовыйURL("https://gitlab.example.com");
	
	// Проверка: реквизит BaseURL установлен корректно
	ЮТест.ОжидаетЧто(Обработка.BaseURL)
		.Равно("https://gitlab.example.com",
			"BaseURL должен быть установлен в значение переданного URL");
	
КонецПроцедуры

// ТЕСТ-002: Установка токена аутентификации GitLab API
//
// Дано: Новая обработка GitlabTimeLog без настроек
// Когда: Вызван КомандаИнициализацииТокен("glpat-abc123def456")
// То: Реквизит Объект.Токен установлен в "glpat-abc123def456"
//
Процедура ТЕСТ002_УстановкаТокенаАутентификации() Экспорт
	
	Обработка = Обработки.GitlabTimeLog.Создать();
	
	// Действие: установка токена
	Обработка.КомандаИнициализацииТокен("glpat-abc123def456");
	
	// Проверка: реквизит Токен установлен корректно
	ЮТест.ОжидаетЧто(Обработка.Токен)
		.Равно("glpat-abc123def456",
			"Токен должен быть установлен в значение переданного токена");
	
КонецПроцедуры

// ТЕСТ-003: Установка идентификатора пользователя GitLab
//
// Дано: Новая обработка GitlabTimeLog без настроек
// Когда: Вызван КомандаИнициализацииПользователь(42)
// То: Реквизит Объект.userID установлен в "42"
//
Процедура ТЕСТ003_УстановкаИдентификатораПользователя() Экспорт
	
	Обработка = Обработки.GitlabTimeLog.Создать();
	
	// Действие: установка идентификатора пользователя
	Обработка.КомандаИнициализацииПользователь(42);
	
	// Проверка: реквизит userID установлен корректно (как строка)
	ЮТест.ОжидаетЧто(Обработка.userID)
		.Равно("42",
			"userID должен быть преобразован в строку и установлен");
	
КонецПроцедуры

// ТЕСТ-004: Проверка корректности настроек - все параметры заданы верно
//
// Дано: Обработка GitlabTimeLog с установленными BaseURL, Токен и userID
// Когда: Вызван КомандаИнициализацииПроверитьНастройки()
// То: Возвращается Истина
//
Процедура ТЕСТ004_ПроверкаКорректностиНастроекВсеВерно() Экспорт
	
	Обработка = Обработки.GitlabTimeLog.Создать();
	
	// Подготовка: установка всех параметров
	Обработка.КомандаИнициализацииБазовыйURL("https://gitlab.example.com");
	Обработка.КомандаИнициализацииТокен("glpat-abc123def456");
	Обработка.КомандаИнициализацииПользователь(42);
	
	// Действие: проверка настроек
	Результат = Обработка.КомандаИнициализацииПроверитьНастройки();
	
	// Проверка: результат должен быть Истина
	ЮТест.ОжидаетЧто(Результат)
		.Равно(Истина,
			"При корректных настройках проверка должна вернуть Истина");
	
КонецПроцедуры

