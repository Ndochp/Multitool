// Тесты для получения таймшита за сегодня из GitLab API
// Покрытие: GITL-012 (ПолучитьТаймЛоги по дате), GITL-008 (ПолучитьТаймЛоги)
// Фреймворк: yaxunit

#Область ТестыGITL012_ПолучениеТаймшитаЗаСегодня

// ТЕСТ-035: Получение таймшита за сегодня для задачи
//
// Дано: 
//   - Установлен базовый URL GitLab сервера
//   - Установлен токен аутентификации
//   - Mock HTTP-сокета возвращает timelogs за дату 2024-12-31 со статусом 200
// Когда: Вызван ПолучитьТаймЛоги(1, 42, "2024-12-31", "2025-01-01")
// То: Возвращается ТаблицаЗначений с timelogs за указанную дату
//     - URL запроса содержит параметры spent_at_on_or_after=2024-12-31 и spent_at_before=2025-01-01
//

Процедура ТЕСТ035_ПолучениеТаймшитаЗаСегодня() Экспорт

    // Подготовка: подмена КоннекторHTTP.Get через Мокито
    МокОтвет = ЮТест.Данные().HTTPОтвет()
        .УстановитьКодСостояния(200)
        .УстановитьТело(СоздатьМокJSONTimelogsЗаДень());
    Мокито.Обучение(КоннекторHTTP)
        .Когда("Get")
        .Вернуть(МокОтвет)
        .Прогон();

    // Подготовка интеграции
    Интеграция = Обработки.ИнтеграцияGitlab.Создать();
    Интеграция.УстановитьБазовыйURL("https://gitlab.example.com");
    Интеграция.УстановитьТокен("glpat-test-token");

    // Даты для проверки (сегодняшняя дата + 1 день для диапазона)
    ДатаСегодня = "2024-12-31";
    ДатаЗавтра = "2025-01-01";

    // Действие: вызываем метод ПолучитьТаймЛоги с параметрами даты
    Результат = Интеграция.ПолучитьТаймЛоги(1, 42, ДатаСегодня, ДатаЗавтра);

    // Проверка количества записей
    ЮТест.ОжидаетЧто(Результат.Количество())
        .Равно(3, "Должно быть 3 записи timelog за сегодня");

    // Проверка первой записи
    Строка0 = Результат[0];
    ЮТест.ОжидаетЧто(Строка0.timelog_id)
        .Равно(2001, "timelog_id должен быть 2001");
    
    ЮТест.ОжидаетЧто(Строка0.project_name)
        .Равно("Backend-разработка", "project_name должно быть Backend-разработка");
    
    ЮТест.ОжидаетЧто(Строка0.issue_title)
        .Равно("Исправление критических багов", "issue_title должно быть Исправление критических багов");
    
    ЮТест.ОжидаетЧто(Строка0.duration_seconds)
        .Равно(1800, "duration_seconds должна быть 1800 секунд (30 мин)");
    
    ЮТест.ОжидаетЧто(Строка0.spent_at)
        .Содержит("2024-12-31", "spent_at должно содержать дату 2024-12-31");
    
    ЮТест.ОжидаетЧто(Строка0.description)
        .Равно("Работа над исправлением бага с памятью", "description должно быть Работа над исправлением бага с памятью");

    // Проверка второй записи
    Строка1 = Результат[1];
    ЮТест.ОжидаетЧто(Строка1.timelog_id)
        .Равно(2002, "Второй timelog_id должен быть 2002");
    
    ЮТест.ОжидаетЧто(Строка1.duration_seconds)
        .Равно(7200, "duration_seconds второй записи должна быть 7200 секунд (2 часа)");

    // Проверка третьей записи
    Строка2 = Результат[2];
    ЮТест.ОжидаетЧто(Строка2.timelog_id)
        .Равно(2003, "Третий timelog_id должен быть 2003");
    
    ЮТест.ОжидаетЧто(Строка2.duration_seconds)
        .Равно(3600, "duration_seconds третьей записи должна быть 3600 секунд (1 час)");

КонецПроцедуры

// ТЕСТ-036: Формирование запроса с параметрами даты для получения таймшита за сегодня
//
// Дано: 
//   - Mock HTTP-сокета возвращает пустой массив со статусом 200
// Когда: Вызван ПолучитьТаймЛоги(1, 42, "2025-01-15", "2025-01-16")
// То: 
//   - Запрос отправлен с параметрами spent_at_on_or_after=2025-01-15
//   - Параметр spent_at_before=2025-01-16
//     URL содержит путь /api/v4/projects/1/issues/42/timelogs

Процедура ТЕСТ036_ФормированиеЗапросаСПараметрамиДаты() Экспорт

    // Подготовка: подмена КоннекторHTTP.Get через Мокито
    МокОтвет = ЮТест.Данные().HTTPОтвет()
        .УстановитьКодСостояния(200)
        .УстановитьТело(СоздатьПустойМассивJSON());
    Мокито.Обучение(КоннекторHTTP)
        .Когда("Get")
        .Вернуть(МокОтвет)
        .Прогон();

    Интеграция = Обработки.ИнтеграцияGitlab.Создать();
    Интеграция.УстановитьБазовыйURL("https://gitlab.example.com");
    Интеграция.УстановитьТокен("glpat-test-token");

    ДатаНач = "2025-01-15";
    ДатаКон = "2025-01-16";

    // Действие: вызываем ПолучитьТаймЛоги - внутри он формирует URL с параметрами
    Результат = Интеграция.ПолучитьТаймЛоги(1, 42, ДатаНач, ДатаКон);

    // Проверяем, что метод Get был вызван ровно 1 раз
    Мокито.Проверить(КоннекторHTTP)
        .КоличествоВызовов("Get").Равно(1);

    Вызовы = Мокито.Проверить(КоннекторHTTP).Вызовы("Get");
    ЮТест.ОжидаетЧто(Вызовы.Количество())
        .Равно(1, "Должен быть ровно 1 вызов КоннекторHTTP.Get");

    URLВызова = Вызовы[0].Параметры[0];
    ПараметрыЗапроса = Вызовы[0].Параметры[1];

    ЮТест.ОжидаетЧто(URLВызова)
        .Содержит("spent_at_on_or_after=" + ДатаНач,
            "URL должен содержать параметр spent_at_on_or_after с правильной датой");

    ЮТест.ОжидаетЧто(URLВызова)
        .Содержит("spent_at_before=" + ДатаКон,
            "URL должен содержать параметр spent_at_before с правильной датой");

    ЮТест.ОжидаетЧто(URLВызова)
        .Содержит("/api/v4/projects/1/issues/42/timelogs",
            "URL должен содержать путь к timelogs задачи");

КонецПроцедуры

// ТЕСТ-037: Пустой список timelogs за сегодня
//
// Дано: Mock HTTP-сокета, возвращающий пустой массив [] со статусом 200
// Когда: Вызван ПолучитьТаймЛоги(1, 42, "2025-07-31", "2025-08-01")
// То: Возвращается пустая ТаблицаЗначений с 6 колонками

Процедура ТЕСТ037_ПустойСписокTimelogovЗаДень() Экспорт

    // Подготовка: подмена КоннекторHTTP.Get через Мокито
    МокОтвет = ЮТест.Данные().HTTPОтвет()
        .УстановитьКодСостояния(200)
        .УстановитьТело(СоздатьПустойМассивJSON());
    Мокито.Обучение(КоннекторHTTP)
        .Когда("Get")
        .Вернуть(МокОтвет)
        .Прогон();

    Интеграция = Обработки.ИнтеграцияGitlab.Создать();
    Интеграция.УстановитьБазовыйURL("https://gitlab.example.com");
    Интеграция.УстановитьТокен("glpat-test-token");

    // Действие: вызываем реальный метод
    Результат = Интеграция.ПолучитьТаймЛоги(1, 42, "2025-07-31", "2025-08-01");

    // Проверка
    ЮТест.ОжидаетЧто(Результат.Количество())
        .Равно(0, "Таблица должна быть пустой");

    ЮТест.ОжидаетЧто(Результат.Колонки.Количество())
        .Равно(6, "Таблица должна содержать 6 колонок");

    // Проверка имён колонок
    ОжидаемыеКолонки = Новый Массив;
    ОжидаемыеКолонки.Добавить("timelog_id");
    ОжидаемыеКолонки.Добавить("project_name");
    ОжидаемыеКолонки.Добавить("issue_title");
    ОжидаемыеКолонки.Добавить("duration_seconds");
    ОжидаемыеКолонки.Добавить("spent_at");
    ОжидаемыеКолонки.Добавить("description");

    Для Индекс = 0 По ОжидаемыеКолонки.Количество() - 1 Цикл
        ЮТест.ОжидаетЧто(Результат.Колонки[Индекс].Имя)
            .Равно(ОжидаемыеКолонки[Индекс],
                "Колонка " + (Индекс + 1) + " должна иметь имя """ + ОжидаемыеКолонки[Индекс] + """");
    КонецЦикла;

КонецПроцедуры

// ТЕСТ-038: Ошибка при получении таймшита за сегодня (401 Unauthorized)
//
// Дано: Mock HTTP-сокета возвращает статус 401 с ошибкой "Unauthorized"
// Когда: Вызван ПолучитьТаймЛоги(1, 42, "2025-07-31", "2025-07-32")
// То: Возбуждается исключение с сообщением "Не авторизован. Проверьте токен."

Процедура ТЕСТ038_ОшибкаПриПолученииТаймшитаЗаСегодня() Экспорт

    // Подготовка: подмена КоннекторHTTP.Get через Мокито - возврат 401
    МокОтвет = ЮТест.Данные().HTTPОтвет()
        .УстановитьКодСостояния(401)
        .УстановитьТело(ПолучитьДвоичныеДанныеИзСтроки("{" + "\"message\": \"Unauthorized\" + "}"));
    Мокито.Обучение(КоннекторHTTP)
        .Когда("Get")
        .Вернуть(МокОтвет)
        .Прогон();

    Интеграция = Обработки.ИнтеграцияGitlab.Создать();
    Интеграция.УстановитьБазовыйURL("https://gitlab.example.com");
    Интеграция.УстановитьТокен("invalid-token");

    // Проверка: должен возникнуть исключение
    ЮТест.ОжидаетЧто(
        Интеграция.ПолучитьТаймЛоги(1, 42, "2025-07-31", "2025-07-32"),
        "Должно быть возбуждено исключение при статусе 401"
    );

КонецПроцедуры

