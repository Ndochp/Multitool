// ТЕСТ-040: Получение таймшита за сегодня с разными проектами и задачами
//
// Дано: Mock HTTP-сокета возвращает timelogs из разных проектов и задач
// Когда: Вызван ПолучитьТаймЛоги(1, 42, "2025-01-20", "2025-01-21")
// То: Возвращается ТаблицаЗначений с разными project_name и issue_title

Процедура ТЕСТ040_ТаймшитСРазнымиПроектами() Экспорт

    // Подготовка: подмена КоннекторHTTP.Get через Мокито - timelogs из разных проектов
    МокОтвет = ЮТест.Данные().HTTPОтвет()
        .УстановитьКодСостояния(200)
        .УстановитьТело(СоздатьМокJSONTimelogsРазныхПроектов());
    Мокито.Обучение(КоннекторHTTP)
        .Когда("Get")
        .Вернуть(МокОтвет)
        .Прогон();

    Интеграция = Обработки.ИнтеграцияGitlab.Создать();
    Интеграция.УстановитьБазовыйURL("https://gitlab.example.com");
    Интеграция.УстановитьТокен("glpat-test-token");

    Результат = Интеграция.ПолучитьТаймЛоги(1, 42, "2025-01-20", "2025-01-21");

    ЮТест.ОжидаетЧто(Результат.Количество())
        .Равно(3, "Должны быть три записи из разных проектов");

    // Проверка первой записи - Project Alpha
    ЮТест.ОжидаетЧто(Результат[0].project_name)
        .Равно("Project Alpha", "Первая запись должна быть из Project Alpha");
    
    ЮТест.ОжидаетЧто(Результат[0].issue_title)
        .Равно("Initial Setup", "Задача должна быть Initial Setup");

    // Проверка второй записи - Project Beta
    ЮТест.ОжидаетЧто(Результат[1].project_name)
        .Равно("Project Beta", "Вторая запись должна быть из Project Beta");
    
    ЮТест.ОжидаетЧто(Результат[1].issue_title)
        .Равно("Feature Development", "Задача должна быть Feature Development");

КонецПроцедуры

