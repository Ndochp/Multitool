	// Проверка колонок - должно быть 8 колонок для timeentries
	ЮТест.ОжидаетЧто(Результат.Колонки.Количество())
		.Равно(8, "Должно быть 8 колонок для timeentries");
	
	// Проверка первой записи
	ПерваяЗапись = Результат[0];
	ЮТест.ОжидаетЧто(ПерваяЗапись.timelog_id)
		.Равно(2001, "timelog_id должен быть 2001");
	ЮТест.ОжидаетЧто(ПерваяЗапись.issue_iid)
		.Равно(5, "issue_iid должен быть 5");
	ЮТест.ОжидаетЧто(ПерваяЗапись.project_name)
		.Равно("Проект Тест", "project_name должен соответствовать");
	
КонецПроцедуры

