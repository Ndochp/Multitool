// ТЕСТ-030: Преобразование JSON timelogs в ТаблицуЗначений
//
// Дано: Обработка GitlabTimeLog с корректным JSON timelogs
// Когда: Вызван КомандаПреобразоватьДанные(JSON, "timelogs")
// То: Возвращается ТаблицаЗначений с 2 записями и правильными колонками
//
Процедура ТЕСТ030_ПреобразованиеJSONTimelogs() Экспорт
	
	Обработка = Обработки.GitlabTimeLog.Создать();
	
	// Подготовка: JSON с двумя timelog записями
	JSONСтрока =
		"["
		+ "{"
		+ """id"": 1001, "
		+ """time_spent"": 3600, "
		+ """spent_at"": ""2024-01-15T10:00:00.000Z"", "
		+ """summary"": ""Работа над модулем"", "
		+ """project"": {""name"": ""Мой проект""}, "
		+ """issue"": {""title"": ""Реализовать функционал""}"
		+ "},"
		+ "{"
		+ """id"": 1002, "
		+ """time_spent"": 1800, "
		+ """spent_at"": ""2024-01-16T14:30:00.000Z"", "
		+ """summary"": ""Доработка"", "
		+ """project"": {""name"": ""Мой проект""}, "
		+ """issue"": {""title"": ""Исправить баг""}"
		+ "}"
		+ "]";
	
	// Действие: преобразование данных
	Результат = Обработка.КомандаПреобразоватьДанные(JSONСтрока, "timelogs");
	
	// Проверка количества записей
	ЮТест.ОжидаетЧто(Результат.Количество())
		.Равно(2, "Должно быть 2 записи");
	
	// Проверка колонок
	ЮТест.ОжидаетЧто(Результат.Колонки.Количество())
		.Равно(6, "Должно быть 6 колонок");
	
	// Проверка первой записи
	ПерваяЗапись = Результат[0];
	ЮТест.ОжидаетЧто(ПерваяЗапись.timelog_id)
		.Равно(1001, "timelog_id должен быть 1001");
	ЮТест.ОжидаетЧто(ПерваяЗапись.duration_seconds)
		.Равно(3600, "duration_seconds должен быть 3600");
	ЮТест.ОжидаетЧто(ПерваяЗапись.project_name)
		.Равно("Мой проект", "project_name должен соответствовать");
	ЮТест.ОжидаетЧто(ПерваяЗапись.issue_title)
		.Равно("Реализовать функционал", "issue_title должен соответствовать");
	
КонецПроцедуры

// ТЕСТ-031: Преобразование JSON timeentries в ТаблицуЗначений
//
// Дано: Обработка GitlabTimeLog с корректным JSON timeentries
// Когда: Вызван КомандаПреобразоватьДанные(JSON, "timeentries")
// То: Возвращается ТаблицаЗначений с правильными колонками timeentries
//
Процедура ТЕСТ031_ПреобразованиеJSONTimeentries() Экспорт
	
	Обработка = Обработки.GitlabTimeLog.Создать();
	
	// Подготовка: JSON с одной timeentry записью
	JSONСтрока =
		"["
		+ "{"
		+ """id"": 2001, "
		+ """time_spent"": 7200, "
		+ """spent_at"": ""2024-02-10T09:00:00.000Z"", "
		+ """note"": ""Тестовая запись"", "
		+ """project"": {""name"": ""Проект Тест"", ""web_url"": ""https://gitlab.com/test/project""}, "
		+ """target"": {""iid"": 5, ""title"": ""Тестовая задача"", ""web_url"": ""https://gitlab.com/test/issue/5""}"
		+ "}"
		+ "]";
	
	// Действие: преобразование данных
	Результат = Обработка.КомандаПреобразоватьДанные(JSONСтрока, "timeentries");
	
	// Проверка количества записей
	ЮТест.ОжидаетЧто(Результат.Количество())
