//
Процедура ТЕСТ046_ВалидацияОписаниеБолее1000Символов() Экспорт
	
	Обработка = Обработки.GitlabTimeLog.Создать();
	
	// Подготовка: данные с описанием более 1000 символов
	ДлинноеОписание = "";
	Для Символ = 1 По 1001 Цикл
		ДлинноеОписание = ДлинноеОписание + "А";
	КонецЦикла;
	
	Данные = Новый Структура("ПроектID, IssueIID, ДлительностьВСекундах, ДатаРаботы, Описание");
	Данные.ПроектID            = 1;
	Данные.IssueIID            = 5;
	Данные.ДлительностьВСекундах = 3600;
	Данные.ДатаРаботы          = "2024-01-15";
	Данные.Описание            = ДлинноеОписание;
	
	// Действие: валидация данных
	Результат = Обработка.КомандаВалидироватьДанныеТаймлога(Данные);
	
	// Проверка: данные некорректны
	ЮТест.ОжидаетЧто(Результат.Корректно)
		.Равно(Ложь, "С описанием >1000 символов данные должны быть некорректны");
	
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество())
		.Больше(0, "Должна быть хотя бы одна ошибка");
	
КонецПроцедуры

