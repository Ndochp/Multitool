// ТЕСТ-034: Преобразование пустого массива timelogs
//
// Дано: Обработка GitlabTimeLog с пустым JSON массивом
// Когда: Вызван КомандаПреобразоватьДанные("[]", "timelogs")
// То: Возвращается пустая ТаблицаЗначений с колонками
//
Процедура ТЕСТ034_ПреобразованиеПустогоМассиваTimelogs() Экспорт
	
	Обработка = Обработки.GitlabTimeLog.Создать();
	
	// Действие: преобразование пустого массива
	Результат = Обработка.КомандаПреобразоватьДанные("[]", "timelogs");
	
	// Проверка: таблица должна быть пустой, но с колонками
	ЮТест.ОжидаетЧто(Результат.Количество())
		.Равно(0, "Таблица должна быть пустой");
	
	ЮТест.ОжидаетЧто(Результат.Колонки.Количество())
		.Равно(6, "Должно быть 6 колонок для timelogs");
	
КонецПроцедуры

// ТЕСТ-035: Преобразование невалидного JSON
//
// Дано: Обработка GitlabTimeLog с невалидной JSON строкой
// Когда: Вызван КомандаПреобразоватьДанные("невалидный JSON", "timelogs")
// То: Возвращается пустая ТаблицаЗначений без ошибки
//
Процедура ТЕСТ035_ПреобразованиеНевалидногоJSON() Экспорт
	
	Обработка = Обработки.GitlabTimeLog.Создать();
	
	// Действие и проверка: преобразование невалидного JSON не должно вызвать исключение
	Попытка
		Результат = Обработка.КомандаПреобразоватьДанные("невалидный JSON", "timelogs");
		
		// Проверка: должна вернуться пустая таблица
		ЮТест.ОжидаетЧто(Результат.Количество())
			.Равно(0, "При невалидном JSON возвращается пустая таблица");
			
	Исключение
		ЮТест.ОжидаетЧто(Ложь)
			.Равно(Истина,
				"При невалидном JSON исключение не должно быть выброшено");
	КонецПопытки;
	
КонецПроцедуры

// ТЕСТ-036: Преобразование неизвестного типа данных
//
// Дано: Обработка GitlabTimeLog с валидным JSON и неизвестным типом
// Когда: Вызван КомандаПреобразоватьДанные("[{}]", "unknownType")
// То: Вызывается исключение с описанием неизвестного типа
//
Процедура ТЕСТ036_ПреобразованиеНеизвестногоТипаДанных() Экспорт
	
	Обработка = Обработки.GitlabTimeLog.Создать();
	
	// Действие и проверка: преобразование неизвестного типа должно вызвать исключение
	Попытка
		Результат = Обработка.КомандаПреобразоватьДаны("[{}]", "unknownType");
		
		ЮТест.ОжидаетЧто(Ложь)
			.Равно(Истина,
				"При неизвестном типе данных должно быть выброшено исключение");
			
	Исключение
		// Ожидаемое исключение - тест пройден
	КонецПопытки;
	
КонецПроцедуры

