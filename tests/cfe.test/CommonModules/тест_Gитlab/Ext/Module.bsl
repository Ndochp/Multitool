// ТЕСТ-040: Валидация корректных данных таймлога
//
// Дано: Обработка GitlabTimeLog и структура с корректными данными
// Когда: Вызван КомандаВалидироватьДанныеТаймлога(КорректныеДанные)
// То: Возвращается Структура с Корректно=Истина и пустым массивом Ошибки
//
Процедура ТЕСТ040_ВалидацияКорректныхДанных() Экспорт
	
	Обработка = Обработки.GitlabTimeLog.Создать();
	
	// Подготовка: корректные данные
	Данные = Новый Структура("ПроектID, IssueIID, ДлительностьВСекундах, ДатаРаботы, Описание");
	Данные.ПроектID            = 1;
	Данные.IssueIID            = 5;
	Данные.ДлительностьВСекундах = 3600;
	Данные.ДатаРаботы          = "2024-01-15";
	Данные.Описание            = "Тестовая запись";
	
	// Действие: валидация данных
	Результат = Обработка.КомандаВалидироватьДанныеТаймлога(Данные);
	
	// Проверка: данные корректны
	ЮТест.ОжидаетЧто(Результат.Корректно)
		.Равно(Истина, "Корректные данные должны пройти валидацию");
	
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество())
		.Равно(0, "Массив ошибок должен быть пустым");
	
КонецПроцедуры

