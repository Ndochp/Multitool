// ТЕСТ_REST_ЗадачиПроекта_Пагинация: страницы следуют по заголовку
// X-Next-Page, остановка - когда заголовка больше нет.
//
// Дано: Mock HTTP: первая страница с X-Next-Page: 2, вторая без него
// Когда: Вызван ПолучитьЗадачиПроекта(3001)
// То: Два GET-запроса (страницы 1 и 2), суммарно 3 задачи
//
Процедура ТЕСТ_REST_ЗадачиПроекта_Пагинация() Экспорт

	МокОтветСтраница1 = ЮТест.Данные().HTTPОтвет()
		.УстановитьКодСостояния(200)
		.УстановитьТело(СоздатьМокJSONЗадачиПроекта())
		.ДобавитьЗаголовок("X-Next-Page", "2");

	МокОтветСтраница2 = ЮТест.Данные().HTTPОтвет()
		.УстановитьКодСостояния(200)
		.УстановитьТело(СоздатьМокJSONЗадачаОдна());

	Мокито.Обучение(КоннекторHTTP)
		.Когда("Get")
		.Вернуть(МокОтветСтраница1)
		.Вернуть(МокОтветСтраница2)
		.Прогон();

	Интеграция = НовыйИнтеграцияДляТеста();

	Результат = Интеграция.ПолучитьЗадачиПроекта(3001);

	Вызовы = Мокито.Проверить(КоннекторHTTP).Вызовы("Get");

	ЮТест.ОжидаетЧто(Вызовы.Количество())
		.Равно(2, "Две страницы");

	ЮТест.ОжидаетЧто(Вызовы[0].Параметры[1].Получить("page"))
		.Равно("1", "Первая страница");

	ЮТест.ОжидаетЧто(Вызовы[1].Параметры[1].Получить("page"))
		.Равно("2", "Вторая страница");

	ЮТест.ОжидаетЧто(Результат.Количество())
		.Равно(3, "Задачи обеих страниц в одной таблице");

КонецПроцедуры

