// ТЕСТ_GQL_Q003_ТаймлогиНаДату_Успешно: таймлоги на дату через GraphQL.
//
// Дано: Mock HTTP, возвращающий currentUser и timelogs с одной записью
// Когда: Вызван ПолучитьТаймлогиНаДатуGraphQL(Дата(2026, 3, 11))
// То: Возвращается таблица с колонками СоздатьПустуюТаблицуДляТаймлоговНаДату,
//     запись разобрана (id, длительность, дата, задача, проект)
//
Процедура ТЕСТ_GQL_Q003_ТаймлогиНаДату_Успешно() Экспорт

	МокОтветUsername = СоздатьМокGraphQLCurrentUser();

	МокОтветТаймлоги = СоздатьМокGraphQLТаймлоги();

	Мокито.Обучение(КоннекторHTTP)
		.Когда("PostJson")
		.Вернуть(МокОтветUsername)
		.Вернуть(МокОтветТаймлоги)
		.Прогон();

	Интеграция = Обработки.ИнтеграцияGitlab.Создать();
	Интеграция.УстановитьБазовыйURL("https://gitlab.example.com");
	Интеграция.УстановитьТокен("glpat-test-token");

	Результат = Интеграция.ПолучитьТаймлогиНаДатуGraphQL(Дата(2026, 3, 11));

	ЮТест.ОжидаетЧто(Результат.Количество())
		.Равно(1, "Должна быть разобрана 1 запись таймлога");

	СтрокаТаймлога = Результат[0];

	ЮТест.ОжидаетЧто(СтрокаТаймлога.timeentry_id)
		.Равно("gid://gitlab/Timelog/555", "Идентификатор записи - строка gid");

	ЮТест.ОжидаетЧто(СтрокаТаймлога.duration_seconds)
		.Равно(3600, "Длительность в секундах");

	ЮТест.ОжидаетЧто(НачалоДня(СтрокаТаймлога.spent_at))
		.Равно(Дата(2026, 3, 11), "Дата записи = spentAt");

	ЮТест.ОжидаетЧто(СтрокаТаймлога.summary)
		.Равно("Работа над модулем", "Описание работы");

	ЮТест.ОжидаетЧто(СтрокаТаймлога.issue_id)
		.Равно(6001, "Глобальный id задачи извлечён из gid");

	ЮТест.ОжидаетЧто(СтрокаТаймлога.issue_iid)
		.Равно(7, "IID задачи");

	ЮТест.ОжидаетЧто(СтрокаТаймлога.issue_title)
		.Равно("Сборка отчёта", "Название задачи");

	ЮТест.ОжидаетЧто(СтрокаТаймлога.issue_web_url)
		.Равно("https://gitlab.example.com/grp/prj/-/issues/7", "URL задачи");

	ЮТест.ОжидаетЧто(СтрокаТаймлога.project_id)
		.Равно(3001, "Глобальный id проекта из поля projectId");

	// Путь/имя проекта в ответе таймлогов отсутствуют - заполняются
	// при докачке задачи REST-запросом.
	ЮТест.ОжидаетЧто(СтрокаТаймлога.project_path)
		.Равно("", "Путь проекта в GraphQL-ответе таймлогов не передаётся");

КонецПроцедуры

