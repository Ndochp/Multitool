// ТЕСТ-009: Установка базового URL
//
// Дано: Новый объект ИнтеграцияGitlab без настроек
// Когда: Вызван УстановитьБазовыйURL("https://gitlab.example.com")
// То: Базовый URL сохранён в реквизите объекта и используется при формировании запросов
//
Процедура ТЕСТ009_УстановкаБазовогоУРЛ() Экспорт

	// Подготовка
	Интеграция = Обработки.ИнтеграцияGitlab.Создать();

	// Действие
	Интеграция.УстановитьБазовыйURL("https://gitlab.example.com");

	// Проверка: реквизит объекта содержит установленный URL
	ЮТест.ОжидаетЧто(Интеграция.БазовыйURL)
		.Равно("https://gitlab.example.com",
			"Базовый URL должен быть сохранён в реквизите объекта");

	// Проверка: формирование URL с использованием установленного базового URL
	ЮТест.ОжидаетЧто(Интеграция.СформироватьURL("/api/v4/projects/1"))
		.Равно("https://gitlab.example.com/api/v4/projects/1",
			"Базовый URL должен использоваться при формировании запросов");

КонецПроцедуры

