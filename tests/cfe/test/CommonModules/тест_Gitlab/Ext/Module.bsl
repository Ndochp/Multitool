#Область ВспомогательныеФункцииДляGQLQ002

// Мок-ответ под контракт КоннекторHTTP.PostJson: возвращает уже распарсенный
// JSON тела (Соответствие при настройках по умолчанию) — как реальный PostJson.
//
Функция ОтветPostJson(Знач JSONСтрока)

	Возврат КоннекторHTTP.JsonВОбъект(JSONСтрока);

КонецФункции

// Мок GraphQL ответа на запрос username пользователя по ID (GetUser).
Функция СоздатьМокGraphQLUsernameПользователя()

	Возврат ОтветPostJson("{""data"": {""user"": {""username"": ""test_user""}}}");

КонецФункции

// Создаёт мок GraphQL ответа с двумя проектами.
//
/// Возвращаемое значение:
///   ДвоичныеДанные - JSON строка в виде двоичных данных.
///
Функция СоздатьМокGraphQLПроектов()

	JSONСтрока =
		"{"
		+ """data"": {"
		+ """user"": {"
		+ """projects"": {"
		+ """nodes"": ["
		+ "{"
		+ """id"": 101, "
		+ """name"": ""Проект А"", "
		+ """pathWithNamespace"": ""group/project-a"", "
		+ """description"": ""Описание проекта А"", "
		+ """webUrl"": ""https://gitlab.example.com/group/project-a"", "
		+ """url"": ""https://gitlab.example.com/api/v4/projects/101"", "
		+ """archived"": false, "
		+ """visibility"": ""PRIVATE"", "
		+ """defaultBranchName"": ""main"""
		+ "},"
		+ "{"
		+ """id"": 102, "
		+ """name"": ""Проект Б (архив)"", "
		+ """pathWithNamespace"": ""group/project-b"", "
		+ """description"": ""Архивный проект"", "
		+ """webUrl"": ""https://gitlab.example.com/group/project-b"", "
		+ """url"": ""https://gitlab.example.com/api/v4/projects/102"", "
		+ """archived"": true, "
		+ """visibility"": ""INTERNAL"", "
		+ """defaultBranchName"": ""master"""
		+ "}"
		+ "],"
		+ """pageInfo"": {"
		+ """hasNextPage"": false, "
		+ """endCursor"": """""
		+ "}"
		+ "}"
		+ "}"
		+ "}"
		+ "}";

	Возврат ОтветPostJson(JSONСтрока);

КонецФункции

