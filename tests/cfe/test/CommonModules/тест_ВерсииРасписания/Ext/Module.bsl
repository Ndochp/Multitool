// yaxUnit-тесты версий расписания подсистемы Проджект
// (ОбщийМодуль.ВерсииРасписания, п.9 роадмапа).
// ИБ-тесты в транзакциях: проект создаётся слоем 2 импорта
// (ИмпортMSPDI) по общей фикстуре тест_ОбменMSProject.

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Версии расписания")
			.ДобавитьТест("ТЕСТ_Версия_СнимокЗаписан")
			.ДобавитьТест("ТЕСТ_Версия_ОтклоненияПослеИзменения")
	;

КонецПроцедуры

#Область Тесты

Процедура ТЕСТ_Версия_СнимокЗаписан() Экспорт

	Результат = ЗагрузитьПоФикстуре();
	СсылкаВерсии = ВерсииРасписания.Зафиксировать(Результат.Проект);

	ЮТест.ОжидаетЧто(СсылкаВерсии.Пустая())
		.Равно(Ложь, "Версия записана");
	ОбъектВерсии = СсылкаВерсии.ПолучитьОбъект();
	ЮТест.ОжидаетЧто(СтрДлина(ОбъектВерсии.UID))
		.Равно(36, "UID версии - строка 36");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(ОбъектВерсии.VersionDate))
		.Равно(Истина, "Дата версии заполнена");
	ЮТест.ОжидаетЧто(ОбъектВерсии.Владелец)
		.Равно(Результат.Проект, "Версия подчинена проекту");
	ЮТест.ОжидаетЧто(ОбъектВерсии.TaskBaselines.Количество())
		.Равно(3, "Все работы проекта в снимке");

	СсылкаЗадачиА = Результат.Задачи.Получить("bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb");
	СтрокаСнимка = СтрокаСнимкаРаботы(ОбъектВерсии, СсылкаЗадачиА);
	ЮТест.ОжидаетЧто(СтрокаСнимка.Start)
		.Равно(Дата(2026, 11, 9, 8, 0, 0), "Start в снимке");
	ЮТест.ОжидаетЧто(СтрокаСнимка.Finish)
		.Равно(Дата(2026, 11, 9, 17, 0, 0), "Finish в снимке");
	ЮТест.ОжидаетЧто(СтрокаСнимка.Duration)
		.Равно(480, "Длительность в снимке");

	// Пока расписание не менялось, отклонений нет.
	ЮТест.ОжидаетЧто(ВерсииРасписания.Отклонения(СсылкаВерсии).Количество())
		.Равно(0, "Без изменений отклонений нет");

КонецПроцедуры

Процедура ТЕСТ_Версия_ОтклоненияПослеИзменения() Экспорт

	Результат = ЗагрузитьПоФикстуре();
	СсылкаВерсии = ВерсииРасписания.Зафиксировать(Результат.Проект);

	// Сдвиг задачи А на сутки и срез длительности вдвое.
	СсылкаЗадачиА = Результат.Задачи.Получить("bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb");
	ОбъектЗадачиА = СсылкаЗадачиА.ПолучитьОбъект();
	ОбъектЗадачиА.Start = ОбъектЗадачиА.Start + 86400;
	ОбъектЗадачиА.Finish = ОбъектЗадачиА.Finish + 86400;
	ОбъектЗадачиА.Duration = 240;
	ОбъектЗадачиА.Записать();

	Отклонения = ВерсииРасписания.Отклонения(СсылкаВерсии);

	ЮТест.ОжидаетЧто(Отклонения.Количество())
		.Равно(1, "Только изменившаяся работа");
	Отклонение = Отклонения[0];
	ЮТест.ОжидаетЧто(Отклонение.Task)
		.Равно(СсылкаЗадачиА, "Отклонение относится к задаче А");
	ЮТест.ОжидаетЧто(Отклонение.СдвигStart)
		.Равно(1440, "Сдвиг старта на сутки - 1440 минут");
	ЮТест.ОжидаетЧто(Отклонение.СдвигFinish)
		.Равно(1440, "Сдвиг финиша на сутки - 1440 минут");
	ЮТест.ОжидаетЧто(Отклонение.StartБыло)
		.Равно(Дата(2026, 11, 9, 8, 0, 0), "Старое начало из снимка");
	ЮТест.ОжидаетЧто(Отклонение.StartСтало)
		.Равно(Дата(2026, 11, 10, 8, 0, 0), "Новое начало");
	ЮТест.ОжидаетЧто(Отклонение.DurationБыло)
		.Равно(480, "Старая длительность");
	ЮТест.ОжидаетЧто(Отклонение.DurationСтало)
		.Равно(240, "Новая длительность");
	ЮТест.ОжидаетЧто(Отклонение.WorkСтало)
		.Равно(0, "Труд задачи в фикстуре не задан (0); труд назначения 240 - в ТЧ Assignments");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Импорт фикстуры слоем 2 (общая фикстура тест_ОбменMSProject).
Функция ЗагрузитьПоФикстуре()

	Данные = ОбменMSProject.Разобрать(тест_ОбменMSProject.Фикстура());
	Возврат ИмпортMSPDI.Загрузить(Данные);

КонецФункции

Функция СтрокаСнимкаРаботы(Версия, СсылкаРаботы)

	Для Каждого СтрокаСнимка Из Версия.TaskBaselines Цикл
		Если СтрокаСнимка.Task = СсылкаРаботы Тогда
			Возврат СтрокаСнимка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти
