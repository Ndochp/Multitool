// yaxUnit-тесты выравнивания ресурсов подсистемы Проджект
// (ОбщийМодуль.ВыравниваниеРесурсов, раздел 5 документации).
// Чистые функции: задачи задаются структурами, календарь - «Стандартный»
// (Пн-Пт 8:00-12:00, 13:00-17:00), база данных не используется.
//
// 2026-11-09 = понедельник; старт проекта 09.11.2026 8:00.

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Сдвиги без разбиения")
			.ДобавитьТест("ТЕСТ_Перегрузка_ЗадержкаНаСледующийДень")
			.ДобавитьТест("ТЕСТ_ПланБезПерегрузки_НеТрогается")
			.ДобавитьТест("ТЕСТ_МультиРесурсныйКонфликт")
			.ДобавитьТест("ТЕСТ_РазныеРесурсы_ПараллельноРаботают")
		.ДобавитьТестовыйНабор("Разбиение и ошибки")
			.ДобавитьТест("ТЕСТ_ЗакреплённаяЗадача_РазбиваетсяНаСегменты")
			.ДобавитьТест("ТЕСТ_НеизвестныйРесурс_Исключение")
	;

КонецПроцедуры

#Область Тесты

Процедура ТЕСТ_Перегрузка_ЗадержкаНаСледующийДень() Экспорт

	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("A", 480, Назначения("R1")));
	СписокЗадач.Добавить(ЗадачаТеста("B", 480, Назначения("R1")));

	Результат = Выровнять(СписокЗадач);

	СегментыА = Результат["A"].Сегменты;
	ЮТест.ОжидаетЧто(СегментыА.Количество())
		.Равно(1, "Первая задача не выравнивается");
	ЮТест.ОжидаетЧто(СегментыА[0].Начало)
		.Равно(Дата(2026, 11, 9, 8, 0, 0), "A остаётся на утро понедельника");
	ЮТест.ОжидаетЧто(Результат["A"].Задержка)
		.Равно(0, "Задержка A нулевая");

	СегментыБ = Результат["B"].Сегменты;
	ЮТест.ОжидаетЧто(СегментыБ.Количество())
		.Равно(1, "B сдвинута целиком, без разбиения");
	ЮТест.ОжидаетЧто(СегментыБ[0].Начало)
		.Равно(Дата(2026, 11, 10, 8, 0, 0), "B стартует на следующее утро");
	ЮТест.ОжидаетЧто(СегментыБ[0].Конец)
		.Равно(Дата(2026, 11, 10, 17, 0, 0), "И заканчивает к вечеру вторника");
	ЮТест.ОжидаетЧто(Результат["B"].Задержка)
		.Равно(480, "Задержка B - один рабочий день");

КонецПроцедуры

Процедура ТЕСТ_ПланБезПерегрузки_НеТрогается() Экспорт

	// A(240) -> B(240): FS-связь уже разводит задачи по времени,
	// у ресурса R1 перегрузки нет - выравнивание ничего не меняет.
	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("A", 240, Назначения("R1")));
	СписокЗадач.Добавить(ЗадачаТеста("B", 240, Назначения("R1"), Связи("A")));

	Результат = Выровнять(СписокЗадач);

	СегментыА = Результат["A"].Сегменты;
	ЮТест.ОжидаетЧто(СегментыА[0].Начало)
		.Равно(Дата(2026, 11, 9, 8, 0, 0), "A - утро понедельника");
	ЮТест.ОжидаетЧто(СегментыА[0].Конец)
		.Равно(Дата(2026, 11, 9, 12, 0, 0), "A - до обеда");
	СегментыБ = Результат["B"].Сегменты;
	ЮТест.ОжидаетЧто(СегментыБ[0].Начало)
		.Равно(Дата(2026, 11, 9, 13, 0, 0), "B - после обеда по FS-связи");
	ЮТест.ОжидаетЧто(СегментыБ[0].Конец)
		.Равно(Дата(2026, 11, 9, 17, 0, 0), "B - до вечера");
	ЮТест.ОжидаетЧто(Результат["B"].Задержка)
		.Равно(0, "Перегрузки нет - задержки нет");

КонецПроцедуры

Процедура ТЕСТ_МультиРесурсныйКонфликт() Экспорт

	// A занята у R1 и R2 весь понедельник; B нужна R1 - конфликт по R1.
	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("A", 480, Назначения("R1", "R2")));
	СписокЗадач.Добавить(ЗадачаТеста("B", 60, Назначения("R1")));

	Результат = Выровнять(СписокЗадач);

	СегментыБ = Результат["B"].Сегменты;
	ЮТест.ОжидаетЧто(СегментыБ[0].Начало)
		.Равно(Дата(2026, 11, 10, 8, 0, 0), "B сдвинута за занятость R1");
	ЮТест.ОжидаетЧто(СегментыБ[0].Конец)
		.Равно(Дата(2026, 11, 10, 9, 0, 0), "Час работы во вторник");
	ЮТест.ОжидаетЧто(Результат["B"].Задержка)
		.Равно(480, "Задержка - весь рабочий день");

КонецПроцедуры

Процедура ТЕСТ_РазныеРесурсы_ПараллельноРаботают() Экспорт

	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("A", 480, Назначения("R1")));
	СписокЗадач.Добавить(ЗадачаТеста("B", 480, Назначения("R2")));

	Результат = Выровнять(СписокЗадач);

	ЮТест.ОжидаетЧто(Результат["A"].Сегменты[0].Начало)
		.Равно(Дата(2026, 11, 9, 8, 0, 0), "A на месте");
	ЮТест.ОжидаетЧто(Результат["B"].Сегменты[0].Начало)
		.Равно(Дата(2026, 11, 9, 8, 0, 0), "B тоже - ресурсы разные");
	ЮТест.ОжидаетЧто(Результат["B"].Задержка)
		.Равно(0, "Разные ресурсы не конфликтуют");

КонецПроцедуры

Процедура ТЕСТ_ЗакреплённаяЗадача_РазбиваетсяНаСегменты() Экспорт

	// A(180) занимает утро до 11:00; B(120) закреплена SNET на 10:00 -
	// её 10:00-11:00 занято A, поэтому B режется: 11:00-12:00 и 13:00-14:00.
	ЗадачаБ = ЗадачаТеста("B", 120, Назначения("R1"));
	ЗадачаБ.ConstraintType = 2; // SNET
	ЗадачаБ.ConstraintDate = Дата(2026, 11, 9, 10, 0, 0);

	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("A", 180, Назначения("R1")));
	СписокЗадач.Добавить(ЗадачаБ);

	Результат = Выровнять(СписокЗадач);

	СегментыБ = Результат["B"].Сегменты;
	ЮТест.ОжидаетЧто(СегментыБ.Количество())
		.Равно(2, "Закреплённая задача разрезана на два куска");
	ЮТест.ОжидаетЧто(СегментыБ[0].Начало)
		.Равно(Дата(2026, 11, 9, 11, 0, 0), "Первый кусок - сразу после A");
	ЮТест.ОжидаетЧто(СегментыБ[0].Конец)
		.Равно(Дата(2026, 11, 9, 12, 0, 0), "До обеда");
	ЮТест.ОжидаетЧто(СегментыБ[1].Начало)
		.Равно(Дата(2026, 11, 9, 13, 0, 0), "Второй кусок - после обеда");
	ЮТест.ОжидаетЧто(СегментыБ[1].Конец)
		.Равно(Дата(2026, 11, 9, 14, 0, 0), "Ещё час");
	ЮТест.ОжидаетЧто(Результат["B"].Задержка)
		.Равно(0, "Разбиение не отодвигает закреплённый старт");

КонецПроцедуры

Процедура ТЕСТ_НеизвестныйРесурс_Исключение() Экспорт

	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("A", 60, Назначения("R9")));

	Упало = Ложь;
	ОписаниеОшибки = "";
	Попытка
		Выровнять(СписокЗадач);
	Исключение
		Упало = Истина;
		ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(Упало)
		.Равно(Истина, "Неизвестный ресурс должен порождать исключение");
	ЮТест.ОжидаетЧто(ОписаниеОшибки)
		.Содержит("неизвестному ресурсу", "Сообщение называет ресурс");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроектТеста()

	Возврат Новый Структура("Calendar, Start",
		КалендариПроектов.СтандартныйКалендарь(), Дата(2026, 11, 9, 8, 0, 0));

КонецФункции

// Ресурсы проекта: R1 и R2 без собственных календарей (календарь проекта).
Функция РесурсыПроекта()

	РесурсыПроекта = Новый Соответствие;
	РесурсыПроекта.Вставить("R1", Новый Структура("Calendar", Неопределено));
	РесурсыПроекта.Вставить("R2", Новый Структура("Calendar", Неопределено));
	Возврат РесурсыПроекта;

КонецФункции

// Задача-структура: контракт ПланированиеПроектов плюс назначения.
Функция ЗадачаТеста(Ключ, Длительность, НазначенияЗадачи, СвязиЗадачи = Неопределено)

	СписокСвязей = Новый Массив;
	Если СвязиЗадачи <> Неопределено Тогда
		СписокСвязей = СвязиЗадачи;
	КонецЕсли;

	Возврат Новый Структура("Ключ, Родитель, Duration, Calendar, ConstraintType, ConstraintDate, LevelingDelay, Predecessors, Assignments",
		Ключ, Неопределено, Длительность, Неопределено, 0, Неопределено, 0, СписокСвязей, НазначенияЗадачи);

КонецФункции

// Назначения на один-два ресурса (Units в процентах).
Функция Назначения(ПервыйРесурс, ВторойРесурс = Неопределено)

	СписокНазначений = Новый Массив;
	СписокНазначений.Добавить(Новый Структура("Resource, Units", ПервыйРесурс, 100));
	Если ВторойРесурс <> Неопределено Тогда
		СписокНазначений.Добавить(Новый Структура("Resource, Units", ВторойРесурс, 100));
	КонецЕсли;
	Возврат СписокНазначений;

КонецФункции

// Массив FS-связей на предшественников.
Функция Связи(ПервыйПредшественник)

	СписокСвязей = Новый Массив;
	СписокСвязей.Добавить(Новый Структура("Task, Type, Lag", ПервыйПредшественник, 1, 0));
	Возврат СписокСвязей;

КонецФункции

Функция Выровнять(СписокЗадач)

	Возврат ВыравниваниеРесурсов.Выровнять(СписокЗадач, РесурсыПроекта(), ПроектТеста());

КонецФункции

#КонецОбласти
