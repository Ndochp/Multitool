// Интеграционный тест зеркала GitLab (подсистема GitLabMirror):
// реальное чтение задач по метке "отв: НД" из gt.rosinkas.ru в тестовую ИБ.
//
// Токен доступа читается из build/secrets/gitlab-token.txt (файл не
// коммитится); при его отсутствии тест пропускается.
// Данные в тестовой ИБ остаются после прогона: конфиг
// tools/yaxunit-gitlab.json отключает транзакции (ВТранзакции: false).
//
// Запуск: vrunner test yaxunit --yaxunit-config tools/yaxunit-gitlab.json

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("GitLab.mirror: поиск и зеркалирование задачи (моки)")
			.ДобавитьТест("ТЕСТ_СсылкаЗадачиПоВебURL_ПустойURL")
			.ДобавитьТест("ТЕСТ_СсылкаЗадачиПоВебURL_НайденаВЗеркале")
			.ДобавитьТест("ТЕСТ_ОбеспечитьЗадачуИзAPI_СоздаётЗадачу")
			.ДобавитьТест("ТЕСТ_ОбеспечитьЗадачуИзAPI_ЗадачаНеНайдена")
			.ДобавитьТест("ТЕСТ_НайтиИлиЗеркалироватьЗадачуПоВебURL_ИзЗеркала")
			.ДобавитьТест("ТЕСТ_НайтиИлиЗеркалироватьЗадачуПоВебURL_Докачка")
			.ДобавитьТест("ТЕСТ_НайтиИлиЗеркалироватьЗадачуПоВебURL_НеНайдено")
		.ДобавитьТестовыйНабор("GitLab.mirror: чтение задач по метке (реальное API)")
			.ДобавитьТест("ТЕСТ_ЧтениеЗадачПоМеткеОтвНД")
		.ДобавитьТестовыйНабор("ЛУРВ: живой сценарий 03.11.2026 (реальное API)")
			.ДобавитьТест("ТЕСТ_ЖивойСценарий_ЛУРВСобратьТаймлогиНаДату")
	;

КонецПроцедуры

#Область Тесты

// Дано: подключение к GitLab gt.rosinkas.ru (токен из build/secrets)
// Когда: ГитлабЗеркало.ЗеркалироватьЗадачиПоМетке("отв: НД", "all")
// То:   задачи прочитаны, все отражены (созданы/обновлены/пропущены),
//       справочники зеркала заполнены, метка в ТЧ задач найдена
//
Процедура ТЕСТ_ЧтениеЗадачПоМеткеОтвНД() Экспорт

	Токен = ТокенИзФайла();

	Если ПустаяСтрока(Токен) Тогда
		ЮТест.Пропустить("Нет токена: build/secrets/gitlab-token.txt");
	КонецЕсли;

	ВнешняяСистема = ОбеспечитьВнешнююСистему(Токен);

	УдалитьДанныеЗеркала();

	Результат = ГитлабЗеркало.ЗеркалироватьЗадачиПоМетке(ВнешняяСистема, "отв: НД", "all");

	ЗаписатьРезюме(Результат);

	ЮТест.ОжидаетЧто(Результат.Задач, "Прочитано задач с меткой 'отв: НД'")
		.Больше(0);

	ЮТест.ОжидаетЧто(Результат.ЗадачСоздано + Результат.ЗадачОбновлено + Результат.ЗадачПропущено, "Каждая задача отражена")
		.Равно(Результат.Задач);

	ЮТест.ОжидаетЧто(КоличествоЗадач(), "Задачи в зеркале")
		.Равно(Результат.Задач);

	ЮТест.ОжидаетЧто(КоличествоПользователей(), "Пользователи в зеркале")
		.Больше(0);

	ЮТест.ОжидаетЧто(КоличествоПроектов(), "Проекты в зеркале")
		.Больше(0);

	ЮТест.ОжидаетЧто(КоличествоМеток(), "Метки в зеркале")
		.Больше(0);

	ЮТест.ОжидаетЧто(КоличествоЗадачСПометкой("отв: НД"), "Задачи с меткой в ТЧ Метки")
		.Больше(0);

КонецПроцедуры

// Дано: подключение к GitLab gt.rosinkas.ru (токен из build/secrets),
//       запуск разрешён маркером build/secrets/live-run.flag
// Когда: создан документ ЛУРВ на 03.11.2026 (ТЧ пустая) и вызван сбор
//        таймлогов на дату (как команда формы «Собрать таймлоги на дату»)
// То:   таймлоги получены из внешней системы, под них найдены/созданы
//       тикеты с заполненной ВнешняяЗадача, строки документа заполнены,
//       документ записан и остаётся в базе для просмотра.
// Резюме: build/out/yaxunit/lurv-live-summary.txt
//
Процедура ТЕСТ_ЖивойСценарий_ЛУРВСобратьТаймлогиНаДату() Экспорт

	Если НЕ МаркерЖивогоСценарияУстановлен() Тогда
		ЮТест.Пропустить("Живой сценарий отключён: нужен маркер build/secrets/live-run.flag");
	КонецЕсли;

	ДатаДня = Дата(2026, 11, 3);

	Токен = ТокенИзФайла();

	Если ПустаяСтрока(Токен) Тогда
		ЮТест.Пропустить("Нет токена: build/secrets/gitlab-token.txt");
	КонецЕсли;

	ОбеспечитьВнешнююСистему(Токен);

	// Фасад (как команда формы) опрашивает все неархивные системы:
	// посторонние системы архивируем, чтобы сбор шёл только по реальной.
	АрхивироватьСистемыКромеРеальной();
	УдалитьЛУРВНаДату(ДатаДня); // ЛУР-015 запрещает дубль документа на дату

	// Создание документа ЛУРВ с датой дня, ТЧ пустая (UC-07)
	ДокОбъект = Документы.ЛУРВ.СоздатьДокумент();
	ДокОбъект.Дата = ДатаДня;

	// Сбор таймлогов внешних систем на дату (ЛУР-013)
	Сбор = Обработки.УчетРабочегоВремениИнтеграции.Создать().СобратьТаймлогиНаДату(ДатаДня);

	ЮТест.ОжидаетЧто(Сбор.НеОтветившиеСистемы.Количество(), "Все внешние системы ответили")
		.Равно(0);

	ЮТест.ОжидаетЧто(Сбор.Таймлоги.Количество(), "Таймлоги за 03.11.2026 получены")
		.Больше(0);

	Заполнение = ДокОбъект.ЗаполнитьСтрокиИзТаймлогов(Сбор.Таймлоги);

	ЮТест.ОжидаетЧто(Заполнение.Добавлено, "Все таймлоги перенесены в строки документа")
		.Равно(Сбор.Таймлоги.Количество());

	ЮТест.ОжидаетЧто(Заполнение.Пропущено, "Пропущенных таймлогов нет")
		.Равно(0);

	ДокОбъект.Записать();

	ЮТест.ОжидаетЧто(ДокОбъект.Ссылка.Пустая(), "Документ записан")
		.Равно(Ложь);

	// Тикет каждой строки связан с задачей зеркала (внешняя задача заполнена)
	Для Каждого Строка Из ДокОбъект.ОтчетЗаДень Цикл
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Строка.Тикет,
			"Наименование, ВнешняяСистема, ВнешнийИдентификатор, СсылкаНаВнешнийТикет, ВнешняяЗадача");
		ЮТест.ОжидаетЧто(Реквизиты.ВнешняяЗадача.Пустая(),
				"ВнешняяЗадача заполнена: " + Реквизиты.Наименование)
			.Равно(Ложь);
	КонецЦикла;

	ЗаписатьРезюмеЛУРВ(ДокОбъект, Сбор, Заполнение);

КонецПроцедуры

#КонецОбласти // Тесты

