// Архивирует все внешние системы, кроме реальной (gt.rosinkas.ru): фасад
// сбора опрашивает все неархивные системы, а система с неподдерживаемым
// типом (старые тестовые артефакты) роняет сбор. Архивируем, а не удаляем —
// мок-тесты находят свои системы повторно и используют их без опроса фасадом.
//
Процедура АрхивироватьСистемыКромеРеальной()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.БазовыйURL КАК БазовыйURL
		|ИЗ Справочник.ВнешниеСистемыТикетов КАК Т";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.БазовыйURL = "https://gt.rosinkas.ru" Тогда
			Продолжить;
		КонецЕсли;
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.Архивная = Истина;
		Объект.Записать();
	КонецЦикла;

КонецПроцедуры

// Удаляет документы ЛУРВ за указанный день (ЛУР-015 запрещает дубль на дату).
//
Процедура УдалитьЛУРВНаДату(Знач ДатаДня)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Т.Ссылка КАК Ссылка
		|ИЗ Документ.ЛУРВ КАК Т
		|ГДЕ Т.Дата МЕЖДУ &Начало И &Конец";
	Запрос.УстановитьПараметр("Начало", НачалоДня(ДатаДня));
	Запрос.УстановитьПараметр("Конец", КонецДня(ДатаДня));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Выборка.Ссылка.ПолучитьОбъект().Удалить();
	КонецЦикла;

КонецПроцедуры

// Пишет резюме живого сценария ЛУРВ: документ, строки, тикеты.
// Файл для просмотра: build/out/yaxunit/lurv-live-summary.txt
//
Процедура ЗаписатьРезюмеЛУРВ(Знач ДокОбъект, Знач Сбор, Знач Заполнение)

	Резюме = Новый Массив;
	Резюме.Добавить("Живой сценарий 03.11.2026, реальное API gt.rosinkas.ru");
	Резюме.Добавить("Документ: Документ.ЛУРВ " + Строка(ДокОбъект.Ссылка)
		+ " (Дата " + Формат(ДокОбъект.Дата, "ДЛФ=DT") + ")");
	Резюме.Добавить("НачалоРаботы: " + Формат(ДокОбъект.НачалоРаботы, "ДЛФ=DT"));
	Резюме.Добавить("Таймлогов получено: " + Сбор.Таймлоги.Количество()
		+ " (в документ добавлено " + Заполнение.Добавлено + ")");
	Если Сбор.НеОтветившиеСистемы.Количество() > 0 Тогда
		Резюме.Добавить("НЕ ответившие системы: " + Сбор.НеОтветившиеСистемы.Количество());
	КонецЕсли;
	Резюме.Добавить("Строки ОтчетЗаДень:");

	Для Каждого Строка Из ДокОбъект.ОтчетЗаДень Цикл
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Строка.Тикет,
			"Наименование, ВнешнийИдентификатор, СсылкаНаВнешнийТикет");
		Резюме.Добавить("  "
			+ Формат(Строка.Начало, "ДЛФ=T") + " - " + Формат(Строка.Окончание, "ДЛФ=T")
			+ " | " + Реквизиты.Наименование
			+ " | " + Строка.Описание
			+ " | " + Формат(Строка.Длительность / 3600, "ЧДЦ=2") + " ч");
		Резюме.Добавить("      тикет: " + Строка(Строка.Тикет)
			+ ", внешний id: " + Реквизиты.ВнешнийИдентификатор
			+ ", url: " + Реквизиты.СсылкаНаВнешнийТикет);
	КонецЦикла;

	Каталог = "build\out\yaxunit";
	СоздатьКаталог(Каталог);

	Запись = Новый ЗаписьТекста(Каталог + "\lurv-live-summary.txt", КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(СтрСоединить(Резюме, Символы.ПС));
	Запись.Закрыть();

КонецПроцедуры

// Возвращает до двух тикетов задач проекта 3E реальной системы
// (первый - задача с наименьшим внешним идентификатором).
//
Функция ТикетыЗадачПроекта3E(Знач Система)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Тикеты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Тикеты КАК Тикеты
		|ГДЕ
		|	Тикеты.ВнешняяСистема = &Система
		|	И Тикеты.СсылкаНаВнешнийТикет ПОДОБНО &Шаблон
		|
		|УПОРЯДОЧИТЬ ПО
		|	Тикеты.ВнешнийИдентификатор";
	Запрос.УстановитьПараметр("Система", Система);
	Запрос.УстановитьПараметр("Шаблон", "%/Neumoichev_D/3E/%");

	Тикеты = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Тикеты.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат Тикеты;

КонецФункции

// Добавляет строку ТЧ ОтчетЗаДень с началом в указанный час дня документа
// и фиксированной длительностью.
//
Процедура ДобавитьСтрокуОтчета0411(ДокОбъект, Знач Тикет, Знач Час,
	Знач Длительность, Знач Описание)

	Начало = НачалоДня(ДокОбъект.Дата) + Час * 3600;

	Строка = ДокОбъект.ОтчетЗаДень.Добавить();
	Строка.Тикет        = Тикет;
	Строка.Описание     = Описание;
	Строка.Начало       = Начало;
	Строка.Окончание    = Начало + Длительность;
	Строка.Длительность = Длительность;

КонецПроцедуры

// Контрольное чтение записей времени на дату из GitLab (как видит их сбор).
//
Функция КонтрольныеТаймлогиНаДату(Знач ДатаДня)

	Возврат Обработки.УчетРабочегоВремениИнтеграции.Создать()
		.СобратьТаймлогиНаДату(ДатаДня).Таймлоги;

КонецФункции

// Пишет резюме живой синхронизации 04.11.2026: загрузка задач, итоги двух
// синхронизаций, строки документа с гидами записей.
// Файл для просмотра: build/out/yaxunit/lurv-sync-0411.txt
//
Процедура ЗаписатьРезюме0411(ДокОбъект, Знач Загрузка, Знач ЗаписейДоSync1,
	Знач Итог1, Знач Итог2, Знач Контроль2)

	Резюме = Новый Массив;
	Резюме.Добавить("Живая синхронизация ЛУРВ 04.11.2026, реальное API gt.rosinkas.ru");
	Резюме.Добавить("Документ: Документ.ЛУРВ " + Строка(ДокОбъект.Ссылка)
		+ " (Дата " + Формат(ДокОбъект.Дата, "ДЛФ=DT") + ")");
	Резюме.Добавить("Проект 3E: тикетов всего " + Загрузка.ТикетовВсего
		+ ", создано " + Загрузка.ТикетовСоздано);
	Резюме.Добавить("Записей в GitLab до первой синхронизации: " + ЗаписейДоSync1);
	Резюме.Добавить("Синхронизация 1: отправлено " + Итог1.Отправлено
		+ ", удалено " + Итог1.Удалено + ", обновлено " + Итог1.Обновлено
		+ ", пропущено " + Итог1.Пропущено);
	ДополнитьРезюмеОшибками0411(Резюме, Итог1.Ошибки, "sync1");
	Резюме.Добавить("Синхронизация 2: отправлено " + Итог2.Отправлено
		+ ", удалено " + Итог2.Удалено + ", обновлено " + Итог2.Обновлено
		+ ", пропущено " + Итог2.Пропущено);
	ДополнитьРезюмеОшибками0411(Резюме, Итог2.Ошибки, "sync2");
	Резюме.Добавить("Записей в GitLab за 04.11 после синхронизаций: " + Контроль2);
	Резюме.Добавить("Строки ОтчетЗаДень:");

	Для Каждого Строка Из ДокОбъект.ОтчетЗаДень Цикл
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Строка.Тикет,
			"Наименование, ВнешнийИдентификатор, СсылкаНаВнешнийТикет");
		Резюме.Добавить("  "
			+ Формат(Строка.Начало, "ДЛФ=T") + " - " + Формат(Строка.Окончание, "ДЛФ=T")
			+ " | " + Реквизиты.Наименование
			+ " | " + Строка.Описание
			+ " | " + Формат(Строка.Длительность / 3600, "ЧДЦ=2") + " ч"
			+ " | таймлог: " + Строка.СсылкаНаТаймлог);
	КонецЦикла;

	Каталог = "build\out\yaxunit";
	СоздатьКаталог(Каталог);

	Запись = Новый ЗаписьТекста(Каталог + "\lurv-sync-0411.txt", КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(СтрСоединить(Резюме, Символы.ПС));
	Запись.Закрыть();

КонецПроцедуры

// Дописывает в резюме ошибки синхронизации (если есть).
//
Процедура ДополнитьРезюмеОшибками0411(Резюме, Знач Ошибки, Знач Этап)

	Для Каждого ТекстОшибки Из Ошибки Цикл
		Резюме.Добавить("  ОШИБКА " + Этап + ": " + ТекстОшибки);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти // СлужебныеПроцедурыИФункции
