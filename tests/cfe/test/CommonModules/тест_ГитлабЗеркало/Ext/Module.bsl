// Интеграционный тест зеркала GitLab (подсистема GitLabMirror):
// реальное чтение задач по метке "отв: НД" из gt.rosinkas.ru в тестовую ИБ.
//
// Токен доступа читается из build/secrets/gitlab-token.txt (файл не
// коммитится); при его отсутствии тест пропускается.
// Данные в тестовой ИБ остаются после прогона: конфиг
// tools/yaxunit-gitlab.json отключает транзакции (ВТранзакции: false).
//
// Запуск: vrunner test yaxunit --yaxunit-config tools/yaxunit-gitlab.json

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("GitLab.mirror: чтение задач по метке (реальное API)")
			.ДобавитьТест("ТЕСТ_ЧтениеЗадачПоМеткеОтвНД")
	;

КонецПроцедуры

#Область Тесты

// Дано: подключение к GitLab gt.rosinkas.ru (токен из build/secrets)
// Когда: ГитлабЗеркало.ЗеркалироватьЗадачиПоМетке("отв: НД", "all")
// То:   задачи прочитаны, все отражены (созданы/обновлены/пропущены),
//       справочники зеркала заполнены, метка в ТЧ задач найдена
//
Процедура ТЕСТ_ЧтениеЗадачПоМеткеОтвНД() Экспорт

	Токен = ТокенИзФайла();

	Если ПустаяСтрока(Токен) Тогда
		ЮТест.Пропустить("Нет токена: build/secrets/gitlab-token.txt");
	КонецЕсли;

	ВнешняяСистема = ОбеспечитьВнешнююСистему(Токен);

	УдалитьДанныеЗеркала();

	Результат = ГитлабЗеркало.ЗеркалироватьЗадачиПоМетке(ВнешняяСистема, "отв: НД", "all");

	ЗаписатьРезюме(Результат);

	ЮТест.ОжидаетЧто(Результат.Задач, "Прочитано задач с меткой 'отв: НД'")
		.Больше(0);

	ЮТест.ОжидаетЧто(Результат.ЗадачСоздано + Результат.ЗадачОбновлено + Результат.ЗадачПропущено, "Каждая задача отражена")
		.Равно(Результат.Задач);

	ЮТест.ОжидаетЧто(КоличествоЗадач(), "Задачи в зеркале")
		.Равно(Результат.Задач);

	ЮТест.ОжидаетЧто(КоличествоПользователей(), "Пользователи в зеркале")
		.Больше(0);

	ЮТест.ОжидаетЧто(КоличествоПроектов(), "Проекты в зеркале")
		.Больше(0);

	ЮТест.ОжидаетЧто(КоличествоМеток(), "Метки в зеркале")
		.Больше(0);

	ЮТест.ОжидаетЧто(КоличествоЗадачСПометкой("отв: НД"), "Задачи с меткой в ТЧ Метки")
		.Больше(0);

КонецПроцедуры

#КонецОбласти // Тесты

#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// Подготовка

// Читает GitLab-токен из build/secrets/gitlab-token.txt.
//
// Возвращаемое значение:
//   Строка - токен (пустая, если файл отсутствует).
//
Функция ТокенИзФайла()

	Пути = МассивПутейТокена();

	Для Каждого Путь Из Пути Цикл
		Если ФайлСуществует(Путь) Тогда
			Чтение = Новый ЧтениеТекста(Путь);
			Токен = СокрЛП(Чтение.ПрочитатьСтроку());
			Чтение.Закрыть();
			Возврат Токен;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Пути к файлу токена относительно возможных рабочих каталогов процесса.
//
Функция МассивПутейТокена()

	Пути = Новый Массив;
	Пути.Добавить("build\secrets\gitlab-token.txt");
	Пути.Добавить(".\build\secrets\gitlab-token.txt");
	Пути.Добавить("..\build\secrets\gitlab-token.txt");

	Возврат Пути;

КонецФункции

// Проверяет существование файла (без исключения при отсутствии).
//
Функция ФайлСуществует(Знач Путь)

	Файл = Новый Файл(Путь);
	Возврат Файл.Существует();

КонецФункции

// Находит или создаёт элемент ВнешниеСистемыТикетов для тестового GitLab
// и записывает в него токен через безопасное хранилище.
//
Функция ОбеспечитьВнешнююСистему(Знач Токен)

	БазовыйURL = "https://gt.rosinkas.ru";

	Ссылка = ВнешняяСистемаПоБазовомуURL(БазовыйURL);

	Если Ссылка.Пустая() Тогда
		Объект = Справочники.ВнешниеСистемыТикетов.СоздатьЭлемент();
		Объект.Наименование = "GitLab: gt.rosinkas.ru (тест зеркала)";
		Объект.БазовыйURL   = БазовыйURL;
		Объект.ТипСистемы   = Справочники.ТипыСистемТикетов.GitLab;
		Объект.Записать();
		Ссылка = Объект.Ссылка;
	КонецЕсли;

	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Ссылка, Токен, "PRIVATE_TOKEN");

	Возврат Ссылка;

КонецФункции

// Ищет элемент ВнешниеСистемыТикетов по базовому URL.
// БазовыйURL - строка неограниченной длины, сравнение в запросе запрещено,
// поэтому отбор выполняется в коде.
//
Функция ВнешняяСистемаПоБазовомуURL(Знач БазовыйURL)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.БазовыйURL КАК БазовыйURL
		|ИЗ Справочник.ВнешниеСистемыТикетов КАК Т";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если Выборка.БазовыйURL = БазовыйURL Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Справочники.ВнешниеСистемыТикетов.ПустаяСсылка();

КонецФункции

// Удаляет данные зеркала из тестовой ИБ перед прогоном: тест должен
// детерминированно проверять наполнение с нуля. Внешние системы тикетов
// не трогаются - удаляются только каталоги подсистемы GitLabMirror.
//
Процедура УдалитьДанныеЗеркала()

	УдалитьВсеЭлементы("Справочник.ГитлабЗадачи");
	УдалитьВсеЭлементы("Справочник.ГитлабМетки");
	УдалитьВсеЭлементы("Справочник.ГитлабПользователи");
	УдалитьВсеЭлементы("Справочник.ГитлабПроекты");

КонецПроцедуры

// Удаляет все элементы каталога по имени таблицы.
//
Процедура УдалитьВсеЭлементы(Знач ИмяТаблицы)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ " + ИмяТаблицы + " КАК Т";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Выборка.Ссылка.ПолучитьОбъект().Удалить();
	КонецЦикла;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Проверки данных зеркала

// Возвращает число задач в зеркале.
//
Функция КоличествоЗадач()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(Т.Ссылка) КАК Количество
		|ИЗ Справочник.ГитлабЗадачи КАК Т";

	Возврат ЕдинственноеЧисло(Запрос);

КонецФункции

// Возвращает число пользователей в зеркале.
//
Функция КоличествоПользователей()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(Т.Ссылка) КАК Количество
		|ИЗ Справочник.ГитлабПользователи КАК Т";

	Возврат ЕдинственноеЧисло(Запрос);

КонецФункции

// Возвращает число проектов в зеркале.
//
Функция КоличествоПроектов()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(Т.Ссылка) КАК Количество
		|ИЗ Справочник.ГитлабПроекты КАК Т";

	Возврат ЕдинственноеЧисло(Запрос);

КонецФункции

// Возвращает число меток в зеркале.
//
Функция КоличествоМеток()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(Т.Ссылка) КАК Количество
		|ИЗ Справочник.ГитлабМетки КАК Т";

	Возврат ЕдинственноеЧисло(Запрос);

КонецФункции

// Возвращает число задач зеркала, у которых в ТЧ Метки есть метка с именем.
//
Функция КоличествоЗадачСПометкой(Знач ИмяМетки)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ М.Ссылка) КАК Количество
		|ИЗ Справочник.ГитлабЗадачи.Метки КАК М
		|ГДЕ М.Имя = &ИмяМетки";
	Запрос.УстановитьПараметр("ИмяМетки", ИмяМетки);

	Возврат ЕдинственноеЧисло(Запрос);

КонецФункции

// Возвращает общее число строк в ТЧ Метки всех задач зеркала.
//
Функция КоличествоСтрокМеткиТЧ()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(М.НомерСтроки) КАК Количество
		|ИЗ Справочник.ГитлабЗадачи.Метки КАК М";

	Возврат ЕдинственноеЧисло(Запрос);

КонецФункции

// Возвращает число меток каталога ГитлабМетки с заданным именем.
//
Функция КоличествоМетокСПометкой(Знач ИмяМетки)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(Т.Ссылка) КАК Количество
		|ИЗ Справочник.ГитлабМетки КАК Т
		|ГДЕ Т.Имя = &ИмяМетки";
	Запрос.УстановитьПараметр("ИмяМетки", ИмяМетки);

	Возврат ЕдинственноеЧисло(Запрос);

КонецФункции

// Возвращает первые 10 различных имён меток из ТЧ Метки (для диагностики).
//
Функция ПримерыИмёнМетокТЧ()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 10 РАЗЛИЧНЫЕ М.Имя КАК Имя
		|ИЗ Справочник.ГитлабЗадачи.Метки КАК М";

	Имена = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Имена.Добавить(Выборка.Имя);
	КонецЦикла;

	Если Имена.Количество() = 0 Тогда
		Возврат "(пусто)";
	КонецЕсли;

	Возврат СтрСоединить(Имена, " | ");

КонецФункции

// Выполняет запрос и возвращает число из единственной строки.
//
Функция ЕдинственноеЧисло(Знач Запрос)

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;

	Возврат 0;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Отчёт о прогоне

// Пишет счётчики синхронизации в build/out/yaxunit/gitlab-mirror-summary.txt
// для просмотра результатов без запуска 1С.
//
Процедура ЗаписатьРезюме(Знач Результат)

	Строки = Новый Массив;
	Строки.Добавить("Задач прочитано:      " + Результат.Задач);
	Строки.Добавить("  создано:            " + Результат.ЗадачСоздано);
	Строки.Добавить("  обновлено:          " + Результат.ЗадачОбновлено);
	Строки.Добавить("  пропущено:          " + Результат.ЗадачПропущено);
	Строки.Добавить("Проектов создано:     " + Результат.ПроектовСоздано);
	Строки.Добавить("Пользователей создано:" + Результат.ПользователейСоздано);
	Строки.Добавить("Меток создано:        " + Результат.МетокСоздано);
	Строки.Добавить("Всего задач в зеркале:  " + КоличествоЗадач());
	Строки.Добавить("Всего пользователей:    " + КоличествоПользователей());
	Строки.Добавить("Всего проектов:         " + КоличествоПроектов());
	Строки.Добавить("Всего меток:            " + КоличествоМеток());
	Строки.Добавить("---- Диагностика ТЧ Метки ----");
	Строки.Добавить("Строк ТЧ Метки всего:   " + КоличествоСтрокМеткиТЧ());
	Строки.Добавить("Метка 'отв: НД' в каталоге ГитлабМетки: " + КоличествоМетокСПометкой("отв: НД"));
	Строки.Добавить("Примеры имён в ТЧ Метки: " + ПримерыИмёнМетокТЧ());

	Каталог = "build\out\yaxunit";
	СоздатьКаталог(Каталог);

	Запись = Новый ЗаписьТекста(Каталог + "\gitlab-mirror-summary.txt", КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(СтрСоединить(Строки, Символы.ПС));
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти // СлужебныеПроцедурыИФункции
