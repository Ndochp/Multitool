// Интеграционный тест зеркала GitLab (подсистема GitLabMirror):
// реальное чтение задач по метке "отв: НД" из gt.rosinkas.ru в тестовую ИБ.
//
// Токен доступа читается из build/secrets/gitlab-token.txt (файл не
// коммитится); при его отсутствии тест пропускается.
// Данные в тестовой ИБ остаются после прогона: конфиг
// tools/yaxunit-gitlab.json отключает транзакции (ВТранзакции: false).
//
// Запуск: vrunner test yaxunit --yaxunit-config tools/yaxunit-gitlab.json

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("GitLab.mirror: поиск и зеркалирование задачи (моки)")
			.ДобавитьТест("ТЕСТ_СсылкаЗадачиПоВебURL_ПустойURL")
			.ДобавитьТест("ТЕСТ_СсылкаЗадачиПоВебURL_НайденаВЗеркале")
			.ДобавитьТест("ТЕСТ_ОбеспечитьЗадачуИзAPI_СоздаётЗадачу")
			.ДобавитьТест("ТЕСТ_ОбеспечитьЗадачуИзAPI_ЗадачаНеНайдена")
			.ДобавитьТест("ТЕСТ_НайтиИлиЗеркалироватьЗадачуПоВебURL_ИзЗеркала")
			.ДобавитьТест("ТЕСТ_НайтиИлиЗеркалироватьЗадачуПоВебURL_Докачка")
			.ДобавитьТест("ТЕСТ_НайтиИлиЗеркалироватьЗадачуПоВебURL_НеНайдено")
		.ДобавитьТестовыйНабор("GitLab.mirror: точечная загрузка задачи по ссылке (моки)")
			.ДобавитьТест("ТЕСТ_ЗаполнитьЗадачуПоСсылке_ЗаполняетНовыйОбъект")
			.ДобавитьТест("ТЕСТ_ЗаполнитьЗадачуПоСсылке_WorkItemsСсылка")
			.ДобавитьТест("ТЕСТ_ЗаполнитьЗадачуПоСсылке_СсылкаНеЗадача")
			.ДобавитьТест("ТЕСТ_ЗаполнитьЗадачуПоСсылке_ЗадачаНеНайдена")
			.ДобавитьТест("ТЕСТ_ФасадЗаполнитьЗадачуПоСсылке_ПодборСистемы")
		;

	ЮТТесты
		.ДобавитьТестовыйНабор("GitLab.mirror: чтение задач по метке (реальное API)")
			.ДобавитьТест("ТЕСТ_ЧтениеЗадачПоМеткеОтвНД")
		.ДобавитьТестовыйНабор("ЛУРВ: живой сценарий 03.11.2026 (реальное API)")
			.ДобавитьТест("ТЕСТ_ЖивойСценарий_ЛУРВСобратьТаймлогиНаДату")
		.ДобавитьТестовыйНабор("ЛУРВ: живая синхронизация 04.11.2026 (реальное API)")
			.ДобавитьТест("ТЕСТ_ЖивойСценарий_ЛУРВСинхронизацияНаДату")
	;

КонецПроцедуры

#Область Тесты

// Дано: подключение к GitLab gt.rosinkas.ru (токен из build/secrets)
// Когда: ГитлабЗеркало.ЗеркалироватьЗадачиПоМетке("отв: НД", "all")
// То:   задачи прочитаны, все отражены (созданы/обновлены/пропущены),
//       справочники зеркала заполнены, метка в ТЧ задач найдена
//
Процедура ТЕСТ_ЧтениеЗадачПоМеткеОтвНД() Экспорт

	Токен = ТокенИзФайла();

	Если ПустаяСтрока(Токен) Тогда
		ЮТест.Пропустить("Нет токена: build/secrets/gitlab-token.txt");
	КонецЕсли;

	ВнешняяСистема = ОбеспечитьВнешнююСистему(Токен);

	УдалитьДанныеЗеркала();

	Результат = ГитлабЗеркало.ЗеркалироватьЗадачиПоМетке(ВнешняяСистема, "отв: НД", "all");

	ЗаписатьРезюме(Результат);

	ЮТест.ОжидаетЧто(Результат.Задач, "Прочитано задач с меткой 'отв: НД'")
		.Больше(0);

	ЮТест.ОжидаетЧто(Результат.ЗадачСоздано + Результат.ЗадачОбновлено + Результат.ЗадачПропущено, "Каждая задача отражена")
		.Равно(Результат.Задач);

	ЮТест.ОжидаетЧто(КоличествоЗадач(), "Задачи в зеркале")
		.Равно(Результат.Задач);

	ЮТест.ОжидаетЧто(КоличествоПользователей(), "Пользователи в зеркале")
		.Больше(0);

	ЮТест.ОжидаетЧто(КоличествоПроектов(), "Проекты в зеркале")
		.Больше(0);

	ЮТест.ОжидаетЧто(КоличествоМеток(), "Метки в зеркале")
		.Больше(0);

	ЮТест.ОжидаетЧто(КоличествоЗадачСПометкой("отв: НД"), "Задачи с меткой в ТЧ Метки")
		.Больше(0);

КонецПроцедуры

// Дано: подключение к GitLab gt.rosinkas.ru (токен из build/secrets),
//       запуск разрешён маркером build/secrets/live-run.flag
// Когда: создан документ ЛУРВ на 03.11.2026 (ТЧ пустая) и вызван сбор
//        таймлогов на дату (как команда формы «Собрать таймлоги на дату»)
// То:   таймлоги получены из внешней системы, под них найдены/созданы
//       тикеты с заполненной ВнешняяЗадача, строки документа заполнены,
//       документ записан и остаётся в базе для просмотра.
// Резюме: build/out/yaxunit/lurv-live-summary.txt
//
Процедура ТЕСТ_ЖивойСценарий_ЛУРВСобратьТаймлогиНаДату() Экспорт

	Если НЕ МаркерЖивогоСценарияУстановлен() Тогда
		ЮТест.Пропустить("Живой сценарий отключён: нужен маркер build/secrets/live-run.flag");
	КонецЕсли;

	ДатаДня = Дата(2026, 11, 3);

	Токен = ТокенИзФайла();

	Если ПустаяСтрока(Токен) Тогда
		ЮТест.Пропустить("Нет токена: build/secrets/gitlab-token.txt");
	КонецЕсли;

	ОбеспечитьВнешнююСистему(Токен);

	// Фасад (как команда формы) опрашивает все неархивные системы:
	// посторонние системы архивируем, чтобы сбор шёл только по реальной.
	АрхивироватьСистемыКромеРеальной();
	УдалитьЛУРВНаДату(ДатаДня); // ЛУР-015 запрещает дубль документа на дату

	// Создание документа ЛУРВ с датой дня, ТЧ пустая (UC-07)
	ДокОбъект = Документы.ЛУРВ.СоздатьДокумент();
	ДокОбъект.Дата = ДатаДня;

	// Сбор таймлогов внешних систем на дату (ЛУР-013)
	Сбор = Обработки.УчетРабочегоВремениИнтеграции.Создать().СобратьТаймлогиНаДату(ДатаДня);

	ЮТест.ОжидаетЧто(Сбор.НеОтветившиеСистемы.Количество(), "Все внешние системы ответили")
		.Равно(0);

	ЮТест.ОжидаетЧто(Сбор.Таймлоги.Количество(), "Таймлоги за 03.11.2026 получены")
		.Больше(0);

	Заполнение = ДокОбъект.ЗаполнитьСтрокиИзТаймлогов(Сбор.Таймлоги);

	ЮТест.ОжидаетЧто(Заполнение.Добавлено, "Все таймлоги перенесены в строки документа")
		.Равно(Сбор.Таймлоги.Количество());

	ЮТест.ОжидаетЧто(Заполнение.Пропущено, "Пропущенных таймлогов нет")
		.Равно(0);

	ДокОбъект.Записать();

	ЮТест.ОжидаетЧто(ДокОбъект.Ссылка.Пустая(), "Документ записан")
		.Равно(Ложь);

	// Тикет каждой строки связан с задачей зеркала (внешняя задача заполнена)
	Для Каждого Строка Из ДокОбъект.ОтчетЗаДень Цикл
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Строка.Тикет,
			"Наименование, ВнешняяСистема, ВнешнийИдентификатор, СсылкаНаВнешнийТикет, ВнешняяЗадача");
		ЮТест.ОжидаетЧто(Реквизиты.ВнешняяЗадача.Пустая(),
				"ВнешняяЗадача заполнена: " + Реквизиты.Наименование)
			.Равно(Ложь);
	КонецЦикла;

	ЗаписатьРезюмеЛУРВ(ДокОбъект, Сбор, Заполнение);

КонецПроцедуры

// Дано: подключение к GitLab gt.rosinkas.ru (токен из build/secrets),
//       запуск разрешён маркером build/secrets/live-run.flag
// Когда: задачи проекта Neumoichev_D/3E загружены в зеркало с тикетами;
//        создан документ ЛУРВ за 04.11.2026 с тремя строками по тикетам;
//        синхронизация №1 (GitLab сводится к документу); правки - одна
//        строка удалена, две добавлены по тем же задачам с новым
//        комментарием; синхронизация №2
// То:   после sync1 в GitLab ровно 2 записи за дату (строки одной задачи
//       свёрнуты в одну запись), все строки получили гиды записей;
//       после sync2 - ровно 2 записи: обе задачи обновлены (записи заменены
//       новыми свёртками), неменяющиеся не тронуты.
// Резюме: build/out/yaxunit/lurv-sync-0411.txt
//
Процедура ТЕСТ_ЖивойСценарий_ЛУРВСинхронизацияНаДату() Экспорт

	Если НЕ МаркерЖивогоСценарияУстановлен() Тогда
		ЮТест.Пропустить("Живой сценарий отключён: нужен маркер build/secrets/live-run.flag");
	КонецЕсли;

	ДатаДня = Дата(2026, 11, 4);

	Токен = ТокенИзФайла();

	Если ПустаяСтрока(Токен) Тогда
		ЮТест.Пропустить("Нет токена: build/secrets/gitlab-token.txt");
	КонецЕсли;

	Система = ОбеспечитьВнешнююСистему(Токен);
	АрхивироватьСистемыКромеРеальной();

	// Задачи проекта 3E -> зеркало GitLab + тикеты
	Загрузка = Обработки.УчетРабочегоВремениИнтеграции.Создать()
		.ЗагрузитьЗадачиПроекта(Система, "Neumoichev_D/3E");

	ЮТест.ОжидаетЧто(Загрузка.ТикетовВсего, "Задачи проекта 3E обеспечены тикетами")
		.Больше(0);

	Тикеты = ТикетыЗадачПроекта3E(Система);
	ЮТест.ОжидаетЧто(Тикеты.Количество(), "Тикеты задач 3E найдены")
		.Больше(0);

	// Документ ЛУРВ за 04.11.2026 (выходной - в GitLab записей нет)
	УдалитьЛУРВНаДату(ДатаДня);
	ДокОбъект = Документы.ЛУРВ.СоздатьДокумент();
	ДокОбъект.Дата         = ДатаДня;
	ДокОбъект.НачалоРаботы = Дата(2026, 11, 4, 9, 0, 0);

	ТикетА = Тикеты[0];
	ТикетБ = ?(Тикеты.Количество() > 1, Тикеты[1], Тикеты[0]);

	ДобавитьСтрокуОтчета0411(ДокОбъект, ТикетА, 9,  3600, "Анализ задачи");
	ДобавитьСтрокуОтчета0411(ДокОбъект, ТикетБ, 10, 5400, "Разработка");
	ДобавитьСтрокуОтчета0411(ДокОбъект, ТикетА, 12, 2700, "Правки по замечаниям");
	ДокОбъект.Записать();

	Фасад = Обработки.УчетРабочегоВремениИнтеграции.Создать();

	ЗаписейДоSync1 = КонтрольныеТаймлогиНаДату(ДатаДня).Количество();

	// Синхронизация №1: запись на дату, которой нет в документе, удаляется,
	// строки документа свёртываются по задачам и отправляются
	Итог1 = Фасад.СинхронизироватьДокумент(ДокОбъект);
	ДокОбъект.Записать();

	ЮТест.ОжидаетЧто(Итог1.Ошибки.Количество(), "Синхронизация 1 без ошибок")
		.Равно(0);

	ЮТест.ОжидаетЧто(Итог1.Отправлено, "Отправлены обе задачи (3 строки свёрнуты в 2 записи)")
		.Равно(2);

	Контроль1 = КонтрольныеТаймлогиНаДату(ДатаДня).Количество();
	ЮТест.ОжидаетЧто(Контроль1, "В GitLab 2 записи за дату после sync1")
		.Равно(2);

	Для Каждого Строка Из ДокОбъект.ОтчетЗаДень Цикл
		ЮТест.ОжидаетЧто(ПустаяСтрока(Строка.СсылкаНаТаймлог), "Гид записи у строки после sync1")
			.Равно(Ложь);
	КонецЦикла;

	// Правки документа: удалить строку 1 (тикет Б), добавить две
	// по тем же задачам с новым комментарием
	ДокОбъект.ОтчетЗаДень.Удалить(1);
	ДобавитьСтрокуОтчета0411(ДокОбъект, ТикетБ, 10, 3600, "Разработка, новый комментарий");
	ДобавитьСтрокуОтчета0411(ДокОбъект, ТикетА, 15, 1800, "Правки, новый комментарий");
	ДокОбъект.Записать();

	// Синхронизация №2: расходящиеся задачи заменены новыми свёртками
	// (по записи на задачу), неменяющиеся не тронуты
	Итог2 = Фасад.СинхронизироватьДокумент(ДокОбъект);
	ДокОбъект.Записать();

	ЮТест.ОжидаетЧто(Итог2.Ошибки.Количество(), "Синхронизация 2 без ошибок")
		.Равно(0);

	ЮТест.ОжидаетЧто(Итог2.Удалено, "Старые записи обеих задач удалены")
		.Равно(2);

	ЮТест.ОжидаетЧто(Итог2.Отправлено, "Новых задач нет")
		.Равно(0);

	ЮТест.ОжидаетЧто(Итог2.Обновлено, "Обе задачи обновлены одной записью")
		.Равно(2);

	Контроль2 = КонтрольныеТаймлогиНаДату(ДатаДня).Количество();
	ЮТест.ОжидаетЧто(Контроль2, "В GitLab 2 записи за дату после sync2")
		.Равно(2);

	ЗаписатьРезюме0411(ДокОбъект, Загрузка, ЗаписейДоSync1, Итог1, Итог2, Контроль2);

КонецПроцедуры

#КонецОбласти // Тесты

#Область ТестыМокиПоискаИЗеркалированияЗадачи

// Мок-тесты методов зеркалирования отдельной задачи (связка ЛУРВ <-> GitLab).
// HTTP-вызовы подменяются через Мокито; тестовые данные чистятся перед
// прогоном, поэтому тесты работают и без транзакций.

// Дано: пустой аргумент ВебURL
// Когда: СсылкаЗадачиПоВебURL("")
// То: Возвращается пустая ссылка
//
Процедура ТЕСТ_СсылкаЗадачиПоВебURL_ПустойURL() Экспорт

	ОчиститьТестовыеДанные();

	Результат = ГитлабЗеркало.СсылкаЗадачиПоВебURL("");

	ЮТест.ОжидаетЧто(Результат.Пустая())
		.Равно(Истина, "Пустой URL - пустая ссылка");

КонецПроцедуры

// Дано: задача с данным ВебURL есть в зеркале
// Когда: СсылкаЗадачиПоВебURL(ВебURL задачи)
// То: Возвращается ссылка задачи зеркала
//
Процедура ТЕСТ_СсылкаЗадачиПоВебURL_НайденаВЗеркале() Экспорт

	ОчиститьТестовыеДанные();

	ЗадачаЗеркала = СоздатьЗадачуЗеркала();

	Результат = ГитлабЗеркало.СсылкаЗадачиПоВебURL(ВебURLЗадачи());

	ЮТест.ОжидаетЧто(Результат)
		.Равно(ЗадачаЗеркала, "Задача найдена в зеркале по ВебURL");

КонецПроцедуры

// Дано: задача и проект отсутствуют в зеркале, API возвращает задачу
// Когда: ОбеспечитьЗадачуИзAPI(Интеграция, 3001, 1234, Результат)
// То: Задача зеркалирована вместе с проектом и автором, возвращена ссылка;
//     числовые коды записаны без разделителей групп разрядов
//
Процедура ТЕСТ_ОбеспечитьЗадачуИзAPI_СоздаётЗадачу() Экспорт

	ОчиститьТестовыеДанные();

	Мокито.Обучение(КоннекторHTTP)
		.Когда("Get").Вернуть(ОтветЗадача()).Вернуть(ОтветПроект())
		.Прогон();

	Интеграция = Обработки.ИнтеграцияGitlab.СоздатьИнтеграцию(ВнешняяСистемаМок());

	РезультатСинхронизации = ГитлабЗеркало.НовыйРезультатСинхронизации();

	СсылкаЗадачи = ГитлабЗеркало.ОбеспечитьЗадачуИзAPI(Интеграция, 3001, 1234, РезультатСинхронизации);

	ЮТест.ОжидаетЧто(СсылкаЗадачи.Пустая())
		.Равно(Ложь, "Задача зеркалирована");

	ЮТест.ОжидаетЧто(СсылкаЗадачи)
		.Равно(ГитлабЗеркало.СсылкаЗадачиПоИдентификатору(6001), "Ссылка по глобальному id задачи");

	// Числовые коды - без разделителей групп разрядов (ru локаль вставляет
	// неразрывный пробел после тысяч, др. локаль может вставить запятую).
	ЮТест.ОжидаетЧто(СсылкаЗадачи.Код)
		.Равно("1234", "Код задачи = IID без разделителей");
	ЮТест.ОжидаетЧто(СсылкаЗадачи.Владелец.Код)
		.Равно("3001", "Код проекта без разделителей");

	ЮТест.ОжидаетЧто(РезультатСинхронизации.ЗадачСоздано)
		.Равно(1, "Задача создана");

	ЮТест.ОжидаетЧто(РезультатСинхронизации.ПроектовСоздано)
		.Равно(1, "Проект создан");

	ЮТест.ОжидаетЧто(РезультатСинхронизации.ПользователейСоздано)
		.Равно(1, "Автор создан");

КонецПроцедуры

// Дано: API не находит задачу (404)
// Когда: ОбеспечитьЗадачуИзAPI(Интеграция, 3001, 99, Результат)
// То: Возвращается пустая ссылка
//
Процедура ТЕСТ_ОбеспечитьЗадачуИзAPI_ЗадачаНеНайдена() Экспорт

	ОчиститьТестовыеДанные();

	Мокито.Обучение(КоннекторHTTP)
		.Когда("Get").Вернуть(ОтветЗадачаНеНайдена())
		.Прогон();

	Интеграция = Обработки.ИнтеграцияGitlab.СоздатьИнтеграцию(ВнешняяСистемаМок());

	СсылкаЗадачи = ГитлабЗеркало.ОбеспечитьЗадачуИзAPI(
		Интеграция, 3001, 99, ГитлабЗеркало.НовыйРезультатСинхронизации());

