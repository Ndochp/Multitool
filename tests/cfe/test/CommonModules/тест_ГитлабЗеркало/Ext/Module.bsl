// Читает GitLab-токен из build/secrets/gitlab-token.txt.
//
// Возвращаемое значение:
//   Строка - токен (пустая, если файл отсутствует).
//
Функция ТокенИзФайла()

	Пути = МассивПутейТокена();

	Для Каждого Путь Из Пути Цикл
		Если ФайлСуществует(Путь) Тогда
			Чтение = Новый ЧтениеТекста(Путь);
			Токен = СокрЛП(Чтение.ПрочитатьСтроку());
			Чтение.Закрыть();
			Возврат Токен;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Пути к файлу токена относительно возможных рабочих каталогов процесса.
//
Функция МассивПутейТокена()

	Пути = Новый Массив;
	Пути.Добавить("build\secrets\gitlab-token.txt");
	Пути.Добавить(".\build\secrets\gitlab-token.txt");
	Пути.Добавить("..\build\secrets\gitlab-token.txt");

	Возврат Пути;

КонецФункции

// Проверяет существование файла (без исключения при отсутствии).
//
Функция ФайлСуществует(Знач Путь)

	Файл = Новый Файл(Путь);
	Возврат Файл.Существует();

КонецФункции

// Находит или создаёт элемент ВнешниеСистемыТикетов для тестового GitLab
// и записывает в него токен через безопасное хранилище.
//
Функция ОбеспечитьВнешнююСистему(Знач Токен)

	БазовыйURL = "https://gt.rosinkas.ru";

	Ссылка = ВнешняяСистемаПоБазовомуURL(БазовыйURL);

	Если Ссылка.Пустая() Тогда
		Объект = Справочники.ВнешниеСистемыТикетов.СоздатьЭлемент();
		Объект.Наименование = "GitLab: gt.rosinkas.ru (тест зеркала)";
		Объект.БазовыйURL   = БазовыйURL;
		Объект.ТипСистемы   = Справочники.ТипыСистемТикетов.GitLab;
		Объект.Записать();
		Ссылка = Объект.Ссылка;
	Иначе
		ОбеспечитьТипСистемыGitlab(Ссылка);
	КонецЕсли;

	ОбеспечитьПризнакИнтеграцииGitlab();

	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Ссылка, Токен, "PRIVATE_TOKEN");

	Возврат Ссылка;

КонецФункции

// Приводит тип существующей системы к предопределённому GitLab: фасад
// выбирает адаптер и решает вопрос интеграции именно по типу системы.
//
Процедура ОбеспечитьТипСистемыGitlab(Знач Система)

	ТипGitlab = Справочники.ТипыСистемТикетов.GitLab;

	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Система, "ТипСистемы") <> ТипGitlab Тогда
		Объект = Система.ПолучитьОбъект();
		Объект.ТипСистемы = ТипGitlab;
		Объект.Записать();
	КонецЕсли;

КонецПроцедуры

// У предопределённого типа GitLab должен стоять признак «Имеет интеграцию»:
// без него фасад пропускает строки системы как неинтегрированные.
//
Процедура ОбеспечитьПризнакИнтеграцииGitlab()

	ТипОбъект = Справочники.ТипыСистемТикетов.GitLab.ПолучитьОбъект();

	Если НЕ ТипОбъект.ИмеетИнтеграцию Тогда
		ТипОбъект.ИмеетИнтеграцию = Истина;
		ТипОбъект.Записать();
	КонецЕсли;

КонецПроцедуры

// Ищет элемент ВнешниеСистемыТикетов по базовому URL.
// БазовыйURL - строка неограниченной длины, сравнение в запросе запрещено,
// поэтому отбор выполняется в коде.
//
Функция ВнешняяСистемаПоБазовомуURL(Знач БазовыйURL)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.БазовыйURL КАК БазовыйURL
		|ИЗ Справочник.ВнешниеСистемыТикетов КАК Т";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если Выборка.БазовыйURL = БазовыйURL Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Справочники.ВнешниеСистемыТикетов.ПустаяСсылка();

КонецФункции

