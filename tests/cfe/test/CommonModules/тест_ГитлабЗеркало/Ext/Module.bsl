// Дано: задача и проект отсутствуют в зеркале, API возвращает задачу
// Когда: ОбеспечитьЗадачуИзAPI(Интеграция, 3001, 7, Результат)
// То: Задача зеркалирована вместе с проектом и автором, возвращена ссылка
//
Процедура ТЕСТ_ОбеспечитьЗадачуИзAPI_СоздаётЗадачу() Экспорт

	ОчиститьТестовыеДанные();

	Мокито.Обучение(КоннекторHTTP)
		.Когда("Get").Вернуть(ОтветЗадача()).Вернуть(ОтветПроект())
		.Прогон();

	Интеграция = Обработки.ИнтеграцияGitlab.СоздатьИнтеграцию(ВнешняяСистемаМок());

	РезультатСинхронизации = ГитлабЗеркало.НовыйРезультатСинхронизации();

	СсылкаЗадачи = ГитлабЗеркало.ОбеспечитьЗадачуИзAPI(Интеграция, 3001, 7, РезультатСинхронизации);

	ЮТест.ОжидаетЧто(СсылкаЗадачи.Пустая())
		.Равно(Ложь, "Задача зеркалирована");

	ЮТест.ОжидаетЧто(СсылкаЗадачи)
		.Равно(ГитлабЗеркало.СсылкаЗадачиПоИдентификатору(6001), "Ссылка по глобальному id задачи");

	ЮТест.ОжидаетЧто(РезультатСинхронизации.ЗадачСоздано)
		.Равно(1, "Задача создана");

	ЮТест.ОжидаетЧто(РезультатСинхронизации.ПроектовСоздано)
		.Равно(1, "Проект создан");

	ЮТест.ОжидаетЧто(РезультатСинхронизации.ПользователейСоздано)
		.Равно(1, "Автор создан");

КонецПроцедуры

