// Подготовка (моки поиска и зеркалирования задачи)

// Находит или создаёт внешнюю систему GitLab для мок-тестов и записывает
// в безопасное хранилище тестовый токен.
//
Функция ВнешняяСистемаМок()

	БазовыйURL = "https://gitlab.example.com";

	Ссылка = ВнешняяСистемаПоБазовомуURL(БазовыйURL);

	Если Ссылка.Пустая() Тогда
		Объект = Справочники.ВнешниеСистемыТикетов.СоздатьЭлемент();
		Объект.Наименование = "GitLab: gitlab.example.com (мок тесты зеркала)";
		Объект.БазовыйURL   = БазовыйURL;
		Объект.ТипСистемы   = Справочники.ТипыСистемТикетов.GitLab;
		Объект.Записать();
		Ссылка = Объект.Ссылка;
	КонецЕсли;

	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Ссылка, "test-token", "PRIVATE_TOKEN");

	Возврат Ссылка;

КонецФункции

// Удаляет данные предыдущих прогонов с тестовыми идентификаторами.
//
Процедура ОчиститьТестовыеДанные()

	УдалитьЗеркалоПоИдентификатору("Справочник.ГитлабЗадачи", 6001);
	УдалитьЗеркалоПоИдентификатору("Справочник.ГитлабПроекты", 3001);
	УдалитьЗеркалоПоИдентификатору("Справочник.ГитлабПользователи", 77);

КонецПроцедуры

// Удаляет элементы каталога зеркала с заданным идентификатором GitLab.
//
Процедура УдалитьЗеркалоПоИдентификатору(Знач ИмяТаблицы, Знач Идентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Т.Ссылка КАК Ссылка
		|ИЗ " + ИмяТаблицы + " КАК Т
		|ГДЕ Т.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Выборка.Ссылка.ПолучитьОбъект().Удалить();
	КонецЦикла;

КонецПроцедуры

// Создаёт задачу зеркала с владельцем-проектом по тестовым идентификаторам.
//
Функция СоздатьЗадачуЗеркала()

	Проект = Справочники.ГитлабПроекты.СоздатьЭлемент();
	Проект.Код           = "3001";
	Проект.Наименование  = "Проект А";
	Проект.Идентификатор = 3001;
	Проект.ПутьПолный    = "grp/prj";
	Проект.ВебURL        = ВебURLПроекта();
	Проект.Записать();

	Задача = Справочники.ГитлабЗадачи.СоздатьЭлемент();
	Задача.Владелец      = Проект.Ссылка;
	Задача.Код           = "7";
	Задача.Наименование  = "Сборка отчёта";
	Задача.Идентификатор = 6001;
	Задача.ВебURL        = ВебURLЗадачи();
	Задача.Записать();

	Возврат Задача.Ссылка;

КонецФункции

Функция ВебURLПроекта()

	Возврат "https://gitlab.example.com/grp/prj";

КонецФункции

Функция ВебURLЗадачи()

	Возврат "https://gitlab.example.com/grp/prj/-/issues/7";

КонецФункции

// Тело GET /api/v4/projects/3001/issues?iids[]=7 (массив задач, как
// возвращает список с фильтром - ПолучитьЗадачуПоПроектуИIID берёт первую).
//
Функция ОтветЗадача()

	JSONСтрока =
		"[{"
		+ """id"": 6001, "
		+ """iid"": 7, "
		+ """project_id"": 3001, "
		+ """title"": ""Сборка отчёта"", "
		+ """description"": ""Описание задачи"", "
		+ """state"": ""opened"", "
		+ """web_url"": """ + ВебURLЗадачи() + """, "
		+ """author"": {"
		+ """id"": 77, "
		+ """username"": ""author_user"", "
