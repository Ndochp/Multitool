// Живой сценарий ЛУРВ запускается только при явном разрешении: маркер
// build/secrets/live-run.flag. Без него тест пропускается, чтобы обычный
// прогон не трогал реальное API и не пересоздавал документ.
//
Функция МаркерЖивогоСценарияУстановлен()

	Пути = Новый Массив;
	Пути.Добавить("build\secrets\live-run.flag");
	Пути.Добавить(".\build\secrets\live-run.flag");
	Пути.Добавить("..\build\secrets\live-run.flag");

	Для Каждого Путь Из Пути Цикл
		Если ФайлСуществует(Путь) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Архивирует все внешние системы, кроме реальной (gt.rosinkas.ru): фасад
// сбора опрашивает все неархивные системы, а система с неподдерживаемым
// типом (старые тестовые артефакты) роняет сбор. Архивируем, а не удаляем —
// мок-тесты находят свои системы повторно и используют их без опроса фасадом.
//
Процедура АрхивироватьСистемыКромеРеальной()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.БазовыйURL КАК БазовыйURL
		|ИЗ Справочник.ВнешниеСистемыТикетов КАК Т";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.БазовыйURL = "https://gt.rosinkas.ru" Тогда
			Продолжить;
		КонецЕсли;
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.Архивная = Истина;
		Объект.Записать();
	КонецЦикла;

КонецПроцедуры

// Удаляет документы ЛУРВ за указанный день (ЛУР-015 запрещает дубль на дату).
//
Процедура УдалитьЛУРВНаДату(Знач ДатаДня)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Т.Ссылка КАК Ссылка
		|ИЗ Документ.ЛУРВ КАК Т
		|ГДЕ Т.Дата МЕЖДУ &Начало И &Конец";
	Запрос.УстановитьПараметр("Начало", НачалоДня(ДатаДня));
	Запрос.УстановитьПараметр("Конец", КонецДня(ДатаДня));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Выборка.Ссылка.ПолучитьОбъект().Удалить();
	КонецЦикла;

КонецПроцедуры

// Пишет резюме живого сценария ЛУРВ: документ, строки, тикеты.
// Файл для просмотра: build/out/yaxunit/lurv-live-summary.txt
//
Процедура ЗаписатьРезюмеЛУРВ(Знач ДокОбъект, Знач Сбор, Знач Заполнение)

	Резюме = Новый Массив;
	Резюме.Добавить("Живой сценарий 03.11.2026, реальное API gt.rosinkas.ru");
	Резюме.Добавить("Документ: Документ.ЛУРВ " + Строка(ДокОбъект.Ссылка)
		+ " (Дата " + Формат(ДокОбъект.Дата, "ДЛФ=DT") + ")");
	Резюме.Добавить("НачалоРаботы: " + Формат(ДокОбъект.НачалоРаботы, "ДЛФ=DT"));
	Резюме.Добавить("Таймлогов получено: " + Сбор.Таймлоги.Количество()
		+ " (в документ добавлено " + Заполнение.Добавлено + ")");
	Если Сбор.НеОтветившиеСистемы.Количество() > 0 Тогда
		Резюме.Добавить("НЕ ответившие системы: " + Сбор.НеОтветившиеСистемы.Количество());
	КонецЕсли;
	Резюме.Добавить("Строки ОтчетЗаДень:");

	Для Каждого Строка Из ДокОбъект.ОтчетЗаДень Цикл
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Строка.Тикет,
			"Наименование, ВнешнийИдентификатор, СсылкаНаВнешнийТикет");
		Резюме.Добавить("  "
			+ Формат(Строка.Начало, "ДЛФ=T") + " - " + Формат(Строка.Окончание, "ДЛФ=T")
			+ " | " + Реквизиты.Наименование
			+ " | " + Строка.Описание
			+ " | " + Формат(Строка.Длительность / 3600, "ЧДЦ=2") + " ч");
		Резюме.Добавить("      тикет: " + Строка(Строка.Тикет)
			+ ", внешний id: " + Реквизиты.ВнешнийИдентификатор
			+ ", url: " + Реквизиты.СсылкаНаВнешнийТикет);
	КонецЦикла;

	Каталог = "build\out\yaxunit";
	СоздатьКаталог(Каталог);

	Запись = Новый ЗаписьТекста(Каталог + "\lurv-live-summary.txt", КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(СтрСоединить(Резюме, Символы.ПС));
	Запись.Закрыть();

КонецПроцедуры

