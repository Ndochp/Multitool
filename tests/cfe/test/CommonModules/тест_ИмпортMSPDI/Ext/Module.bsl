// yaxUnit-тесты слоя 2 импорта MSPDI подсистемы Проджект
// (ОбщийМодуль.ИмпортMSPDI, разделы 4.6 и 6 документации).
// ИБ-тесты: yaxUnit запускает их в транзакциях (ВТранзакции: true),
// записи не сохраняются между тестами - каждый тест сам вызывает Загрузить.
// Фикстура - общая с тест_ОбменMSProject (экспортирована оттуда).

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Загрузка MSPDI в ИБ")
			.ДобавитьТест("ТЕСТ_Загрузка_ПроектИКалендарь")
			.ДобавитьТест("ТЕСТ_Загрузка_ЗадачиСвязиНазначения")
			.ДобавитьТест("ТЕСТ_Загрузка_ПовторныйИдемпотентна")
	;

КонецПроцедуры

#Область Тесты

Процедура ТЕСТ_Загрузка_ПроектИКалендарь() Экспорт

	Результат = ЗагрузитьПоФикстуре();

	ЮТест.ОжидаетЧто(Результат.Проект.Пустая())
		.Равно(Ложь, "Проект создан по UID");
	ОбъектПроекта = Результат.Проект.ПолучитьОбъект();
	ЮТест.ОжидаетЧто(ОбъектПроекта.Наименование)
		.Равно("Тестовый проект", "Наименование из Title");
	ЮТест.ОжидаетЧто(ОбъектПроекта.UID)
		.Равно("11111111-1111-1111-1111-111111111111", "UID сохранён");
	ЮТест.ОжидаетЧто(ОбъектПроекта.StartDate)
		.Равно(Дата(2026, 11, 9, 8, 0, 0), "Дата начала");
	ЮТест.ОжидаетЧто(ОбъектПроекта.FinishDate)
		.Равно(Дата(1, 1, 1), "FinishDate в файле нет - пустая дата");
	ЮТест.ОжидаетЧто(ОбъектПроекта.MinutesPerDay)
		.Равно(480, "Минут в дне");
	ЮТест.ОжидаетЧто(ОбъектПроекта.MinutesPerWeek)
		.Равно(2400, "Минут в неделе");
	ЮТест.ОжидаетЧто(ОбъектПроекта.DaysPerMonth)
		.Равно(20, "Дней в месяце");
	ЮТест.ОжидаетЧто(ОбъектПроекта.CurrencyCode)
		.Равно("RUB", "Валюта");

	// Календарь проекта найден по UID из файла.
	ОбъектКалендаря = ОбъектПроекта.Calendar.ПолучитьОбъект();
	ЮТест.ОжидаетЧто(ОбъектКалендаря.UID)
		.Равно("22222222-2222-2222-2222-222222222222", "Календарь записан по UID");
	ЮТест.ОжидаетЧто(ОбъектКалендаря.Наименование)
		.Равно("Стандартный", "Имя календаря");
	ЮТест.ОжидаетЧто(ОбъектКалендаря.IsBaseCalendar)
		.Равно(Истина, "Признак базового календаря");
	ЮТест.ОжидаетЧто(ОбъектКалендаря.WeekDays.Количество())
		.Равно(2, "Два дня недели из файла");
	СтрокаДня = ОбъектКалендаря.WeekDays[0];
	ЮТест.ОжидаетЧто(СтрокаДня.DayType)
		.Равно(1, "DayType 2 MSPDI -> день 1");
	ЮТест.ОжидаетЧто(СтрокаДня.DayWorking)
		.Равно(Истина, "День рабочий");
	ЮТест.ОжидаетЧто(СтрокаДня.FromTime1)
		.Равно(Дата(1, 1, 1, 8, 0, 0), "Первый интервал с 8:00");
	ЮТест.ОжидаетЧто(СтрокаДня.ToTime2)
		.Равно(Дата(1, 1, 1, 17, 0, 0), "Второй интервал до 17:00");
	ЮТест.ОжидаетЧто(ОбъектКалендаря.Exceptions.Количество())
		.Равно(1, "Исключение Type 9 пропущено (только Type 1)");
	СтрокаИсключения = ОбъектКалендаря.Exceptions[0];
	ЮТест.ОжидаетЧто(СтрокаИсключения.Name)
		.Равно("Новый год", "Имя исключения");
	ЮТест.ОжидаетЧто(СтрокаИсключения.FromDate)
		.Равно(Дата(2027, 1, 1), "Дата исключения");
	ЮТест.ОжидаетЧто(СтрокаИсключения.DayWorking)
		.Равно(Ложь, "День нерабочий");

КонецПроцедуры

Процедура ТЕСТ_Загрузка_ЗадачиСвязиНазначения() Экспорт

	Результат = ЗагрузитьПоФикстуре();

	ЮТест.ОжидаетЧто(Результат.Задачи.Количество())
		.Равно(3, "Три работы");

	// Сводная верхнего уровня.
	СсылкаЭтапа = Результат.Задачи.Получить("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa");
	ЮТест.ОжидаетЧто(СсылкаЭтапа)
		.НеРавно(Неопределено, "Задача Этап найдена по UID");
	ОбъектЭтапа = СсылкаЭтапа.ПолучитьОбъект();
	ЮТест.ОжидаетЧто(ОбъектЭтапа.Наименование)
		.Равно("Этап", "Наименование работы");
	ЮТест.ОжидаетЧто(ОбъектЭтапа.Summary)
		.Равно(Истина, "Признак сводной");
	ЮТест.ОжидаетЧто(ОбъектЭтапа.Родитель)
		.Равно(Справочники.Работы.ПустаяСсылка(), "Уровень 1 - без родителя");
	ЮТест.ОжидаетЧто(ОбъектЭтапа.Владелец)
		.Равно(Результат.Проект, "Работа подчинена проекту");

	// Родитель по стеку OutlineLevel, поля задачи.
	ОбъектЗадачиА = Результат.Задачи
		.Получить("bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb").ПолучитьОбъект();
	ЮТест.ОжидаетЧто(ОбъектЗадачиА.Родитель)
		.Равно(СсылкаЭтапа, "Родитель - ближайшая сводная уровнем выше");
	ЮТест.ОжидаетЧто(ОбъектЗадачиА.OutlineLevel)
		.Равно(2, "Уровень структуры");
	ЮТест.ОжидаетЧто(ОбъектЗадачиА.Duration)
		.Равно(480, "Длительность PT8H0M0S -> 480 минут");
	ЮТест.ОжидаетЧто(ОбъектЗадачиА.Start)
		.Равно(Дата(2026, 11, 9, 8, 0, 0), "Начало");
	ЮТест.ОжидаетЧто(ОбъектЗадачиА.Critical)
		.Равно(Истина, "Признак критической");
	ЮТест.ОжидаетЧто(ОбъектЗадачиА.IsActive)
		.Равно(Истина, "Активная (Active 1)");

	// Веха с ограничением.
	ОбъектВехи = Результат.Задачи
		.Получить("cccccccc-cccc-cccc-cccc-cccccccccccc").ПолучитьОбъект();
	ЮТест.ОжидаетЧто(ОбъектВехи.Milestone)
		.Равно(Истина, "Признак вехи");
	ЮТест.ОжидаетЧто(ОбъектВехи.ConstraintDate)
		.Равно(Дата(2026, 11, 10, 8, 0, 0), "Дата ограничения");

	// Связи по UID -> ссылкам.
	ЮТест.ОжидаетЧто(ОбъектЗадачиА.Predecessors.Количество())
		.Равно(2, "Две связи предшествования");
	СтрокаСвязи = ОбъектЗадачиА.Predecessors[0];
	ЮТест.ОжидаетЧто(СтрокаСвязи.Task)
		.Равно(ОбъектВехи.Ссылка, "Предшественник найден по UID");
	ЮТест.ОжидаетЧто(СтрокаСвязи.LinkType)
		.Равно(1, "Тип связи из файла");
	ЮТест.ОжидаетЧто(СтрокаСвязи.Lag)
		.Равно(120, "Лаг 1200 десятых минуты -> 120 минут");
	ЮТест.ОжидаетЧто(ОбъектЗадачиА.Predecessors[1].Task)
		.Равно(СсылкаЭтапа, "Вторая связь - на Этап");

	// Назначения.
	ЮТест.ОжидаетЧто(ОбъектЗадачиА.Assignments.Количество())
		.Равно(1, "Одно назначение");
	СтрокаНазначения = ОбъектЗадачиА.Assignments[0];
	ЮТест.ОжидаетЧто(СтрокаНазначения.Resource)
		.Равно(Результат.Ресурсы.Получить("eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee"),
			"Ресурс назначен по UID");
	ЮТест.ОжидаетЧто(СтрокаНазначения.Units)
		.Равно(50, "Доля 0.5 -> 50%");
	ЮТест.ОжидаетЧто(СтрокаНазначения.Work)
		.Равно(240, "Труд PT4H0M0S -> 240 минут");

	// Ресурсы подчинены проекту, конвертации долей и активности.
	ЮТест.ОжидаетЧто(Результат.Ресурсы.Количество())
		.Равно(2, "Два ресурса");
	ОбъектРесурса = Результат.Ресурсы
		.Получить("eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee").ПолучитьОбъект();
	ЮТест.ОжидаетЧто(ОбъектРесурса.Наименование)
		.Равно("Иванов", "Имя ресурса");
	ЮТест.ОжидаетЧто(ОбъектРесурса.Владелец)
		.Равно(Результат.Проект, "Ресурс подчинён проекту");
	ЮТест.ОжидаетЧто(ОбъектРесурса.MaxUnits)
		.Равно(100, "Максимум единиц 1 -> 100%");
	ЮТест.ОжидаетЧто(ОбъектРесурса.IsActive)
		.Равно(Истина, "Активный (IsInactive 0)");
	ОбъектМатериала = Результат.Ресурсы
		.Получить("ffffffff-ffff-ffff-ffff-ffffffffffff").ПолучитьОбъект();
	ЮТест.ОжидаетЧто(ОбъектМатериала.IsActive)
		.Равно(Ложь, "Неактивный (IsInactive 1)");
	ЮТест.ОжидаетЧто(ОбъектМатериала.MaterialLabel)
		.Равно("кг", "Единица материала");

КонецПроцедуры

Процедура ТЕСТ_Загрузка_ПовторныйИдемпотентна() Экспорт

	РезультатПервый = ЗагрузитьПоФикстуре();
	РезультатВторой = ЗагрузитьПоФикстуре();

	ЮТест.ОжидаетЧто(РезультатВторой.Проект)
		.Равно(РезультатПервый.Проект, "Проект переиспользован по UID");
	ЮТест.ОжидаетЧто(РезультатВторой.Задачи.Количество())
		.Равно(3, "Дубликатов работ нет");
	ЮТест.ОжидаетЧто(РезультатВторой.Ресурсы.Количество())
		.Равно(2, "Дубликатов ресурсов нет");
	ОбъектЗадачиА = РезультатВторой.Задачи
		.Получить("bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb").ПолучитьОбъект();
	ЮТест.ОжидаетЧто(ОбъектЗадачиА.Assignments.Количество())
		.Равно(1, "Назначения не задвоились");
	ЮТест.ОжидаетЧто(ОбъектЗадачиА.Predecessors.Количество())
		.Равно(2, "Связи не задвоились");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разбирает фикстуру (общая с тест_ОбменMSProject) и загружает в ИБ.
Функция ЗагрузитьПоФикстуре()

	Данные = ОбменMSProject.Разобрать(тест_ОбменMSProject.Фикстура());
	Возврат ИмпортMSPDI.Загрузить(Данные);

КонецФункции

#КонецОбласти
