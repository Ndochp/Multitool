// yaxUnit-тесты календарной математики подсистемы Проджект
// (ОбщийМодуль.КалендариПроектов). Чистые функции проверяются на структуре
// «Стандартный» календаря (Пн-Пт 8:00-12:00, 13:00-17:00), чтение из базы -
// на паре базовый/ресурсный календарь справочника ГрафикиРаботы.
//
// 2026-11-09 = понедельник той недели, что используется в тестах.

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Стандартный календарь")
			.ДобавитьТест("ТЕСТ_БудниРабочие_ВыходныеНет")
			.ДобавитьТест("ТЕСТ_ЭтоРабочийМомент_ГраницыИнтервалов")
			.ДобавитьТест("ТЕСТ_СледующийРабочийМомент_ОбедИВыходные")
			.ДобавитьТест("ТЕСТ_ДобавитьРабочиеМинуты_ПереносЧерезОбедИВыходные")
			.ДобавитьТест("ТЕСТ_ДобавитьРабочиеМинуты_ВосьмичасовойДень")
			.ДобавитьТест("ТЕСТ_ОтнятьРабочиеМинуты_ПереносЧерезОбедИВыходные")
			.ДобавитьТест("ТЕСТ_РабочиеМинутыМежду_СуткиИНерабочиеОтрезки")
		.ДобавитьТестовыйНабор("Исключения календаря")
			.ДобавитьТест("ТЕСТ_Исключение_НерабочийПраздникПропускается")
			.ДобавитьТест("ТЕСТ_Исключение_РабочаяСуббота")
		.ДобавитьТестовыйНабор("Чтение календаря из базы")
			.ДобавитьТест("ТЕСТ_КалендарьПоСсылке_НаследованиеОтБазового")
	;

КонецПроцедуры

