КонецПроцедуры

Процедура ТЕСТ_КалендарьПоСсылке_НаследованиеОтБазового() Экспорт

	// Базовый: Пн-Пт 8-12, 13-17, исключение - пятница 13.11 нерабочая.
	Базовый = Справочники.ГрафикиРаботы.СоздатьЭлемент();
	Базовый.Наименование = "тест_Проджект_Базовый_" + Строка(Новый УникальныйИдентификатор);
	Базовый.IsBaseCalendar = Истина;
	ЗаполнитьНеделюСтандартной(Базовый.WeekDays);
	СтрокаИсключения = Базовый.Exceptions.Добавить();
	СтрокаИсключения.Name = "тест_Праздник";
	СтрокаИсключения.FromDate = Дата(2026, 11, 13);
	СтрокаИсключения.ToDate = Дата(2026, 11, 13);
	СтрокаИсключения.DayWorking = Ложь;
	Базовый.Записать();

	// Ресурсный: суббота рабочая 9:00-13:00, остальное - наследует.
	Ресурсный = Справочники.ГрафикиРаботы.СоздатьЭлемент();
	Ресурсный.Наименование = "тест_Проджект_Ресурсный_" + Строка(Новый УникальныйИдентификатор);
	Ресурсный.IsBaseCalendar = Ложь;
	Ресурсный.BaseCalendar = Базовый.Ссылка;
	СтрокаСубботы = Ресурсный.WeekDays.Добавить();
	СтрокаСубботы.DayType = 6;
	СтрокаСубботы.DayWorking = Истина;
	СтрокаСубботы.FromTime1 = Дата(1, 1, 1, 9, 0, 0);
	СтрокаСубботы.ToTime1 = Дата(1, 1, 1, 13, 0, 0);
	Ресурсный.Записать();

	Календарь = КалендариПроектов.КалендарьПоСсылке(Ресурсный.Ссылка);

	ЮТест.ОжидаетЧто(КалендариПроектов.ЭтоРабочийДень(Календарь, Дата(2026, 11, 10)))
		.Равно(Истина, "Будни наследованы от базового");
	ЮТест.ОжидаетЧто(КалендариПроектов.ЭтоРабочийДень(Календарь, Дата(2026, 11, 14)))
		.Равно(Истина, "Суббота своя - рабочая");
	ЮТест.ОжидаетЧто(КалендариПроектов.ЭтоРабочийДень(Календарь, Дата(2026, 11, 13)))
		.Равно(Ложь, "Исключение базового наследовано - пятница нерабочая");
	ЮТест.ОжидаетЧто(КалендариПроектов.ДобавитьРабочиеМинуты(Календарь, Дата(2026, 11, 12, 16, 55, 0), 10))
		.Равно(Дата(2026, 11, 14, 9, 5, 0), "Через нерабочую пятницу в субботу");

	УдалитьКалендарь(Ресурсный.Ссылка);
	УдалитьКалендарь(Базовый.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИсключениеДня(ДатаС, ДатаПо, Рабочий, ЧасС = 0, ЧасПо = 0)

	ОписаниеИсключения = Новый Структура("С, По, Рабочий, Интервалы", ДатаС, ДатаПо, Рабочий, Новый Массив);
	Если Рабочий Тогда
		ОписаниеИсключения.Интервалы.Добавить(Новый Структура("Начало, Конец", ЧасС * 3600, ЧасПо * 3600));
	КонецЕсли;
	Возврат ОписаниеИсключения;

КонецФункции

// Заполняет таблицу WeekDays стандартной неделей Пн-Пт 8:00-12:00, 13:00-17:00.
Процедура ЗаполнитьНеделюСтандартной(Таблица)

	Для НомерДня = 1 По 7 Цикл
		Строка = Таблица.Добавить();
		Строка.DayType = НомерДня;
		Строка.DayWorking = (НомерДня <= 5);
		Если НомерДня <= 5 Тогда
			Строка.FromTime1 = Дата(1, 1, 1, 8, 0, 0);
			Строка.ToTime1 = Дата(1, 1, 1, 12, 0, 0);
			Строка.FromTime2 = Дата(1, 1, 1, 13, 0, 0);
			Строка.ToTime2 = Дата(1, 1, 1, 17, 0, 0);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура УдалитьКалендарь(Ссылка)

	Объект = Ссылка.ПолучитьОбъект();
	Объект.Удалить();

КонецПроцедуры

#КонецОбласти
