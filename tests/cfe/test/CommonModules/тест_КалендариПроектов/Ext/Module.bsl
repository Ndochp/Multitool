Процедура ТЕСТ_БудниРабочие_ВыходныеНет() Экспорт

	Календарь = КалендариПроектов.СтандартныйКалендарь();

	ЮТест.ОжидаетЧто(КалендариПроектов.ЭтоРабочийДень(Календарь, Дата(2026, 11, 9)))
		.Равно(Истина, "Понедельник рабочий");
	ЮТест.ОжидаетЧто(КалендариПроектов.ЭтоРабочийДень(Календарь, Дата(2026, 11, 13)))
		.Равно(Истина, "Пятница рабочая");
	ЮТест.ОжидаетЧто(КалендариПроектов.ЭтоРабочийДень(Календарь, Дата(2026, 11, 14)))
		.Равно(Ложь, "Суббота нерабочая");
	ЮТест.ОжидаетЧто(КалендариПроектов.ЭтоРабочийДень(Календарь, Дата(2026, 11, 15)))
		.Равно(Ложь, "Воскресенье нерабочее");

