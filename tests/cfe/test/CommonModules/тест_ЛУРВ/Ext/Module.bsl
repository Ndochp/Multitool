	Документ = Документы.ЛУРВ.СоздатьДокумент();
	Документ.НачалоРаботы = Дата(2024, 1, 15, 9, 0, 0);
	Тикет = СоздатьТикет("ЗадачаА" + СуффиксТеста(), Истина);
	ТикетБ = СоздатьТикет("ЗадачаБ" + СуффиксТеста(), Истина);

	Строка1 = ДобавитьСтроку(Документ, Тикет, "2024-01-15 09:00:00", "2024-01-15 12:00:00");

	// Добавление новой строки в конец (UC-03: переключение задачи).
	Документ.СоздатьСтроку(ТикетБ, Дата(2024, 1, 15, 12, 30, 0));

	ЮТест.ОжидаетЧто(Строка1.Начало, "Начало первой строки не затёрто")
		.Равно(Дата(2024, 1, 15, 9, 0, 0));
	ЮТест.ОжидаетЧто(Строка1.Окончание, "Границы зафиксированной строки сохранены")
		.Равно(Дата(2024, 1, 15, 12, 0, 0));
	ЮТест.ОжидаетЧто(Строка1.Длительность, "Длительность первой сохранена")
		.Равно(3 * 60 * 60);
	ЮТест.ОжидаетЧто(Документ.ОтчетЗаДень[1].Начало, "Новая строка начинается с окончания первой")
		.Равно(Дата(2024, 1, 15, 12, 0, 0));

КонецПроцедуры

