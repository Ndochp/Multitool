		.Равно(Дата(2024, 1, 15, 11, 0, 0));

КонецПроцедуры

// UC-00 шаг 5: при изменении начала строки у предыдущей меняется ТОЛЬКО
// окончание — её начало и длительность сохраняются. Воспроизводит баг:
// добавление новой строки в форме затирало начало предыдущей (первой) строки
// и обнуляло длительность.
Процедура ТЕСТ_ЛУР014_ИзменениеНачалаНеЗатираетНачалоПредыдущей() Экспорт

	Документ = Документы.ЛУРВ.СоздатьДокумент();
	Тикет = СоздатьТикет("ЗадачаА" + СуффиксТеста(), Истина);

	Строка1 = ДобавитьСтроку(Документ, Тикет, "2024-01-15 09:00:00", "2024-01-15 12:00:00");
	Строка2 = ДобавитьСтроку(Документ, Тикет, "2024-01-15 12:00:00", "");
	// Новая строка формы имеет пустое окончание (открытый интервал).
	Строка2.Окончание = Дата(1, 1, 1);

	// Путь формы при правке начала добавленной строки (ЛУРВКлиентСервер).
	Строка2.Начало = Дата(2024, 1, 15, 14, 0, 0);
	ЛУРВКлиентСервер.ОбработатьИзменениеНачала(Документ.ОтчетЗаДень, 1);

	ЮТест.ОжидаетЧто(Строка1.Начало, "Начало предыдущей строки не затёрто")
		.Равно(Дата(2024, 1, 15, 9, 0, 0));
	ЮТест.ОжидаетЧто(Строка1.Окончание, "Окончание предыдущей = новое начало текущей")
		.Равно(Дата(2024, 1, 15, 14, 0, 0));
	ЮТест.ОжидаетЧто(Строка1.Длительность, "Длительность предыдущей пересчитана по границам")
		.Равно(5 * 60 * 60);

КонецПроцедуры

// UC-00 шаг 7 + UC-03: правка окончания строки (в том числе ложная дельта
// при интерактивном добавлении строки) не затирает начало предыдущей строки.
// Воспроизводит сценарий формы: строка добавлена (Начало = момент, окончание
// пусто), ПриИзменении сравнило её с прошлыми значениями другой строки и
// вызвало пересчёт окончания для последней строки.
Процедура ТЕСТ_ЛУР014_ИзменениеОкончанияНеЗатираетНачалоПредыдущей() Экспорт

	Документ = Документы.ЛУРВ.СоздатьДокумент();
	Тикет = СоздатьТикет("ЗадачаА" + СуффиксТеста(), Истина);

	Строка1 = ДобавитьСтроку(Документ, Тикет, "2024-01-15 09:00:00", "2024-01-15 12:00:00");
	Строка2 = ДобавитьСтроку(Документ, Тикет, "2024-01-15 12:00:00", "2024-01-15 12:00:00");
	// Интерактивно добавленная строка: окончание пустое (открытая).
	Строка2.Окончание = Дата(1, 1, 1);

	// Путь формы: интерактивное добавление строки — пересчёт окончания
	// для добавленной (последней) строки.
	ЛУРВКлиентСервер.ОбработатьИзменениеОкончания(Документ.ОтчетЗаДень, 1);

	ЮТест.ОжидаетЧто(Строка1.Начало, "Начало предыдущей строки не затёрто")
		.Равно(Дата(2024, 1, 15, 9, 0, 0));
	ЮТест.ОжидаетЧто(Строка1.Окончание, "Окончание предыдущей строки сохранено")
		.Равно(Дата(2024, 1, 15, 12, 0, 0));
	ЮТест.ОжидаетЧто(Строка1.Длительность, "Длительность предыдущей строки сохранена")
		.Равно(3 * 60 * 60);
	ЮТест.ОжидаетЧто(Строка2.Длительность, "Открытая строка: нулевая длительность")
		.Равно(0);
	ЮТест.ОжидаетЧто(ПустаяДата(Строка2.Окончание), "Открытая строка: окончание остаётся пустым")
		.Равно(Истина);

КонецПроцедуры

// UC-00 шаги 3 и 10: добавление новой строки не меняет границ уже
// зафиксированных строк. Воспроизводит баг затирания начала первой строки.
