#Область СлужебныеПроцедурыИФункции

// Признак пустой (незаполненной) даты.
Функция ПустаяДата(Значение)

	Возврат НЕ ЗначениеЗаполнено(Значение);

КонецФункции

// Помечает на удаление все документы ЛУРВ с началом работы в указанный день —
// защита от остатков предыдущих прогонов (тесты выполняются без транзакций).
Процедура ОчиститьДокументыНаДату(Знач ДатаДня)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЛУРВ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЛУРВ КАК ЛУРВ
	|ГДЕ
	|	ЛУРВ.НачалоРаботы >= &НачалоДня
	|	И ЛУРВ.НачалоРаботы < &КонецДня";
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ДатаДня));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ДатаДня) + 1);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.ПометкаУдаления = Истина;
		Объект.Записать();
	КонецЦикла;

КонецПроцедуры

// Преобразует строковый фрагмент времени в число ("09" -> 9).
Функция ЧислоИзСтроки(Значение)

	Возврат Число(СокрЛП(Значение));

КонецФункции

Функция СуффиксТеста()

	Возврат "_ТЕСТ";

КонецФункции

// Создаёт тикет с признаком интеграции типа внешней системы.
Функция СоздатьТикет(Наименование, ИмеетИнтеграцию)

	ТипСистемы = Справочники.ТипыСистемТикетов.СоздатьЭлемент();
	ТипСистемы.Наименование = "Тип_" + Наименование;
	ТипСистемы.ИмеетИнтеграцию = ИмеетИнтеграцию;
	ТипСистемы.Записать();

	ВнешняяСистема = Справочники.ВнешниеСистемыТикетов.СоздатьЭлемент();
	ВнешняяСистема.Наименование = "Система_" + Наименование;
	ВнешняяСистема.ТипСистемы = ТипСистемы.Ссылка;
	ВнешняяСистема.Записать();

	Тикет = Справочники.Тикеты.СоздатьЭлемент();
	Тикет.Наименование = Наименование;
	Тикет.ВнешняяСистема = ВнешняяСистема.Ссылка;
	Тикет.Записать();

	Возврат Тикет.Ссылка;

КонецФункции

Функция ДобавитьСтроку(Документ, Тикет, Начало, Окончание)

	Строка = Документ.ОтчетЗаДень.Добавить();
	Строка.Тикет = Тикет;
	Строка.Начало = ДатаИзСтроки(Начало);
	Строка.Окончание = ДатаИзСтроки(Окончание);
	Строка.Длительность = ДлительностьСтроки(Строка);

	Возврат Строка;

КонецФункции

Функция ДатаИзСтроки(Значение)

	Возврат Дата(2024, 1, 15) + Цел(ЧислоСекундИзСтроки(Значение));

КонецФункции

Функция ЧислоСекундИзСтроки(Значение)

	// Значение вида "2024-01-15 09:00:00" — возвращаем секунды от начала суток.
	Части = СтрРазделить(Значение, " ", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат 0;
	КонецЕсли;

	Время = СтрРазделить(Части[1], ":", Ложь);
	Часы = ЧислоИзСтроки(Время[0]);
	Минуты = ?(Время.Количество() > 1, ЧислоИзСтроки(Время[1]), 0);
	Секунды = ?(Время.Количество() > 2, ЧислоИзСтроки(Время[2]), 0);

	Возврат Часы * 60 * 60 + Минуты * 60 + Секунды;

КонецФункции

Функция ДлительностьСтроки(Строка)

	Если Строка.Окончание <= Строка.Начало Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Строка.Окончание - Строка.Начало;

КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции