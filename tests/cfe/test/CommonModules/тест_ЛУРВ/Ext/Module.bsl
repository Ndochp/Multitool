// UC-00 шаг 15: начало следующей строки становится началом удаляемой.
Процедура ТЕСТ_ЛУР014_УдалениеПереноситНачалоСледующей() Экспорт

	Документ = Документы.ЛУРВ.СоздатьДокумент();
	ТикетА = СоздатьТикет("ЗадачаА" + СуффиксТеста(), Истина);
	ТикетБ = СоздатьТикет("ЗадачаБ" + СуффиксТеста(), Истина);
	ТикетВ = СоздатьТикет("ЗадачаВ" + СуффиксТеста(), Истина);

	Строка1 = ДобавитьСтроку(Документ, ТикетА, "2024-01-15 09:00:00", "2024-01-15 10:00:00");
	Строка2 = ДобавитьСтроку(Документ, ТикетБ, "2024-01-15 10:00:00", "2024-01-15 12:00:00");
	Строка3 = ДобавитьСтроку(Документ, ТикетВ, "2024-01-15 12:00:00", "2024-01-15 17:00:00");

	ДанныеУдаленной = Новый Структура(
		"Начало, Окончание, Тикет, Описание, СсылкаНаТаймлог, Длительность",
		Строка2.Начало, Строка2.Окончание, Строка2.Тикет,
		Строка2.Описание, Строка2.СсылкаНаТаймлог, Строка2.Длительность);

	Документ.ОтчетЗаДень.Удалить(1);
	Документ.ОбработатьУдалениеСтрокиНаСервере(1, ДанныеУдаленной);

	ЮТест.ОжидаетЧто(Документ.ОтчетЗаДень[1].Тикет, "Строка после удалённой стала на её место")
		.Равно(ТикетВ);
	ЮТест.ОжидаетЧто(Документ.ОтчетЗаДень[1].Начало, "Начало следующей = начало удаляемой")
		.Равно(Дата(2024, 1, 15, 10, 0, 0));
	ЮТест.ОжидаетЧто(Документ.ОтчетЗаДень[1].Окончание, "Окончание сохранено")
		.Равно(Дата(2024, 1, 15, 17, 0, 0));

КонецПроцедуры

// UC-00 шаг 15: удаление строки через общий модуль (путь формы) —
// начало следующей строки становится началом удаляемой, запись внешней
// системы переносится в первую строку с комментарием «к удалению».
Процедура ТЕСТ_ЛУР014_УдалениеЧерезКлиентСерверПереноситЗапись() Экспорт

	Документ = Документы.ЛУРВ.СоздатьДокумент();
	ТикетА = СоздатьТикет("ЗадачаА" + СуффиксТеста(), Истина);
	ТикетБ = СоздатьТикет("ЗадачаБ" + СуффиксТеста(), Истина);
	ТикетВ = СоздатьТикет("ЗадачаВ" + СуффиксТеста(), Истина);

	Строка1 = ДобавитьСтроку(Документ, ТикетА, "2024-01-15 09:00:00", "2024-01-15 10:00:00");
	Строка2 = ДобавитьСтроку(Документ, ТикетБ, "2024-01-15 10:00:00", "2024-01-15 12:00:00");
	Строка3 = ДобавитьСтроку(Документ, ТикетВ, "2024-01-15 12:00:00", "2024-01-15 17:00:00");
	Строка2.СсылкаНаТаймлог = "500";

	ДанныеУдаленной = Новый Структура(
		"Начало, Окончание, Тикет, Описание, СсылкаНаТаймлог, Длительность",
		Строка2.Начало, Строка2.Окончание, Строка2.Тикет,
		Строка2.Описание, Строка2.СсылкаНаТаймлог, Строка2.Длительность);

	Документ.ОтчетЗаДень.Удалить(1);
	ЛУРВКлиентСервер.ОбработатьУдалениеСтроки(Документ.ОтчетЗаДень, 1, ДанныеУдаленной);

	ЮТест.ОжидаетЧто(Документ.ОтчетЗаДень.Количество(), "Добавлена строка «к удалению»")
		.Равно(3);
	ЮТест.ОжидаетЧто(Документ.ОтчетЗаДень[0].Описание, "Перенесённая запись помечена «к удалению»")
		.Равно("к удалению");
	ЮТест.ОжидаетЧто(Документ.ОтчетЗаДень[0].СсылкаНаТаймлог, "Идентификатор записи внешней системы перенесён")
		.Равно("500");
	ЮТест.ОжидаетЧто(Документ.ОтчетЗаДень[0].Начало, "Начало перенесённой = окончание удаляемой")
		.Равно(Дата(2024, 1, 15, 12, 0, 0));
	ЮТест.ОжидаетЧто(Документ.ОтчетЗаДень[2].Тикет, "Строка после удалённой стала на её место")
		.Равно(ТикетВ);
	ЮТест.ОжидаетЧто(Документ.ОтчетЗаДень[2].Начало, "Начало следующей = начало удаляемой")
		.Равно(Дата(2024, 1, 15, 10, 0, 0));
	ЮТест.ОжидаетЧто(Документ.ОтчетЗаДень[2].Окончание, "Окончание сохранено")
		.Равно(Дата(2024, 1, 15, 17, 0, 0));

КонецПроцедуры

