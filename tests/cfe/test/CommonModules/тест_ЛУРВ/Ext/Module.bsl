	Документ.НачалоРаботы = НачалоДня(Дата(2024, 1, 15)) + 9 * 60 * 60;
	Строка = Документ.СоздатьСтроку();

	Документ.АвтопродлитьПоследнююСтроку(Дата(2024, 1, 15, 9, 7, 0));

	ЮТест.ОжидаетЧто(Строка.Окончание, "Автопродление обновило окончание последней строки")
		.Равно(Дата(2024, 1, 15, 9, 7, 0));
	ЮТест.ОжидаетЧто(Строка.Длительность, "Длительность = с начала до момента")
		.Равно(7 * 60);

