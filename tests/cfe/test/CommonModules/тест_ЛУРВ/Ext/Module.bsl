Процедура ТЕСТ_ЛУР004_ГруппировкаОднозадачныхСтрок() Экспорт

	Документ = Документы.ЛУРВ.СоздатьДокумент();
	Тикет = СоздатьТикет("ЗадачаА" + СуффиксТеста(), Истина);

	ДобавитьСтроку(Документ, Тикет, "2024-01-15 09:00:00", "2024-01-15 09:30:00");
	ДобавитьСтроку(Документ, Тикет, "2024-01-15 09:30:00", "2024-01-15 10:00:00");
	ДобавитьСтроку(Документ, Тикет, "2024-01-15 10:00:00", "2024-01-15 11:00:00");

	Группы = Документ.СгруппироватьСтрокиДляСинхронизации();

