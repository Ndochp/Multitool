// Smoke-тест (клиент): форма нового документа ЛУРВ открывается без ошибок.
// Серверные тесты не компилируют модуль формы, поэтому ошибки контекстов
// (например, обращение к клиентскому модулю из &НаСервере) видны только здесь.
Процедура ТЕСТ_ЛУРВ_ФормаДокументаОткрывается() Экспорт

	#Если Клиент Тогда
		Форма = ОткрытьФорму("Документ.ЛУРВ.Форма.ФормаДокумента");

		ЮТест.ОжидаетЧто(Форма, "Форма документа ЛУРВ открыта")
			.НеРавно(Неопределено);
