// UC-05: повторное завершение ничего не меняет.
Процедура ТЕСТ_ЛУР003_ПовторноеЗавершениеВозвращаетЛожь() Экспорт

	Документ = Документы.ЛУРВ.СоздатьДокумент();
	Документ.НачалоРаботы = Дата(2024, 1, 15, 9, 0, 0);
	Документ.ЗавершитьДень(Дата(2024, 1, 15, 18, 30, 0));

	Результат = Документ.ЗавершитьДень(Дата(2024, 1, 15, 19, 0, 0));

	ЮТест.ОжидаетЧто(Результат, "Повторное завершение возвращает Ложь")
		.Равно(Ложь);
	ЮТест.ОжидаетЧто(Документ.ОкончаниеРаботы, "Окончание дня не изменилось")
		.Равно(Дата(2024, 1, 15, 18, 30, 0));

