#Область ЛУР_001_СозданиеСтроки

// UC-00 шаг 3: первая строка начинается с даты начала рабочего дня.
Процедура ТЕСТ_ЛУР001_ПерваяСтрокаНачинаетсяСНачалаДня() Экспорт

	Документ = Документы.ЛУРВ.СоздатьДокумент();
	Документ.НачалоРаботы = НачалоДня(Дата(2024, 1, 15)) + 9 * 60 * 60;

	Строка = Документ.СоздатьСтроку();

	ЮТест.ОжидаетЧто(Строка.Начало, "Начало первой строки = начало рабочего дня")
		.Равно(Документ.НачалоРаботы);
	ЮТест.ОжидаетЧто(ПустаяДата(Строка.Окончание), "Открытая строка: окончание пустое")
		.Равно(Истина);
	ЮТест.ОжидаетЧто(Строка.Длительность, "Нулевая длительность у открытой строки")
		.Равно(0);

КонецПроцедуры

// UC-03: переключение задачи — предыдущая открытая строка фиксируется моментом.
Процедура ТЕСТ_ЛУР001_ВтораяСтрокаФиксируетПервую() Экспорт

	Документ = Документы.ЛУРВ.СоздатьДокумент();
	Документ.НачалоРаботы = НачалоДня(Дата(2024, 1, 15)) + 9 * 60 * 60;
	Первая = Документ.СоздатьСтроку();

	Момент = Дата(2024, 1, 15, 10, 30, 0);
	Вторая = Документ.СоздатьСтроку(Неопределено, Момент);

	ЮТест.ОжидаетЧто(Первая.Окончание, "Первая строка зафиксирована моментом переключения")
		.Равно(Момент);
	ЮТест.ОжидаетЧто(Вторая.Начало, "Вторая строка начинается с окончания первой")
		.Равно(Момент);
	ЮТест.ОжидаетЧто(ПустаяДата(Вторая.Окончание), "Новая строка открыта: окончание пустое")
		.Равно(Истина);
	ЮТест.ОжидаетЧто(Документ.ОтчетЗаДень.Количество())
		.Равно(2);

КонецПроцедуры

// UC-03: фиксация окончания открытой строки моментом (путь формы при
// добавлении новой строки). Повторный вызов зафиксированную строку не меняет.
Процедура ТЕСТ_ЛУР001_ЗафиксироватьОкончаниеСтроки() Экспорт

	Документ = Документы.ЛУРВ.СоздатьДокумент();
	Документ.НачалоРаботы = Дата(2024, 1, 15, 9, 0, 0);
	Строка = ДобавитьСтроку(Документ, Неопределено, "2024-01-15 09:00:00", "2024-01-15 09:00:00");
	Строка.Окончание = Дата(1, 1, 1);

	Момент = Дата(2024, 1, 15, 10, 30, 0);
	ЛУРВКлиентСервер.ЗафиксироватьОкончаниеСтроки(Документ.ОтчетЗаДень, 0, Момент);

	ЮТест.ОжидаетЧто(Строка.Окончание, "Окончание открытой строки зафиксировано моментом")
		.Равно(Момент);
	ЮТест.ОжидаетЧто(Строка.Длительность, "Длительность = с начала до момента")
		.Равно(90 * 60);

	ЛУРВКлиентСервер.ЗафиксироватьОкончаниеСтроки(Документ.ОтчетЗаДень, 0, Дата(2024, 1, 15, 11, 0, 0));

	ЮТест.ОжидаетЧто(Строка.Окончание, "Зафиксированная строка не перефиксируется")
		.Равно(Момент);

КонецПроцедуры

// UC-00 шаг 10: вставка в середину — нулевая длительность,
// начало = окончание строки, после которой вставляем.
Процедура ТЕСТ_ЛУР001_ВставкаВСередину() Экспорт

	Документ = Документы.ЛУРВ.СоздатьДокумент();
	Документ.НачалоРаботы = НачалоДня(Дата(2024, 1, 15)) + 9 * 60 * 60;
	Первая = Документ.СоздатьСтроку();
	Первая.Окончание = Дата(2024, 1, 15, 10, 0, 0);
	Документ.ОбработатьИзменениеОкончанияСтрокиНаСервере(0);

	Вторая = Документ.СоздатьСтроку();
	Вторая.Начало = Дата(2024, 1, 15, 10, 0, 0);
	Вторая.Окончание = Дата(2024, 1, 15, 12, 0, 0);
	Документ.ОбработатьИзменениеОкончанияСтрокиНаСервере(1);

	Вставленная = Документ.СоздатьСтроку(Неопределено, Дата(2024, 1, 15, 12, 0, 0), 0);

	ЮТест.ОжидаетЧто(Вставленная.Начало, "Начало вставленной строки = окончание строки, после которой вставляем")
		.Равно(Дата(2024, 1, 15, 10, 0, 0));
	ЮТест.ОжидаетЧто(Вставленная.Длительность, "Нулевая длительность у вставленной строки")
		.Равно(0);
	ЮТест.ОжидаетЧто(Документ.ОтчетЗаДень.Количество())
		.Равно(3);

КонецПроцедуры

#КонецОбласти // ЛУР_001_СозданиеСтроки

