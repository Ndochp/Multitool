// Smoke-тесты форм ЛУРВ (клиентский общий модуль).
// Серверные тесты не компилируют модуль формы, поэтому ошибки контекстов
// (обращение к клиентскому модулю из &НаСервере, «Переменная не определена»)
// ловятся только клиентским открытием формы.
// Создан через unica.apply (object.create + props.set) — XML вручную не правился.

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Smoke: формы")
			// Клиентский тест: только открытие формы компилирует модуль формы.
			.ДобавитьКлиентскийТест("ТЕСТ_ЛУРВ_ФормаДокументаОткрывается")
	;

КонецПроцедуры

// Smoke-тест (клиент): форма нового документа ЛУРВ открывается без ошибок.
Процедура ТЕСТ_ЛУРВ_ФормаДокументаОткрывается() Экспорт

	#Если Клиент Тогда
		Форма = ОткрытьФорму("Документ.ЛУРВ.Форма.ФормаДокумента");

		ЮТест.ОжидаетЧто(Форма, "Форма документа ЛУРВ открыта")
			.НеРавно(Неопределено);
		ЮТест.ОжидаетЧто(Форма.Объект.ОтчетЗаДень.Количество(),
			"UC-01: форма нового документа содержит первую строку")
			.Равно(1);
		ЮТест.ОжидаетЧто(ПустаяДата(Форма.Объект.ОтчетЗаДень[0].Окончание),
			"UC-01: окончание открытой строки пустое")
			.Равно(Истина);

		Форма.Модифицированность = Ложь;
		Форма.Закрыть();
	#КонецЕсли

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Признак пустой (незаполненной) даты.
Функция ПустаяДата(Значение)

	Возврат НЕ ЗначениеЗаполнено(Значение);

КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции
