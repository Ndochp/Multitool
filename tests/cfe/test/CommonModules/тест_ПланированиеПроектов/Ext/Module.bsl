// yaxUnit-тесты расчёта расписания подсистемы Проджект
// (ОбщийМодуль.ПланированиеПроектов, CPM - разделы 4.2-4.3 документации).
// Чистые функции: задачи задаются структурами, календарь - «Стандартный»
// (Пн-Пт 8:00-12:00, 13:00-17:00), база данных не используется.
//
// 2026-11-09 = понедельник; старт проекта 09.11.2026 8:00.

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Прямой проход")
			.ДобавитьТест("ТЕСТ_ЦепочкаСвязейFS_ДатыПоКалендарю")
			.ДобавитьТест("ТЕСТ_Веха_НулеваяДлительность")
			.ДобавитьТест("ТЕСТ_Lag_РабочимиМинутами")
			.ДобавитьТест("ТЕСТ_ОграничениеSNET")
		.ДобавитьТестовыйНабор("Обратный проход и резервы")
			.ДобавитьТест("ТЕСТ_КритическийПуть_РезервНоль")
			.ДобавитьТест("ТЕСТ_ПараллельнаяВетка_Резервы")
		.ДобавитьТестовыйНабор("Сводные и ошибки")
			.ДобавитьТест("ТЕСТ_СводнаяЗадача_АгрегацияИСвязь")
			.ДобавитьТест("ТЕСТ_ЦиклическаяСвязь_Исключение")
	;

КонецПроцедуры

#Область Тесты

Процедура ТЕСТ_ЦепочкаСвязейFS_ДатыПоКалендарю() Экспорт

	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("A", 480));
	СписокЗадач.Добавить(ЗадачаТеста("B", 480, Связи("A")));
	СписокЗадач.Добавить(ЗадачаТеста("C", 480, Связи("B")));

	Результат = Рассчитать(СписокЗадач);

	ЮТест.ОжидаетЧто(Результат["A"].Start)
		.Равно(Дата(2026, 11, 9, 8, 0, 0), "Первая задача - со старта проекта");
	ЮТест.ОжидаетЧто(Результат["A"].Finish)
		.Равно(Дата(2026, 11, 9, 17, 0, 0), "Длительность 480 мин по календарю");
	ЮТест.ОжидаетЧто(Результат["B"].Start)
		.Равно(Дата(2026, 11, 10, 8, 0, 0), "FS-связь переносит на следующее утро");
	ЮТест.ОжидаетЧто(Результат["C"].Start)
		.Равно(Дата(2026, 11, 11, 8, 0, 0), "Третья задача - на третий день");

КонецПроцедуры

Процедура ТЕСТ_Веха_НулеваяДлительность() Экспорт

	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("A", 480));
	СписокЗадач.Добавить(ЗадачаТеста("M", 0, Связи("A")));

	Результат = Рассчитать(СписокЗадач);

	ЮТест.ОжидаетЧто(Результат["M"].Start)
		.Равно(Дата(2026, 11, 10, 8, 0, 0), "Веха - утро после предшественника");
	ЮТест.ОжидаетЧто(Результат["M"].Finish)
		.Равно(Дата(2026, 11, 10, 8, 0, 0), "У вехи начало и конец совпадают");

КонецПроцедуры

Процедура ТЕСТ_Lag_РабочимиМинутами() Экспорт

	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("A", 480));
	СписокЗадач.Добавить(ЗадачаТеста("C", 60, Связи("A", 120)));

	Результат = Рассчитать(СписокЗадач);

	// EF(A) = пн 17:00; + 120 рабочих минут = вт 10:00 (обед не входит).
	ЮТест.ОжидаетЧто(Результат["C"].Start)
		.Равно(Дата(2026, 11, 10, 10, 0, 0), "Lag 120 рабочих минут от вечера пятницы-подобного дня");
	ЮТест.ОжидаетЧто(Результат["C"].Finish)
		.Равно(Дата(2026, 11, 10, 11, 0, 0), "Длительность 60 минут");

КонецПроцедуры

Процедура ТЕСТ_ОграничениеSNET() Экспорт

	Задача = ЗадачаТеста("A", 480);
	Задача.ConstraintType = 2; // SNET: старт не ранее даты
	Задача.ConstraintDate = Дата(2026, 11, 11, 8, 0, 0);

	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(Задача);

	Результат = Рассчитать(СписокЗадач);

	ЮТест.ОжидаетЧто(Результат["A"].Start)
		.Равно(Дата(2026, 11, 11, 8, 0, 0), "SNET сдвигает старт на среду");
	ЮТест.ОжидаетЧто(Результат["A"].Finish)
		.Равно(Дата(2026, 11, 11, 17, 0, 0), "Окончание по календарю");

КонецПроцедуры

Процедура ТЕСТ_КритическийПуть_РезервНоль() Экспорт

	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("A", 480));
	СписокЗадач.Добавить(ЗадачаТеста("B", 480, Связи("A")));
	СписокЗадач.Добавить(ЗадачаТеста("C", 480, Связи("B")));

	Результат = Рассчитать(СписокЗадач);

	ЮТест.ОжидаетЧто(Результат["A"].Critical)
		.Равно(Истина, "Первая задача цепочки критическая");
	ЮТест.ОжидаетЧто(Результат["B"].Critical)
		.Равно(Истина, "Средняя задача цепочки критическая");
	ЮТест.ОжидаетЧто(Результат["C"].Critical)
		.Равно(Истина, "Последняя задача цепочки критическая");
	ЮТест.ОжидаетЧто(Результат["A"].TotalSlack)
		.Равно(0, "Резерв критической цепочки нулевой");
	ЮТест.ОжидаетЧто(Результат["A"].FreeSlack)
		.Равно(0, "Преемник начинается сразу после предшественника");

КонецПроцедуры

Процедура ТЕСТ_ПараллельнаяВетка_Резервы() Экспорт

	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("A", 480));
	СписокЗадач.Добавить(ЗадачаТеста("B", 480, Связи("A")));
	СписокЗадач.Добавить(ЗадачаТеста("D", 60, Связи("A")));

	Результат = Рассчитать(СписокЗадач);

	ЮТест.ОжидаетЧто(Результат["D"].Start)
		.Равно(Дата(2026, 11, 10, 8, 0, 0), "Короткая ветка стартует после A");
	ЮТест.ОжидаетЧто(Результат["D"].Finish)
		.Равно(Дата(2026, 11, 10, 9, 0, 0), "И час спустя заканчивается");
	ЮТест.ОжидаетЧто(Результат["B"].Critical)
		.Равно(Истина, "Длинная ветка критическая");
	ЮТест.ОжидаетЧто(Результат["D"].Critical)
		.Равно(Ложь, "Короткая ветка не критическая");
	// LF(D) = финиш проекта = вт 17:00; EF(D) = вт 9:00;
	// резерв = рабочие минуты между 9:00 и 17:00 = 180 + 240 = 420.
	ЮТест.ОжидаетЧто(Результат["D"].TotalSlack)
		.Равно(420, "Резерв короткой ветки - вечер вторника");
	ЮТест.ОжидаетЧто(Результат["A"].Critical)
		.Равно(Истина, "Общий предшественник критический");

КонецПроцедуры

Процедура ТЕСТ_СводнаяЗадача_АгрегацияИСвязь() Экспорт

	Сводная = ЗадачаТеста("S", 0);
	ЗадачаA = ЗадачаТеста("A", 480);
	ЗадачаA.Родитель = "S";
	ЗадачаB = ЗадачаТеста("B", 480);
	ЗадачаB.Родитель = "S";

	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(Сводная);
	СписокЗадач.Добавить(ЗадачаA);
	СписокЗадач.Добавить(ЗадачаB);
	СписокЗадач.Добавить(ЗадачаТеста("C", 60, Связи("S")));

	Результат = Рассчитать(СписокЗадач);

	ЮТест.ОжидаетЧто(Результат["S"].Start)
		.Равно(Дата(2026, 11, 9, 8, 0, 0), "Сводная начинается с первого ребёнка");
	ЮТест.ОжидаетЧто(Результат["S"].Finish)
		.Равно(Дата(2026, 11, 9, 17, 0, 0), "Оба ребёнка в один день - сводная тоже");
	ЮТест.ОжидаетЧто(Результат["S"].SummaryDuration)
		.Равно(480, "Сводная длительность - рабочие минуты между датами");
	ЮТест.ОжидаетЧто(Результат["C"].Start)
		.Равно(Дата(2026, 11, 10, 8, 0, 0), "Преемник сводной стартует после её финиша");

КонецПроцедуры

Процедура ТЕСТ_ЦиклическаяСвязь_Исключение() Экспорт

	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("A", 60, Связи("B")));
	СписокЗадач.Добавить(ЗадачаТеста("B", 60, Связи("A")));

	Упало = Ложь;
	ОписаниеОшибки = "";
	Попытка
		Рассчитать(СписокЗадач);
	Исключение
		Упало = Истина;
		ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(Упало)
		.Равно(Истина, "Циклическая связь должна порождать исключение");
	ЮТест.ОжидаетЧто(ОписаниеОшибки)
		.Содержит("Циклическая связь", "Сообщение объясняет причину");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроектТеста()

	Возврат Новый Структура("Calendar, Start",
		КалендариПроектов.СтандартныйКалендарь(), Дата(2026, 11, 9, 8, 0, 0));

КонецФункции

// Задача-структура с значениями по умолчанию (см. шапку ПланированиеПроектов).
Функция ЗадачаТеста(Ключ, Длительность, Предшественники = Неопределено)

	Связи = Новый Массив;
	Если Предшественники <> Неопределено Тогда
		Связи = Предшественники;
	КонецЕсли;

	Возврат Новый Структура("Ключ, Родитель, Duration, Calendar, ConstraintType, ConstraintDate, LevelingDelay, Predecessors",
		Ключ, Неопределено, Длительность, Неопределено, 0, Неопределено, 0, Связи);

КонецФункции

// Массив FS-связей на предшественников.
Функция Связи(ПервыйПредшественник, Lag = 0)

	Связи = Новый Массив;
	Связи.Добавить(Новый Структура("Task, Type, Lag", ПервыйПредшественник, 1, Lag));
	Возврат Связи;

КонецФункции

Функция Рассчитать(СписокЗадач)

	Возврат ПланированиеПроектов.РассчитатьРасписание(СписокЗадач, ПроектТеста());

КонецФункции

#КонецОбласти
