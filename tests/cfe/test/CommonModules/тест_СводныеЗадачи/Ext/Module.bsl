КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// 09.11.2026 - понедельник; стандартный календарь (8-12, 13-17).
Функция ПроектТеста()

	Возврат Новый Структура("Calendar, Start",
		КалендариПроектов.СтандартныйКалендарь(), Момент(9, 8));

КонецФункции

Функция ЗадачаТеста(Ключ, Родитель)

	Возврат Новый Структура("Ключ, Родитель", Ключ, Родитель);

КонецФункции

Функция ЛистРасписания(Начало, Финиш)

	Возврат Новый Структура("Start, Finish", Начало, Финиш);

КонецФункции

Функция Момент(День, Час)

	Возврат Дата(2026, 11, День, Час, 0, 0);

КонецФункции

#КонецОбласти
