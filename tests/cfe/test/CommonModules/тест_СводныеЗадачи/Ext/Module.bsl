Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Агрегация сводных")
			.ДобавитьТест("ТЕСТ_Сводная_ДатыИДлительность")
			.ДобавитьТест("ТЕСТ_ВложенныеСводные")
			.ДобавитьТест("ТЕСТ_ЛистБезДаты_Исключение")
		.ДобавитьТестовыйНабор("Структура WBS")
			.ДобавитьТест("ТЕСТ_WBS_НомераИУровни")
			.ДобавитьТест("ТЕСТ_WBS_ТриУровня")
			.ДобавитьТест("ТЕСТ_WBS_РодительВКонце")
			.ДобавитьТест("ТЕСТ_WBS_РодительВнеСписка")
		.ДобавитьТестовыйНабор("Ошибки иерархии")
			.ДобавитьТест("ТЕСТ_ЦиклВИерархии_Исключение")
	;

КонецПроцедуры

#Область Тесты

Процедура ТЕСТ_Сводная_ДатыИДлительность() Экспорт

	// 09.11.2026 - понедельник; календарь по умолчанию 8-12, 13-17.
	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("Этап", ""));
	СписокЗадач.Добавить(ЗадачаТеста("А", "Этап"));
	СписокЗадач.Добавить(ЗадачаТеста("Б", "Этап"));

	Расписание = Новый Соответствие;
	Расписание.Вставить("А", ЛистРасписания(Момент(9, 8), Момент(9, 17)));
	Расписание.Вставить("Б", ЛистРасписания(Момент(10, 8), Момент(10, 13)));

	Результат = СводныеЗадачи.Агрегировать(СписокЗадач, Расписание, ПроектТеста());

	Этап = Результат.Получить("Этап");
	ЮТест.ОжидаетЧто(Этап, "Сводная вошла в результат").НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Этап.Start)
		.Равно(Момент(9, 8), "Старт сводной - минимум стартов потомков");
	ЮТест.ОжидаетЧто(Этап.Finish)
		.Равно(Момент(10, 13), "Финиш сводной - максимум финишей потомков");
	ЮТест.ОжидаетЧто(Этап.Duration)
		.Равно(720, "Рабочие минуты пн 8:00 - вт 13:00 = 480 + 240");

	ЮТест.ОжидаетЧто(Результат.Получить("А"))
		.Равно(Неопределено, "Листья в результат не попадают");
	ЮТест.ОжидаетЧто(Результат.Получить("Б"))
		.Равно(Неопределено, "Листья в результат не попадают");

КонецПроцедуры

Процедура ТЕСТ_ВложенныеСводные() Экспорт

	// Верх содержит сводную Этап (пн) и лист Г (вт).
	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("Верх", ""));
	СписокЗадач.Добавить(ЗадачаТеста("Этап", "Верх"));
	СписокЗадач.Добавить(ЗадачаТеста("А", "Этап"));
	СписокЗадач.Добавить(ЗадачаТеста("Б", "Этап"));
	СписокЗадач.Добавить(ЗадачаТеста("Г", "Верх"));

	Расписание = Новый Соответствие;
	Расписание.Вставить("А", ЛистРасписания(Момент(9, 8), Момент(9, 17)));
	Расписание.Вставить("Б", ЛистРасписания(Момент(9, 8), Момент(9, 12)));
	Расписание.Вставить("Г", ЛистРасписания(Момент(10, 8), Момент(10, 17)));

	Результат = СводныеЗадачи.Агрегировать(СписокЗадач, Расписание, ПроектТеста());

	Этап = Результат.Получить("Этап");
	ЮТест.ОжидаетЧто(Этап.Start)
		.Равно(Момент(9, 8), "Этап - понедельник");
	ЮТест.ОжидаетЧто(Этап.Finish)
		.Равно(Момент(9, 17), "Этап - до 17:00 понедельника");
	ЮТест.ОжидаетЧто(Этап.Duration)
		.Равно(480, "Полный рабочий день");

	Верх = Результат.Получить("Верх");
	ЮТест.ОжидаетЧто(Верх.Start)
		.Равно(Момент(9, 8), "Охватывает сводную и параллельный лист");
	ЮТест.ОжидаетЧто(Верх.Finish)
		.Равно(Момент(10, 17), "Финиш по листу вторника");
	ЮТест.ОжидаетЧто(Верх.Duration)
		.Равно(960, "Два полных рабочих дня");

КонецПроцедуры

Процедура ТЕСТ_ЛистБезДаты_Исключение() Экспорт

	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("Этап", ""));
	СписокЗадач.Добавить(ЗадачаТеста("А", "Этап"));

	Упало = Ложь;
	ОписаниеОшибки = "";
	Попытка
		СводныеЗадачи.Агрегировать(СписокЗадач, Новый Соответствие, ПроектТеста());
	Исключение
		Упало = Истина;
		ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(Упало)
		.Равно(Истина, "Лист без дат в расписании - ошибка контракта");
	ЮТест.ОжидаетЧто(ОписаниеОшибки)
		.Содержит("отсутствует в расписании", "Сообщение объясняет причину");

КонецПроцедуры

Процедура ТЕСТ_WBS_НомераИУровни() Экспорт

	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("Этап", ""));
	СписокЗадач.Добавить(ЗадачаТеста("А", "Этап"));
	СписокЗадач.Добавить(ЗадачаТеста("Б", "Этап"));
	СписокЗадач.Добавить(ЗадачаТеста("Веха", ""));

	Результат = СводныеЗадачи.СтруктураWBS(СписокЗадач);

	Этап = Результат.Получить("Этап");
	ЮТест.ОжидаетЧто(Этап.ID).Равно(1, "ID - позиция в массиве");
	ЮТест.ОжидаетЧто(Этап.OutlineLevel).Равно(1, "Корень - уровень 1");
	ЮТест.ОжидаетЧто(Этап.OutlineNumber).Равно("1", "Корень - номер позиции");

	А = Результат.Получить("А");
	ЮТест.ОжидаетЧто(А.ID).Равно(2, "ID второго элемента");
	ЮТест.ОжидаетЧто(А.OutlineLevel).Равно(2, "Потомок - уровень 2");
	ЮТест.ОжидаетЧто(А.OutlineNumber).Равно("1.1", "Номер родителя и позиция");

	Б = Результат.Получить("Б");
	ЮТест.ОжидаетЧто(Б.OutlineNumber).Равно("1.2", "Второй потомок этапа");

	Веха = Результат.Получить("Веха");
	ЮТест.ОжидаетЧто(Веха.OutlineLevel).Равно(1, "Второй корень");
	ЮТест.ОжидаетЧто(Веха.OutlineNumber).Равно("2", "Номер среди корней");

КонецПроцедуры

Процедура ТЕСТ_WBS_ТриУровня() Экспорт

	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("Верх", ""));
	СписокЗадач.Добавить(ЗадачаТеста("Средняя", "Верх"));
	СписокЗадач.Добавить(ЗадачаТеста("Нижняя", "Средняя"));

	Результат = СводныеЗадачи.СтруктураWBS(СписокЗадач);

	ЮТест.ОжидаетЧто(Результат.Получить("Верх").OutlineNumber)
		.Равно("1", "Корень");
	ЮТест.ОжидаетЧто(Результат.Получить("Средняя").OutlineNumber)
		.Равно("1.1", "Второй уровень");
	ЮТест.ОжидаетЧто(Результат.Получить("Нижняя").OutlineNumber)
		.Равно("1.1.1", "Третий уровень");
	ЮТест.ОжидаетЧто(Результат.Получить("Нижняя").OutlineLevel)
		.Равно(3, "Глубина три - уровень 3");
	ЮТест.ОжидаетЧто(Результат.Получить("Нижняя").WBS)
		.Равно("1.1.1", "WBS равен OutlineNumber (ограничение v1)");

КонецПроцедуры

Процедура ТЕСТ_WBS_РодительВКонце() Экспорт

	// Потомок идёт раньше родителя: номер всё равно строится рекурсивно.
	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("А", "Этап"));
	СписокЗадач.Добавить(ЗадачаТеста("Этап", ""));

	Результат = СводныеЗадачи.СтруктураWBS(СписокЗадач);

	ЮТест.ОжидаетЧто(Результат.Получить("А").OutlineNumber)
		.Равно("1.1", "Потомок получил номер родителя");
	ЮТест.ОжидаетЧто(Результат.Получить("Этап").OutlineNumber)
		.Равно("1", "Родитель в конце массива - номер по позиции");
	ЮТест.ОжидаетЧто(Результат.Получить("А").ID)
		.Равно(1, "ID - по порядку массива, не по иерархии");

КонецПроцедуры

Процедура ТЕСТ_WBS_РодительВнеСписка() Экспорт

	// Родитель отсутствует в массиве - задача считается корневой.
	СписокЗадач = Новый Массив;
	СписокЗадач.Добавить(ЗадачаТеста("А", "Неттакого"));

	Результат = СводныеЗадачи.СтруктураWBS(СписокЗадач);

	ЮТест.ОжидаетЧто(Результат.Получить("А").OutlineLevel)
		.Равно(1, "Верхний уровень");
	ЮТест.ОжидаетЧто(Результат.Получить("А").OutlineNumber)
		.Равно("1", "Номер как у корня");

КонецПроцедуры

