		.Равно(1, "Вместо них создана одна свёрнутая");

	ЮТест.ОжидаетЧто(Результат.ГидыПоСтрокам.Получить(0))
		.Равно("gid://gitlab/Timelog/9003", "Гид новой записи в первой строке");

	ЮТест.ОжидаетЧто(Результат.ГидыПоСтрокам.Получить(1))
		.Равно("gid://gitlab/Timelog/9003", "Тот же гид во второй строке");

КонецПроцедуры

// Дано: документ ЛУРВ, где между двумя строками по тикету GitLab стоит
//       строка обеда без задачи; записей в GitLab нет
// Когда: УчетРабочегоВремениИнтеграции.СинхронизироватьДокумент(Документ)
// То: строки задачи свёрнуты в одну запись, её гид проставлен обеим строкам
//     по их фактическим позициям в ТЧ; строка обеда осталась без ссылки
//     и учтена в Пропущено
//
Процедура ТЕСТ_СинхронизацияДокумента_ГидыПоФактическимСтрокамТЧ() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	СоздатьЗадачуЗеркала();
	Тикет = СоздатьТикетВнешнейСистемы("6001", ВебURLЗадачи(), Система);

	Мокито.Обучение(КоннекторHTTP)
		.Когда("PostJson")
			.Вернуть(ОтветUsername())
			.Вернуть(ОтветТаймлогиПустой())
			.Вернуть(ОтветTimelogCreate("gid://gitlab/Timelog/9001"))
		.Прогон();

	Документ = Документы.ЛУРВ.СоздатьДокумент();
	Документ.Дата = Дата(2026, 3, 11, 12, 0, 0);
	ДобавитьСтрокуДокумента(Документ, Тикет, "", "Утренняя работа", 1800, 9);
	ДобавитьСтрокуДокумента(Документ, Справочники.Тикеты.ПустаяСсылка(), "", "Обед", 3600, 12);
	ДобавитьСтрокуДокумента(Документ, Тикет, "", "Вечерняя работа", 3600, 13);

	Результат = Обработки.УчетРабочегоВремениИнтеграции.Создать()
		.СинхронизироватьДокумент(Документ);

	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество())
		.Равно(0, "Синхронизация без ошибок");

	ЮТест.ОжидаетЧто(Результат.Отправлено)
		.Равно(1, "Строки задачи отправлены одной записью");

	ЮТест.ОжидаетЧто(Результат.Пропущено)
		.Равно(1, "Строка обеда без задачи пропущена");

	ЮТест.ОжидаетЧто(Документ.ОтчетЗаДень[0].СсылкаНаТаймлог)
		.Равно("gid://gitlab/Timelog/9001", "Гид в первой строке задачи");

	ЮТест.ОжидаетЧто(Документ.ОтчетЗаДень[1].СсылкаНаТаймлог)
		.Равно("", "Строка обеда ссылки не получила");

	ЮТест.ОжидаетЧто(Документ.ОтчетЗаДень[2].СсылкаНаТаймлог)
		.Равно("gid://gitlab/Timelog/9001", "Гид в третьей строке, а не со сдвигом");

КонецПроцедуры

#КонецОбласти // Тесты

#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// Подготовка данных

// Находит или создаёт внешнюю систему GitLab для мок-тестов и записывает
// в безопасное хранилище тестовый токен (API-адаптер требует токен).
//
Функция ВнешняяСистемаМок()

	БазовыйURL = "https://gitlab.example.com";

	Ссылка = ВнешняяСистемаПоБазовомуURL(БазовыйURL);

	Если Ссылка.Пустая() Тогда
		Объект = Справочники.ВнешниеСистемыТикетов.СоздатьЭлемент();
		Объект.Наименование = "GitLab: gitlab.example.com (мок тесты таймлогов)";
		Объект.БазовыйURL   = БазовыйURL;
		Объект.ТипСистемы   = Справочники.ТипыСистемТикетов.GitLab;
		Объект.Записать();
		Ссылка = Объект.Ссылка;
	Иначе
		ОбеспечитьТипСистемыGitlab(Ссылка);
	КонецЕсли;

	ОбеспечитьПризнакИнтеграцииGitlab();

	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Ссылка, "test-token", "PRIVATE_TOKEN");

	Возврат Ссылка;

КонецФункции

// Приводит тип существующей мок-системы к предопределённому GitLab:
// запись в ИБ могла остаться от прежних прогонов с другим типом, а фасад
// выбирает адаптер именно по типу системы.
//
Процедура ОбеспечитьТипСистемыGitlab(Знач Система)

	ТипGitlab = Справочники.ТипыСистемТикетов.GitLab;

	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Система, "ТипСистемы") <> ТипGitlab Тогда
		Объект = Система.ПолучитьОбъект();
		Объект.ТипСистемы = ТипGitlab;
		Объект.Записать();
	КонецЕсли;

КонецПроцедуры

// У предопределённого типа GitLab должен стоять признак «Имеет интеграцию»:
// без него фасад пропускает строки системы как неинтегрированные.
//
Процедура ОбеспечитьПризнакИнтеграцииGitlab()

	ТипОбъект = Справочники.ТипыСистемТикетов.GitLab.ПолучитьОбъект();

	Если НЕ ТипОбъект.ИмеетИнтеграцию Тогда
		ТипОбъект.ИмеетИнтеграцию = Истина;
		ТипОбъект.Записать();
	КонецЕсли;

КонецПроцедуры

// Ищет элемент ВнешниеСистемыТикетов по базовому URL (строка неограниченной
// длины не сравнивается в запросе - отбор выполняется в коде).
//
Функция ВнешняяСистемаПоБазовомуURL(Знач БазовыйURL)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.БазовыйURL КАК БазовыйURL
		|ИЗ Справочник.ВнешниеСистемыТикетов КАК Т";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если Выборка.БазовыйURL = БазовыйURL Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Справочники.ВнешниеСистемыТикетов.ПустаяСсылка();

КонецФункции

// Удаляет данные предыдущих прогонов с тестовыми идентификаторами
// (тикеты, зеркало GitLab) - тесты детерминированны и без транзакций.
//
Процедура ОчиститьТестовыеДанные()

	УдалитьТикетыПоИдентификатору("6001");
	УдалитьТикетыПоИдентификатору("6002");
	УдалитьТикетыПоИдентификатору("7777");
	УдалитьЗеркалоПоИдентификатору("Справочник.ГитлабЗадачи", 6001);
	УдалитьЗеркалоПоИдентификатору("Справочник.ГитлабЗадачи", 6002);
	УдалитьЗеркалоПоИдентификатору("Справочник.ГитлабПроекты", 3001);
	УдалитьЗеркалоПоИдентификатору("Справочник.ГитлабПользователи", 77);

КонецПроцедуры

// Удаляет тикеты с заданным внешним идентификатором.
//
Процедура УдалитьТикетыПоИдентификатору(Знач ВнешнийИдентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Т.Ссылка КАК Ссылка
		|ИЗ Справочник.Тикеты КАК Т
		|ГДЕ Т.ВнешнийИдентификатор = &ВнешнийИдентификатор";
	Запрос.УстановитьПараметр("ВнешнийИдентификатор", ВнешнийИдентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Выборка.Ссылка.ПолучитьОбъект().Удалить();
	КонецЦикла;

КонецПроцедуры

// Удаляет элементы каталога зеркала с заданным идентификатором GitLab.
//
Процедура УдалитьЗеркалоПоИдентификатору(Знач ИмяТаблицы, Знач Идентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Т.Ссылка КАК Ссылка
		|ИЗ " + ИмяТаблицы + " КАК Т
		|ГДЕ Т.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Выборка.Ссылка.ПолучитьОбъект().Удалить();
	КонецЦикла;

КонецПроцедуры

// Возвращает число тикетов с заданным внешним идентификатором.
//
Функция КоличествоТикетовПоИдентификатору(Знач ВнешнийИдентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(Т.Ссылка) КАК Количество
		|ИЗ Справочник.Тикеты КАК Т
		|ГДЕ Т.ВнешнийИдентификатор = &ВнешнийИдентификатор";
	Запрос.УстановитьПараметр("ВнешнийИдентификатор", ВнешнийИдентификатор);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Создаёт задачу зеркала с владельцем-проектом по тестовым идентификаторам.
//
Функция СоздатьЗадачуЗеркала()

	Проект = Справочники.ГитлабПроекты.СоздатьЭлемент();
	Проект.Код           = "3001";
	Проект.Наименование  = "Проект А";
	Проект.Идентификатор = 3001;
	Проект.ПутьПолный    = "grp/prj";
	Проект.ВебURL        = ВебURLПроекта();
	Проект.Записать();

	Задача = Справочники.ГитлабЗадачи.СоздатьЭлемент();
	Задача.Владелец      = Проект.Ссылка;
	Задача.Код           = "7";
	Задача.Наименование  = "Сборка отчёта";
	Задача.Идентификатор = 6001;
	Задача.ВебURL        = ВебURLЗадачи();
	Задача.Записать();

	Возврат Задача.Ссылка;

КонецФункции

// Создаёт тикет с данными внешней системы; Загрузка = Истина записывает
// объект без обработчика ПередЗаписью (симуляция тикета без автосвязки).
//
Функция СоздатьТикетВнешнейСистемы(Знач ВнешнийИдентификатор, Знач ВебURL, Знач Система, Знач Загрузка = Ложь)

	Объект = Справочники.Тикеты.СоздатьЭлемент();
	Объект.Наименование         = "Тикет теста " + ВнешнийИдентификатор;
	Объект.ВнешняяСистема       = Система;
	Объект.ВнешнийИдентификатор = ВнешнийИдентификатор;
	Объект.СсылкаНаВнешнийТикет = ВебURL;

	Если Загрузка Тогда
		Объект.ОбменДанными.Загрузка = Истина;
	КонецЕсли;

	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

Функция ВебURLПроекта()

	Возврат "https://gitlab.example.com/grp/prj";

КонецФункции

// Таблица строк документа в контракте СинхронизироватьСтрокиДокумента.
//
Функция ТаблицаСтрокДокумента()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ИндексСтроки", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Тикет");
	Таблица.Колонки.Добавить("ГидТаймлога", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Длительность", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Момент", Новый ОписаниеТипов("Дата"));

	Возврат Таблица;

КонецФункции

// Добавляет строку синхронизации с началом в 09:00 тестовой даты.
//
Функция ДобавитьСтрокуСинхронизации(Знач Таблица, Знач Тикет, Знач Гид, Знач Описание, Знач Длительность)

	Строка = Таблица.Добавить();
	Строка.ИндексСтроки = Таблица.Количество() - 1;
	Строка.Тикет        = Тикет;
	Строка.ГидТаймлога  = Гид;
	Строка.Описание     = Описание;
	Строка.Длительность = Длительность;
	Строка.Момент       = Дата(2026, 3, 11, 9, 0, 0);

	Возврат Строка;

КонецФункции

// Создаёт незаписанный документ ЛУРВ на тестовую дату: без описания -
// две строки без записей внешней системы, с описанием - одна строка,
// совпадающая со своей записью.
//
Функция НовыйДокументССтрокамиGitlab(Знач Тикет, Знач ГидПервойСтроки,
	Знач ОписаниеПервойСтроки = "", Знач ДлительностьПервойСтроки = 0)

	Документ = Документы.ЛУРВ.СоздатьДокумент();
	Документ.Дата = Дата(2026, 3, 11, 12, 0, 0);

	Если ПустаяСтрока(ОписаниеПервойСтроки) Тогда
		ДобавитьСтрокуДокумента(Документ, Тикет, "", "Утренняя работа", 1800, 9);
		ДобавитьСтрокуДокумента(Документ, Тикет, "", "Вечерняя работа", 3600, 10);
	Иначе
		ДобавитьСтрокуДокумента(
			Документ, Тикет, ГидПервойСтроки, ОписаниеПервойСтроки, ДлительностьПервойСтроки, 9);
	КонецЕсли;

	Возврат Документ;

КонецФункции

// Добавляет строку в ТЧ ОтчетЗаДень документа с началом в указанный час.
//
Процедура ДобавитьСтрокуДокумента(Документ, Знач Тикет, Знач Гид, Знач Описание,
	Знач Длительность, Знач ЧасНачала)

	Строка = Документ.ОтчетЗаДень.Добавить();
	Строка.Тикет           = Тикет;
	Строка.СсылкаНаТаймлог = Гид;
	Строка.Описание        = Описание;
	Строка.Длительность    = Длительность;
	Строка.Начало          = Дата(2026, 3, 11, ЧасНачала, 0, 0);

