// Тесты адаптера таймлогов GitLab (Обработка.ТаймлогиGitlab): сбор записей
// времени на дату с привязкой к тикетам и зеркалу GitLab (ЛУР-013, UC-07).
// HTTP-вызовы подменяются через Мокито (КоннекторHTTP), реальные вызовы не
// выполняются. Фреймворк: yaxunit.
//
// Тесты чистят свои данные (зеркало/тикеты по тестовым идентификаторам)
// перед прогоном, поэтому одинаково работают с транзакциями и без.

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("ТаймлогиGitlab: сбор таймлогов на дату")
			.ДобавитьТест("ТЕСТ_СборТаймлогов_ЗадачаДокачиваетсяВЗеркало")
			.ДобавитьТест("ТЕСТ_СборТаймлогов_UsernameНеОпределен")
			.ДобавитьТест("ТЕСТ_СборТаймлогов_ЗадачаУжеВЗеркале")
			.ДобавитьТест("ТЕСТ_СборТаймлогов_ТикетУжеЕсть")
		.ДобавитьТестовыйНабор("Загрузка задач проекта в зеркало")
			.ДобавитьТест("ТЕСТ_Загрузка_ЗадачиЗеркалируются")
			.ДобавитьТест("ТЕСТ_Загрузка_ТикетыОбеспечиваются")
		.ДобавитьТестовыйНабор("Синхронизация строк документа с GitLab")
			.ДобавитьТест("ТЕСТ_СинхронизацияСтрок_ОтправкаНовыхСтрок")
			.ДобавитьТест("ТЕСТ_СинхронизацияСтрок_УдаляетЗаписиНеИзДокумента")
			.ДобавитьТест("ТЕСТ_СинхронизацияСтрок_ОбновляетРасходящуюся")
			.ДобавитьТест("ТЕСТ_СинхронизацияСтрок_ПропускаетСтрокуБезЗадачи")
			.ДобавитьТест("ТЕСТ_СинхронизацияСтрок_ОтправкаПриПотеряннойСвязкеСЗеркалом")
			.ДобавитьТест("ТЕСТ_СинхронизацияСтрок_ПропускаетСтрокуНулевойДлительности")
			.ДобавитьТест("ТЕСТ_СинхронизацияСтрок_СовпадающаяСвёрткаСвязываетБезМутаций")
			.ДобавитьТест("ТЕСТ_СинхронизацияСтрок_СвёрткаЗаменяетНесколькоЗаписейОдной")
			.ДобавитьТест("ТЕСТ_СинхронизацияДокумента_ГидыЗаписываютсяВСтроки")
			.ДобавитьТест("ТЕСТ_СинхронизацияДокумента_УдаляетЗаписиНеИзДокумента")
			.ДобавитьТест("ТЕСТ_СинхронизацияДокумента_ГидыПоФактическимСтрокамТЧ")
	;

КонецПроцедуры

#Область Тесты

// Дано: таймлоги GitLab на дату, задача и проект отсутствуют в зеркале,
//       тикета нет
// Когда: ТаймлогиGitlab.СобратьТаймлогиНаДату(Дата(2026, 3, 11))
// То: задача докачана в зеркало (GET задачи + проекта), тикет создан
//     с данными внешней системы и связкой на задачу зеркала, строка
//     таблицы таймлогов заполнена всеми колонками
//
Процедура ТЕСТ_СборТаймлогов_ЗадачаДокачиваетсяВЗеркало() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	Мокито.Обучение(КоннекторHTTP)
		.Когда("PostJson").Вернуть(ОтветUsername()).Вернуть(ОтветТаймлоги())
		.Когда("Get").Вернуть(ОтветЗадача()).Вернуть(ОтветПроект())
		.Прогон();

	Адаптер = Обработки.ТаймлогиGitlab.Создать();
	Адаптер.Инициализировать(Система);

	Результат = Адаптер.СобратьТаймлогиНаДату(Дата(2026, 3, 11));

	ЮТест.ОжидаетЧто(ТипЗнч(Результат))
		.Равно(Тип("ТаблицаЗначений"), "Успешный сбор возвращает таблицу таймлогов");

	ЮТест.ОжидаетЧто(Результат.Количество())
		.Равно(1, "Должна быть собрана 1 запись времени");

	СтрокаТаймлога = Результат[0];

	ЮТест.ОжидаетЧто(СтрокаТаймлога.СсылкаНаТаймлог)
		.Равно("gid://gitlab/Timelog/555", "СсылкаНаТаймлог = id записи GraphQL");

	ЮТест.ОжидаетЧто(СтрокаТаймлога.Описание)
		.Равно("Работа над модулем", "Описание = summary записи");

	ЮТест.ОжидаетЧто(СтрокаТаймлога.Длительность)
		.Равно(3600, "Длительность в секундах");

	ЮТест.ОжидаетЧто(НачалоДня(СтрокаТаймлога.ДатаЗаписи))
		.Равно(Дата(2026, 3, 11), "ДатаЗаписи = spentAt записи");

	// Задача докачана в зеркало и связана с тикетом.
	ЗадачаЗеркала = ГитлабЗеркало.СсылкаЗадачиПоИдентификатору(6001);
	ЮТест.ОжидаетЧто(ЗадачаЗеркала.Пустая())
		.Равно(Ложь, "Задача докачана в зеркало по данным REST");

	РеквизитыТикета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаймлога.Тикет,
		"Наименование, ВнешняяСистема, ВнешнийИдентификатор, СсылкаНаВнешнийТикет, ВнешняяЗадача");

	ЮТест.ОжидаетЧто(РеквизитыТикета.Наименование)
		.Равно("Сборка отчёта", "Тикет создан с названием задачи");

	ЮТест.ОжидаетЧто(РеквизитыТикета.ВнешняяСистема)
		.Равно(Система, "Тикет привязан к системе адаптера");

	ЮТест.ОжидаетЧто(РеквизитыТикета.ВнешнийИдентификатор)
		.Равно("6001", "ВнешнийИдентификатор = глобальный id задачи");

	ЮТест.ОжидаетЧто(РеквизитыТикета.СсылкаНаВнешнийТикет)
		.Равно(ВебURLЗадачи(), "СсылкаНаВнешнийТикет = URL задачи");

	ЮТест.ОжидаетЧто(РеквизитыТикета.ВнешняяЗадача)
		.Равно(ЗадачаЗеркала, "ВнешняяЗадача = задача зеркала");

КонецПроцедуры

// Дано: таймлоги на дату, username не получен (currentUser = null)
// Когда: ТаймлогиGitlab.СобратьТаймлогиНаДату(Дата(2026, 3, 11))
// То: адаптер возвращает строку ошибки (фасад отнесёт систему
//     к НеОтветившиеСистемы)
//
Процедура ТЕСТ_СборТаймлогов_UsernameНеОпределен() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	Мокито.Обучение(КоннекторHTTP)
		.Когда("PostJson").Вернуть(ОтветUsernameПустой())
		.Прогон();

	Адаптер = Обработки.ТаймлогиGitlab.Создать();
	Адаптер.Инициализировать(Система);

	Результат = Адаптер.СобратьТаймлогиНаДату(Дата(2026, 3, 11));

	ЮТест.ОжидаетЧто(ТипЗнч(Результат))
		.Равно(Тип("Строка"), "Ошибка API возвращается строкой (НеОтветившиеСистемы)");

	ЮТест.ОжидаетЧто(Результат)
		.Содержит("username", "Ошибка связана с определением пользователя");

КонецПроцедуры

// Дано: задача уже есть в зеркале (по глобальному id), тикета нет
// Когда: ТаймлогиGitlab.СобратьТаймлогиНаДату(Дата(2026, 3, 11))
// То: REST-запросы за задачей не выполняются (только GraphQL), тикет создан
//     со связкой на существующую задачу зеркала
//
Процедура ТЕСТ_СборТаймлогов_ЗадачаУжеВЗеркале() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	ЗадачаЗеркала = СоздатьЗадачуЗеркала();

	Мокито.Обучение(КоннекторHTTP)
		.Когда("PostJson").Вернуть(ОтветUsername()).Вернуть(ОтветТаймлоги())
		.Когда("Get").Вернуть(ОтветЗадача())
		.Прогон();

	Адаптер = Обработки.ТаймлогиGitlab.Создать();
	Адаптер.Инициализировать(Система);

	Результат = Адаптер.СобратьТаймлогиНаДату(Дата(2026, 3, 11));

	ЮТест.ОжидаетЧто(Результат.Количество())
		.Равно(1, "Запись времени собрана");

	ЮТест.ОжидаетЧто(Результат[0].Тикет.Пустая())
		.Равно(Ложь, "Тикет создан");

	Мокито.Проверить(КоннекторHTTP)
		.КоличествоВызовов("Get").Равно(0, "Задача в зеркале - REST не вызывался");

	РеквизитыТикета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Результат[0].Тикет, "ВнешняяЗадача");

	ЮТест.ОжидаетЧто(РеквизитыТикета.ВнешняяЗадача)
		.Равно(ЗадачаЗеркала, "Связка на существующую задачу зеркала");

КонецПроцедуры

// Дано: задача в зеркале, тикет уже существует без связки (записан с
//       ОбменДанными.Загрузка - без автосвязки, как до её появления)
// Когда: ТаймлогиGitlab.СобратьТаймлогиНаДату(Дата(2026, 3, 11))
// То: существующий тикет найден по ВнешнийИдентификатор и возвращён
//     без создания дубля
//
Процедура ТЕСТ_СборТаймлогов_ТикетУжеЕсть() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	СоздатьЗадачуЗеркала();

	Тикет = СоздатьТикетВнешнейСистемы("6001", ВебURLЗадачи(), Система, Истина);

	Мокито.Обучение(КоннекторHTTP)
		.Когда("PostJson").Вернуть(ОтветUsername()).Вернуть(ОтветТаймлоги())
		.Когда("Get").Вернуть(ОтветЗадача())
		.Прогон();

	Адаптер = Обработки.ТаймлогиGitlab.Создать();
	Адаптер.Инициализировать(Система);

	Результат = Адаптер.СобратьТаймлогиНаДату(Дата(2026, 3, 11));

	ЮТест.ОжидаетЧто(Результат.Количество())
		.Равно(1, "Запись времени собрана");

	ЮТест.ОжидаетЧто(Результат[0].Тикет)
		.Равно(Тикет, "Возвращён существующий тикет, найденный по внешнему идентификатору");

	ЮТест.ОжидаетЧто(КоличествоТикетовПоИдентификатору("6001"))
		.Равно(1, "Дубль тикета не создаётся");

КонецПроцедуры

// Дано: пустое зеркало, GitLab возвращает список из 2 задач проекта
// Когда: ГитлабЗеркало.ЗеркалироватьЗадачиПроекта(Система, "Neumoichev_D/3E")
// То: обе задачи докачаны в зеркало вместе с проектом, счётчики заполнены
//
Процедура ТЕСТ_Загрузка_ЗадачиЗеркалируются() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	Мокито.Обучение(КоннекторHTTP)
		.Когда("Get").Вернуть(ОтветЗадачиПроекта()).Вернуть(ОтветПроект())
		.Прогон();

	Результат = ГитлабЗеркало.ЗеркалироватьЗадачиПроекта(Система, "Neumoichev_D/3E");

	ЮТест.ОжидаетЧто(Результат.Задач)
		.Равно(2, "Список задач проекта разобран");

	ЮТест.ОжидаетЧто(Результат.Проект.Пустая())
		.Равно(Ложь, "Проект задач возвращён в результате");

	РеквизитыПроекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Результат.Проект, "Идентификатор");

	ЮТест.ОжидаетЧто(РеквизитыПроекта.Идентификатор)
		.Равно(3001, "Проект обеспечен по идентификатору из задач");

	ЮТест.ОжидаетЧто(ГитлабЗеркало.СсылкаЗадачиПоИдентификатору(6001).Пустая())
		.Равно(Ложь, "Первая задача в зеркале");

	ЮТест.ОжидаетЧто(ГитлабЗеркало.СсылкаЗадачиПоИдентификатору(6002).Пустая())
		.Равно(Ложь, "Вторая задача в зеркале");

КонецПроцедуры

// Дано: пустое зеркало, GitLab возвращает список из 2 задач проекта
// Когда: ТаймлогиGitlab.ЗагрузитьЗадачиПроекта("Neumoichev_D/3E") дважды
// То: первый вызов создаёт тикеты по задачам, второй - находит существующие
//     без дублей
//
Процедура ТЕСТ_Загрузка_ТикетыОбеспечиваются() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	Мокито.Обучение(КоннекторHTTP)
		.Когда("Get")
			.Вернуть(ОтветЗадачиПроекта())
			.Вернуть(ОтветПроект())
			.Вернуть(ОтветЗадачиПроекта())
		.Прогон();

	Адаптер = Обработки.ТаймлогиGitlab.Создать();
	Адаптер.Инициализировать(Система);

	Результат = Адаптер.ЗагрузитьЗадачиПроекта("Neumoichev_D/3E");

	ЮТест.ОжидаетЧто(Результат.ТикетовВсего)
		.Равно(2, "Обе задачи проекта обеспечены тикетами");

	ЮТест.ОжидаетЧто(Результат.ТикетовСоздано)
		.Равно(2, "Тикеты созданы при первой загрузке");

	ЮТест.ОжидаетЧто(КоличествоТикетовПоИдентификатору("6001"))
		.Равно(1, "Тикет первой задачи создан");

	ЮТест.ОжидаетЧто(КоличествоТикетовПоИдентификатору("6002"))
		.Равно(1, "Тикет второй задачи создан");

	РезультатПовтора = Адаптер.ЗагрузитьЗадачиПроекта("Neumoichev_D/3E");

	ЮТест.ОжидаетЧто(РезультатПовтора.ТикетовВсего)
		.Равно(2, "Повторная загрузка находит те же задачи");

	ЮТест.ОжидаетЧто(РезультатПовтора.ТикетовСоздано)
		.Равно(0, "Существующие тикеты не дублируются");

КонецПроцедуры

// Дано: две строки документа по одному тикету без записей внешней системы,
//       GitLab на дату пуст
// Когда: ТаймлогиGitlab.СинхронизироватьСтрокиДокумента(Строки, Дата)
// То: строки одной задачи свёрнуты в одну отправку: мутация timelogCreate с
//     суммарной длительностью, моментом первой строки и объединёнными
//     описаниями; гид записи возвращён обеим строкам
//
Процедура ТЕСТ_СинхронизацияСтрок_ОтправкаНовыхСтрок() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	СоздатьЗадачуЗеркала();
	Тикет = СоздатьТикетВнешнейСистемы("6001", ВебURLЗадачи(), Система);

	Мокито.Обучение(КоннекторHTTP)
		.Когда("PostJson")
			.Вернуть(ОтветUsername())
			.Вернуть(ОтветТаймлогиПустой())
			.Вернуть(ОтветTimelogCreate("gid://gitlab/Timelog/9001"))
		.Прогон();

	Адаптер = Обработки.ТаймлогиGitlab.Создать();
	Адаптер.Инициализировать(Система);

	СтрокиДокумента = ТаблицаСтрокДокумента();
	ДобавитьСтрокуСинхронизации(СтрокиДокумента, Тикет, "", "Утренняя работа", 1800);
	ДобавитьСтрокуСинхронизации(СтрокиДокумента, Тикет, "", "Вечерняя работа", 3600);

	Результат = Адаптер.СинхронизироватьСтрокиДокумента(СтрокиДокумента, Дата(2026, 3, 11));

	ЮТест.ОжидаетЧто(Результат.Успешно)
		.Равно(Истина, "Синхронизация без ошибок");

	ЮТест.ОжидаетЧто(Результат.Отправлено)
		.Равно(1, "Строки задачи свёрнуты в одну запись");

	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество())
		.Равно(0, "Ошибок нет");

	ЮТест.ОжидаетЧто(Результат.ГидыПоСтрокам.Получить(0))
		.Равно("gid://gitlab/Timelog/9001", "Гид записи первой строки");

	ЮТест.ОжидаетЧто(Результат.ГидыПоСтрокам.Получить(1))
		.Равно("gid://gitlab/Timelog/9001", "Тот же гид во второй строке");

	// Тело мутации: [0] - username, [1] - timelogs, [2] - create.
	Вызовы = Мокито.Проверить(КоннекторHTTP).Вызовы("PostJson");
	Variables = Вызовы[2].Параметры[1].variables;

	ЮТест.ОжидаетЧто(Variables.Получить("issuableId"))
		.Равно("gid://gitlab/Issue/6001", "Запись привязана к задаче тикета");

	ЮТест.ОжидаетЧто(Variables.Получить("timeSpent"))
		.Равно("1h30m", "Длительности строк сложены");

	ЮТест.ОжидаетЧто(Variables.Получить("spentAt"))
		.Равно("2026-03-11T09:00:00", "Момент работы из первой строки");

	СводноеОписание = Строка(Variables.Получить("summary"));

	ЮТест.ОжидаетЧто(СтрНайти(СводноеОписание, "Утренняя работа"))
		.Больше(0, "Описание первой строки в сводном комментарии");

	ЮТест.ОжидаетЧто(СтрНайти(СводноеОписание, "Вечерняя работа"))
		.Больше(0, "Описание второй строки в сводном комментарии");

КонецПроцедуры

// Дано: документ без строк, в GitLab на дату есть запись, которой нет
//       среди строк
// Когда: ТаймлогиGitlab.СинхронизироватьСтрокиДокумента(Строки, Дата)
// То: лишняя внешняя запись удалена мутацией timelogDelete с её гидом
//
Процедура ТЕСТ_СинхронизацияСтрок_УдаляетЗаписиНеИзДокумента() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	Мокито.Обучение(КоннекторHTTP)
		.Когда("PostJson")
			.Вернуть(ОтветUsername())
			.Вернуть(ОтветТаймлогиЗапись("gid://gitlab/Timelog/999", 1800, "Чужая запись"))
			.Вернуть(ОтветTimelogDelete())
