// JSON-строка одной записи опроса таймлогов (по умолчанию задача 6001,
// spentAt 10:00 UTC). webUrl для чужих задач не заполняется осмысленно:
// sync-сценарии его не читают.
//
Функция ЗаписьТаймлогаJSON(Знач Гид, Знач Секунды, Знач Summary,
	Знач IssueID = 6001, Знач IID = 7)

	Возврат "{"
		+ """id"": """ + Гид + """, "
		+ """timeSpent"": " + Формат(Секунды, "ЧГ=") + ", "
		+ """spentAt"": ""2026-03-11T10:00:00.000Z"", "
		+ """summary"": """ + Summary + """, "
		+ """issue"": {"
		+ """id"": ""gid://gitlab/Issue/" + Формат(IssueID, "ЧГ=") + """, "
		+ """iid"": " + Формат(IID, "ЧГ=") + ", "
		+ """title"": ""Сборка отчёта"", "
		+ """webUrl"": """ + ВебURLЗадачи() + """, "
		+ """projectId"": 3001"
		+ "}}";

