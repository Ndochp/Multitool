Функция ОтветUsername()

	Возврат ЮТест.Данные().HTTPОтвет()
		.УстановитьКодСостояния(200)
		.УстановитьТело(ПолучитьДвоичныеДанныеИзСтроки(
			"{""data"": {""currentUser"": {""username"": ""test_user""}}}"));

