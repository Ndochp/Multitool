// Тесты адаптера таймлогов GitLab (Обработка.ТаймлогиGitlab): сбор записей
// времени на дату с привязкой к тикетам и зеркалу GitLab (ЛУР-013, UC-07).
// HTTP-вызовы подменяются через Мокито (КоннекторHTTP), реальные вызовы не
// выполняются. Фреймворк: yaxunit.
//
// Тесты чистят свои данные (зеркало/тикеты по тестовым идентификаторам)
// перед прогоном, поэтому одинаково работают с транзакциями и без.

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("ТаймлогиGitlab: сбор таймлогов на дату")
			.ДобавитьТест("ТЕСТ_СборТаймлогов_ЗадачаДокачиваетсяВЗеркало")
			.ДобавитьТест("ТЕСТ_СборТаймлогов_UsernameНеОпределен")
			.ДобавитьТест("ТЕСТ_СборТаймлогов_ЗадачаУжеВЗеркале")
			.ДобавитьТест("ТЕСТ_СборТаймлогов_ТикетУжеЕсть")
	;

КонецПроцедуры

#Область Тесты

// Дано: таймлоги GitLab на дату, задача и проект отсутствуют в зеркале,
//       тикета нет
// Когда: ТаймлогиGitlab.СобратьТаймлогиНаДату(Дата(2026, 3, 11))
// То: задача докачана в зеркало (GET задачи + проекта), тикет создан
//     с данными внешней системы и связкой на задачу зеркала, строка
//     таблицы таймлогов заполнена всеми колонками
//
Процедура ТЕСТ_СборТаймлогов_ЗадачаДокачиваетсяВЗеркало() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	Мокито.Обучение(КоннекторHTTP)
		.Когда("Post").Вернуть(ОтветUsername()).Потом().Вернуть(ОтветТаймлоги())
		.Когда("Get").Вернуть(ОтветЗадача()).Потом().Вернуть(ОтветПроект())
		.Прогон();

	Адаптер = Обработки.ТаймлогиGitlab.Создать();
	Адаптер.Инициализировать(Система);

	Результат = Адаптер.СобратьТаймлогиНаДату(Дата(2026, 3, 11));

	ЮТест.ОжидаетЧто(ТипЗнч(Результат))
		.Равно(Тип("ТаблицаЗначений"), "Успешный сбор возвращает таблицу таймлогов");

	ЮТест.ОжидаетЧто(Результат.Количество())
		.Равно(1, "Должна быть собрана 1 запись времени");

	СтрокаТаймлога = Результат[0];

	ЮТест.ОжидаетЧто(СтрокаТаймлога.СсылкаНаТаймлог)
		.Равно("gid://gitlab/Timelog/555", "СсылкаНаТаймлог = id записи GraphQL");

	ЮТест.ОжидаетЧто(СтрокаТаймлога.Описание)
		.Равно("Работа над модулем", "Описание = summary записи");

	ЮТест.ОжидаетЧто(СтрокаТаймлога.Длительность)
		.Равно(3600, "Длительность в секундах");

	ЮТест.ОжидаетЧто(НачалоДня(СтрокаТаймлога.ДатаЗаписи))
		.Равно(Дата(2026, 3, 11), "ДатаЗаписи = spentAt записи");

	// Задача докачана в зеркало и связана с тикетом.
	ЗадачаЗеркала = ГитлабЗеркало.СсылкаЗадачиПоИдентификатору(6001);
	ЮТест.ОжидаетЧто(ЗадачаЗеркала.Пустая())
		.Равно(Ложь, "Задача докачана в зеркало по данным REST");

	РеквизитыТикета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаймлога.Тикет,
		"Наименование, ВнешняяСистема, ВнешнийИдентификатор, СсылкаНаВнешнийТикет, ВнешняяЗадача");

	ЮТест.ОжидаетЧто(РеквизитыТикета.Наименование)
		.Равно("Сборка отчёта", "Тикет создан с названием задачи");

	ЮТест.ОжидаетЧто(РеквизитыТикета.ВнешняяСистема)
		.Равно(Система, "Тикет привязан к системе адаптера");

	ЮТест.ОжидаетЧто(РеквизитыТикета.ВнешнийИдентификатор)
		.Равно("6001", "ВнешнийИдентификатор = глобальный id задачи");

	ЮТест.ОжидаетЧто(РеквизитыТикета.СсылкаНаВнешнийТикет)
		.Равно(ВебURLЗадачи(), "СсылкаНаВнешнийТикет = URL задачи");

	ЮТест.ОжидаетЧто(РеквизитыТикета.ВнешняяЗадача)
		.Равно(ЗадачаЗеркала, "ВнешняяЗадача = задача зеркала");

КонецПроцедуры

// Дано: таймлоги на дату, username не получен (currentUser = null)
// Когда: ТаймлогиGitlab.СобратьТаймлогиНаДату(Дата(2026, 3, 11))
// То: адаптер возвращает строку ошибки (фасад отнесёт систему
//     к НеОтветившиеСистемы)
//
Процедура ТЕСТ_СборТаймлогов_UsernameНеОпределен() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	Мокито.Обучение(КоннекторHTTP)
		.Когда("Post").Вернуть(ОтветUsernameПустой())
		.Прогон();

	Адаптер = Обработки.ТаймлогиGitlab.Создать();
	Адаптер.Инициализировать(Система);

	Результат = Адаптер.СобратьТаймлогиНаДату(Дата(2026, 3, 11));

	ЮТест.ОжидаетЧто(ТипЗнч(Результат))
		.Равно(Тип("Строка"), "Ошибка API возвращается строкой (НеОтветившиеСистемы)");

	ЮТест.ОжидаетЧто(Результат)
		.Содержит("username", "Ошибка связана с определением пользователя");

КонецПроцедуры

// Дано: задача уже есть в зеркале (по глобальному id), тикета нет
// Когда: ТаймлогиGitlab.СобратьТаймлогиНаДату(Дата(2026, 3, 11))
// То: REST-запросы за задачей не выполняются (только GraphQL), тикет создан
//     со связкой на существующую задачу зеркала
//
Процедура ТЕСТ_СборТаймлогов_ЗадачаУжеВЗеркале() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	ЗадачаЗеркала = СоздатьЗадачуЗеркала();

	Мокито.Обучение(КоннекторHTTP)
		.Когда("Post").Вернуть(ОтветUsername()).Потом().Вернуть(ОтветТаймлоги())
		.Когда("Get").Вернуть(ОтветЗадача())
		.Прогон();

	Адаптер = Обработки.ТаймлогиGitlab.Создать();
	Адаптер.Инициализировать(Система);

	Результат = Адаптер.СобратьТаймлогиНаДату(Дата(2026, 3, 11));

	ЮТест.ОжидаетЧто(Результат.Количество())
		.Равно(1, "Запись времени собрана");

	ЮТест.ОжидаетЧто(Результат[0].Тикет.Пустая())
		.Равно(Ложь, "Тикет создан");

	ЮТест.ОжидаетЧто(Мокито.Проверить(КоннекторHTTP).КоличествоВызовов("Get"))
		.Равно(0, "Задача в зеркале - REST не вызывался");

	РеквизитыТикета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Результат[0].Тикет, "ВнешняяЗадача");

	ЮТест.ОжидаетЧто(РеквизитыТикета.ВнешняяЗадача)
		.Равно(ЗадачаЗеркала, "Связка на существующую задачу зеркала");

КонецПроцедуры

// Дано: задача в зеркале, тикет уже существует без связки (записан с
//       ОбменДанными.Загрузка - без автосвязки, как до её появления)
// Когда: ТаймлогиGitlab.СобратьТаймлогиНаДату(Дата(2026, 3, 11))
// То: существующий тикет найден по ВнешнийИдентификатор и возвращён
//     без создания дубля
//
Процедура ТЕСТ_СборТаймлогов_ТикетУжеЕсть() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	СоздатьЗадачуЗеркала();

	Тикет = СоздатьТикетВнешнейСистемы("6001", ВебURLЗадачи(), Система, Истина);

	Мокито.Обучение(КоннекторHTTP)
		.Когда("Post").Вернуть(ОтветUsername()).Потом().Вернуть(ОтветТаймлоги())
		.Когда("Get").Вернуть(ОтветЗадача())
		.Прогон();

	Адаптер = Обработки.ТаймлогиGitlab.Создать();
	Адаптер.Инициализировать(Система);

	Результат = Адаптер.СобратьТаймлогиНаДату(Дата(2026, 3, 11));

	ЮТест.ОжидаетЧто(Результат.Количество())
		.Равно(1, "Запись времени собрана");

	ЮТест.ОжидаетЧто(Результат[0].Тикет)
		.Равно(Тикет, "Возвращён существующий тикет, найденный по внешнему идентификатору");

	ЮТест.ОжидаетЧто(КоличествоТикетовПоИдентификатору("6001"))
		.Равно(1, "Дубль тикета не создаётся");

КонецПроцедуры

#КонецОбласти // Тесты

#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// Подготовка данных

// Находит или создаёт внешнюю систему GitLab для мок-тестов и записывает
// в безопасное хранилище тестовый токен (API-адаптер требует токен).
//
Функция ВнешняяСистемаМок()

	БазовыйURL = "https://gitlab.example.com";

	Ссылка = ВнешняяСистемаПоБазовомуURL(БазовыйURL);

	Если Ссылка.Пустая() Тогда
		Объект = Справочники.ВнешниеСистемыТикетов.СоздатьЭлемент();
		Объект.Наименование = "GitLab: gitlab.example.com (мок тесты таймлогов)";
		Объект.БазовыйURL   = БазовыйURL;
		Объект.ТипСистемы   = Справочники.ТипыСистемТикетов.GitLab;
		Объект.Записать();
		Ссылка = Объект.Ссылка;
	КонецЕсли;

	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Ссылка, "test-token", "PRIVATE_TOKEN");

	Возврат Ссылка;

КонецФункции

// Ищет элемент ВнешниеСистемыТикетов по базовому URL (строка неограниченной
// длины не сравнивается в запросе - отбор выполняется в коде).
//
Функция ВнешняяСистемаПоБазовомуURL(Знач БазовыйURL)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.БазовыйURL КАК БазовыйURL
		|ИЗ Справочник.ВнешниеСистемыТикетов КАК Т";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если Выборка.БазовыйURL = БазовыйURL Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Справочники.ВнешниеСистемыТикетов.ПустаяСсылка();

КонецФункции

// Удаляет данные предыдущих прогонов с тестовыми идентификаторами
// (тикеты, зеркало GitLab) - тесты детерминированны и без транзакций.
//
Процедура ОчиститьТестовыеДанные()

	УдалитьТикетыПоИдентификатору("6001");
	УдалитьЗеркалоПоИдентификатору("Справочник.ГитлабЗадачи", 6001);
	УдалитьЗеркалоПоИдентификатору("Справочник.ГитлабПроекты", 3001);
	УдалитьЗеркалоПоИдентификатору("Справочник.ГитлабПользователи", 77);

КонецПроцедуры

// Удаляет тикеты с заданным внешним идентификатором.
//
Процедура УдалитьТикетыПоИдентификатору(Знач ВнешнийИдентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Т.Ссылка КАК Ссылка
		|ИЗ Справочник.Тикеты КАК Т
		|ГДЕ Т.ВнешнийИдентификатор = &ВнешнийИдентификатор";
	Запрос.УстановитьПараметр("ВнешнийИдентификатор", ВнешнийИдентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Выборка.Ссылка.ПолучитьОбъект().Удалить();
	КонецЦикла;

КонецПроцедуры

// Удаляет элементы каталога зеркала с заданным идентификатором GitLab.
//
Процедура УдалитьЗеркалоПоИдентификатору(Знач ИмяТаблицы, Знач Идентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Т.Ссылка КАК Ссылка
		|ИЗ " + ИмяТаблицы + " КАК Т
		|ГДЕ Т.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Выборка.Ссылка.ПолучитьОбъект().Удалить();
	КонецЦикла;

КонецПроцедуры

// Возвращает число тикетов с заданным внешним идентификатором.
//
Функция КоличествоТикетовПоИдентификатору(Знач ВнешнийИдентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(Т.Ссылка) КАК Количество
		|ИЗ Справочник.Тикеты КАК Т
		|ГДЕ Т.ВнешнийИдентификатор = &ВнешнийИдентификатор";
	Запрос.УстановитьПараметр("ВнешнийИдентификатор", ВнешнийИдентификатор);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Создаёт задачу зеркала с владельцем-проектом по тестовым идентификаторам.
//
Функция СоздатьЗадачуЗеркала()

	Проект = Справочники.ГитлабПроекты.СоздатьЭлемент();
	Проект.Код           = "3001";
	Проект.Наименование  = "Проект А";
	Проект.Идентификатор = 3001;
	Проект.ПутьПолный    = "grp/prj";
	Проект.ВебURL        = ВебURLПроекта();
	Проект.Записать();

	Задача = Справочники.ГитлабЗадачи.СоздатьЭлемент();
	Задача.Владелец      = Проект.Ссылка;
	Задача.Код           = "7";
	Задача.Наименование  = "Сборка отчёта";
	Задача.Идентификатор = 6001;
	Задача.ВебURL        = ВебURLЗадачи();
	Задача.Записать();

	Возврат Задача.Ссылка;

КонецФункции

// Создаёт тикет с данными внешней системы; Загрузка = Истина записывает
// объект без обработчика ПередЗаписью (симуляция тикета без автосвязки).
//
Функция СоздатьТикетВнешнейСистемы(Знач ВнешнийИдентификатор, Знач ВебURL, Знач Система, Знач Загрузка = Ложь)

	Объект = Справочники.Тикеты.СоздатьЭлемент();
	Объект.Наименование         = "Тикет теста " + ВнешнийИдентификатор;
	Объект.ВнешняяСистема       = Система;
	Объект.ВнешнийИдентификатор = ВнешнийИдентификатор;
	Объект.СсылкаНаВнешнийТикет = ВебURL;

	Если Загрузка Тогда
		Объект.ОбменДанными.Загрузка = Истина;
	КонецЕсли;

	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

Функция ВебURLПроекта()

	Возврат "https://gitlab.example.com/grp/prj";

КонецФункции

Функция ВебURLЗадачи()

	Возврат "https://gitlab.example.com/grp/prj/-/issues/7";

КонецФункции

