// выполняет сам ПолучитьЗадачуПоПроектуИIID).
//
Функция ОтветЗадача()

	JSONСтрока =
		"{"
		+ """id"": 6001, "
		+ """iid"": 7, "
		+ """project_id"": 3001, "
		+ """title"": ""Сборка отчёта"", "
		+ """description"": ""Описание задачи"", "
