// Тесты автосвязки тикетов с задачами зеркала GitLab: при записи тикета
// с данными внешней системы связка ВнешняяЗадача ищется в зеркале/во внешней
// системе (передЗаписью -> УчетРабочегоВремениИнтеграции). HTTP-вызовы
// подменяются через Мокито (КоннекторHTTP). Фреймворк: yaxunit.
//
// Тесты чистят свои данные перед прогоном и работают с транзакциями и без.

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Тикеты: автосвязка ВнешняяЗадача при записи")
			.ДобавитьТест("ТЕСТ_ТикетПередЗаписью_ЗадачаНайденаВЗеркале")
			.ДобавитьТест("ТЕСТ_ТикетПередЗаписью_ДокачкаИзAPI")
			.ДобавитьТест("ТЕСТ_ТикетПередЗаписью_ЗадачаНеНайдена")
			.ДобавитьТест("ТЕСТ_ТикетПередЗаписью_БезВнешнихДанных")
			.ДобавитьТест("ТЕСТ_ТикетПередЗаписью_ЗаполненнаяЗадачаНеПерезаписывается")
	;

КонецПроцедуры

#Область Тесты

// Дано: задача с данным ВебURL есть в зеркале GitLab
// Когда: записан тикет с СсылкаНаВнешнийТикет = URL задачи и глобальным
//        ВнешнийИдентификатор
// То: ВнешняяЗадача заполнена задачей зеркала, HTTP не вызывался
//
Процедура ТЕСТ_ТикетПередЗаписью_ЗадачаНайденаВЗеркале() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	ЗадачаЗеркала = СоздатьЗадачуЗеркала();

	Тикет = Справочники.Тикеты.СоздатьЭлемент();
	Тикет.Наименование         = "Тикет теста (зеркало)";
	Тикет.ВнешняяСистема       = Система;
	Тикет.ВнешнийИдентификатор = "9999";
	Тикет.СсылкаНаВнешнийТикет = ВебURLЗадачи();

	Мокито.Обучение(КоннекторHTTP)
		.Когда("Get").Вернуть(ОтветЗадачаНеНайдена())
		.Прогон();

	Тикет.Записать();

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Тикет.Ссылка, "ВнешняяЗадача");

	ЮТест.ОжидаетЧто(Реквизиты.ВнешняяЗадача)
		.Равно(ЗадачаЗеркала, "Связка заполнена задачей зеркала по ВебURL");

	Мокито.Проверить(КоннекторHTTP)
		.КоличествоВызовов("Get").Равно(0, "Задача найдена в зеркале - API не вызывался");

КонецПроцедуры

// Дано: зеркало GitLab пустое
// Когда: записан тикет с СсылкаНаВнешнийТикет
// То: задача докачана из API GitLab (GET задачи и проекта), зеркалирована
//     и связана с тикетом
//
Процедура ТЕСТ_ТикетПередЗаписью_ДокачкаИзAPI() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	Тикет = Справочники.Тикеты.СоздатьЭлемент();
	Тикет.Наименование         = "Тикет теста (докачка)";
	Тикет.ВнешняяСистема       = Система;
	Тикет.ВнешнийИдентификатор = "6001";
	Тикет.СсылкаНаВнешнийТикет = ВебURLЗадачи();

	Мокито.Обучение(КоннекторHTTP)
		.Когда("Get").Вернуть(ОтветЗадача()).Вернуть(ОтветПроект())
		.Прогон();

	Тикет.Записать();

	ЗадачаЗеркала = ГитлабЗеркало.СсылкаЗадачиПоИдентификатору(6001);
	ЮТест.ОжидаетЧто(ЗадачаЗеркала.Пустая())
		.Равно(Ложь, "Задача докачана в зеркало");

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Тикет.Ссылка, "ВнешняяЗадача");

	ЮТест.ОжидаетЧто(Реквизиты.ВнешняяЗадача)
		.Равно(ЗадачаЗеркала, "Связка заполнена докачанной задачей");

КонецПроцедуры

// Дано: зеркало GitLab пустое, API не находит задачу (404)
// Когда: записан тикет с данными внешней системы
// То: запись проходит, ВнешняяЗадача остаётся пустой
//
Процедура ТЕСТ_ТикетПередЗаписью_ЗадачаНеНайдена() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	Тикет = Справочники.Тикеты.СоздатьЭлемент();
	Тикет.Наименование         = "Тикет теста (не найдена)";
	Тикет.ВнешняяСистема       = Система;
	Тикет.ВнешнийИдентификатор = "8888";
	Тикет.СсылкаНаВнешнийТикет = ВебURLЗадачи();

	Мокито.Обучение(КоннекторHTTP)
		.Когда("Get").Вернуть(ОтветЗадачаНеНайдена())
		.Прогон();

	Тикет.Записать();

	ЮТест.ОжидаетЧто(Тикет.Ссылка.Пустая())
		.Равно(Ложь, "Тикет записан, несмотря на недоступную задачу");

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Тикет.Ссылка, "ВнешняяЗадача");

	ЮТест.ОжидаетЧто(Реквизиты.ВнешняяЗадача.Пустая())
		.Равно(Истина, "Задача не найдена - связка осталась пустой");

КонецПроцедуры

// Дано: тикет без данных внешней системы (ВнешняяСистема пустая)
// Когда: тикет записан
// То: запись проходит без обращения к API, ВнешняяЗадача пустая
//
Процедура ТЕСТ_ТикетПередЗаписью_БезВнешнихДанных() Экспорт

	ОчиститьТестовыеДанные();

	Тикет = Справочники.Тикеты.СоздатьЭлемент();
	Тикет.Наименование = "Тикет теста (без внешней системы)";

	Мокито.Обучение(КоннекторHTTP)
		.Когда("Get").Вернуть(ОтветЗадачаНеНайдена())
		.Прогон();

	Тикет.Записать();

	ЮТест.ОжидаетЧто(Тикет.Ссылка.Пустая())
		.Равно(Ложь, "Тикет записан");

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Тикет.Ссылка, "ВнешняяЗадача");

	ЮТест.ОжидаетЧто(Реквизиты.ВнешняяЗадача.Пустая())
		.Равно(Истина, "Связка не заполняется без данных внешней системы");

	Мокито.Проверить(КоннекторHTTP)
		.КоличествоВызовов("Get").Равно(0, "API не вызывался");

КонецПроцедуры

// Дано: тикет уже имеет заполненную ВнешняяЗадача (задача Б)
// Когда: тикет перезаписан (внешние данные указывают на задачу А в зеркале)
// То: связка не перезаписывается
//
Процедура ТЕСТ_ТикетПередЗаписью_ЗаполненнаяЗадачаНеПерезаписывается() Экспорт

	Система = ВнешняяСистемаМок();
	ОчиститьТестовыеДанные();

	ЗадачаБ = СоздатьЗадачуЗеркала();

	Тикет = Справочники.Тикеты.СоздатьЭлемент();
	Тикет.Наименование         = "Тикет теста (перезапись)";
	Тикет.ВнешняяСистема       = Система;
	Тикет.ВнешнийИдентификатор = "9999";
	Тикет.СсылкаНаВнешнийТикет = ВебURLЗадачи();
	Тикет.ВнешняяЗадача        = ЗадачаБ;

	Мокито.Обучение(КоннекторHTTP)
		.Когда("Get").Вернуть(ОтветЗадачаНеНайдена())
		.Прогон();

	Тикет.Записать();

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Тикет.Ссылка, "ВнешняяЗадача");

	ЮТест.ОжидаетЧто(Реквизиты.ВнешняяЗадача)
		.Равно(ЗадачаБ, "Уже заполненная связка не перезаписывается");

	Мокито.Проверить(КоннекторHTTP)
		.КоличествоВызовов("Get").Равно(0, "API не вызывался");

КонецПроцедуры

#КонецОбласти // Тесты

#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// Подготовка данных

// Находит или создаёт внешнюю систему GitLab для мок-тестов и записывает
// в безопасное хранилище тестовый токен.
//
Функция ВнешняяСистемаМок()

	БазовыйURL = "https://gitlab.example.com";

	Ссылка = ВнешняяСистемаПоБазовомуURL(БазовыйURL);

	Если Ссылка.Пустая() Тогда
		Объект = Справочники.ВнешниеСистемыТикетов.СоздатьЭлемент();
		Объект.Наименование = "GitLab: gitlab.example.com (мок тесты тикетов)";
		Объект.БазовыйURL   = БазовыйURL;
		Объект.ТипСистемы   = Справочники.ТипыСистемТикетов.GitLab;
		Объект.Записать();
		Ссылка = Объект.Ссылка;
	КонецЕсли;

	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Ссылка, "test-token", "PRIVATE_TOKEN");

	Возврат Ссылка;

КонецФункции

// Ищет элемент ВнешниеСистемыТикетов по базовому URL (строка неограниченной
// длины не сравнивается в запросе - отбор выполняется в коде).
//
Функция ВнешняяСистемаПоБазовомуURL(Знач БазовыйURL)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.БазовыйURL КАК БазовыйURL
		|ИЗ Справочник.ВнешниеСистемыТикетов КАК Т";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если Выборка.БазовыйURL = БазовыйURL Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Справочники.ВнешниеСистемыТикетов.ПустаяСсылка();

КонецФункции

// Удаляет данные предыдущих прогонов с тестовыми идентификаторами.
//
Процедура ОчиститьТестовыеДанные()

	УдалитьТикетыПоИдентификатору("9999");
	УдалитьТикетыПоИдентификатору("8888");
	УдалитьТикетыПоИдентификатору("6001");
	УдалитьЗеркалоПоИдентификатору("Справочник.ГитлабЗадачи", 6001);
	УдалитьЗеркалоПоИдентификатору("Справочник.ГитлабПроекты", 3001);
	УдалитьЗеркалоПоИдентификатору("Справочник.ГитлабПользователи", 77);

КонецПроцедуры

// Удаляет тикеты с заданным внешним идентификатором.
//
Процедура УдалитьТикетыПоИдентификатору(Знач ВнешнийИдентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Т.Ссылка КАК Ссылка
		|ИЗ Справочник.Тикеты КАК Т
		|ГДЕ Т.ВнешнийИдентификатор = &ВнешнийИдентификатор";
	Запрос.УстановитьПараметр("ВнешнийИдентификатор", ВнешнийИдентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Выборка.Ссылка.ПолучитьОбъект().Удалить();
	КонецЦикла;

КонецПроцедуры

// Удаляет элементы каталога зеркала с заданным идентификатором GitLab.
//
Процедура УдалитьЗеркалоПоИдентификатору(Знач ИмяТаблицы, Знач Идентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Т.Ссылка КАК Ссылка
		|ИЗ " + ИмяТаблицы + " КАК Т
		|ГДЕ Т.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Выборка.Ссылка.ПолучитьОбъект().Удалить();
	КонецЦикла;

КонецПроцедуры

// Создаёт задачу зеркала с владельцем-проектом по тестовым идентификаторам.
//
Функция СоздатьЗадачуЗеркала()

	Проект = Справочники.ГитлабПроекты.СоздатьЭлемент();
	Проект.Код           = "3001";
	Проект.Наименование  = "Проект А";
	Проект.Идентификатор = 3001;
	Проект.ПутьПолный    = "grp/prj";
	Проект.ВебURL        = ВебURLПроекта();
	Проект.Записать();

	Задача = Справочники.ГитлабЗадачи.СоздатьЭлемент();
	Задача.Владелец      = Проект.Ссылка;
	Задача.Код           = "7";
	Задача.Наименование  = "Сборка отчёта";
	Задача.Идентификатор = 6001;
	Задача.ВебURL        = ВебURLЗадачи();
	Задача.Записать();

	Возврат Задача.Ссылка;

КонецФункции

Функция ВебURLПроекта()

	Возврат "https://gitlab.example.com/grp/prj";

КонецФункции

Функция ВебURLЗадачи()

	Возврат "https://gitlab.example.com/grp/prj/-/issues/7";

КонецФункции

