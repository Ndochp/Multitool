// yaxUnit-тесты выгрузки MSPDI из базы подсистемы Проджект
// (ОбщийМодуль.ЭкспортMSPDI, п.7 роадмапа).
// Полный круг: Разобрать(фикстура) -> ИмпортMSPDI.Загрузить -> Выгрузить ->
// Записать -> Разобрать; сравниваются поля, сохраняющиеся через базу
// (нулевые числовые значения не сравниваются - см. ограничения v1).

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Выгрузка MSPDI из ИБ")
			.ДобавитьТест("ТЕСТ_Круг_ИБ_XML_ИБ")
	;

КонецПроцедуры

#Область Тесты

Процедура ТЕСТ_Круг_ИБ_XML_ИБ() Экспорт

	Данные1 = ОбменMSProject.Разобрать(тест_ОбменMSProject.Фикстура());
	РезультатЗагрузки = ИмпортMSPDI.Загрузить(Данные1);
	Данные2 = ЭкспортMSPDI.Выгрузить(РезультатЗагрузки.Проект);
	ТекстXML = ОбменMSProject.Записать(Данные2);
	Данные3 = ОбменMSProject.Разобрать(ТекстXML);

	// Проект.
	ЮТест.ОжидаетЧто(Данные3.Проект.UID)
		.Равно("11111111-1111-1111-1111-111111111111", "UID проекта из базы");
	ЮТест.ОжидаетЧто(Данные3.Проект.Name)
		.Равно("Тестовый проект", "Наименование проекта");
	ЮТест.ОжидаетЧто(Данные3.Проект.StartDate)
		.Равно(Дата(2026, 11, 9, 8, 0, 0), "Начало проекта");
	ЮТест.ОжидаетЧто(Данные3.Проект.MinutesPerDay)
		.Равно(480, "Минут в дне");
	ЮТест.ОжидаетЧто(Данные3.Проект.MinutesPerWeek)
		.Равно(2400, "Минут в неделе");
	ЮТест.ОжидаетЧто(Данные3.Проект.DaysPerMonth)
		.Равно(20, "Дней в месяце");
	ЮТест.ОжидаетЧто(Данные3.Проект.CurrencyCode)
		.Равно("RUB", "Валюта");
	ЮТест.ОжидаетЧто(Данные3.Проект.CalendarUID)
		.Равно("22222222-2222-2222-2222-222222222222", "Календарь проекта по UID");

	// Календарь собран по ссылке из базы: дни, интервалы, исключения.
	ЮТест.ОжидаетЧто(Данные3.Календари.Количество())
		.Равно(1, "Календарь проекта собран по ссылке");
	День = Данные3.Календари[0].WeekDays[0];
	ЮТест.ОжидаетЧто(День.DayType)
		.Равно(1, "День недели сохранён");
	ЮТест.ОжидаетЧто(День.Интервалы.Количество())
		.Равно(2, "Плоские колонки свернулись в две пары");
	ЮТест.ОжидаетЧто(День.Интервалы[0].FromTime)
		.Равно(Дата(1, 1, 1, 8, 0, 0), "Интервал 1 с 8:00");
	ЮТест.ОжидаетЧто(День.Интервалы[1].ToTime)
		.Равно(Дата(1, 1, 1, 17, 0, 0), "Интервал 2 до 17:00");
	ЮТест.ОжидаетЧто(Данные3.Календари[0].Exceptions.Количество())
		.Равно(1, "Диапазонное исключение сохранено");
	ЮТест.ОжидаетЧто(Данные3.Календари[0].Exceptions[0].Name)
		.Равно("Новый год", "Имя исключения");
	ЮТест.ОжидаетЧто(Данные3.Календари[0].Exceptions[0].FromDate)
		.Равно(Дата(2027, 1, 1), "Дата исключения");

	// Задачи: иерархия, длительности, связи.
	ЮТест.ОжидаетЧто(Данные3.Задачи.Количество())
		.Равно(3, "Три работы по порядку ID");
	ЮТест.ОжидаетЧто(Данные3.Задачи[0].UID)
		.Равно("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", "Этап");
	ЮТест.ОжидаетЧто(Данные3.Задачи[0].OutlineLevel)
		.Равно(1, "Уровень сводной");
	ЮТест.ОжидаетЧто(Данные3.Задачи[0].Summary)
		.Равно(Истина, "Признак сводной");
	ЮТест.ОжидаетЧто(Данные3.Задачи[1].Duration)
		.Равно(480, "Длительность Задачи А");
	ЮТест.ОжидаетЧто(Данные3.Задачи[1].Start)
		.Равно(Дата(2026, 11, 9, 8, 0, 0), "Начало Задачи А");
	ЮТест.ОжидаетЧто(Данные3.Задачи[1].Finish)
		.Равно(Дата(2026, 11, 9, 17, 0, 0), "Финиш Задачи А");
	ЮТест.ОжидаетЧто(Данные3.Задачи[1].Предшественники.Количество())
		.Равно(2, "Две связи Задачи А");
	Связь = Данные3.Задачи[1].Предшественники[0];
	ЮТест.ОжидаетЧто(Связь.PredecessorUID)
		.Равно("cccccccc-cccc-cccc-cccc-cccccccccccc", "Предшественник по UID");
	ЮТест.ОжидаетЧто(Связь.LinkType)
		.Равно(1, "Тип связи");
	ЮТест.ОжидаетЧто(Связь.Lag)
		.Равно(120, "Лаг в минутах");
	ЮТест.ОжидаетЧто(Данные3.Задачи[2].Milestone)
		.Равно(Истина, "Веха");
	ЮТест.ОжидаетЧто(Данные3.Задачи[2].ConstraintDate)
		.Равно(Дата(2026, 11, 10, 8, 0, 0), "Ограничение вехи");

	// Ресурсы и назначения.
	ЮТест.ОжидаетЧто(Данные3.Ресурсы.Количество())
		.Равно(2, "Два ресурса");
	ЮТест.ОжидаетЧто(Данные3.Ресурсы[0].UID)
		.Равно("eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee", "Иванов по UID");
	ЮТест.ОжидаетЧто(Данные3.Ресурсы[0].MaxUnits)
		.Равно(100, "Максимум единиц в процентах");
	ЮТест.ОжидаетЧто(Данные3.Ресурсы[1].IsActive)
		.Равно(Ложь, "Материал неактивен");
	ЮТест.ОжидаетЧто(Данные3.Ресурсы[1].MaterialLabel)
		.Равно("кг", "Единица материала");
	ЮТест.ОжидаетЧто(Данные3.Назначения.Количество())
		.Равно(1, "Одно назначение");
	Назначение = Данные3.Назначения[0];
	ЮТест.ОжидаетЧто(Назначение.TaskUID)
		.Равно("bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb", "Назначение на Задачу А");
	ЮТест.ОжидаетЧто(Назначение.ResourceUID)
		.Равно("eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee", "Ресурс назначения");
	ЮТест.ОжидаетЧто(Назначение.Units)
		.Равно(50, "Доля в процентах");
	ЮТест.ОжидаетЧто(Назначение.Work)
		.Равно(240, "Труд назначения в минутах");

	// Промежуточная структура Выгрузить тоже в единицах подсистемы.
	ЮТест.ОжидаетЧто(Данные2.Ресурсы[0].MaxUnits)
		.Равно(100, "Выгрузить возвращает проценты, не доли");
	ЮТест.ОжидаетЧто(Данные2.Назначения[0].Units)
		.Равно(50, "Выгрузить: доля назначения в процентах");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти
